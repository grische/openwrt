- * BDYL[15:0] is the PDU body length, ppt[1] SEGL[9:0], ppt[0] OFFS[15:8].
- * Bounded spin; returns -ETIMEDOUT on timeout.
- */
-int tmu_ppt_read(u32 pos, u32 *ppt);
