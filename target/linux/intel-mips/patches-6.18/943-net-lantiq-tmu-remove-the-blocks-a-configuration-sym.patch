-	memset(tmu_buf, 0, TMU_MOCK_BUFSZ);
-	g_cbm_qeqcnt_base = (void __iomem *)qeqcnt_buf;
-	g_cbm_qdqcnt_base = (void __iomem *)qdqcnt_buf;
-	g_cbm_tmu_base = (void __iomem *)tmu_buf;
