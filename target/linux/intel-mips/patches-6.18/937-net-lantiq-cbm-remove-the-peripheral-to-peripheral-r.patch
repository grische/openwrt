-		ltq_dma_chan_data_buf_alloc(chan2_1);
-
-	if ((ltq_request_dma(chan1_2, "dma1 tx lan")) < 0)
-		pr_err(" %s failed to open chan for chan1_2\r\n", __func__);
-
-	if ((ltq_request_dma(chan2_2, "dma2 rx gswpr")) < 0)
