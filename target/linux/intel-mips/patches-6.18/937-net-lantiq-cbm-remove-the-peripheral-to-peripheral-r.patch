-	}
-	return 0;
-}
-
 static int cbm_eqm_rx_chan_open(int chan, int cbm_port, u32 buf_type)
 {
 	dma_addr_t desc;
@@ -347,14 +233,6 @@ int cbm_hw_init(struct platform_device *pdev)
