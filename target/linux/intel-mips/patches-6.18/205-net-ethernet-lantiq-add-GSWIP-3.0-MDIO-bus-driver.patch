+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Intel xRX500 GSWIP-3.x MDIO bus driver.
+ *
+ * Phase 3 Sub-6 ST-002b: closes the Plan-Reviewer critical-1 finding —
+ * Sub-1's switch-api/ shipped zero MDIO bus driver, so the v6.18 port
+ * had no mii_bus registered against the GSWIP-3.x MDIO_CTRL / MDIO_READ
+ * / MDIO_WRITE register triple at DWORD offsets 0x008 / 0x009 / 0x00A
+ * (per switch-api/gsw_reg_top.h). Without a registered bus,
+ * phylink_of_phy_connect() in ST-003 always returns -ENODEV and the
+ * whole phylink chain never comes up.
+ *
+ * This TU lands a minimal but correct MDIO bus driver:
+ *
+ *   (a) devm_mdiobus_alloc_size() + devm_ioremap (NOT
+ *       devm_platform_ioremap_resource — see below) on a
+ *       SUB-APERTURE of the gswl register window. Same
+ *       syscon-or-sub-aperture decision ST-001's xrx500_phy_fw.c made —
+ *       sibling platform_device whose reg = <0x1c000020 0x20> overlaps
+ *       the gswl@1c000000 <0x1c000000 0x4000> claim by design (dtc
+ *       tolerates root-scope sibling-node reg overlaps at root scope).
+ *
+ *       EVAL-FIX-ROUND-1 correction (AC-002b-1): the prior comment
+ *       claimed "the kernel resource subsystem honours per-node
+ *       ioremap regardless" — that was factually wrong.
+ *       devm_request_mem_region (called inside
+ *       devm_platform_ioremap_resource via devm_ioremap_resource) DOES
+ *       check iomem_resource conflicts and returns -EBUSY when a
+ *       region is already claimed by a parent. Since gswl@1c000000's
+ *       full <0x1c000000 0x4000> parent claim is held by the
+ *       intel,xrx500-gswip-3.0 driver, the request_mem_region for our
+ *       0x1c000020..0x1c00003F sub-range would fail. The fix is to use
+ *       devm_ioremap directly (which only maps the MMIO window without
+ *       claiming the resource), which the mainline lantiq_gswip.c
+ *       driver also uses for its own MDIO sub-aperture probe. The
+ *       longer-term Sub-1.1 cleanup would restructure gswl@1c000000 as
+ *       compatible='syscon' (so children share its regmap) but that
+ *       requires xrx500.dtsi edits beyond eval-fix-round-1 scope; the
+ *       devm_ioremap approach is the minimum-impact fix.
+ *
+ *   (b) C22 read/write callbacks that pack PHYAD/REGAD/OP/MBUSY into
+ *       MDIO_CTRL exactly as the GSWIP-3.0 datasheet specifies (review
+ *       focus #7): OP=READ is binary 10 = (2 << OP_SHIFT) = 0x800;
+ *       OP=WRITE is binary 01 = (1 << OP_SHIFT) = 0x400. Read draws
+ *       from MDIO_READ_RDATA after the post-issue poll; write stages
+ *       the 16-bit value into MDIO_WRITE_WDATA before issuing the
+ *       CTRL with MBUSY=1. Both callbacks bound the MBUSY-clear poll
+ *       with a 10 ms hard cap (review focus #1) so a wedged bus does
+ *       not lock the kernel — readl_poll_timeout returns -ETIMEDOUT
+ *       which propagates straight back to the mdiobus core, which in
+ *       turn lets phylink mark the affected PHY as inaccessible.
+ *
+ *   (c) of_mdiobus_register() against pdev->dev.of_node so the DT
+ *       child phy@N nodes are auto-discovered (review focus #3 — no
+ *       manual mdiobus_scan). PHY devices are instantiated at the
+ *       silicon addresses {0x02, 0x03, 0x04, 0x05} per CQ-002 A.
+ *
+ *   (d) ST-001 GPHY firmware-loader dependency honoured via explicit
+ *       xrx500_gphy_fw_is_loaded() probe-gate (review focus #4):
+ *       if the firmware loader has not yet completed, this probe
+ *       returns -EPROBE_DEFER so the driver-core requeues us until
+ *       request_firmware + dma_alloc_coherent + LBADR/MBADR writes
+ *       have all landed. (The alternative — late_initcall ordering —
+ *       was rejected because in the intel-xrx500-gswip composite both
+ *       TUs use device_initcall, and link-order does NOT guarantee
+ *       probe-order: registration order only affects which driver
+ *       wins the platform-device match-and-probe race, and the actual
+ *       probe firing depends on DT-tree walk order.)
+ *
+ *   (e) Probe-time pr_info on success emits the scanned PHY-address
+ *       list (review focus #5 / AC-002b-6 / smoke_test_description)
+ *       so the boot log is the first-hardware-iteration diagnostic.
+ *
+ * Compatible-string collision audit (review focus #6): grep across
+ * /project/linux-6.18.y for "lantiq,gswip-mdio" returns zero hits.
+ * The existing mainline drivers/net/dsa/lantiq/lantiq_gswip.c uses
+ * "lantiq,xrx200-mdio" as its mdio-child compatible — different
+ * string, no binding collision.
+ *
+ * Endianness note (Sub-6.2 BUGFIX): the FB7560 kernel runs BIG-ENDIAN
+ * MIPS (CONFIG_CPU_BIG_ENDIAN=y). The GSWIP register block is accessed
+ * NATIVELY (no byte-swap) on this SoC. AVM's gsw_w32/gsw_r32 reach the
+ * hardware via gsw1_w32/gsw1_r32 == ltq_w32/ltq_r32, which are
+ * __raw_writel/__raw_readl (arch/mips/include/asm/mach-lantiq/lantiq.h:16-17)
+ * — i.e. NO endianness conversion. The PRIOR Sub-6.1 driver used
+ * writel()/readl(), which on big-endian MIPS byte-SWAP (they assume a
+ * little-endian device). That mismatch scrambled the MDIO control word
+ * across byte lanes (OP/PHYAD/REGAD ended up in the upper 16 bits) so no
+ * MDIO transaction completed and RDATA read back as 0x00000000 for every
+ * register. This TU switches to __raw_writel/__raw_readl to match AVM's
+ * effective access exactly, which is what makes PHY_ID read the real
+ * 0xd565a409 instead of 0x0.
+ *
+ * Register-layout note (Sub-6.1 BUGFIX): the FB7560 GSWIP-L is
+ * GSWIP-3.0. Its MDIO master registers are the GSWT_MD* registers in
+ * gsw30_reg_top.h, at DWORD offsets 0x004 / 0x005 / 0x006 (CTRL / READ
+ * / WRITE) PLUS GSW30_TOP_OFFSET (0xF00). The hardware byte address is
+ * gswl_base + (DWORD * 4), so the physical addresses are
+ * 0x1c003c10 / 0x1c003c14 / 0x1c003c18, with MDCCFG_0 at 0x1c003c1c
+ * and MDCCFG_1 at 0x1c003c20. The DT reg sub-aperture starts at
+ * 0x1c003c10 size 0x20, so the byte offsets WITHIN the sub-aperture
+ * are 0x000 / 0x004 / 0x008 (CTRL / READ / WRITE) and 0x00C / 0x010
+ * (MDCCFG_0 / MDCCFG_1).
+ *
+ * The PRIOR ST-002b layout used gsw_reg_top.h MDIO_CTRL_*_OFFSET=0x008
+ * at aperture 0x1c000020 — that is the GSWIP-2.x register map, which
+ * on GSWIP-3.0 silicon is not the MDIO master and returned a constant
+ * (0x1020 per register: PHY_ID read 0x10201020). Switching to the
+ * GSWT_MD* / GSW30_TOP_OFFSET layout faithfully ports AVM's
+ * GSW_MDIO_DataRead/DataWrite LTQ_GSWIP_3_0 branch.
+ *
+ * Sub-aperture overlap audit:
+ *   - gswl@1c000000 ........ <0x1c000000 0x4000> (parent register window)
+ *   - phy-xrx500@1c003c00 .. <0x1c003c00 0x0280> (ST-001 sub-aperture)
+ *   - gswip-mdio@1c003c10 .. <0x1c003c10 0x0020> (THIS sub-aperture)
+ * THIS window now sits INSIDE phy-xrx500's window; both are
+ * devm_ioremap-only (no devm_request_mem_region resource claim), so
+ * the overlap is intentional and harmless.
+ */
+
+#include <linux/bits.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_mdio.h>
+#include <linux/phy.h>
+#include <linux/platform_device.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#include "gsw30_reg_top.h"
+#include "../include/xrx500_phy_fw.h"
+
+/*
+ * BUGFIX (Sub-6.1): the from-scratch ST-002b driver mapped the WRONG
+ * MDIO register block. It used the gsw_reg_top.h MDIO_CTRL_MBUSY_OFFSET
+ * = 0x008 (DWORD) layout — that is the GSWIP-2.x register map. The
+ * FB7560 GSWIP-L is GSWIP-3.0 (DT compatible "intel,xrx500-gswip-3.0").
+ * On GSWIP-3.0 the MDIO master registers live in the GSW-T "top" window
+ * at the GSWT_MD* DWORD offsets plus GSW30_TOP_OFFSET (0xF00), NOT at
+ * 0x008. AVM's GSW_MDIO_DataRead/DataWrite take the
+ * "if (gswdev->gipver == LTQ_GSWIP_3_0)" branch and address:
+ *
+ *   GSWT_MDCTRL_MBUSY_OFFSET  = 0x004 (gsw30_reg_top.h:38)
+ *   GSWT_MDREAD_RDATA_OFFSET  = 0x005 (gsw30_reg_top.h:60)
+ *   GSWT_MDWRITE_WDATA_OFFSET = 0x006 (gsw30_reg_top.h:67)
+ *   GSWT_MDCCFG_0_PEN_*       = 0x007 (gsw30_reg_top.h:104)
+ *   GSWT_MDCCFG_1_*           = 0x008 (gsw30_reg_top.h:126-131)
+ *   GSW30_TOP_OFFSET          = 0xF00 (gsw30_reg_top.h:16)
+ *
+ * The hardware byte address is gsw_base + (DWORD_offset * 4) — see AVM
+ * gsw_w32_raw()/gsw_r32_raw() in switch-api/gsw_init.c:416,433. So the
+ * physical byte addresses (gsw_base = 0x1c000000) are:
+ *
+ *   MDCTRL   = (0x004 + 0xF00) * 4 = 0x3C10  (phys 0x1c003c10)
+ *   MDREAD   = (0x005 + 0xF00) * 4 = 0x3C14  (phys 0x1c003c14)
+ *   MDWRITE  = (0x006 + 0xF00) * 4 = 0x3C18  (phys 0x1c003c18)
+ *   MDCCFG_0 = (0x007 + 0xF00) * 4 = 0x3C1C  (phys 0x1c003c1c)
+ *   MDCCFG_1 = (0x008 + 0xF00) * 4 = 0x3C20  (phys 0x1c003c20)
+ *
+ * The DT reg sub-aperture is now <0x1c003c10 0x20> so byte offset 0x000
+ * within the ioremap lands on MDCTRL. The OLD aperture <0x1c000020 0x20>
+ * pointed at the GSWIP-2.x block, which on GSWIP-3.0 silicon is not the
+ * MDIO master — it returned a constant (0x1020 per register), the
+ * smoking-gun symptom this fix resolves.
+ *
+ * Citations (AVM 4.9, FB7560 source tree):
+ *   GSW_MDIO_DataRead  : switch-api/gsw_flow_core.c:11997-12026 (3.0 branch)
+ *   GSW_MDIO_DataWrite : switch-api/gsw_flow_core.c:12050-12077 (3.0 branch)
+ *   mdio_init_gswip3_0 : switch-api/gsw_flow_core.c:2733-2752
+ */
+#define LTQ_GSWIP_MDIO_SUBAP_DWORD_BASE \
+	(GSWT_MDCTRL_MBUSY_OFFSET + GSW30_TOP_OFFSET)
+#define LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE    (LTQ_GSWIP_MDIO_SUBAP_DWORD_BASE * 4)
+
+/*
+ * Byte offsets WITHIN the sub-aperture for the three registers the
+ * bus callbacks touch. Sub-aperture base == MDCTRL, so:
+ *   MDCTRL == 0x000, MDREAD == 0x004, MDWRITE == 0x008.
+ */
+#define LTQ_GSWIP_MDIO_CTRL_OFF \
+	(((GSWT_MDCTRL_MBUSY_OFFSET  + GSW30_TOP_OFFSET) * 4) - LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE)
+#define LTQ_GSWIP_MDIO_READ_OFF \
+	(((GSWT_MDREAD_RDATA_OFFSET  + GSW30_TOP_OFFSET) * 4) - LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE)
+#define LTQ_GSWIP_MDIO_WRITE_OFF \
+	(((GSWT_MDWRITE_WDATA_OFFSET + GSW30_TOP_OFFSET) * 4) - LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE)
+
+/* MBUSY single-bit at MDCTRL[12]. */
+#define LTQ_GSWIP_MDIO_CTRL_MBUSY  BIT(GSWT_MDCTRL_MBUSY_SHIFT)
+
+/*
+ * Byte offsets WITHIN the sub-aperture for the MDC clock-configuration
+ * registers (EVAL-FIX-ROUND-1 AC-002b-1 (1)). The mainline DSA driver
+ * (drivers/net/dsa/lantiq/lantiq_gswip.c:634-637) programs these at
+ * probe time so the MDIO bus has a known good clock rate before any
+ * transactions issue. Without explicit programming, the post-reset
+ * default may leave MCEN clear or FREQ at an unsupported value, which
+ * causes MDIO transactions to silently never complete (MBUSY stays
+ * stuck) and the 10ms readl_poll_timeout cap then surfaces -ETIMEDOUT.
+ *
+ * AVM's mdio_init_gswip3_0() (switch-api/gsw_flow_core.c:2733-2752)
+ * programs MDCCFG_1 on GSWIP-3.0: FREQ=0x9 (2.5 MHz), MCEN=1, RES=1
+ * (MDIO hardware reset). The GSWIP-3.0 register byte offsets are:
+ *
+ *   MDCCFG_0 = (0x007 + 0xF00) * 4 = 0x3C1C  -> aperture offset 0x00C
+ *   MDCCFG_1 = (0x008 + 0xF00) * 4 = 0x3C20  -> aperture offset 0x010
+ *
+ *   MDCCFG_0  PEN_ALL[6:1] polling-state-machine enables; WRITE 0
+ *             so phylink owns link-state polling for our 4 attached
+ *             PHYs and the GSWIP poll state-machine does not fight it.
+ *   MDCCFG_1  RES (bit 15) MDIO HW reset, MCEN (bit 8) master-clock
+ *             enable, FREQ (bits 7:0) = 0x9 -> 2.5 MHz MDC.
+ */
+#define LTQ_GSWIP_MDIO_MDC_CFG_0_OFF \
+	(((GSWT_MDCCFG_0_PEN_ALL_OFFSET + GSW30_TOP_OFFSET) * 4) - LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE)
+#define LTQ_GSWIP_MDIO_MDC_CFG_1_OFF \
+	(((GSWT_MDCCFG_1_FREQ_OFFSET    + GSW30_TOP_OFFSET) * 4) - LTQ_GSWIP_MDIO_SUBAP_BYTE_BASE)
+
+/* MDCCFG_1 field values (AVM mdio_init_gswip3_0). */
+#define LTQ_GSWIP_MDIO_MDC_CFG_1_RES   BIT(GSWT_MDCCFG_1_RES_SHIFT)   /* bit 15 */
+#define LTQ_GSWIP_MDIO_MDC_CFG_1_MCEN  BIT(GSWT_MDCCFG_1_MCEN_SHIFT)  /* bit 8 */
+#define LTQ_GSWIP_MDIO_MDC_CFG_1_FREQ_DEFAULT  0x09                   /* 2.5 MHz */
+#define LTQ_GSWIP_MDIO_MDC_CFG_1_INIT  \
+	(LTQ_GSWIP_MDIO_MDC_CFG_1_RES | LTQ_GSWIP_MDIO_MDC_CFG_1_MCEN | \
+	 LTQ_GSWIP_MDIO_MDC_CFG_1_FREQ_DEFAULT)
+
+/*
+ * OP[1:0] = MDIO_CTRL[11:10] encodes the bus operation.
+ *
+ *   OP = 0b10 -> READ   (datasheet review focus #7; do not swap)
+ *   OP = 0b01 -> WRITE
+ *
+ * AVM packs the control word as ((OP << 10) | (PHYAD << 5) | REGAD)
+ * with OP=0x2 for read, 0x1 for write (gsw_flow_core.c:12016,12071).
+ * Use GSWT_MDCTRL_OP_SHIFT (=10) as the shift base so a future
+ * re-numbering of the field stays single-sourced.
+ */
+#define LTQ_GSWIP_MDIO_OP_READ   (2u << GSWT_MDCTRL_OP_SHIFT)
+#define LTQ_GSWIP_MDIO_OP_WRITE  (1u << GSWT_MDCTRL_OP_SHIFT)
+
+/* 5-bit PHYAD and REGAD field masks (each is 5 bits wide). */
+#define LTQ_GSWIP_MDIO_PHYAD_MASK  GENMASK(GSWT_MDCTRL_PHYAD_SIZE - 1, 0)
+#define LTQ_GSWIP_MDIO_REGAD_MASK  GENMASK(GSWT_MDCTRL_REGAD_SIZE - 1, 0)
+
+/*
+ * IG-104: MBUSY-in-CTRL self-calibration.
+ *
+ * AVM 4.9 issues every MDIO transaction by writing the CTRL word with
+ * MBUSY=0 — one 16-bit write, "once at a time" (gsw_flow_core.c:
+ * 12066-12077) — and the hardware self-sets MBUSY while it executes.
+ * Sub-6.4 instead set MBUSY=1 in the CTRL word (claiming transactions
+ * never start without it). With the HW polling unit now enabled
+ * (IG-103) the MBUSY=1 convention can stomp an in-flight poller
+ * transaction: smoke-5 caught corrupted reads (0x0800 patterns) and a
+ * BMCR resume that never took (PHY stuck in PDOWN, IG-104).
+ *
+ * Rather than risk a dead bus if Sub-6.4's observation was real, the
+ * probe path CALIBRATES: a PHYID1 read of GPHY5 issued with MBUSY=0,
+ * before PEN is enabled. PHY11G PHYID1 = 0xD565; anything else flips
+ * this flag back to the MBUSY=1 convention and logs the fallback.
+ */
+static bool ltq_gswip_mdio_ctrl_mbusy; /* false = AVM-exact (MBUSY=0) */
+
+static inline u32 ltq_gswip_mdio_ctrl_word(u32 op, int addr, int reg)
+{
+	return (ltq_gswip_mdio_ctrl_mbusy ? LTQ_GSWIP_MDIO_CTRL_MBUSY : 0)
+	     | op
+	     | (((u32)addr & LTQ_GSWIP_MDIO_PHYAD_MASK) << GSWT_MDCTRL_PHYAD_SHIFT)
+	     | (((u32)reg  & LTQ_GSWIP_MDIO_REGAD_MASK) << GSWT_MDCTRL_REGAD_SHIFT);
+}
+
+/*
+ * MBUSY-clear poll budgets. readl_poll_timeout sleeps udelay()-style
+ * between samples — typical clear is sub-microsecond on functional
+ * silicon, the hard 10 ms cap is the wedged-bus safety net per
+ * AC-002b-2 / review focus #1.
+ */
+#define LTQ_GSWIP_MDIO_POLL_INTERVAL_US  1
+#define LTQ_GSWIP_MDIO_POLL_TIMEOUT_US   10000
+
+/**
+ * struct ltq_gswip_mdio_priv - per-bus state.
+ * @base:  ioremap'd sub-aperture covering MDIO_CTRL / MDIO_READ /
+ *         MDIO_WRITE (DT reg = <0x1c000020 0x20>).
+ * @dev:   probing device, retained for dev_err / dev_info.
+ *
+ * Allocated inline at the tail of devm_mdiobus_alloc_size's mii_bus
+ * via bus->priv — devm-managed, freed automatically on probe failure
+ * or device unbind.
+ */
+struct ltq_gswip_mdio_priv {
+	void __iomem *base;
+	struct device *dev;
+	struct mii_bus *bus;	/* IG-104: for mdio_lock serialization */
+	struct delayed_work gsw_reinit_work;
+};
+
+/* IG-113 (gsw_flow_pce.c): GSW-L whole-core SWRES + full re-init. */
+int gsw_hw_reinit_gswl(void);
+
+static int ltq_gswip_mdio_poll_mbusy(struct ltq_gswip_mdio_priv *priv);
+
+/* Raw C22 read on priv->base (no mii_bus) — probe-time CTRL calibration. */
+static int ltq_gswip_mdio_dbg_rd(struct ltq_gswip_mdio_priv *priv,
+				 int addr, int reg)
+{
+	u32 cmd;
+
+	if (ltq_gswip_mdio_poll_mbusy(priv))
+		return -1;
+	cmd = ltq_gswip_mdio_ctrl_word(LTQ_GSWIP_MDIO_OP_READ, addr, reg);
+	__raw_writel(cmd, priv->base + LTQ_GSWIP_MDIO_CTRL_OFF);
+	if (ltq_gswip_mdio_poll_mbusy(priv))
+		return -1;
+	return __raw_readl(priv->base + LTQ_GSWIP_MDIO_READ_OFF) & 0xFFFF;
+}
+
+/*
+ * IG-107: AVM master-bias parity. AVM's PHY driver sets MII_CTRL1000
+ * bit 10 ("Port type: prefer multi-port device / master") before EVERY
+ * autonegotiation (AVM 4.9 drivers/net/phy/lantiq.c:77-89,
+ * vr9_gphy_config_aneg) — so the working box's GPHY5 resolves 1000BT
+ * MASTER against the host NIC, while our genphy-driven GPHY resolves
+ * SLAVE (IG-106 oracle: STAT1000 0x7800 vs our 0x3800, bit14). That is
+ * the ONLY functional PHY-state difference found on an otherwise
+ * byte-identical system, and SLAVE means our GPHY recovers its data
+ * clock from the partner instead of self-clocking. Registered as a
+ * phylib fixup for the PHY11G id; genphy_config_advert only rewrites
+ * MII_CTRL1000 bits 9:8, so the bit persists across renegotiations.
+ */
+#define LTQ_GPHY11G_PHY_ID	0xd565a409
+#define LTQ_GPHY11G_PHY_MASK	0xfffffff8
+#define LTQ_CTL1000_MULTIPORT	BIT(10)
+
+static int ltq_gswip_gphy_mpd_fixup(struct phy_device *phydev)
+{
+	int ret;
+
+	/*
+	 * IG-132 (genuine port — restores AVM 4.9 de-facto phylib behavior):
+	 * soft-reset the GPHY at attach, BEFORE our MMD/MULTIPORT config.
+	 * AVM 4.9's phy_init_hw() had an `else genphy_soft_reset()` fallback
+	 * (4.9 phy_device.c:802) that fired for the lantiq.c driver (no
+	 * .soft_reset) — a real BMCR_RESET that ALSO clears BMCR_ISOLATE and
+	 * re-latches the GPHY data path on every attach. Mainline 6.18 DELETED
+	 * that fallback (phy_device.c:1385) and our GPHY binds to genphy (no
+	 * lantiq.c in 6.18, INTEL_XWAY_PHY off), whose genphy_driver has no
+	 * .soft_reset — so the GPHY is NEVER soft-reset / de-isolated. Symptom
+	 * matches exactly: the GPHY links + trains on the wire (phy5 RXACT
+	 * counts) but never passes RX out its system-side GMII to the p5 MAC
+	 * (p5_RxGood=0, p5 RXprofile all-zero, lsq=0). genphy_soft_reset does
+	 * phy_modify(MII_BMCR, BMCR_ISOLATE, BMCR_RESET|BMCR_ANRESTART) + poll,
+	 * i.e. clears ISOLATE + re-latches; our IG-107b/110/106 writes below
+	 * then re-apply on the freshly-reset PHY (MULTIPORT re-set at the tail).
+	 */
+	ret = genphy_soft_reset(phydev);
+	if (ret)
+		return ret;
+
+	/*
+	 * IG-107b: AVM vr9_gphy_config_init parity (lantiq.c:46-75) — the
+	 * MMD 0x1f reg 0x707 = 0x11 poke ("fake clearing of interrupt",
+	 * an undocumented erratum write AVM performs at every PHY init).
+	 * LED config from the same function is cosmetic and skipped.
+	 */
+	ret = phy_write_mmd(phydev, 0x1f, 0x707, 0x11);
+	if (ret)
+		return ret;
+
+	/*
+	 * IG-110: AVM `avm,eee-adv = <0x0>` parity for GPHY5/lan1
+	 * (grx350_common.dtsi:19-21 via phy_ethtool_set_eee at
+	 * ltq_eth_drv_xrx500.c:1810-1816). Smoke-9's PHYDUMP showed our
+	 * MMD 7.60 still at the fw-default 0x0006 — the IG-103
+	 * probe-time phy_disable_eee did not survive to the final state
+	 * (suspected EPROBE_DEFER re-attach resetting eee_cfg at
+	 * phy_probe). Done HERE (every attach, pre-aneg): hard-zero the
+	 * advertisement register AND pin phylib's eee_cfg so
+	 * genphy_c45_an_config_eee_aneg keeps writing 0 on every
+	 * renegotiation. Suspected EEE erratum: with EEE negotiated the
+	 * GPHY's RX-to-GMII delivery dies (RXACT counts, p5 RXprofile
+	 * all-zero) — plausibly WHY AVM zeroes the advert on exactly
+	 * this port.
+	 */
+	ret = phy_write_mmd(phydev, MDIO_MMD_AN, MDIO_AN_EEE_ADV, 0);
+	if (ret)
+		return ret;
+	phy_disable_eee(phydev);
+
+	return phy_set_bits(phydev, MII_CTRL1000, LTQ_CTL1000_MULTIPORT);
+}
+
+/*
+ * IG-104: calibrate the CTRL-word convention. Issues a PHYID1 read of
+ * GPHY5 with the AVM-exact MBUSY=0 convention; PHY11G must answer
+ * 0xD565. On mismatch, falls back to the Sub-6.4 MBUSY=1 convention
+ * and retries. MUST run BEFORE the polling unit is enabled (quiet bus)
+ * and after the MDC master init (MCEN up).
+ */
+static void ltq_gswip_mdio_calibrate_ctrl(struct ltq_gswip_mdio_priv *priv)
+{
+	int id;
+
+	ltq_gswip_mdio_ctrl_mbusy = false;
+	id = ltq_gswip_mdio_dbg_rd(priv, 5, 2 /* PHYID1 */);
+	if ((id & 0xFFFF) == 0xD565) {
+		dev_info(priv->dev,
+			 "mdio: IG-104 CTRL calibration: MBUSY=0 (AVM-exact) verified, PHYID1=0x%04x\n",
+			 id & 0xFFFF);
+		return;
+	}
+
+	ltq_gswip_mdio_ctrl_mbusy = true;
+	id = ltq_gswip_mdio_dbg_rd(priv, 5, 2);
+	dev_warn(priv->dev,
+		 "mdio: IG-104 CTRL calibration: MBUSY=0 FAILED, fallback MBUSY=1 active (PHYID1=0x%04x, want 0xd565)\n",
+		 id & 0xFFFF);
+}
+
+/*
+ * One-shot GSW-L re-init under live link (IG-113, AVM GSW_HW_Init parity).
+ *
+ * On the working AVM 4.9 system the full switch-core init runs AFTER the
+ * CBM/DMA bring-up; our probe order is inverted (the GSW-L core + PMAC
+ * init runs before the DMA channels open). IG-174 proved the working
+ * PMAC<->DMA interface rests at P2D_RME=1 while ours never leaves 0 with
+ * byte-identical register state — an enable-time-latched handshake is
+ * the one mechanism state diffing cannot see. Re-running the whole GSW-L
+ * init (ETHSW_SWRES pulse + gsw_pmicro_code_init: PCE microcode,
+ * GCTRL.SE, FDMA/SDMA enables, PMAC tables, special-tag, flood maps —
+ * gsw_flow_pce.c gsw_hw_reinit) with the GPHY links live and the DMA
+ * channels armed re-latches it.
+ *
+ * The switch TOP block is wiped by the reset, so the MDIO master and the
+ * HW polling unit are re-initialized here under the mdio_lock, in the
+ * same FREQ -> MCEN -> RES order as probe (RES last, on its own write,
+ * so the self-clearing reset pulse cannot clobber the just-set MCEN).
+ *
+ * Timing: preserved from the original firing site (a 2 s poller started
+ * +3 s after probe, firing at its 14th iteration) — one delayed work
+ * scheduled from probe with the same total ~31 s delay, after link-up.
+ */
+#define LTQ_GSWIP_GSW_REINIT_DELAY_MS	(3000 + 14 * 2000)
+
+static void ltq_gswip_gsw_reinit_work(struct work_struct *w)
+{
+	struct ltq_gswip_mdio_priv *priv =
+		container_of(to_delayed_work(w), struct ltq_gswip_mdio_priv,
+			     gsw_reinit_work);
+	u32 c1;
+	int ret;
+
+	if (priv->bus)
+		mutex_lock(&priv->bus->mdio_lock);
+	ret = gsw_hw_reinit_gswl();
+	/* MDIO master re-init: FREQ, then MCEN, then RES (self-clearing). */
+	c1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	c1 &= ~GENMASK(GSWT_MDCCFG_1_FREQ_SHIFT +
+		       GSWT_MDCCFG_1_FREQ_SIZE - 1,
+		       GSWT_MDCCFG_1_FREQ_SHIFT);
+	c1 |= LTQ_GSWIP_MDIO_MDC_CFG_1_FREQ_DEFAULT;
+	__raw_writel(c1, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	c1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	__raw_writel(c1 | LTQ_GSWIP_MDIO_MDC_CFG_1_MCEN,
+		     priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	c1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	__raw_writel(c1 | LTQ_GSWIP_MDIO_MDC_CFG_1_RES,
+		     priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	/* Re-enable the HW polling unit for the four GE GPHY ports. */
+	__raw_writel(0x003Cu, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_0_OFF);
+	if (priv->bus)
+		mutex_unlock(&priv->bus->mdio_lock);
+	dev_info(priv->dev,
+		 "GSW-L re-init under live link done (rc=%d)\n", ret);
+}
+
+/**
+ * ltq_gswip_mdio_poll_mbusy() - wait for MDIO_CTRL.MBUSY to clear.
+ * @priv: per-bus state.
+ *
+ * Polls the MBUSY bit (MDIO_CTRL[12]) until it reads 0 or the 10 ms
+ * hard cap fires. The hard cap matters because phylink and the phy_state
+ * machine may end up calling into this from softirq context during
+ * link-state changes — a wedged bus must NOT block the kernel
+ * indefinitely (review focus #1).
+ *
+ * Return: 0 when MBUSY cleared in time, -ETIMEDOUT on cap expiry.
+ */
+static int ltq_gswip_mdio_poll_mbusy(struct ltq_gswip_mdio_priv *priv)
+{
+	u32 ctrl;
+
+	/*
+	 * Sub-6.2 BUGFIX: use __raw_readl (native byte order) NOT
+	 * readl_poll_timeout (which uses readl and byte-swaps on big-endian
+	 * MIPS). AVM polls MBUSY via gsw_r32 -> ltq_r32 -> __raw_readl, so we
+	 * must match. read_poll_timeout() with a __raw_readl callback keeps
+	 * the 10 ms wedged-bus safety cap (review focus #1).
+	 */
+	return read_poll_timeout(__raw_readl, ctrl,
+				 !(ctrl & LTQ_GSWIP_MDIO_CTRL_MBUSY),
+				 LTQ_GSWIP_MDIO_POLL_INTERVAL_US,
+				 LTQ_GSWIP_MDIO_POLL_TIMEOUT_US,
+				 false,
+				 priv->base + LTQ_GSWIP_MDIO_CTRL_OFF);
+}
+
+/**
+ * ltq_gswip_mdio_read() - mii_bus read callback (C22).
+ * @bus:  registered mii_bus.
+ * @addr: PHY address (5-bit, 0..31).
+ * @reg:  register address (5-bit, 0..31).
+ *
+ * AC-002b-2: writes MDIO_CTRL with OP=READ (0b10) | PHYAD | REGAD |
+ * MBUSY=1; polls MBUSY clear; returns MDIO_READ_RDATA[15:0]. A
+ * polling timeout at either of the two poll points (pre-issue and
+ * post-issue) propagates back as -ETIMEDOUT so the mdiobus core can
+ * surface the failure to phylink.
+ *
+ * Return: PHY register value (0..0xFFFF) on success, -ETIMEDOUT on
+ * a wedged bus.
+ */
+static int ltq_gswip_mdio_read(struct mii_bus *bus, int addr, int reg)
+{
+	struct ltq_gswip_mdio_priv *priv = bus->priv;
+	u32 cmd;
+	int ret;
+
+	/* Drain any in-flight prior operation first. */
+	ret = ltq_gswip_mdio_poll_mbusy(priv);
+	if (ret) {
+		dev_err(priv->dev,
+			"mdio_read: pre-issue MBUSY poll timed out (phy=%d reg=%d)\n",
+			addr, reg);
+		return -ETIMEDOUT;
+	}
+
+	/*
+	 * IG-104: CTRL word convention is runtime-calibrated — AVM-exact
+	 * MBUSY=0 by default (gsw_flow_core.c:12066-12077, hardware
+	 * self-arbitrates against the IG-103 polling unit), with the
+	 * Sub-6.4 MBUSY=1 convention as the calibrated fallback (see
+	 * ltq_gswip_mdio_ctrl_word). Sub-6.4's original finding ("no
+	 * transaction starts without MBUSY=1", v5.10 reference macro
+	 * lantiq_xrx500.c:5347-5357) is re-tested at probe by the PHYID1
+	 * calibration read. __raw_writel = native byte order, matching
+	 * ltq_w32 on big-endian MIPS.
+	 */
+	cmd = ltq_gswip_mdio_ctrl_word(LTQ_GSWIP_MDIO_OP_READ, addr, reg);
+	__raw_writel(cmd, priv->base + LTQ_GSWIP_MDIO_CTRL_OFF);
+
+	/* Wait for the read transaction to complete (MBUSY -> 0). */
+	ret = ltq_gswip_mdio_poll_mbusy(priv);
+	if (ret) {
+		dev_err(priv->dev,
+			"mdio_read: post-issue MBUSY poll timed out (phy=%d reg=%d)\n",
+			addr, reg);
+		return -ETIMEDOUT;
+	}
+
+	return __raw_readl(priv->base + LTQ_GSWIP_MDIO_READ_OFF) & 0xFFFF;
+}
+
+/**
+ * ltq_gswip_mdio_write() - mii_bus write callback (C22).
+ * @bus:  registered mii_bus.
+ * @addr: PHY address (5-bit, 0..31).
+ * @reg:  register address (5-bit, 0..31).
+ * @val:  16-bit value to write.
+ *
+ * AC-002b-2: stages @val into MDIO_WRITE_WDATA first, then issues
+ * MDIO_CTRL with OP=WRITE (0b01) | PHYAD | REGAD | MBUSY=1, then polls
+ * MBUSY clear. No read-back per the AVM 4.9 / datasheet contract.
+ *
+ * Return: 0 on success, -ETIMEDOUT on a wedged bus.
+ */
+static int ltq_gswip_mdio_write(struct mii_bus *bus, int addr, int reg,
+				u16 val)
+{
+	struct ltq_gswip_mdio_priv *priv = bus->priv;
+	u32 cmd;
+	int ret;
+
+	ret = ltq_gswip_mdio_poll_mbusy(priv);
+	if (ret) {
+		dev_err(priv->dev,
+			"mdio_write: pre-issue MBUSY poll timed out (phy=%d reg=%d)\n",
+			addr, reg);
+		return -ETIMEDOUT;
+	}
+
+	/*
+	 * WDATA must be staged BEFORE MDIO_CTRL is written
+	 * (gsw_flow_core.c:12069). Use __raw_writel (native byte order) to
+	 * match ltq_w32 (lantiq.h:17) on big-endian MIPS.
+	 */
+	__raw_writel((u32)val, priv->base + LTQ_GSWIP_MDIO_WRITE_OFF);
+
+	/*
+	 * IG-104: runtime-calibrated CTRL convention (MBUSY=0 AVM-exact by
+	 * default, MBUSY=1 Sub-6.4 fallback) — see ltq_gswip_mdio_ctrl_word.
+	 */
+	cmd = ltq_gswip_mdio_ctrl_word(LTQ_GSWIP_MDIO_OP_WRITE, addr, reg);
+	__raw_writel(cmd, priv->base + LTQ_GSWIP_MDIO_CTRL_OFF);
+
+	/*
+	 * Wait for the write transaction to retire. The AVM 4.9 reference
+	 * does NOT poll after the write issue, but the GSWIP-3.0 datasheet
+	 * documents that back-to-back writes without an MBUSY drain may
+	 * coalesce / be dropped — so we poll defensively.
+	 */
+	ret = ltq_gswip_mdio_poll_mbusy(priv);
+	if (ret) {
+		dev_err(priv->dev,
+			"mdio_write: post-issue MBUSY poll timed out (phy=%d reg=%d val=0x%04x)\n",
+			addr, reg, val);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+/**
+ * ltq_gswip_mdio_log_scanned_phys() - dump the discovered PHY-address list.
+ * @pdev: probing platform_device, used for dev_info routing.
+ * @bus:  registered mii_bus whose mdio_map[] is now populated.
+ *
+ * After of_mdiobus_register has parsed the DT child phy@N nodes and
+ * instantiated phy_devices, walk mdio_map[] across the full 0..31
+ * address range and emit a single comma-separated diagnostic line.
+ * AC-002b-6 mandates the exact "lantiq-gswip-mdio: bus registered,
+ * scanned N PHY(s) at addresses [list]" wording so a downstream
+ * Evaluator can grep boot logs against it.
+ */
+static void ltq_gswip_mdio_log_scanned_phys(struct platform_device *pdev,
+					    struct mii_bus *bus)
+{
+	char list[80] = "";
+	int n = 0;
+	int i;
+
+	for (i = 0; i < PHY_MAX_ADDR; i++) {
+		struct phy_device *phydev;
+		size_t off;
+
+		phydev = mdiobus_get_phy(bus, i);
+		if (!phydev)
+			continue;
+
+		off = strlen(list);
+		scnprintf(list + off, sizeof(list) - off,
+			  "%s0x%02x", n ? "," : "", i);
+		n++;
+	}
+
+	dev_info(&pdev->dev,
+		 "lantiq-gswip-mdio: bus registered, scanned %d PHY(s) at addresses [%s]\n",
+		 n, list);
+}
+
+static int ltq_gswip_mdio_probe(struct platform_device *pdev)
+{
+	struct ltq_gswip_mdio_priv *priv;
+	struct mii_bus *bus;
+	struct resource *res;
+	u32 mdc_cfg_1;
+	int ret;
+
+	/*
+	 * AC-002b-7: defer until ST-001's xrx500_phy_fw probe has lit up
+	 * the GPHYs. MDIO reads from un-firmware-loaded GPHYs return
+	 * 0xFFFF, which mdiobus_scan / of_mdiobus_register would
+	 * silently accept as "PHY present but identity unreadable" —
+	 * masquerading a load-order bug as a hardware-failure mode.
+	 * The -EPROBE_DEFER return path lets the driver-core requeue us
+	 * once xrx500_gphy_fw_is_loaded() transitions true.
+	 */
+	if (!xrx500_gphy_fw_is_loaded()) {
+		dev_dbg(&pdev->dev,
+			"GPHY firmware not yet loaded; deferring MDIO probe\n");
+		return -EPROBE_DEFER;
+	}
+
+	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*priv));
+	if (!bus)
+		return -ENOMEM;
+
+	priv = bus->priv;
+	priv->dev = &pdev->dev;
+	priv->bus = bus;	/* IG-104: LINKDBG mdio_lock serialization */
+
+	/*
+	 * EVAL-FIX-ROUND-1 (AC-002b-1): use devm_ioremap (NOT
+	 * devm_platform_ioremap_resource / devm_ioremap_resource) because
+	 * gswl@1c000000's full 0x4000 parent reg range is already claimed
+	 * by the intel,xrx500-gswip-3.0 driver; devm_request_mem_region
+	 * checks iomem_resource conflicts and would return -EBUSY for our
+	 * sub-aperture probe. devm_ioremap only maps the MMIO window
+	 * without claiming the resource — the same pattern the mainline
+	 * lantiq_gswip.c driver uses for its own MDIO sub-aperture probe.
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res) {
+		dev_err(&pdev->dev, "no MDIO sub-aperture resource in DT\n");
+		return -ENODEV;
+	}
+	priv->base = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!priv->base) {
+		dev_err(&pdev->dev,
+			"devm_ioremap(MDIO sub-aperture %pR) failed\n", res);
+		return -ENOMEM;
+	}
+
+	/*
+	 * EVAL-FIX-ROUND-1 (AC-002b-1): program MDC clock-configuration
+	 * registers BEFORE registering the bus, so any of_mdiobus_register
+	 * PHY-identity reads issued below see a working MDIO bus.
+	 *
+	 * MDC_CFG_0 := 0 during master bring-up, then PEN_2..PEN_5 := 1
+	 *   (reg value 0x003C) once the master is initialised — see the
+	 *   IG-103 comment at the PEN write below. (The original port
+	 *   carried mainline lantiq_gswip.c:634's polling-off choice here;
+	 *   that is a GSWIP-2.x/external-PHY precaution AVM never applies
+	 *   on GSWIP-3.0 GSW-L, and IG-100's PHY_ADDR-force substitute is
+	 *   unvalidated on 3.0 silicon while frames cross in neither
+	 *   direction at p5 — IG-102.)
+	 *
+	 * MDC_CFG_1 := RES|MCEN|FREQ=0x09:  this matches AVM's
+	 *   mdio_init_gswip3_0() (switch-api/gsw_flow_core.c:2733-2752)
+	 *   exactly — FREQ=0x9 (2.5 MHz MDC), MCEN=1 (enable MDIO master
+	 *   clock generator), RES=1 (MDIO hardware reset). Without MCEN the
+	 *   MDIO master never clocks transactions and MBUSY stays stuck,
+	 *   surfacing as -ETIMEDOUT.
+	 */
+	/*
+	 * Sub-6.3 BUGFIX (MCEN-wipe): the prior single full-word write of
+	 * RES|MCEN|FREQ (0x8109) to MDCCFG_1 left the management clock
+	 * DISABLED. On-hardware instrumentation showed MDCCFG_1 reading back
+	 * 0x0109 — FREQ=0x09 survived but MCEN (bit 8) was GONE. The reason:
+	 * RES (bit 15) is "MDIO Hardware Reset"; asserting RES in the SAME
+	 * register write that sets MCEN makes the MDIO block reset and clear
+	 * the MCEN bit it was handed in the same cycle. With MCEN clear the
+	 * MDIO master never generates MDC, so writing MDCTRL never sets MBUSY
+	 * and RDATA stays 0x0000 for every PHY register.
+	 *
+	 * AVM's mdio_init_gswip3_0 (switch-api/gsw_flow_core.c:2743-2749)
+	 * avoids this by issuing THREE SEPARATE read-modify-write field
+	 * writes IN ORDER: FREQ first, then MCEN, then RES last. Because RES
+	 * is written on its own (after MCEN has already latched), the reset
+	 * pulse does not wipe MCEN. Replicate that ordering exactly with
+	 * read-modify-write __raw_* accesses (native byte order == AVM's
+	 * gsw_w32 -> ltq_w32 path on big-endian MIPS).
+	 */
+	__raw_writel(0u, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_0_OFF);
+
+	/* 1) FREQ = 0x09 (2.5 MHz MDC), preserving the rest of the reg. */
+	mdc_cfg_1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	mdc_cfg_1 &= ~GENMASK(GSWT_MDCCFG_1_FREQ_SHIFT + GSWT_MDCCFG_1_FREQ_SIZE - 1,
+			      GSWT_MDCCFG_1_FREQ_SHIFT);
+	mdc_cfg_1 |= LTQ_GSWIP_MDIO_MDC_CFG_1_FREQ_DEFAULT;
+	__raw_writel(mdc_cfg_1, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+
+	/* 2) MCEN = 1 (enable management clock) — separate write. */
+	mdc_cfg_1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	mdc_cfg_1 |= LTQ_GSWIP_MDIO_MDC_CFG_1_MCEN;
+	__raw_writel(mdc_cfg_1, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+
+	/* 3) RES = 1 (MDIO HW reset) LAST — on its own so it does not
+	 *    clobber the just-latched MCEN bit. RES self-clears. */
+	mdc_cfg_1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+	mdc_cfg_1 |= LTQ_GSWIP_MDIO_MDC_CFG_1_RES;
+	__raw_writel(mdc_cfg_1, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+
+	mdc_cfg_1 = __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_1_OFF);
+
+	/*
+	 * IG-104: calibrate the MDIO CTRL-word convention on the still-quiet
+	 * bus (PEN not yet enabled, no poller contention).
+	 */
+	ltq_gswip_mdio_calibrate_ctrl(priv);
+
+	/*
+	 * IG-103: enable the GSWIP-3.0 hardware MDIO polling state machine
+	 * for the four GE GPHY ports — MDC_CFG_0.PEN[6:1] = 0x1e, i.e.
+	 * PEN_2..PEN_5 (register value 0x003C). This is the ONLY link->MAC
+	 * coupling mechanism the working system ever runs: AVM writes it at
+	 * switch-core init (gsw_flow_core.c:2804-2810 legacy init, repeated
+	 * at :11832-11836 GSW_HW_Init) and its phylib adjust_link is an
+	 * empty stub — the poller populates MDIO_STAT_p (PACT/LSTAT/SPEED/
+	 * FDUP/pause) which the per-port MAC consumes. Ground truth: corpus
+	 * MDC_CFG_0 = 0x003C on AVM stock under live ping AND on the Lane-H
+	 * 4.9 testbed (v108pd..ra-avm-paired, v108rr-avm49:1215);
+	 * MDIO_STAT_5 = 0x0074 with link up + traffic (v108xr/ym/yl);
+	 * PHY_ADDR_5 stays at its reset default 0x1805 (AUTO — no force).
+	 * Written AFTER the RES pulse so the block reset cannot clear it.
+	 * Concurrent SW MDIO (phylib/LINKDBG) + HW poller is AVM-stock-
+	 * validated; the master arbitrates via MBUSY.
+	 */
+	__raw_writel(0x003Cu, priv->base + LTQ_GSWIP_MDIO_MDC_CFG_0_OFF);
+
+	dev_info(&pdev->dev, "MDC_CFG_0=0x%08x MDC_CFG_1=0x%08x\n",
+		 __raw_readl(priv->base + LTQ_GSWIP_MDIO_MDC_CFG_0_OFF),
+		 mdc_cfg_1);
+
+	/*
+	 * IG-107: register the AVM master-bias fixup BEFORE the bus scan so
+	 * it applies to the GPHYs at attach (pre-aneg). Idempotent enough
+	 * for our single-bus probe; EPROBE_DEFER re-entry would register a
+	 * duplicate fixup entry, which phylib tolerates (same effect).
+	 */
+	ret = phy_register_fixup_for_uid(LTQ_GPHY11G_PHY_ID,
+					 LTQ_GPHY11G_PHY_MASK,
+					 ltq_gswip_gphy_mpd_fixup);
+	if (ret)
+		dev_warn(&pdev->dev,
+			 "IG-107 MPD fixup registration failed: %d\n", ret);
+
+	/* AC-002b-3: bus identity. */
+	bus->name = "lantiq-gswip-mdio";
+	bus->read = ltq_gswip_mdio_read;
+	bus->write = ltq_gswip_mdio_write;
+	bus->parent = &pdev->dev;
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", dev_name(&pdev->dev));
+
+	platform_set_drvdata(pdev, bus);
+
+	/*
+	 * AC-002b-3 + review focus #3: of_mdiobus_register against the
+	 * platform_device's of_node so the DT child phy@N nodes are
+	 * auto-discovered. No manual mdiobus_scan is used.
+	 *
+	 * devm_-managed: the mdiobus_unregister + mdiobus_free pair is
+	 * scheduled by the devres machinery so the .remove callback need
+	 * not do anything.
+	 */
+	ret = devm_of_mdiobus_register(&pdev->dev, bus, pdev->dev.of_node);
+	if (ret) {
+		dev_err(&pdev->dev,
+			"of_mdiobus_register failed: %d\n", ret);
+		return ret;
+	}
+
+	ltq_gswip_mdio_log_scanned_phys(pdev, bus);
+
+	/* One-shot GSW-L re-init under live link (IG-113) — see the work fn. */
+	INIT_DELAYED_WORK(&priv->gsw_reinit_work, ltq_gswip_gsw_reinit_work);
+	schedule_delayed_work(&priv->gsw_reinit_work,
+			      msecs_to_jiffies(LTQ_GSWIP_GSW_REINIT_DELAY_MS));
+	return 0;
+}
+
+static const struct of_device_id ltq_gswip_mdio_match[] = {
+	{ .compatible = "lantiq,gswip-mdio" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ltq_gswip_mdio_match);
+
+static struct platform_driver ltq_gswip_mdio_driver = {
+	.probe = ltq_gswip_mdio_probe,
+	.driver = {
+		.name = "lantiq-gswip-mdio",
+		.of_match_table = ltq_gswip_mdio_match,
+	},
+};
+
+/*
+ * Composite-module init: device_initcall() instead of module_init() so
+ * that this TU can coexist with gsw_init.c's module_platform_driver()
+ * macro inside the same intel-xrx500-gswip composite — see the matching
+ * comment in switch-api/../xrx500_phy_fw.c. device_initcall fires at
+ * the same boot-order level as module_init in the built-in case
+ * (CONFIG_INTEL_XRX500_GSWIP_API=y, the FB7560 OpenWrt setting).
+ */
+static int __init ltq_gswip_mdio_init(void)
+{
+	return platform_driver_register(&ltq_gswip_mdio_driver);
+}
+device_initcall(ltq_gswip_mdio_init);
