+#define TMU_SBITR0_SIE_EN               0x80000000  /* AVM drv_tmu_reg.h:2104 */
+#define TMU_SBITR0_IWGT_MASK            0x03FF0000  /* AVM drv_tmu_reg.h:2109 */
+#define TMU_SBITR0_IWGT_OFFSET          16          /* AVM drv_tmu_reg.h:2111 */
+#define TMU_SBITR0_SIT_SBID             0x00008000  /* AVM drv_tmu_reg.h:2123 */
+#define TMU_SBITR0_QSID_MASK            0x000000FF  /* AVM drv_tmu_reg.h:2130 */
+#define TMU_SBITR0_QSID_OFFSET          0           /* AVM drv_tmu_reg.h:2132 */
