+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * tmu/drv_tmu_ll.c and tmu/drv_tmu_reg.h:
+ * Copyright (c) 2012 Lantiq Deutschland GmbH
