+/* AVM drv_tmu_ll.c:1143-1195 — tmu_token_bucket_shaper_table_init.
+ * Token Bucket Shaper Table (TBST) — all TBs disabled, color-blind,
+ * NIL scheduler block input ID. TOCKEN_BUCKET_ID=256 (corrected from
+ * AS-007). KEEP_GPON_ALL / sim removed.
+ */
+static void tmu_token_bucket_shaper_table_init(void)
+{
+	u32 i;
+	unsigned long flags;
+
+	spin_lock_irqsave(&tmu_lock, flags);
+
+	for (i = 0; i <= TOKEN_BUCKET_MAX; i++) {
+		/* color-blind TB attached to reserved scheduler input 1023 */
+		tmu_w32(NULL_SCHEDULER_INPUT_ID, TMU_TBSTR0_OFFSET);
