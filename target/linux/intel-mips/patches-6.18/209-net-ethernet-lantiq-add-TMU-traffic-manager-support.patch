+#define TMU_SBOTR0_SOE_EN               0x80000000  /* AVM drv_tmu_reg.h:2247 */
+#define TMU_SBOTR0_LVL_MASK             0x00070000  /* AVM drv_tmu_reg.h:2255 */
+#define TMU_SBOTR0_LVL_OFFSET           16          /* AVM drv_tmu_reg.h:2257 */
+#define TMU_SBOTR0_V_SBIN               0x00008000  /* AVM drv_tmu_reg.h:2269 */
