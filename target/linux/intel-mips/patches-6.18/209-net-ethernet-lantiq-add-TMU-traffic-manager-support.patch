+#define TMU_QMTC_QSW                    0x00000200  /* AVM drv_tmu_reg.h:1906 */
+#define TMU_QMTC_QTW                    0x00000400  /* AVM drv_tmu_reg.h:1902 */
+#define TMU_QMTC_QOW                    0x00000800  /* AVM drv_tmu_reg.h:1898 */
+#define TMU_QMTC_QDW                    0x00002000  /* AVM drv_tmu_reg.h:1888 */
+#define TMU_QMTC_QFW                    0x00004000  /* AVM drv_tmu_reg.h:1884 */
+#define TMU_QMTC_QFR                    0x00400000  /* AVM drv_tmu_reg.h:1856 (QFMT read) */
+#define TMU_QMTC_QEV                    0x01000000  /* AVM drv_tmu_reg.h:1852 */
+#define TMU_QMTC_QSV                    0x02000000  /* AVM drv_tmu_reg.h:1847 */
+#define TMU_QMTC_QTV                    0x04000000  /* AVM drv_tmu_reg.h:1842 */
+#define TMU_QMTC_QOV                    0x08000000  /* AVM drv_tmu_reg.h:1837 */
+#define TMU_QMTC_QDV                    0x20000000  /* AVM drv_tmu_reg.h:1826 */
+#define TMU_QMTC_QFV                    0x40000000  /* AVM drv_tmu_reg.h:1821 */
+
