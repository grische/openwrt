+	 * AVM drv_tmu_ll.c:2571-2577 — set CPR.CP field. INLINED per plan Step 3a.
+	 */
+	v = tmu_r32(TMU_CPR_OFFSET);
+	v = (v & ~TMU_CPR_CP_MASK) |
+	    ((TMU_WRED_CRAWLER_PERIOD_DEFAULT << TMU_CPR_CP_OFFSET) & TMU_CPR_CP_MASK);
