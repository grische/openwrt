+#define TMU_QEMT_EPN_MASK               0x0000007F  /* AVM drv_tmu_reg.h:1530 */
+#define TMU_QSMT_SBIN_MASK              0x000003FF  /* AVM drv_tmu_reg.h:1538 */
+
+/* QOCT0/1/2 field masks — AVM drv_tmu_reg.h:1690-1718 */
+#define TMU_QOCT0_WQ_MASK               0x000F0000  /* AVM drv_tmu_reg.h:1690 */
+#define TMU_QOCT0_WQ_OFFSET             16          /* AVM drv_tmu_reg.h:1692 */
+#define TMU_QOCT0_QRTH_MASK             0x00000FFF  /* AVM drv_tmu_reg.h:1700 */
+#define TMU_QOCT1_QOCC_MASK             0x00007FFF  /* AVM drv_tmu_reg.h:1709 */
+#define TMU_QOCT2_QAVG_MASK             0x007FFFFF  /* AVM drv_tmu_reg.h:1718 */
+
+/* QTHT0 enable bit — AVM drv_tmu_reg.h:1551
+ * (Used by tmu_egress_queue_table_init — qtht[0] = 0x00011320 keeps QE = 0,
+ * but the symbol exists for completeness / future use.)
+ */
+#define TMU_QTHT0_QE_EN                 0x80000000  /* AVM drv_tmu_reg.h:1551 */
+
