+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * tmu_init.c — TMU bring-up sequencing.
+ *
+ * Phase-3 Sub-5 entry point. Called once from cbm_xrx500_probe() AFTER
+ * cbm_hw_init() success and BEFORE netdev_register (per CQ-001 answer A
+ * and AS-007's mandated init order). On success, prints the v108hk M0
+ * milestone marker "tmu: probe complete, EPOC zeroed at t=<jiffies>" and
+ * arms the AS-013 ordering guard (tmu_init_done -> 1).
+ *
+ * In ST-001 the body runs but __tmu_ll_init() returns -ENOSYS, so the
+ * pr_info marker does NOT fire yet. That fail-fast behaviour is
+ * intentional: cbm_xrx500_probe sees the -ENOSYS and aborts probe rather
+ * than admit frames against an unzeroed EPOC. ST-002 lands the real
+ * __tmu_ll_init body and the marker starts firing.
+ */
+
+#include <linux/types.h>
+#include <linux/printk.h>
+#include <linux/jiffies.h>
+#include <linux/atomic.h>
+#include <linux/errno.h>
+
+#include "../cqm/grx500/cbm.h"
+#include "drv_tmu_ll.h"
+
+/*
+ * File-scope externs into drv_tmu_ll.c.
+ *
+ * tmu_init_done is defined in drv_tmu_ll.c with EXTERNAL LINKAGE (no static
+ * qualifier). It is composite-module-internal per AS-003, which is why it
+ * is NOT promoted to drv_tmu_ll.h.
+ *
+ * __tmu_ll_init is likewise NON-static in drv_tmu_ll.c — a drv_tmu_internal.h-
+ * style declaration kept here intentionally; not promoted to drv_tmu_ll.h
+ * because __tmu_ll_init is composite-module-internal per AS-003.
+ */
+extern atomic_t tmu_init_done;
+extern int __tmu_ll_init(void);
+
+int tmu_init(void)
+{
+	int ret;
+
+	if (!g_cbm_tmu_base) {
+		pr_err("tmu: init failed, base=NULL\n");
+		return -EIO;
+	}
+
+	ret = __tmu_ll_init();
+	if (ret) {
+		pr_err("tmu: __tmu_ll_init failed: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * v108hk M0 milestone marker — fires after EPOC is zeroed and after
+	 * tmu_enable(true). The atomic_set BELOW the pr_info preserves the
+	 * milestone-proof ordering: the marker emits the timestamp BEFORE
+	 * the ordering guard arms, so the dmesg evidence matches the moment
+	 * EPOC was actually zeroed.
+	 */
+	pr_info("tmu: probe complete, EPOC zeroed at t=%lu\n", jiffies);
+	atomic_set(&tmu_init_done, 1);
+	return 0;
+}
