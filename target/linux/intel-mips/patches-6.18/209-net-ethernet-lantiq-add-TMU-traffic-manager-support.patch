+/* ------------------------------------------------------------------ *
+ * Public API surface (exactly three functions)
+ *
+ * Bodies for the egress-port-enable and MIB-reset entry points arrive in
+ * ST-002 / ST-004 respectively; ST-001 ships compiling WARN_ONCE stubs.
+ * The bring-up orchestrator lives in tmu_init.c and runs its full
+ * sequencing from ST-001 onwards — the internal low-level helper still
+ * returns -ENOSYS until ST-002 fills it.
+ * ------------------------------------------------------------------ */
+
+/**
+ * tmu_init - Phase-3 TMU bring-up.
+ *
+ * Runs from cqm/grx500/cbm.c:cbm_xrx500_probe() AFTER cbm_hw_init() success
+ * (per CQ-001 answer A). Performs basic-register, EPT, SBIT, SBOT, TBST, and
+ * PPT initialization in the AVM-canonical order; the EPOC zero-init step is
+ * the M0 milestone artifact (v108hk: "tmu: probe complete, EPOC zeroed at
+ * t=<jiffies>"). Arms the ordering guard on success.
+ *
+ * Returns 0 on success, -EIO if the TMU MMIO base is NULL, or the negative
+ * errno returned by the internal low-level helper on hardware failure.
+ */
+int tmu_init(void);
+
+/**
+ * tmu_egress_port_enable - flip the EPE bit on EPMT[epn] then commit via
+ * the CFGCMD reconfiguration channel. Called per LAN port from Sub-6
+ * ndo_open() (matching the AVM dp_enable -> egress-port-enable chain).
+ *
+ * The function is a no-op if the AS-013 ordering guard is not yet armed —
+ * calls that arrive before TMU bring-up completes silently return without
+ * touching hardware.
+ *
+ * @epn: egress port number (0..EGRESS_PORT_ID_MAX-1).
+ * @ena: true to enable, false to disable.
+ */
+void tmu_egress_port_enable(uint32_t epn, bool ena);
+
+/**
+ * tmu_qfmt_read - indirect read of the Queue Format table for @qid.
+ * Faithful port of AVM drv_tmu_ll.c:724-744. Fills qfm[0..2] (QFMT0/1/2);
+ * qfm[1] HQPP[13:0] is the head PDU's PPT index. Bounded spin; returns
+ * -ETIMEDOUT if the QMTC valid bit never sets. IG-060.
+ */
+int tmu_qfmt_read(u32 qid, u32 *qfm);
+
+/**
+ * tmu_ppt_read - indirect read of Packet Pointer Table entry @pos.
+ * Faithful port of AVM drv_tmu_ll.c:3954-3963. Fills ppt[0..3]
+ * (PPT0/1/2/3); ppt[2] BDYL[15:0] is the PDU body length, ppt[1] SEGL[9:0],
+ * ppt[0] OFFS[15:8]. Bounded spin; returns -ETIMEDOUT on timeout. IG-060.
+ */
+int tmu_ppt_read(u32 pos, u32 *ppt);
+
+/**
+ * tmu_reset_mib_all - zero all egress-queue MIB counters (enq + deq +
+ * QDCT rings) for every QID up to EGRESS_QUEUE_ID_MAX. Called from Sub-4
+ * cbm dp_sys_mib_reset() during the boot-time CBM bring-up.
+ *
+ * Returns 0 on success. The legacy AVM signature accepts an unused
+ * "flag" argument; Sub-5 drops it because dp_sys_mib_reset never passed
+ * a non-zero value in the call sites being ported.
+ */
+int tmu_reset_mib_all(void);
+
+/**
+ * tmu_create_flat_egress_path - build a flat TMU egress path for one port.
+ *
+ * AVM drv_tmu_ll.c:2819-2847. Programs, for each of @num_ports egress ports:
+ *   (1) a scheduler block (SBOT[base_sbid+epn]) whose output drives the
+ *       egress port (base_epn+epn) directly (V=0, level 0),
+ *   (2) the egress-port EPMT mapping with EPE=1 pointing at that SB, and
+ *   (3) @qid_per_sb egress queues (QEMT/QSMT/QTHT + SBIT input link) attached
+ *       to the scheduler block's leaves.
+ *
+ * This is the egress-side drain path stripped per CQ-004: without it a
+ * descriptor enqueued to a TMU queue has no scheduler/port to dequeue to and
+ * never reaches the DMA2TX -> PMAC -> GPHY chain. Sub-7 ST-007 wires the call
+ * from cbm_dp_enable per LAN port at ndo_open.
+ *
+ * No-op (with WARN_ONCE) if tmu_init has not armed the AS-013 ordering guard.
+ *
+ * @num_ports:  number of consecutive egress ports to build (1 per LAN port).
+ * @base_epn:   first egress-port number (= tmu_egress_port for the LAN port).
+ * @base_sbid:  first scheduler-block id (= tmu_queue - SBID_START).
+ * @base_qid:   first egress-queue id (= tmu_queue).
+ * @qid_per_sb: queues per scheduler block (1 for a flat LAN path).
+ */
+void tmu_create_flat_egress_path(uint16_t num_ports, uint16_t base_epn,
+				 uint16_t base_sbid, uint16_t base_qid,
+				 uint16_t qid_per_sb);
+
+#endif /* _DRV_TMU_LL_H_ */
