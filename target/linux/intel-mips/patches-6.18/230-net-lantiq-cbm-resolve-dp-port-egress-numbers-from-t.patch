@@ -1194,6 +1206,14 @@ static int intel_xrx500_port_setup(struct intel_xrx500_priv *priv,
 		return -EINVAL;
 	}
 
+	ret = cbm_dp_deq_port_get(dp_port_id, &deq_port);
+	if (ret) {
+		dev_err(priv->dev,
+			"intel-xrx500: port@%u intel,dp-port-id=%u has no CBM egress resources\n",
+			port_idx, dp_port_id);
