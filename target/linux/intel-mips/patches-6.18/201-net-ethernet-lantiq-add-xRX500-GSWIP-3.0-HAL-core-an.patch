diff --git a/drivers/net/ethernet/lantiq/Kconfig b/drivers/net/ethernet/lantiq/Kconfig
new file mode 100644
index 000000000000..91e346075bad
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/Kconfig
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Intel xRX500 GSWIP-3.x ethernet driver suite.
+#
+# INTEL_XRX500_NET is separate from LANTIQ_XRX200 because INTEL_MIPS and
+# LANTIQ are mutually exclusive entries in arch/mips/Kconfig's "System
+# type" choice, so this port cannot depend on SOC_TYPE_XWAY.
+
+menuconfig INTEL_XRX500_NET
+	bool "Intel xRX500 / GRX350 ethernet drivers"
+	depends on INTEL_MIPS && OF && HAS_IOMEM
+	default n
+	select MFD_SYSCON
+	select REGMAP_MMIO
+	select RESET_CONTROLLER
+	select RESET_LANTIQ
+	help
+	  Selects the Intel xRX500-family ethernet driver suite, beginning
+	  with a passive register-access HAL for the GSWIP-3.x switch core.
+	  Say N here unless you are building for a GRX350-class board such
+	  as the AVM FRITZ!Box 7560.
+
+	  Selects MFD_SYSCON + REGMAP_MMIO + RESET_CONTROLLER + RESET_LANTIQ
+	  because the rcu0 reset-controller (lantiq,xrx200-reset, declared
+	  inside the rcu@ syscon node) is the GPHY reset producer for the
+	  phy-xrx500 GPHY firmware loader. RESET_LANTIQ defaults to
+	  SOC_TYPE_XWAY which the INTEL_MIPS target does NOT set, and it
+	  lives inside the RESET_CONTROLLER menu, so both are selected here
+	  for the intel-mips/xrx500 family.
+
+if INTEL_XRX500_NET
+
+source "drivers/net/ethernet/lantiq/switch-api/Kconfig"
+
+endif # INTEL_XRX500_NET
diff --git a/drivers/net/ethernet/lantiq/Makefile b/drivers/net/ethernet/lantiq/Makefile
new file mode 100644
index 000000000000..156a670a2e71
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/Makefile
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Makefile for the Intel xRX500 ethernet driver suite.
+#
+# switch-api/, datapath/ and cqm/grx500/ all contribute objects to one
+# composite module, so the object list lives here rather than in the
+# subdirectory Makefiles: symbol resolution between them stays
+# intra-module and needs no exports.
+
+obj-$(CONFIG_INTEL_XRX500_GSWIP_API) += intel-xrx500-gswip.o
+
+intel-xrx500-gswip-y := switch-api/gsw_init.o switch-api/gsw_flow_core.o
diff --git a/drivers/net/ethernet/lantiq/switch-api/Kconfig b/drivers/net/ethernet/lantiq/switch-api/Kconfig
new file mode 100644
index 000000000000..c5b8ec84e5a9
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/switch-api/Kconfig
@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config INTEL_XRX500_GSWIP_API
+	tristate "Intel xRX500 GSWIP-3.x register-access HAL"
+	depends on INTEL_XRX500_NET
+	#
+	# The netdev driver ships inside this composite and reaches its
+	# ports through PHYLINK.
+	#
+	select PHYLINK
+	default n
+	help
+	  Passive register-access HAL for the Intel xRX500 (GRX350-class)
+	  GSWIP-3.x switch core. This module binds two SoC-scope platform
+	  devices (gswip@1c000000 and gswip@1a000000), ioremaps their
+	  register windows, and exposes the four word/field accessors used
+	  by higher-level GSWIP feature drivers. It performs no PCE
+	  microcode load, no switch soft-reset toggle, no PHY/MDIO
+	  bring-up, no clock/reset gating, and no interrupt wiring.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called intel-xrx500-gswip.
