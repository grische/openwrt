+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Makefile for the Intel xRX500 ethernet driver suite.
+#
+# Sub-3 ST-001 restructure: the intel-xrx500-gswip composite-module
+# object list moved up from switch-api/Makefile to this Makefile so that
+# datapath/ and switch-api/ can both contribute object files to the same
+# .ko (per CQ-004 answer B's single-module pairing requirement).
+#
+# Sub-4 ST-001 addition: the cqm/grx500/ TU set is appended to the same
+# composite (CQ-001 A) so CBM symbol resolution is intra-module — no new
+# Kconfig symbol is needed (the existing CONFIG_INTEL_XRX500_GSWIP_API
+# gate covers all three subsystems). Only cbm_basic.o and cbm_buf.o ship
+# real bodies in ST-001; the remaining .o files are empty TU stubs that
+# ST-002..ST-006 fill in.
+
+obj-$(CONFIG_INTEL_XRX500_GSWIP_API) += intel-xrx500-gswip.o
+
+intel-xrx500-gswip-y := switch-api/gsw_init.o switch-api/gsw_flow_core.o
diff --git a/drivers/net/ethernet/lantiq/switch-api/Kconfig b/drivers/net/ethernet/lantiq/switch-api/Kconfig
new file mode 100644
index 0000000000000..d646c886b711e
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/switch-api/Kconfig
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config INTEL_XRX500_GSWIP_API
+	tristate "Intel xRX500 GSWIP-3.x register-access HAL"
+	depends on INTEL_XRX500_NET
+	#
+	# Sub-6 ST-001 (AC-001-10): the GPHY firmware loader (xrx500_phy_fw.o)
+	# and the future intel_xrx500.c netdev/phylink driver (ST-003) live
+	# inside this composite. PHYLIB / OF_MDIO / PHYLINK are needed by the
+	# phylink_of_phy_connect call chain ST-003 will land; FW_LOADER
+	# provides request_firmware/release_firmware for xrx500_phy_fw.c's
+	# firmware fetch; RESET_CONTROLLER backs the per-PHY
+	# devm_reset_control_get calls against the rcu0 reset-controller
+	# phandle. AS-010 correction: the task originally listed
+	# MTD_OF_PARTS, which is unrelated to the phy/firmware path and is
+	# therefore intentionally NOT added here.
+	#
+	select PHYLIB
+	select OF_MDIO
+	select PHYLINK
+	select FW_LOADER
+	select RESET_CONTROLLER
+	default n
+	help
+	  Passive register-access HAL for the Intel xRX500 (GRX350-class)
+	  GSWIP-3.x switch core. This module binds two SoC-scope platform
+	  devices (gswip@1c000000 and gswip@1a000000), ioremaps their
+	  register windows, and exposes the four word/field accessors used
+	  by higher-level GSWIP feature drivers. It performs no PCE
+	  microcode load, no switch soft-reset toggle, no PHY/MDIO
+	  bring-up, no clock/reset gating, and no interrupt wiring.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called intel-xrx500-gswip.
