-/**
- * intel_xrx500_port_setup() - allocate and configure a single per-port
- * netdev.
- *
- * @priv:      owning private state.
- *
- * @port_node: DT child node carrying the port configuration.
- *
- * @port_idx:  port slot index (= reg = <N> from DT).
- *
- * Returns 0 on success or a negative errno (including -EPROBE_DEFER)
- * on failure. On failure no per-slot artifacts are left dangling -
- * the caller-side rollback walks slot indices 0..(i-1) only.
- */
-static int intel_xrx500_port_setup(struct intel_xrx500_priv *priv,
-				   struct device_node *port_node,
-				   u32 port_idx)
-{
-	struct intel_xrx500_port *port;
-	struct net_device *netdev;
-	struct phylink *phylink;
-	u32 dp_port_id;
-	u32 deq_port;
-	bool is_wan;
-	int ret;
-
-	ret = of_property_read_u32(port_node, "intel,dp-port-id", &dp_port_id);
-	if (ret) {
-		dev_err(priv->dev,
-			"intel-xrx500: port@%u missing intel,dp-port-id\n",
-			port_idx);
-		return ret;
-	}
-
-	/*
-	 * Validate dp_port_id by resolving it, rather than against a literal
-	 * range. The CQM's tables know which datapath ports this silicon has
-	 * egress resources for - LAN ports 2..5 and the WAN port 15 - so a DT
-	 * typo is rejected by the same lookup that produces the numbers, and
-	 * the two can never disagree about which ports are admissible.
-	 *
-	 * Done before anything is allocated, so a rejection costs no cleanup.
-	 */
-	ret = cbm_dp_deq_port_get(dp_port_id, &deq_port);
-	if (ret) {
-		dev_err(priv->dev,
-			"intel-xrx500: port@%u intel,dp-port-id=%u is not a datapath Ethernet port\n",
-			port_idx, dp_port_id);
-		return ret;
-	}
-
-	/*
-	 * DP_F_FAST_ETH_WAN pins the datapath port id: AVM's allocator walks
-	 * PMAC_ETH_WAN_ID as both the start and the end of its search, so the
-	 * WAN class can only ever land on dp port 15, and dp port 15 can only
-	 * ever be WAN.
-	 *
-	 * Hence the equivalence, checked in both directions. lantiq,wan on any
-	 * other port describes something the silicon cannot do. dp port 15
-	 * WITHOUT lantiq,wan is the quieter half of the same mistake: the port
-	 * would come up, take the LAN PMAC template, and egress with
-	 * redirect = 0 - which is exactly the silent class/template
-	 * disagreement this check exists to catch.
-	 */
-	is_wan = of_property_read_bool(port_node, "lantiq,wan");
-	if (is_wan != (dp_port_id == INTEL_XRX500_DP_PORT_WAN)) {
-		dev_err(priv->dev,
-			"intel-xrx500: port@%u intel,dp-port-id=%u %s lantiq,wan (dp %u is the WAN port, and only it)\n",
-			port_idx, dp_port_id,
-			is_wan ? "must not have" : "requires",
-			INTEL_XRX500_DP_PORT_WAN);
-		return -EINVAL;
-	}
-
-	netdev = alloc_etherdev_mq(sizeof(*port), 1);
-	if (!netdev)
-		return -ENOMEM;
-
-	SET_NETDEV_DEV(netdev, priv->dev);
-
-	port = netdev_priv(netdev);
-	port->netdev          = netdev;
-	port->port_idx        = port_idx;
-	port->dp_port_id      = dp_port_id;
-	/*
-	 *   dp_port_id  cbm_deq_port == tmu_egress_port   tmu_queue
-	 *      5            10                              20     (eth0 = LAN1)
-	 *      4             9                              19     (eth1 = LAN2)
-	 *      3             8                              18     (eth2 = LAN3)
-	 *      2             7                              17     (eth3 = LAN4)
-	 *     15            19                              28     (wan)
-	 *
-	 * The LAN rows used to be computed as dp_port_id + 5. They are not a
-	 * formula — dp 15 resolves to 19, where +5 would say 20, and 20 is the
-	 * checksum dequeue port. See cbm_dp_egress_res_get() in
-	 * cqm/grx500/cbm_ports.c.
-	 */
-	port->cbm_deq_port    = deq_port;
-	port->tmu_egress_port = deq_port;
-	port->parent          = priv;
-	port->dp_alloc_flags  = is_wan ? DP_F_FAST_ETH_WAN : DP_F_FAST_ETH_LAN;
-	port->dp_subif_id     = -1;
-	port->state_open      = false;
-	port->state_subif_registered = false;
-	spin_lock_init(&port->tx_lock);
-	port->tx_chan = 0;
-	port->tx_ring = NULL;
-	port->tx_ring_phys = 0;
-	port->tx_head = 0;
-	port->state_tx_initialized = false;
-
-	port->port_node = of_node_get(port_node);
-	port->phy_node  = of_parse_phandle(port_node, "phy-handle", 0);
-
-	/*
-	 * Ask the netdev core for per-CPU packet/byte counters. It allocates
-	 * dev->tstats inside register_netdevice() and frees it again on both
-	 * the failure and the unregister path, so there is nothing for this
-	 * driver to unwind. Must be set before register_netdev() below --
-	 * same placement as am65-cpsw-nuss and r8169. Only the two
-	 * atomic_long_t drop counters remain in port->stats, and those need
-	 * no initialiser beyond alloc_etherdev_mq's zeroing.
-	 */
-	netdev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
-
-	/*
-	 * The supported_interfaces bitmap MUST be populated BEFORE
-	 * phylink_create - otherwise phylink_create returns an error pointer.
-	 */
-	port->phylink_config.dev  = &netdev->dev;
-	port->phylink_config.type = PHYLINK_NETDEV;
-	/*
-	 * The MAC handles flow control in both directions, so both pause caps
-	 * are advertised and phylink_caps_to_linkmodes() sets the Pause and
-	 * Asym_Pause link modes in the MAC support mask; the GPHY advertises
-	 * the same pair. Speeds are full duplex only.
-	 */
-	port->phylink_config.mac_capabilities =
-		MAC_SYM_PAUSE | MAC_ASYM_PAUSE |
-		MAC_1000FD | MAC_100FD | MAC_10FD;
-	__set_bit(PHY_INTERFACE_MODE_INTERNAL,
-		  port->phylink_config.supported_interfaces);
-
-	netdev->netdev_ops  = &intel_xrx500_netdev_ops;
-	netdev->ethtool_ops = &intel_xrx500_ethtool_ops;
-
-	netdev->min_mtu = ETH_MIN_MTU;
-	/*
-	 * The switch core these ports sit behind is initialised to discard
-	 * anything longer than a standard Ethernet frame (gsw_flow_pce.c
-	 * writes a frame length of 1518) and intel_xrx500_ndo_start_xmit()
-	 * only ever checks out a standard 2 KiB CBM segment, so a standard
-	 * MTU is the most a port can carry.
-	 */
-	netdev->max_mtu = ETH_DATA_LEN;
-
-	phylink = phylink_create(&port->phylink_config,
-				 of_fwnode_handle(port_node),
-				 PHY_INTERFACE_MODE_INTERNAL,
-				 &intel_xrx500_phylink_ops);
-	if (IS_ERR(phylink)) {
-		ret = PTR_ERR(phylink);
-		dev_err(priv->dev,
-			"intel-xrx500: phylink_create(port@%u) failed: %d\n",
-			port_idx, ret);
-		of_node_put(port->phy_node);
-		of_node_put(port->port_node);
-		free_netdev(netdev);
-		return ret;
-	}
-	port->phylink = phylink;
-
-	ret = phylink_of_phy_connect(phylink, port_node, 0);
-	/*
-	 * phylink reports "the device tree names a PHY but no such device
-	 * exists" as -ENODEV, which no caller retries. The GPHY firmware
-	 * loader and the MDIO bus that create these PHYs can be a module, so
-	 * on a cold boot they legitimately arrive after this probe. Ask to be
-	 * retried instead; a PHY registering is what re-triggers it.
-	 */
-	if (ret == -ENODEV && port->phy_node)
-		ret = -EPROBE_DEFER;
-	if (ret) {
-		if (ret != -EPROBE_DEFER)
-			dev_err(priv->dev,
-				"intel-xrx500: phylink_of_phy_connect(port@%u) failed: %d\n",
-				port_idx, ret);
-		phylink_destroy(phylink);
-		port->phylink = NULL;
-		of_node_put(port->phy_node);
-		of_node_put(port->port_node);
-		free_netdev(netdev);
-		return ret;
-	}
-
-	/*
-	 * (1) Strip Pause/Asym_Pause from the GPHY advertisement. With the HW
-	 * poller now conveying resolved pause into the MAC, advertising pause
-	 * would diverge from the only proven configuration.
-	 *
-	 * (2) Disable EEE advertisement. AVM zeroes the EEE advert on exactly
-	 * this port (grx350_common.dtsi:19-21 &lan1 avm,eee-adv=<0x0>,
-	 * applied via phy_ethtool_set_eee at ltq_eth_drv_xrx500.c:1810-1816).
-	 */
-	if (netdev->phydev) {
-		phy_remove_link_mode(netdev->phydev,
-				     ETHTOOL_LINK_MODE_Pause_BIT);
-		phy_remove_link_mode(netdev->phydev,
-				     ETHTOOL_LINK_MODE_Asym_Pause_BIT);
-		phy_disable_eee(netdev->phydev);
-	}
-
-	/*
-	 * Set a sane MAC address before register_netdev so userspace sees a
-	 * non-zero hwaddr from the moment the netdev appears.
-	 */
-	eth_hw_addr_random(netdev);
-
-	ret = register_netdev(netdev);
-	if (ret) {
-		dev_err(priv->dev,
-			"intel-xrx500: register_netdev(port@%u) failed: %d\n",
-			port_idx, ret);
-		rtnl_lock();
-		phylink_disconnect_phy(phylink);
-		rtnl_unlock();
-		phylink_destroy(phylink);
-		port->phylink = NULL;
-		of_node_put(port->phy_node);
-		of_node_put(port->port_node);
-		free_netdev(netdev);
-		return ret;
-	}
-
-	/*
-	 * Diagnostic line on per-port success. The chassis-side LAN
-	 * label (LAN1..LAN4) reads naturally against dp_port_id 5..2.
-	 */
-	dev_info(priv->dev,
-		 "intel-xrx500: %s registered (port@%u dp_port_id=%u deq=%u tmu=%u)\n",
-		 netdev_name(netdev), port_idx, port->dp_port_id,
-		 port->cbm_deq_port, port->tmu_egress_port);
-
-	priv->ports[port_idx] = port;
-	return 0;
-}
