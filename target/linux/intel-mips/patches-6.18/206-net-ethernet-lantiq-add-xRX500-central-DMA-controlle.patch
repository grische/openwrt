+/*
+ * Public API — declared here so Sub-3 / Sub-4 / Sub-6 (all sibling TUs
+ * inside the same intel-xrx500-gswip composite module) can resolve
+ * symbols at link time without EXPORT_SYMBOL leakage outside the lantiq/
+ * subtree (architectural_constraint #3).
+ *
+ * All declarations below are AVM-verbatim from AVM lantiq_dmax.h:780-1108
+ * except hdma_port_enable, which is the ONLY new Sub-4B-authored entry
+ * (CQ-001 C) and is marked as such below.
+ */
+int ltq_request_dma(u32 chan, const char *device_id);
+int ltq_free_dma(u32 chan);
