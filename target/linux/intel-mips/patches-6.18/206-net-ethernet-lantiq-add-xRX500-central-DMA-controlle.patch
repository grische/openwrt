+/*
+ * Intel xRX500 High-Performance DMA — probe + DT bindings + silicon init.
+ *
+ * Sub-4B ST-003 — fills in dma_ctrl_init's body and adds the entire
+ * chained-irqchip + tasklet + per-channel devm_request_irq scaffold
+ * ported verbatim (with v6.18 API translations) from AVM 4.9
+ * drivers/dma/intel/hdma.c per CQ-004 A. This is where ALL the real
+ * silicon programming and the probe-time UART markers land.
+ *
+ * Call order inside dma_ctrl_init (per AC-003-1 + AC-003-3 + AC-003-8):
+ *   spin_lock_init → bitmap_zero → atomic_set →
+ *   dma_ctrl_reset → dma_ctrl_cfg →
+ *   dma_irq_chip_init → tasklet_init →
+ *   per-port loop:
+ *     dma_set_port_controller_data → dma_port_cfg →
+ *     per-channel inner loop:
+ *       dma_set_chan_controller_data → dma_set_chan_port_data →
+ *       dma_chan_cfg → pch->irq = pctrl->irq_base + pch->nr →
+ *       devm_request_irq
+ *
+ * v6.18 API translations applied (per CQ-004 A):
+ *   - the legacy AVM 'set-up-irq' helper (removed in v5.17) is replaced
+ *     with request_irq / irq_set_chained_handler_and_data.
+ *   - the legacy 'irq-domain-add-legacy' helper (renamed in v5.18) is
+ *     replaced with irq_domain_create_legacy (current v6.18 name).
+ *   - the AVM dma_cascade irqaction struct dropped (only needed by the
+ *     removed legacy helper).
+ *
+ * Per AC-003-1 the silicon-init body fires EXACTLY ONCE per cid — the
+ * call site for dma_ctrl_init stays inside ltq_dma_probe (one invocation
+ * per platform-device probe). dma_ctrl_reset and dma_ctrl_cfg are static
+ * helpers called from inside dma_ctrl_init only — no duplicate call
+ * sites anywhere else in the TU.
+ *
+ * Per AC-003-11 do_dma_tasklet performs an explicit NULL-check on
+ * pch->intr_handler before invocation — Sub-4/Sub-6 register the
+ * intr_handler callbacks LATER (in their own probe paths), so an
+ * unconditional dispatch on the first DMA IRQ at ST-003 commit would
+ * oops on NULL deref.
+ *
+ * Per AC-003-2 do_dma_tasklet uses the budget-and-recheck pattern:
+ * processes up to pctrl->budget set-bits per invocation, re-schedules on
+ * (a) budget exhausted OR (b) bitmap non-empty after dropping the
+ * dma_in_process flag (the atomic-flag race recovery).
+ *
+ * Strips from AVM drivers/dma/intel/hdma.c per the plan:
+ *   - clock-acquire-and-enable block at AVM:4373-4379 (AS-007 / AC-002-3).
+ *   - panic-on-failure calls at AVM:4355 / :4360 replaced with dev_err +
+ *     return -ENODEV / PTR_ERR(membase) (IG-007 / AC-002-2).
+ *   - AVM debugfs scaffold (hdma.c:4044-4091 + :4400) stripped (AS-016).
+ *   - DMA0 branch of dma_cfg_init (AVM:4136-4147 + :4230-4273): CQ-002 C.
+ *   - DMA0 dispatch branch in do_dma_tasklet (AVM:2921-2940): the
+ *     special-case for !dma_is_64bit (DMA0 8-DW-desc controllers) is
+ *     fully stripped per AC-003-2; only the 64-bit branch survives.
+ *   - auto-descriptor-allocation tail in dma_chan_cfg (AVM:2225-2228):
+ *     dma_chan_desc_alloc + dma_chan_data_buf_alloc auto-invocation
+ *     stripped per AC-003-6; Sub-4/Sub-6 own descriptor seeding (AS-013).
+ *   - DMA3 disable_irq branch in dma_irq_chip_init (AVM:3177-3178)
+ *     dropped — DMA3 out of scope per AS-008.
+ *
+ * DMA0 / DMA3 / DMA4 are out of scope per CQ-002 C / AS-008.
+ *
+ * Citations:
+ *   - dma_name[]                                 AVM hdma.c:215-223
+ *   - ltq_dma_controller[DMAMAX] static array    AVM hdma.c:238
+ *   - itoc()                                     AVM hdma.c:212
+ *   - ltq_dma_r32 / w32 / w32_mask accessors     AVM hdma.c:247-262
+ *   - dma_get_name_by_cid                        AVM hdma.c:242-245
+ *   - dma_port_get_controller                    AVM hdma.c:269-274
+ *   - dma_chan_get_controller                    AVM hdma.c:276-281
+ *   - dma_chan_get_port                          AVM hdma.c:301-306
+ *   - dma_set_{port,chan}_controller_data        AVM hdma.c:352-364
+ *   - dma_set_chan_port_data                     AVM hdma.c:366-370
+ *   - dma_is_64bit / dma_chan_tx / dma_chan_rx   AVM hdma.c:372-385
+ *   - dma_ctrl_reset                             AVM hdma.c:407-415
+ *   - dma_ctrl_{pkt_arb,arb,sram,flowctl,...}_cfg AVM hdma.c:418-575
+ *   - dma_ctrl_cfg                               AVM hdma.c:577-617
+ *   - dma_chan_cctrl_cfg / set_class             AVM hdma.c:619-683
+ *   - burst_len_to_burst_cfg                     AVM hdma.c:4093-4118
+ *   - dma_cfg_init body (cid != DMA0 branch)     AVM hdma.c:4120-4319
+ *   - dma_port_cfg                               AVM hdma.c:2124-2163
+ *   - dma_chan_cfg (auto-desc-alloc stripped)    AVM hdma.c:2179-2233
+ *   - do_dma_tasklet (DMA0 branch stripped)      AVM hdma.c:2907-2957
+ *   - dma_chan_interrupt                         AVM hdma.c:2964-2988
+ *   - dma_irq_to_chan_nr                         AVM hdma.c:2959-2962
+ *   - dma_disable/enable/ack/mask_and_ack_irq    AVM hdma.c:3031-3096
+ *   - dma_irq_handler (chained parent dispatch)  AVM hdma.c:3098-3120
+ *   - dma_irq_chip / irq_map / domain_ops        AVM hdma.c:3122-3145
+ *   - dma_irq_chip_init (v6.18 adaptation)       AVM hdma.c:3153-3181
+ *   - dma_ctrl_init (full body, AC-003-1)        AVM hdma.c:2990-3029
+ *   - ltq_dma_probe                              AVM hdma.c:4322-4404
+ *   - of_match_table + platform_driver           AVM hdma.c:4406-4418
+ *   - postcore_initcall(ltq_dma_init)            AVM hdma.c:4420-4424
+ *
+ * NEW (non-AVM) symbol: hdma_port_enable() — see lantiq_dmax.h doc-comment.
+ */
