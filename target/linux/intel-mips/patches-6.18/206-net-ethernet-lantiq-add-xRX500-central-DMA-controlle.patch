+/*
+ * dma_cfg_init() — AVM hdma.c:4120-4319 with the DMA0 / DMA3 / DMA4
+ * branches stripped per AC-002-4 (CQ-002 C / AS-008). Only DMA1TX,
+ * DMA1RX and DMA2TX bind via the lantiq,dma-xrx500 compatible, so:
+ *   - AVM's "if (pctrl->cid != DMA0)" guard collapses: we
+ *     unconditionally set DMA_CTL_64BIT.
+ *   - AVM's "if (cid == DMA3 || cid == DMA4) port_nrs--" guard is gone
+ *     (those cids never reach this function).
+ *   - AVM's "if (pctrl->cid == DMA0)" branch (AVM:4230-4273) is gone.
+ *
+ * Reads ALL of: lantiq,dma-pkt-arb, lantiq,dma-chan-fc, lantiq,dma-desc-fod,
+ * lantiq,dma-desc-in-sram, lantiq,dma-drb, lantiq,dma-byte-en,
+ * lantiq,dma-polling-cnt, lantiq,dma-lab-cnt, lantiq,dma-orrc,
+ * lantiq,dma-txendi, lantiq,dma-rxendi, lantiq,budget, lantiq,dma-burst
+ * via of_property_read_u32 per AC-002-6. The polling-cnt value is stored
+ * as a raw uint into pctrl->pollcnt (encoded into CPOLL_CNT later by
+ * dma_ctrl_cfg in ST-003 — see hdma_regs.h DMA_CPOLL bit-7 comment).
+ */
+static int dma_cfg_init(struct dma_ctrl *pctrl)
+{
+	int i;
+	u32 prop;
+	u32 chan_fc = 0;
+	u32 desc_fod = 0;
+	u32 desc_insram = 0;
+	u32 dma_drb = 0;
+	u32 byte_en = 0;
+	u32 txendi;
+	u32 rxendi;
+	struct dma_port *pport;
+	struct dmax_chan *pch;
+	struct device_node *node = pctrl->dev->of_node;
+
+	pctrl->flags |= DMA_CTL_64BIT;
+
+	pctrl->burst_mask = DMA_4DW_DESC_MASK;
+	pctrl->desc_size = DMA_4DW_DESC_SIZE;
+
+	if (!of_property_read_u32(node, "lantiq,dma-pkt-arb", &prop)) {
+		if (prop > DMA_ARB_MAX)
+			pctrl->arb_type = DMA_ARB_PKT;
+		else
+			pctrl->arb_type = prop;
+	} else {
+		pctrl->arb_type = DMA_ARB_PKT;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-chan-fc", &chan_fc)) {
+		if (chan_fc)
+			pctrl->flags |= DMA_FLCTL;
+		else
+			pctrl->flags &= ~DMA_FLCTL;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-desc-fod", &desc_fod)) {
+		if (desc_fod)
+			pctrl->flags |= DMA_FTOD;
+		else
+			pctrl->flags &= ~DMA_FTOD;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-desc-in-sram",
+				  &desc_insram)) {
+		if (desc_insram)
+			pctrl->flags |= DMA_DESC_IN_SRAM;
+		else
+			pctrl->flags &= ~DMA_DESC_IN_SRAM;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-drb", &dma_drb)) {
+		if (dma_drb)
+			pctrl->flags |= DMA_DRB;
+		else
+			pctrl->flags &= ~DMA_DRB;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-byte-en", &byte_en)) {
+		if (byte_en)
+			pctrl->flags |= DMA_EN_BYTE_EN;
+		else
+			pctrl->flags &= ~DMA_EN_BYTE_EN;
+	}
+
+	if (!of_property_read_u32(node, "lantiq,dma-polling-cnt", &prop))
+		pctrl->pollcnt = prop;
+	else
+		pctrl->pollcnt = DMA_GLOBAL_POLLING_DEFAULT_INTERVAL;
+
+	if (!of_property_read_u32(node, "lantiq,dma-lab-cnt", &prop))
+		pctrl->labcnt = prop;
+	else
+		pctrl->labcnt = 0;
+
+	if (!of_property_read_u32(node, "lantiq,dma-orrc", &prop))
+		pctrl->orrc = prop;
+	else
+		pctrl->orrc = 0;
+
+	if (!of_property_read_u32(node, "lantiq,dma-txendi", &prop))
+		txendi = prop;
+	else
+		txendi = DMA_DEFAULT_ENDIAN;
+
+	if (!of_property_read_u32(node, "lantiq,dma-rxendi", &prop))
+		rxendi = prop;
+	else
+		rxendi = DMA_DEFAULT_ENDIAN;
+
+	dev_dbg(pctrl->dev,
+		"arb %d fc %d fod %d insram %d drb %d ben %d pcnt %d labcnt %d orrc %d\n",
+		pctrl->arb_type, chan_fc, desc_fod, desc_insram, dma_drb,
+		byte_en, pctrl->pollcnt, pctrl->labcnt, pctrl->orrc);
+
+	if (!of_property_read_u32(node, "lantiq,budget", &prop))
+		pctrl->budget = prop;
+	else
+		pctrl->budget = DMA_IRQ_BUDGET;
+
+	/*
+	 * AVM's cid == DMA0 branch (hdma.c:4230-4273) stripped per AC-002-4.
+	 * Sub-4B only enters the cid != DMA0 path below.
+	 */
+	pctrl->ports = devm_kzalloc(pctrl->dev,
+				    pctrl->port_nrs * sizeof(*pport),
+				    GFP_KERNEL);
+	if (!pctrl->ports)
+		return -ENOMEM;
+
+	pport = &pctrl->ports[0];
+	pport->chan_nrs = pctrl->chans;
+	pport->pid = 0;
+	pport->name = dma_name[pctrl->cid];
+	pport->rxendi = rxendi;
+	pport->txendi = txendi;
+
+	if (!of_property_read_u32(node, "lantiq,dma-burst", &prop)) {
+		u32 burst = burst_len_to_burst_cfg(prop);
+
+		pport->rxbl = burst;
+		pport->txbl = burst;
+	} else {
+		pport->rxbl = DMA_DEFAULT_BURST;
+		pport->txbl = DMA_DEFAULT_BURST;
+	}
+	pport->txwgt = DMA_TX_PORT_DEFAULT_WEIGHT;
+	pport->pkt_drop = DMA_PKT_DROP_DISABLE;
+	pport->flush_memcpy = 0;
+
+	pport->chans = devm_kzalloc(pctrl->dev,
+				    pport->chan_nrs * sizeof(*pch),
+				    GFP_KERNEL);
+	if (!pport->chans) {
+		devm_kfree(pctrl->dev, pctrl->ports);
+		return -ENOMEM;
+	}
+	for (i = 0; i < pport->chan_nrs; i++) {
+		pch = &pport->chans[i];
+		pch->flags |= DEVICE_ALLOC_DESC;
+		pch->nr = i;
+		pch->onoff = DMA_CH_OFF;
+		pch->rst = DMA_CHAN_RST;
+		pch->pkt_size = DMA_PKT_SIZE_DEFAULT;
+		pch->opt = NULL;
+		pch->lnr = -1;
+		pch->cis = 0;
+		pch->desc_configured = false;
+	}
+	return 0;
+}
+
+/*
+ * dma_ctrl_init — full body per AC-003-1. AVM hdma.c:2990-3029 with the
+ * following deltas:
+ *   - dma_irq_chip_init invoked INSIDE dma_ctrl_init (AVM has it in
+ *     ltq_dma_probe) — call BEFORE the per-channel devm_request_irq loop
+ *     so pctrl->irq_base is allocated when pch->irq is set per AC-003-3.
+ *   - tasklet_init invoked INSIDE dma_ctrl_init (AVM has it in
+ *     ltq_dma_probe) — pctrl->dma_tasklet must be ready BEFORE the
+ *     per-channel devm_request_irq loop installs the IRQ handlers, since
+ *     a stray IRQ could fire as soon as devm_request_irq returns.
+ *
+ * Per AC-003-1 dma_ctrl_reset / dma_ctrl_cfg fire EXACTLY ONCE per cid,
+ * only from this function — no duplicate call sites in ltq_dma_probe or
+ * elsewhere in the TU.
+ *
+ * Per AC-003-7 the per-channel devm_request_irq uses
+ * IRQF_NO_THREAD | IRQF_NOBALANCING (chained-IRQ child handlers must not
+ * be threaded), name = dma_get_name_by_cid(cid), handler = dma_chan_interrupt,
+ * dev_id = pch, irq = pctrl->irq_base + pch->nr.
+ */
+static int dma_ctrl_init(struct dma_ctrl *pctrl)
+{
+	u32 i, j;
+	int ret;
+	struct dma_port *pport = NULL;
+	struct dmax_chan *pch = NULL;
+
+	dev_dbg(pctrl->dev,
+		"struct dma_ctrl size %zu port %zu chan %zu\n",
+		sizeof(*pctrl), sizeof(*pport), sizeof(*pch));
+	spin_lock_init(&pctrl->ctrl_lock);
+	bitmap_zero(pctrl->dma_int_status, MAX_DMA_CHAN_PER_PORT);
+	atomic_set(&pctrl->dma_in_process, 0);
+
+	dma_ctrl_reset(pctrl);
+
+	dma_ctrl_cfg(pctrl);
+
+	/*
+	 * dma_irq_chip_init MUST complete BEFORE the per-channel
+	 * devm_request_irq loop runs (else the irq_domain isn't yet wired
+	 * and pctrl->irq_base is undefined). See ST-003 risks #2.
+	 */
+	ret = dma_irq_chip_init(pctrl);
+	if (ret)
+		return ret;
+
+	/*
+	 * tasklet_init BEFORE the devm_request_irq loop — a child IRQ
+	 * could fire (and dma_chan_interrupt schedule the tasklet) as soon
+	 * as request_irq returns.
+	 */
+	tasklet_init(&pctrl->dma_tasklet, do_dma_tasklet,
+		     (unsigned long)pctrl);
+
+	for (i = 0; i < pctrl->port_nrs; i++) {
+		pport = &pctrl->ports[i];
+		dma_set_port_controller_data(pport, pctrl);
+		dma_port_cfg(pport);
+
+		for (j = 0; j < pport->chan_nrs; j++) {
+			pch = &pport->chans[j];
+			dma_set_chan_controller_data(pch, pctrl);
+			dma_set_chan_port_data(pch, pport);
+			dma_chan_cfg(pch);
+			pch->irq = pctrl->irq_base + pch->nr;
+			/* Per-channel IRQ handler — AC-003-7. */
+			ret = devm_request_irq(pctrl->dev, pch->irq,
+					       dma_chan_interrupt,
+					       IRQF_NO_THREAD |
+					       IRQF_NOBALANCING,
+					       dma_get_name_by_cid(pctrl->cid),
+					       (void *)pch);
+			if (ret) {
+				dev_err(pctrl->dev,
+					"Failed to register irq %d on chan %d %s\n",
+					pch->irq, pch->nr, pctrl->name);
+				return -ENODEV;
+			}
+		}
+	}
+	return 0;
+}
+
+/*
+ * ltq_dma_probe — AVM hdma.c:4322-4404 with:
+ *   - the clock-acquire-and-enable block (AVM:4373-4379) stripped per
+ *     AS-007 / AC-002-3.
+ *   - debugfs_init call (AVM:4400) stripped per AS-016 / AC-002-9.
+ *   - the panic-on-failure call at :4355 replaced with dev_err + return
+ *     -ENODEV per IG-007 / AC-002-2.
+ *   - the panic-on-failure call at :4360 replaced with dev_err + return
+ *     PTR_ERR(membase).
+ *   - the dev_info marker family at :4390 / :4401 replaced with a
+ *     single pr_info("probe entry cid=%d name=%s reg=0x%lx irq=%d")
+ *     emitted immediately before return 0 per AC-002-7.
+ *   - dma_irq_chip_init (AVM:4388) and tasklet_init (AVM:4396) calls
+ *     MOVED INSIDE dma_ctrl_init's body per AC-003-1 + ST-003 review_focus
+ *     (the silicon-init body fires exactly once per cid; the call sites
+ *     for dma_ctrl_reset / dma_ctrl_cfg / dma_irq_chip_init / tasklet_init
+ *     all live inside dma_ctrl_init).
+ */
+static int ltq_dma_probe(struct platform_device *pdev)
+{
+	int err;
+	int irq;
+	struct device_node *node = pdev->dev.of_node;
+	struct resource *memres;
+	struct dma_ctrl *pctrl;
+	unsigned int id;
+	int cidx;
+
+	/*
+	 * Layout asserts hosted here (rather than in dma_ctrl_init) to fire
+	 * exactly once early in probe. Descriptor sizes are silicon-binding
+	 * (16-byte 4-DW format) and MAX_DMA_CHAN_PER_PORT defines the
+	 * bitmap width inside struct dma_ctrl. Per AC-001-4 the third
+	 * assert's spec text reads BUILD_BUG_ON(... == 64) but that
+	 * condition would trip the build; the canonical kernel form
+	 * (... != 64) preserves the equality intent (recorded as a
+	 * planned-text deviation in ST-001 manifest).
+	 */
+	BUILD_BUG_ON(sizeof(struct dma_rx_desc) != 16);
+	BUILD_BUG_ON(sizeof(struct dma_tx_desc) != 16);
+	BUILD_BUG_ON(MAX_DMA_CHAN_PER_PORT != 64);
+
+	/* DMA controller physical idx from aliases. */
+	cidx = of_alias_get_id(node, "dma");
+	if (cidx < 0) {
+		dev_err(&pdev->dev, "failed to get alias id, errno %d\n", cidx);
+		return cidx;
+	}
+
+	pdev->id = cidx;
+
+	if (pdev->id < 0 || pdev->id >= DMAMAX)
+		return -EINVAL;
+
+	pctrl = &ltq_dma_controller[pdev->id];
+
+	memset(pctrl, 0, sizeof(*pctrl));
+
+	pctrl->cid = pdev->id;
+	pctrl->name = dma_name[pctrl->cid];
+	pctrl->dev = &pdev->dev;
+
+	memres = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!memres) {
+		dev_err(&pdev->dev, "failed to get dma resource\n");
+		return -ENODEV;
+	}
+
+	/* remap dma register range */
+	pctrl->membase = devm_ioremap_resource(&pdev->dev, memres);
+	if (IS_ERR(pctrl->membase)) {
+		dev_err(&pdev->dev, "failed to remap dma resource\n");
+		return PTR_ERR(pctrl->membase);
+	}
+
+	err = dma_set_mask(pctrl->dev, DMA_BIT_MASK(32));
+	if (err) {
+		err = dma_set_coherent_mask(pctrl->dev, DMA_BIT_MASK(32));
+		if (err) {
+			dev_err(&pdev->dev,
+				"No usable DMA configuration, aborting\n");
+			return err;
+		}
+	}
+
+	/*
+	 * The AVM clock-acquire-and-enable block (AVM:4373-4379) is
+	 * intentionally absent — DMA1TX / DMA1RX / DMA2TX DT nodes carry
+	 * no clocks property (AS-007 / AC-002-3).
+	 */
+
+	id = ltq_dma_r32(pctrl, DMA_ID);
+	pctrl->chans = MS(id, DMA_ID_CHNR);
+	pctrl->port_nrs = MS(id, DMA_ID_PRTNR);
+	pctrl->ver = MS(id, DMA_ID_REV);
+
+	err = dma_cfg_init(pctrl);
+	if (err)
+		return err;
+
+	/*
+	 * dma_ctrl_init is the silicon-init body — invokes dma_ctrl_reset,
+	 * dma_ctrl_cfg, dma_irq_chip_init, tasklet_init, the per-port loop
+	 * (dma_set_port_controller_data → dma_port_cfg), and the per-channel
+	 * inner loop (dma_set_chan_controller_data → dma_set_chan_port_data
+	 * → dma_chan_cfg → devm_request_irq) per AC-003-1.
+	 */
+	err = dma_ctrl_init(pctrl);
+	if (err)
+		return err;
+
+	/* Link platform with driver data for retrieving */
+	platform_set_drvdata(pdev, pctrl);
+
+	/*
+	 * The AVM debug-filesystem scaffold is absent per AS-016 /
+	 * AC-002-9 — the single pr_info marker below serves the
+	 * human-tester verification surface that scaffold would otherwise
+	 * serve.
+	 */
+
+	irq = platform_get_irq(pdev, 0);
+
+	/*
+	 * Probe-entry marker (AC-002-7). The full marker sequence per
+	 * AC-003-8 (post-reset / post-ctrl-cfg / post-port-cfg / post-chan-cfg)
+	 * fires inside dma_ctrl_init's body — see AC-003-1 for the order.
+	 */
+	pr_info("probe entry cid=%d name=%s reg=0x%lx irq=%d\n",
+		cidx, pctrl->name, (unsigned long)memres->start, irq);
+
+	return 0;
+}
+
+/*
+ * ============================================================================
+ * Channel-level public API surface — ST-004
+ * ============================================================================
+ *
+ * AVM-verbatim port of the ltq_request_dma / ltq_free_dma / ltq_dma_chan_*
+ * channel-level entry points (CQ-001 C) plus a handful of Sub-4B-specific
+ * deviations called out by ST-004 acceptance criteria. All symbols below are
+ * file-internal-or-composite-module-internal per AC-004-9: NO EXPORT_SYMBOL
+ * appears anywhere in this TU (verified by `grep '^EXPORT_SYMBOL'` returning
+ * 0 lines). Sub-3 / Sub-4 / Sub-6 resolve these symbols at link time via the
+ * intel-xrx500-gswip composite-module linkage per architectural_constraint
+ * #3.
+ *
+ * Deviations from AVM verbatim, all driven by ST-004 acceptance criteria:
+ *
+ *   1. Sub-4B-specific cid range guard inside ltq_request_dma per AC-004-1:
+ *      reject cid==DMA0 or cid > DMA2TX (Sub-4B never binds those cids),
+ *      reject when ltq_dma_controller[cid].dev is NULL (controller not
+ *      bound). AVM's dma_chan_l2p indirectly returns NULL in those cases
+ *      via a downstream pport->chans walk; the explicit early-return makes
+ *      the contract Sub-4B-callers can rely on.
+ *
+ *   2. ltq_dma_chan_irq_enable writes DMA_CI_DEFAULT (= DMA_CI_EOP |
+ *      DMA_CI_DESCPT) unconditionally per AC-004-8, where AVM splits TX
+ *      (DMA_CI_EOP only) vs RX (EOP | DESCPT). The plan's harmonization
+ *      mirrors the safer "no spurious interrupts" intent — DMA_CI_DUR /
+ *      CI_CHOFF / CI_RDERR remain masked.
+ *
+ *   3. ltq_dma_chan_irq_enable / ltq_dma_chan_irq_disable also set/clear
+ *      BIT(cn & 0x1f) in the top-level DMA_IRNEN (cn<=31) or DMA_IRNEN1
+ *      (cn>=32) per AC-004-8 / AC-004-11. AVM handles top-level IRNEN in
+ *      its irq_data chip ops (dma_enable_irq / dma_disable_irq); Sub-4B's
+ *      channel API conflates per-channel CIE and top-level IRNEN into a
+ *      single enable / disable primitive so callers don't need both paths.
+ *
+ *   4. ltq_dma_chan_desc_alloc uses dma_alloc_coherent (not AVM's
+ *      dmam_alloc_coherent) per AC-004-6 so ltq_dma_chan_desc_free can
+ *      explicitly reverse the alloc with dma_free_coherent. The
+ *      pch->desc_base == NULL guard on free is also AC-004-6 mandated.
+ *
+ *   5. ltq_dma_chan_open / ltq_dma_chan_close are composed strictly from
+ *      the on/off + irq_enable/disable primitives per AC-004-3 — they do
+ *      NOT call ltq_dma_chan_reset before/after (verified against AVM
+ *      hdma.c:1020-1054 where dma_chan_open is `on + (rx? irq_enable)` and
+ *      dma_chan_close is `off + irq_disable` with no reset).
+ *
+ *   6. ltq_dma_chan_pkt_drop_cfg toggles DMA_CCTRL_PDEN (BIT(23)) per
+ *      AC-004-7 — channel-level packet-drop, distinct from port-level
+ *      DMA_PCTRL_PDEN (BIT(6)) which is programmed at dma_port_cfg time.
+ *      AVM's dma_chan_pkt_drop_cfg also has an early-return for TX (only
+ *      RX honours packet-drop); Sub-4B preserves that AVM guard.
+ *
+ * Citations (AVM file:line for every non-trivial body):
+ *   - dma_chan_l2p                              AVM hdma.c:685-701
+ *   - dma_chan_on / dma_chan_off / ltq_*        AVM hdma.c:734-788
+ *   - dma_chan_irq_enable / disable / ltq_*     AVM hdma.c:972-1018
+ *   - dma_chan_open / close / ltq_*             AVM hdma.c:1020-1054
+ *   - dma_chan_reset / ltq_*                    AVM hdma.c:935-970
+ *   - dma_chan_pkt_drop_cfg / ltq_*             AVM hdma.c:1056-1085
+ *   - dma_chan_byte_offset_cfg / ltq_*          AVM hdma.c:1241-1278
+ *   - dma_chan_set_class (reused by class_cfg)  AVM hdma.c:661-683
+ *   - dma_chan_desc_alloc                       AVM hdma.c:1582-1620
+ *     (dmam_alloc_coherent → dma_alloc_coherent per AC-004-6)
+ *   - dma_chan_desc_free                        AVM hdma.c:1632-1650
+ *     (dmam_free_coherent → dma_free_coherent per AC-004-6)
+ *   - dma_chan_data_buf_alloc / free            AVM hdma.c:1887-2054
+ *   - ltq_dma_chan_pseudo_irq_handler_callback_cfg AVM hdma.c:2107-2122
+ *   - dma_chan_desc_cfg / ltq_*                 AVM hdma.c:809-845
+ *   - ltq_request_dma                           AVM hdma.c:2236-2266
+ *   - ltq_free_dma                              AVM hdma.c:2268-2281
+ *   - ltq_dma_chan_pktsize_cfg                  AVM hdma.c:1134-1147
+ */
+
+/*
+ * dma_lookup_ctrl — Sub-4B cid-range guard per AC-004-1. Rejects DMA0 (out
+ * of scope per AS-008 / CQ-002 C) and any cid above DMA2RX (DMA3, DMA4 out
+ * of scope). Returns NULL when ltq_dma_controller[cid].dev is NULL
+ * (controller never bound by ltq_dma_probe).
+ *
+ * IG-068: the upper bound was DMA2TX; relaxed to DMA2RX so the AVM
+ * DMA1TX<->DMA2RX peripheral-to-peripheral bridge (setup_DMA_p2p) can
+ * request DMA2RX channels. DMA2RX only binds when the xrx500.dtsi dma2rx
+ * node (alias dma4) is present; absent that node ltq_dma_controller[DMA2RX]
+ * .dev stays NULL and this function still returns NULL for DMA2RX cids.
+ */
+static struct dma_ctrl *dma_lookup_ctrl(int cid)
+{
+	if (cid <= DMA0 || cid > DMA2RX)
+		return NULL;
+	if (cid >= DMAMAX)
+		return NULL;
+	if (!ltq_dma_controller[cid].dev)
+		return NULL;
+	return &ltq_dma_controller[cid];
+}
+
+/*
+ * dma_chan_l2p — AVM hdma.c:685-701 with Sub-4B's cid-range guard layered in
+ * front. Decodes the 32-bit encoded channel handle, validates the controller
+ * is bound and the (pid, nid) pair resolves to a real per-channel slot.
+ *
+ * Returns NULL on any failure (caller logs / returns -EINVAL upstream).
+ * Unlike AVM, this lookup deliberately does NOT enforce the CHAN_IN_USE
+ * post-condition — callers like ltq_dma_chan_on need to inspect the slot
+ * before request_dma marks it used. AC-004-1 calls for explicit early-return
+ * on Sub-4B-out-of-scope cids; the CHAN_IN_USE check is left to the AVM
+ * surface that needs it (ltq_dma_chan_on retains the desc_configured guard
+ * which serves the same defensive purpose).
+ */
+static struct dmax_chan *dma_chan_l2p(u32 chan)
+{
+	int cid = _DMA_CONTROLLER(chan);
+	int pid = _DMA_PORT(chan);
+	int nid = _DMA_CHANNEL(chan);
+	struct dma_ctrl *pctrl;
+	struct dma_port *pport;
+	int i;
+
+	pctrl = dma_lookup_ctrl(cid);
+	if (!pctrl)
+		return NULL;
+	if (pid < 0 || pid >= (int)pctrl->port_nrs)
+		return NULL;
+	pport = &pctrl->ports[pid];
+	if (!pport->chans)
+		return NULL;
+	for (i = 0; i < pport->chan_nrs; i++) {
+		if (pport->chans[i].nr == nid)
+			return &pport->chans[i];
+	}
+	return NULL;
+}
+
+/*
+ * dma_chan_in_use — small inline helper used to enforce post-request
+ * preconditions on the per-channel APIs. Matches AVM hdma.c:387-389.
+ */
+static inline bool dma_chan_in_use(struct dmax_chan *pch)
+{
+	return (pch->flags & CHAN_IN_USE) ? true : false;
+}
+
+/*
+ * ltq_request_dma — AVM hdma.c:2236-2266 with Sub-4B's cid-range +
+ * controller-bound guard (AC-004-1). Per AC-004-2 the device_id string and
+ * the lnr (encoded channel handle) are recorded on the per-channel slot;
+ * the CHAN_IN_USE bit marks the channel as held (AVM uses bit-flag rather
+ * than refcnt — preserved verbatim).
+ */
+int ltq_request_dma(u32 chan, const char *device_id)
+{
+	int cid = _DMA_CONTROLLER(chan);
+	int pid = _DMA_PORT(chan);
+	int nid = _DMA_CHANNEL(chan);
+	struct dma_ctrl *pctrl;
+	struct dma_port *pport;
+	struct dmax_chan *pch = NULL;
+	int i;
+
+	/* AC-004-1: reject DMA0 / DMA2RX..DMA4 cids and unbound controllers. */
+	pctrl = dma_lookup_ctrl(cid);
+	if (!pctrl)
+		return -EINVAL;
+
+	if (pid < 0 || pid >= (int)pctrl->port_nrs)
+		return -EINVAL;
+	pport = &pctrl->ports[pid];
+	if (!pport->chans)
+		return -EINVAL;
+	for (i = 0; i < pport->chan_nrs; i++) {
+		if (pport->chans[i].nr == nid) {
+			pch = &pport->chans[i];
+			break;
+		}
+	}
+	if (!pch)
+		return -ENODEV;
+
+	if (!device_id)
+		pr_warn("%s: no device id given for %s chan %d\n", __func__,
+			dma_get_name_by_cid(cid), nid);
+
+	mutex_lock(&pch->ch_lock);
+	if (dma_chan_in_use(pch)) {
+		mutex_unlock(&pch->ch_lock);
+		pr_err("%s chan %d already in use\n",
+		       dma_get_name_by_cid(cid), nid);
+		return -EBUSY;
+	}
+	/* AC-004-2: mark CHAN_IN_USE + stash device_id and encoded handle. */
+	pch->flags |= CHAN_IN_USE;
+	pch->lnr = chan;
+	pch->device_id = device_id;
+	mutex_unlock(&pch->ch_lock);
+
+	pr_debug("%s chan %d is allocated for %s\n", dma_get_name_by_cid(cid),
+		 nid, device_id ? device_id : "(unnamed)");
+	return 0;
+}
+
+/*
+ * ltq_free_dma — AVM hdma.c:2268-2281 verbatim. Inverse of ltq_request_dma:
+ * clears CHAN_IN_USE, resets lnr / device_id. No silicon-side teardown
+ * here — callers must have already invoked ltq_dma_chan_close +
+ * ltq_dma_chan_desc_free per the API contract documented in lantiq_dmax.h.
+ */
+int ltq_free_dma(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	mutex_lock(&pch->ch_lock);
+	pch->flags &= ~CHAN_IN_USE;
+	pch->lnr = -1;
+	pch->device_id = NULL;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+
+/*
+ * dma_chan_on / ltq_dma_chan_on — AVM hdma.c:734-756 verbatim. The
+ * DMA_CS-select-before-DMA_CCTRL-write ordering is silicon-mandatory per
+ * AC-004-4. The desc_configured WARN_ON in the public wrapper preserves
+ * AVM's "no on without descriptors" contract — callers must invoke
+ * ltq_dma_chan_desc_cfg (or equivalent) before chan_on.
+ */
+static void dma_chan_on(struct dmax_chan *pch)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32_mask(pctrl, 0, DMA_CCTRL_ON, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	pch->onoff = DMA_CH_ON;
+}
+
+int ltq_dma_chan_on(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	/* If descriptors not configured, not allow to turn on channel. */
+	if (WARN_ON(!pch || !pch->desc_configured))
+		return -EINVAL;
+	dma_chan_on(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_off / ltq_dma_chan_off — AVM hdma.c:758-788 verbatim. Spins up
+ * to ~10k iterations waiting for the DMA_CCTRL_ON bit to self-clear; logs
+ * (but does not fail) on timeout — silicon may take longer if a long
+ * descriptor is mid-burst.
+ */
+static void dma_chan_off(struct dmax_chan *pch)
+{
+	u32 reg;
+	int i = 10000;
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32_mask(pctrl, DMA_CCTRL_ON, 0, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+
+	/* Wait for channel off to complete. */
+	while (((reg = ltq_dma_r32(pctrl, DMA_CCTRL)) & DMA_CCTRL_ON) && i--)
+		;
+	if (i == 0)
+		dev_err(pctrl->dev, "%s chan %d off failed\n",
+			pctrl->name, pch->nr);
+	pch->onoff = DMA_CH_OFF;
+}
+
+int ltq_dma_chan_off(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	dma_chan_off(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_reset / ltq_dma_chan_reset — AVM hdma.c:935-970. dma_chan_off
+ * is invoked first so any in-flight burst finishes cleanly before the
+ * reset pulse. Resets curr_desc / prev_desc back to 0 and re-arms the
+ * silicon CDBA / CDLEN registers with the cached descriptor ring.
+ *
+ * Sub-4B deviation: AVM also calls dma_chan_desc_reset (which walks the
+ * descriptor ring and clears the per-desc OWN bits). Per AS-013 Sub-4 /
+ * Sub-6 own descriptor seeding; ltq_dma_chan_reset deliberately does NOT
+ * walk the ring. Callers that need a ring re-seed must do it via the
+ * descriptor-cfg path explicitly.
+ */
+int ltq_dma_chan_reset(u32 chan)
+{
+	int i = 10000;
+	unsigned long flags;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+	struct dma_ctrl *pctrl;
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+
+	dma_chan_off(pch);
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32_mask(pctrl, 0, DMA_CCTRL_RST, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	/* Wait for the RST bit to self-clear. */
+	while ((ltq_dma_r32(pctrl, DMA_CCTRL) & DMA_CCTRL_RST) && i--)
+		;
+	if (i == 0)
+		dev_err(pctrl->dev, "%s chan %d reset failed\n",
+			pctrl->name, pch->nr);
+	pch->rst = 1;
+	/* Re-arm CDBA / CDLEN with the cached descriptor ring base. */
+	if (pch->desc_phys && pch->desc_len) {
+		spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+		ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+		ltq_dma_w32(pctrl, pch->desc_phys, DMA_CDBA);
+		ltq_dma_w32(pctrl, pch->desc_len, DMA_CDLEN);
+		spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	}
+	pch->curr_desc = 0;
+	pch->prev_desc = 0;
+	pch->desc_configured = false;
+	return 0;
+}
+
+/*
+ * dma_chan_irq_enable / ltq_dma_chan_irq_enable — per AC-004-8 + AC-004-11.
+ * Writes DMA_CI_DEFAULT (= DMA_CI_EOP | DMA_CI_DESCPT) to the per-channel
+ * DMA_CIE — NOT DMA_CI_ALL (DUR/CHOFF/RDERR would generate spurious IRQs at
+ * high traffic). Then sets BIT(cn & 0x1f) in the top-level DMA_IRNEN
+ * (cn<=31) or DMA_IRNEN1 (cn>=32) so the GIC delivers the chained IRQ.
+ *
+ * Sub-4B deviation from AVM: AVM splits TX (DMA_CI_EOP only) vs RX (EOP |
+ * DESCPT) and handles top-level IRNEN in its irq_data chip ops. Sub-4B
+ * conflates both into one primitive per AC-004-8; this is the
+ * Sub-4B-required public API contract for non-irqdomain-managed callers.
+ */
+static void dma_chan_irq_enable(struct dmax_chan *pch)
+{
+	unsigned long flags;
+	u32 reg_off;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32(pctrl, DMA_CI_DEFAULT, DMA_CIE);
+	/* AC-004-11: chans >= 32 use the high-bank IRNEN1 register. */
+	reg_off = (pch->nr >= 32) ? DMA_IRNEN1 : DMA_IRNEN;
+	ltq_dma_w32_mask(pctrl, 0, BIT(pch->nr & 0x1f), reg_off);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+int ltq_dma_chan_irq_enable(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	dma_chan_irq_enable(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_irq_disable / ltq_dma_chan_irq_disable — inverse of irq_enable.
+ * Clears DMA_CIE (mask all per-channel IRQ sources) only.
+ *
+ * IG-086: do NOT clear the top-level DMA_IRNEN channel bit here. AVM's
+ * dma_chan_irq_disable (hdma.c:998-1007) writes ONLY DMA_CIE=0; the
+ * top-level IRNEN is owned exclusively by the genirq irqchip (set for ALL
+ * channels at dma_ctrl_init via devm_request_irq -> irq_unmask ->
+ * dma_enable_irq). Working AVM silicon therefore runs the DMA2TX controller
+ * with IRNEN=0x0000ffff (all 16 channel bits set) + per-channel CIE=0 on the
+ * CBM-managed egress channels. Our prior code added an IRNEN read-modify-
+ * write that cleared bit 5 (the eth0 CPU-TX egress ch5) — the ONE register
+ * divergence from working silicon on the entire DMA->PMAC->GSW-L p0 path
+ * (IG-085 live testbed diff: every other register byte-identical). Clearing
+ * CIE alone is sufficient to silence the channel (no IRQ source); leaving
+ * IRNEN set matches AVM exactly and cannot raise a spurious IRQ.
+ */
+static void dma_chan_irq_disable(struct dmax_chan *pch)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32(pctrl, 0, DMA_CIE);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+int ltq_dma_chan_irq_disable(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	dma_chan_irq_disable(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_open / ltq_dma_chan_open — AVM hdma.c:1020-1037 verbatim (per
+ * AC-004-3 "re-check against AVM hdma.c source"). Composition: chan_on +
+ * (for RX) irq_enable. TX channels intentionally do NOT enable IRQ at open
+ * time — AVM-verbatim contract preserved.
+ *
+ * Per AC-004-3 ltq_dma_chan_open is composed FROM the on / irq_enable
+ * primitives (not re-implemented inline) so a single point of truth for
+ * the chan_on / irq_enable semantics is preserved.
+ */
+static void dma_chan_open(struct dmax_chan *pch)
+{
+	/* chan on, then enable irq (RX only — AVM verbatim). */
+	dma_chan_on(pch);
+	if (dma_chan_rx(pch))
+		dma_chan_irq_enable(pch);
+}
+
+int ltq_dma_chan_open(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch || !pch->desc_configured))
+		return -EINVAL;
+	dma_chan_open(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_close / ltq_dma_chan_close — AVM hdma.c:1039-1054 verbatim.
+ * Composition: chan_off + irq_disable (unconditional for both directions
+ * — TX too, since TX may have been later promoted to IRQ-enabled via the
+ * direct ltq_dma_chan_irq_enable path).
+ */
+static void dma_chan_close(struct dmax_chan *pch)
+{
+	dma_chan_off(pch);
+	dma_chan_irq_disable(pch);
+}
+
+int ltq_dma_chan_close(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	dma_chan_close(pch);
+	return 0;
+}
+
+/*
+ * dma_chan_pkt_drop_cfg / ltq_dma_chan_pkt_drop_cfg — AVM hdma.c:1056-1085
+ * verbatim. Toggles DMA_CCTRL_PDEN = BIT(23) on the channel per AC-004-7
+ * (distinct from DMA_PCTRL_PDEN = BIT(6) which is port-level). TX channels
+ * silently no-op — packet-drop is meaningful only on the RX side where
+ * silicon needs a fallback when the descriptor ring overflows.
+ */
+static void dma_chan_pkt_drop_cfg(struct dmax_chan *pch, int enable)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	if (dma_chan_tx(pch))
+		return;
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	if (enable)
+		ltq_dma_w32_mask(pctrl, 0, DMA_CCTRL_PDEN, DMA_CCTRL);
+	else
+		ltq_dma_w32_mask(pctrl, DMA_CCTRL_PDEN, 0, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+int ltq_dma_chan_pkt_drop_cfg(u32 chan, int enable)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	dma_chan_pkt_drop_cfg(pch, enable);
+	mutex_lock(&pch->ch_lock);
+	pch->pden = enable;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_pktsize_cfg — AVM hdma.c:1134-1147 verbatim. Stores
+ * pkt_size in the per-channel slot; the silicon honours this at
+ * data_buf_alloc / descriptor-seed time.
+ */
+int ltq_dma_chan_pktsize_cfg(u32 chan, size_t pktsize)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	if (pktsize > DMA_MAX_PKT_SIZE)
+		return -EINVAL;
+	mutex_lock(&pch->ch_lock);
+	pch->pkt_size = (int)pktsize;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+
+/*
+ * dma_chan_byte_offset_cfg / ltq_dma_chan_byte_offset_cfg — AVM
+ * hdma.c:1241-1278 verbatim. boff_len > DMA_CHAN_BOFF_MAX (255) disables
+ * the feature; valid 1..255 enables and writes the length to DMA_C_BOFF.
+ * V2.2 hardware doesn't have DMA_C_BOFF — returns -EPERM there.
+ */
+static void dma_chan_byte_offset_cfg(struct dmax_chan *pch, u32 boff_len)
+{
+	u32 val = 0;
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	if (boff_len == 0 || boff_len > DMA_CHAN_BOFF_MAX) {
+		ltq_dma_w32_mask(pctrl, DMA_C_BOFF_EN | DMA_C_BOFF_BOF_LEN,
+				 0, DMA_C_BOFF);
+	} else {
+		val = SM(boff_len, DMA_C_BOFF_BOF_LEN) | DMA_C_BOFF_EN;
+		ltq_dma_w32(pctrl, val, DMA_C_BOFF);
+	}
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+int ltq_dma_chan_byte_offset_cfg(u32 chan, u32 boff_len)
+{
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+
+	pctrl = dma_chan_get_controller(pch);
+	if (pctrl->ver <= DMA_VER_22)
+		return -EPERM;
+
+	dma_chan_byte_offset_cfg(pch, boff_len);
+
+	mutex_lock(&pch->ch_lock);
+	pch->boff_len = boff_len;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_class_cfg — Sub-4B-authored public surface wrapping the
+ * private AVM dma_chan_set_class helper (AVM hdma.c:661-683). Programs the
+ * 5-bit CCTRL_CLASS / CCTRL_CLASSH field used by GSWIP-3.0 traffic classes.
+ * V2.2 silicon does NOT have the class field — returns -EPERM there.
+ * cls > 31 (5-bit max) returns -EINVAL.
+ */
+int ltq_dma_chan_class_cfg(u32 chan, u32 cls)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	return dma_chan_set_class(pch, cls);
+}
+
+/*
+ * ltq_dma_chan_desc_alloc — per AC-004-6. Allocates desc_num *
+ * pctrl->desc_size bytes (the silicon descriptor size — 16 bytes for the
+ * 4-DW format Sub-4B always binds) via dma_alloc_coherent (NOT AVM's
+ * dmam_alloc_coherent — Sub-4B's ltq_dma_chan_desc_free explicitly
+ * reverses with dma_free_coherent per AC-004-6).
+ *
+ * Sub-4B deviation from AVM: AVM also invokes dma_chan_desc_hw_cfg to
+ * program CDBA / CDLEN here. Per AS-013 Sub-4 / Sub-6 own descriptor
+ * seeding — they invoke ltq_dma_chan_desc_cfg separately after seeding
+ * descriptor contents. desc_alloc only allocates memory.
+ *
+ * AVM's pch->opt allocation (used by the dma_chan_read / write paths) is
+ * also skipped — Sub-4B does not engage those AVM data paths (CBM uses
+ * its own buffer management).
+ */
+int ltq_dma_chan_desc_alloc(u32 chan, u32 desc_num)
+{
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+	dma_addr_t phys;
+	void *vaddr;
+	size_t bytes;
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+
+	if (desc_num == 0 || desc_num > DMA_MAX_DESC_NUM) {
+		dev_err(pctrl->dev,
+			"%s: invalid desc_num %u (max %u)\n",
+			pch->device_id ? pch->device_id : "(unnamed)",
+			desc_num, DMA_MAX_DESC_NUM);
+		return -EINVAL;
+	}
+
+	if (pch->desc_base) {
+		dev_err(pctrl->dev,
+			"%s chan %d desc already allocated\n",
+			pch->device_id ? pch->device_id : "(unnamed)",
+			pch->nr);
+		return -EINVAL;
+	}
+
+	bytes = (size_t)desc_num * pctrl->desc_size;
+	vaddr = dma_alloc_coherent(pctrl->dev, bytes, &phys, GFP_KERNEL);
+	if (!vaddr)
+		return -ENOMEM;
+
+	memset(vaddr, 0, bytes);
+	pch->desc_base = (u32)(uintptr_t)vaddr;
+	pch->desc_phys = phys;
+	pch->desc_len = desc_num;
+	pch->curr_desc = 0;
+	pch->prev_desc = 0;
+	dev_dbg(pctrl->dev,
+		"%s chan %d desc_base=0x%08x desc_phys=0x%llx desc_len=%u\n",
+		dma_get_name_by_cid(pctrl->cid), pch->nr, pch->desc_base,
+		(unsigned long long)pch->desc_phys, desc_num);
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_desc_free — per AC-004-6. Reverses ltq_dma_chan_desc_alloc
+ * with dma_free_coherent. Idempotent: returns 0 if desc_base is already
+ * NULL (e.g. double-free or free-before-alloc). Always clears the slot
+ * back to a zero state so a subsequent desc_alloc can re-bind.
+ */
+int ltq_dma_chan_desc_free(u32 chan)
+{
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+	size_t bytes;
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+
+	/* Idempotent: AC-004-6 — graceful no-op on NULL desc_base. */
+	if (!pch->desc_base)
+		return 0;
+
+	bytes = (size_t)pch->desc_len * pctrl->desc_size;
+	dma_free_coherent(pctrl->dev, bytes, (void *)(uintptr_t)pch->desc_base,
+			  pch->desc_phys);
+	pch->desc_base = 0;
+	pch->desc_phys = 0;
+	pch->desc_len = 0;
+	pch->curr_desc = 0;
+	pch->prev_desc = 0;
+	pch->desc_configured = false;
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_data_buf_alloc — AVM hdma.c:1887-1906 verbatim. Walks the
+ * descriptor ring and uses pch->alloc to populate the per-desc data
+ * buffer. Returns -EINVAL if no allocator callback has been registered —
+ * Sub-4B's primary callers (Sub-3 datapath / Sub-4 CBM) do their own
+ * buffer management per AS-013, so this path is largely vestigial here.
+ */
+int ltq_dma_chan_data_buf_alloc(u32 chan)
+{
+	int i;
+	int byte_offset;
+	int ret;
+	char *buffer;
+	struct dma_rx_desc *rx_desc_p;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+	struct dma_ctrl *pctrl;
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+	if (!pch->alloc)
+		return -EINVAL;
+	if (!pch->desc_base || pch->desc_len <= 0)
+		return -EINVAL;
+
+	/*
+	 * IG-197: the AS-013 "documented-by-omission" stub that lived here
+	 * is REPLACED by the AVM walk (dma_rx_chan_data_buf_4dws_alloc, 4.9
+	 * hdma.c:1663-1702, verbatim incl. the wmb ordering). Two pieces
+	 * 4.9 does inside desc_alloc are folded in here because our
+	 * ltq_dma_chan_desc_alloc deliberately skips them (its CBM callers
+	 * self-seed + self-program): the opt[] array (4.9 hdma.c:1615-1618)
+	 * and the CDBA/CDLEN hardware programming (dma_chan_desc_hw_cfg,
+	 * 4.9 hdma.c:790-802 — done FIRST, while the ring is still
+	 * all-CPU-owned, so silicon never sees a half-seeded ring).
+	 */
+	if (!pch->opt) {
+		pch->opt = devm_kzalloc(pctrl->dev,
+					(size_t)pch->desc_len * sizeof(void *),
+					GFP_KERNEL);
+		if (!pch->opt)
+			return -ENOMEM;
+	}
+	ret = ltq_dma_chan_desc_cfg(chan, pch->desc_phys, pch->desc_len);
+	if (ret)
+		return ret;
+
+	/*
+	 * IG-197c: map the ring with ioremap, NOT KSEG1 arithmetic and NOT
+	 * the dma_alloc_coherent vaddr. This platform has RAM at phys
+	 * 0x20000000+ (PHYS_OFFSET) so allocator pages sit ABOVE the plain
+	 * 512 MB KSEG1 window: the IG-197b CKSEG1ADDR path could never
+	 * work (its guard aborted every boot — the silent no-seed of the
+	 * IG-198/199 boots), and the coherent-remap vaddr faulted in the
+	 * first IG-197 boot. ioremap of the phys is the battle-tested
+	 * pattern this tree already uses for exactly these addresses (the
+	 * IG-163 uncached window on the 0x23xxxxxx pool pages). Probe
+	 * context here, so ioremap may sleep. The mapping is kept (and
+	 * published for the IG-199 forensics rider, which runs in softirq
+	 * and must never ioremap).
+	 */
+	/*
+	 * IG-197d: access the ring via CKSEG1ADDR after all. History of
+	 * this address war, for the next reader:
+	 *   - boot 1 used the dma_alloc_coherent vaddr and faulted at
+	 *     0xC23AF00C: on this PHYS_OFFSET=0x20000000 platform the
+	 *     MIPS uncached-alias arithmetic lands at UNCAC_BASE + FULL
+	 *     phys (0xA0000000+0x223AF000 = KSEG2/vmalloc space, unmapped)
+	 *     instead of subtracting PHYS_OFFSET — the returned pointer is
+	 *     arithmetically wrong for RAM above 512 MB phys.
+	 *   - IG-197b's CKSEG1ADDR was CORRECT but its phys<0x20000000
+	 *     guard aborted every boot (RAM here IS at 0x20000000+).
+	 *   - IG-197c's ioremap returned NULL: MIPS ioremap refuses
+	 *     page-allocator RAM (the IG-163 precedent works only because
+	 *     the CBM pools are reserved-memory).
+	 * The GRX500 aliases DDR at phys 0x00000000 (dual-view — the EVA
+	 * ramboot itself loads the kernel through the alias), so
+	 * CKSEG1ADDR(phys) = 0xA0000000|phys maps the ALIAS of the native
+	 * 0x2xxxxxxx page: an uncached window onto the very same DRAM.
+	 * Guard: accept exactly the native DDR window.
+	 */
+	if (pch->desc_phys < 0x20000000ULL ||
+	    pch->desc_phys >= 0x28000000ULL) {
+		dev_err(pctrl->dev,
+			"IG-197: desc_phys 0x%llx outside native DDR window — aborting seed\n",
+			(unsigned long long)pch->desc_phys);
+		return -EINVAL;
+	}
+	g_ig197_ring_va = (void __iomem *)
+		CKSEG1ADDR((unsigned long)pch->desc_phys);
+
+	for (i = 0; i < pch->desc_len; i++) {
+		rx_desc_p = (struct dma_rx_desc *)g_ig197_ring_va + i;
+		buffer = pch->alloc(pch->pkt_size, &byte_offset, &pch->opt[i]);
+		if (!buffer) {
+			dev_err(pctrl->dev, "No enough memory for %s\n",
+				pch->device_id ? pch->device_id : "(unnamed)");
+			return -ENOMEM;
+		}
+		rx_desc_p->data_pointer = dma_map_single(pctrl->dev, buffer,
+							 pch->pkt_size,
+							 DMA_FROM_DEVICE);
+		if (dma_mapping_error(pctrl->dev, rx_desc_p->data_pointer)) {
+			dev_err(pctrl->dev, "%s DMA map failed\n", __func__);
+			pch->free(buffer, pch->opt[i]);
+			return -ENOMEM;
+		}
+		rx_desc_p->status.all = 0;
+		rx_desc_p->status.field.sop = 1;
+		rx_desc_p->status.field.eop = 1;
+		rx_desc_p->status.field.c = 0;
+		rx_desc_p->status.field.byte_offset = byte_offset;
+		rx_desc_p->status.field.data_len = pch->pkt_size;
+		/* Ensure data field ready before ownership change */
+		wmb();
+		rx_desc_p->status.field.own = DMA_OWN;
+		/* Ensure ownership changed before moving to next step */
+		wmb();
+	}
+
+	pr_info("hdma: %s ch%d rx ring seeded: %d desc x %d B, cdba=0x%08llx\n",
+		dma_get_name_by_cid(pctrl->cid), pch->nr, pch->desc_len,
+		pch->pkt_size, (unsigned long long)pch->desc_phys);
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_data_buf_free — counterpart to data_buf_alloc. Same
+ * caveats: Sub-4B's primary callers manage their own buffers per AS-013.
+ */
+int ltq_dma_chan_data_buf_free(u32 chan)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	if (!pch->free)
+		return 0;
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_pseudo_irq_handler_callback_cfg — AVM hdma.c:2107-2122
+ * verbatim. Records the per-channel intr_handler + opaque priv on the
+ * per-channel slot; do_dma_tasklet (ST-003) invokes the registered
+ * handler from softirq context, with explicit NULL-check per AC-003-11.
+ */
+int ltq_dma_chan_pseudo_irq_handler_callback_cfg(u32 chan,
+						 intr_handler_t handler,
+						 void *priv)
+{
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!handler || !pch))
+		return -EINVAL;
+
+	mutex_lock(&pch->ch_lock);
+	pch->intr_handler = handler;
+	pch->priv = priv;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+
+/*
+ * dma_chan_desc_cfg / ltq_dma_chan_desc_cfg — per AC-004-5. AVM
+ * hdma.c:809-845 with the Sub-4B-mandated explicit desc_num range check
+ * up front (-EINVAL on desc_num == 0 or desc_num > DMA_MAX_DESC_NUM
+ * (4095) per the 12-bit DMA_CDLEN field).
+ *
+ * The DMA_CS-select-before-CDBA/CDLEN-write ordering is silicon-mandatory
+ * — silicon requires DMA_CS to point at the channel before per-channel
+ * register writes take effect. See review_focus #3.
+ */
+int ltq_dma_chan_desc_cfg(u32 chan, dma_addr_t desc_base, int desc_num)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+
+	/* AC-004-5: DMA_CDLEN is 12 bits — desc_num must fit. */
+	if (desc_num <= 0 || desc_num > DMA_MAX_DESC_NUM) {
+		dev_err(pctrl->dev,
+			"%s: desc_num %d out of range (1..%u)\n",
+			pch->device_id ? pch->device_id : "(unnamed)",
+			desc_num, DMA_MAX_DESC_NUM);
+		return -EINVAL;
+	}
+
+	mutex_lock(&pch->ch_lock);
+	pch->flags |= DMA_HW_DESC;
+	pch->desc_len = desc_num;
+	pch->desc_phys = desc_base;
+	mutex_unlock(&pch->ch_lock);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32(pctrl, desc_base, DMA_CDBA);
+	ltq_dma_w32(pctrl, desc_num, DMA_CDLEN);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+
+	pch->desc_configured = true;
+	return 0;
+}
+
+/*
+ * ltq_dma_chan_get_curr_desc_addr — returns the physical address of the
+ * descriptor currently being processed by silicon on the selected
+ * channel. Reads DMA_CDPTNR (the silicon current-descriptor pointer
+ * register) after DMA_CS-select.
+ *
+ * No AVM analogue: AVM's debugfs surface uses DMA_CDPTNR as a raw reg
+ * dump (AVM hdma.c:3230). Sub-4B promotes the read into a public API so
+ * Sub-3 / Sub-6 can compute per-descriptor offsets without re-deriving
+ * the silicon-managed cursor.
+ *
+ * Returns the dma_addr_t value read from DMA_CDPTNR, or 0 on lookup
+ * failure (callers must check pch validity via prior ltq_request_dma).
+ */
+dma_addr_t ltq_dma_chan_get_curr_desc_addr(u32 chan)
+{
+	unsigned long flags;
+	dma_addr_t cur;
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return 0;
+	pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	cur = (dma_addr_t)ltq_dma_r32(pctrl, DMA_CDPTNR);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	return cur;
+}
+
+/*
+ * AVM hdma.c:4406-4409 with the compatible renamed to "lantiq,dma-xrx500"
+ * per CQ-003 B (v6.18 naming convention). The "lantiq,dma0-grx500" alias
+ * is absent — DMA0 is out of scope per AS-008 / AC-002-1. The AVM-legacy
+ * "lantiq,dma-grx500" compatible is also absent (renamed wholesale).
+ */
+static const struct of_device_id ltq_dma_match[] = {
+	{ .compatible = "lantiq,dma-xrx500" },
+	{},
+};
+
+static struct platform_driver ltq_dma_driver = {
+	.probe = ltq_dma_probe,
+	.driver = {
+		.name = "dma-xrx500",
+		.of_match_table = ltq_dma_match,
+	},
+};
+
+/*
+ * AVM hdma.c:4420-4424 verbatim. postcore_initcall runs BEFORE
+ * switch-api / datapath / ethernet probes per architectural_constraint
+ * #5, so the per-DT-node ltq_dma_probe() fires during
+ * of_platform_populate's postcore-time pass — ensuring the controllers
+ * are bound when later subsystems (Sub-3 datapath, Sub-4 cqm, Sub-6
+ * intel_xrx500) try to allocate channels.
+ *
+ * Per AC-002-5: ltq_dma_init does ONLY platform_driver_register and
+ * returns its result; no module_exit (DMA controller is built-in, never
+ * unloaded). The per-DT-node probe fires later — AS-004.
+ */
+static int __init ltq_dma_init(void)
+{
+	return platform_driver_register(&ltq_dma_driver);
+}
+postcore_initcall(ltq_dma_init);
+
+/*
+ * Reverse-engineering context (port7_channels[] derivation):
+ *   (a) DMA_CTRL bit 29: the stock firmware's "RX-DMA mode enable" is
+ *       the DMA_DBG_P2D_RME debug-state bit at DMA_PCTRL[29], NOT a
+ *       writable bit in DMA_CTRL — see hdma_regs.h DMA_PCTRL section
+ *       comment and AVM hdma.c:140 (DMA_DBG_P2D_RME).
+ *   (b) DMA_CPOLL bit 7: the stock firmware's "bit 7 enable" is an
+ *       artifact of the CPOLL_CNT field encoding (bits 4-15); the
+ *       standalone CPOLL enable is DMA_CPOLL_EN at bit 31 (AVM
+ *       hdma.c:58-61).
+ *
+ *   (c) AS-013 boundary: hdma_port_enable() opens DMA channels and registers
+ *       a placeholder descriptor ring via ltq_dma_chan_desc_alloc +
+ *       ltq_dma_chan_desc_cfg (required because ltq_dma_chan_open's
+ *       pch->desc_configured guard rejects a never-cfg'd channel). It does
+ *       NOT touch per-descriptor DW2/DW3 bitfields — descriptor seeding
+ *       (DW2 data_ptr + DW3 own/sop/eop/byte_offset/len) is Sub-4 CBM's
+ *       responsibility inside init_cbm_eqm_dma_port (cqm/grx500/cbm_dma.c).
+ *
+ * Sub-6 sequencing (per parent task description):
+ *   hdma_port_enable(port_id) -> cbm_dp_enable() -> dp_register_subif()
+ */
+
+/*
+ * port7_channels[] derivation (CQ-001 C / AC-005-3 / AC-005-4):
+ *
+ *   AVM cbm_config.c:40-49 (DEQUEUE, TX-egress) — CBM tmu_port=7 row:
+ *     { .type = DQM_DMA_TYPE, .tmu_port = 7, .tmu_queue = 17,
+ *       .tmu_queue_nos = 1, .dma_ctrl = 2, .dma_chan = 2, ... }
+ *   AVM cbm.c:4514-4539 (dequeue_dma_port_init):
+ *     sprintf(dma_ctrl, "DMA%dTX", dma_hw_num);
+ *     chan = _DMA_C(cqm_dma_get_controller(dma_ctrl), 0, dma_chan_num);
+ *   Substituting (dma_hw_num=2, dma_chan_num=2) yields
+ *     _DMA_C(DMA2TX_controller, 0, 2) == lantiq_dmax.h:303
+ *     DMA2TX_CBM_P7_CLASS2 — empirical (not name-heuristic) evidence
+ *     that DMA2TX channel 2 services CBM port 7 TX-egress.
+ *
+ *   AVM cbm_config.c:289-306 (ENQUEUE, RX-admit) lists two CBM tmu_port=7
+ *   entries: _DMA_C(DMA1RX, 0, 0) (std buf) and _DMA_C(DMA1RX, 0, 16)
+ *   (jumbo). These do NOT match the lantiq_dmax.h macro names
+ *   (DMA1RX_TMU_CLASS0 / DMA1RX_CBM_P8_CLASS16_JUMBO) and are intentionally
+ *   omitted from port7_channels[]: Sub-6 ndo_open is expected to call
+ *   ltq_request_dma directly for the RX-admit channels alongside its CBM
+ *   admit-path configuration. To add them later, append:
+ *     { .cid = DMA1RX, .pid = DMA1RX_PORT, .nid = DMA_CHANNEL_0, ... },
+ *     { .cid = DMA1RX, .pid = DMA1RX_PORT, .nid = DMA_CHANNEL_16, ... },
+ *   with citation cbm_config.c:289-306 + cbm.c:4459-4496.
+ *
+ * AC-005-3: explicit (u32 pid) column (not a ternary on DMA1RX_PORT vs
+ * DMA2TX_PORT — both happen to be 0, but the column form future-proofs
+ * against a non-zero PORT enum value).
+ */
+struct port7_chan_desc {
+	u32 cid;
+	u32 pid;
+	u32 nid;
+	const char *label;
+	/*
+	 * IG-041: CBM dequeue port this channel serves, or 0 for the legacy
+	 * software-ring path. When non-zero the channel is CBM-managed: its
+	 * descriptor base points at the CBM DQM descriptor window (MMIO) where
+	 * the CBM writes the dequeued frame's buffer pointer + OWN bit at run
+	 * time — NOT a dma_alloc_coherent software ring.
+	 */
+	u32 cbm_deq;
+};
+
+static const struct port7_chan_desc port7_channels[] = {
+	{ .cid = DMA2TX, .pid = DMA2TX_PORT, .nid = DMA_CHANNEL_2,
+	  .label = "DMA2TX_CBM_P7_CLASS2", .cbm_deq = 0 },
+};
+
+/*
+ * IG-039: eth0 / LAN1 (dp_port_id=5) egresses via CBM dequeue port 10 ->
+ * DMA2TX channel 5 -> PMAC port 5 -> GPHY5 RGMII, per AVM epg_lookup_table
+ * (dp5 -> CBM_P10, cbm.c:568) + DT DQ10 cbm-config <10 20 2 5 1 2> + corpus
+ * working_theory.md:112. The Sub-4B port7 table opened DMA2TX channel 2
+ * (CBM_P7 = the dp2/LAN4 binding), so eth0 frames egressed the wrong
+ * physical channel. Channel = deq_port - 5: deq10 -> CLASS5.
+ */
+static const struct port7_chan_desc port10_channels[] = {
+	{ .cid = DMA2TX, .pid = DMA2TX_PORT, .nid = DMA_CHANNEL_5,
+	  .label = "DMA2TX_CBM_P10_CLASS5", .cbm_deq = 10 },
+};
+
+/*
+ * IG-041: CBM DQM descriptor-window physical layout (the window the DMA2TX
+ * channel must read dequeue descriptors from for a CBM-managed egress port).
+ * AVM setup_DMA_channel (cqm/grx500/cbm.c:4416) configures the channel with
+ *   ltq_dma_chan_desc_cfg(chan,
+ *       RPHYSADDR(CBM_DMADESC_BASE + CBM_DQM_DMA_DESC(deq, 0)), 2)
+ * CBM_DMADESC_BASE is the DT "dma_desc" window (reg idx 11, phys 0x1e500000);
+ * CBM_DQM_DMA_DESC(deq,0) = DESC0_0_EGP_5 (0x40000) + (deq-5)*0x1000. AVM
+ * uses 2 ping-pong descriptors per dequeue port.
+ */
+#define CBM_DMADESC_PHYS_BASE   0x1e500000U  /* DT cbm dma_desc window */
+#define CBM_DESC0_0_EGP_5_OFF   0x40000U     /* cbm_regs.h DESC0_0_EGP_5 */
+#define CBM_DQM_DESC_NUM        2U           /* AVM: 2 ping-pong descriptors */
+#define CBM_DQM_DESC_PHYS(deq) \
+	((dma_addr_t)(CBM_DMADESC_PHYS_BASE + CBM_DESC0_0_EGP_5_OFF + \
+		      ((u32)((deq) - 5) * 0x1000U)))
+
+/*
+ * hdma_port_enable() — Sub-6-facing wrapper, no AVM analogue (CQ-001 C).
+ *
+ * The ONLY new (non-AVM-verbatim) public function in the Sub-4B TU set.
+ * Opens the DMA channel(s) listed in port7_channels[] above. Called from
+ * Sub-6 ndo_open BEFORE cbm_dp_enable() / dp_register_subif().
+ *
+ * Contract (AC-005-1 / AC-005-2 / AC-005-8):
+ *   port_id == 7: per port7_channels[] entry, the wrapper drives
+ *                 ltq_request_dma -> ltq_dma_chan_desc_alloc ->
+ *                 ltq_dma_chan_desc_cfg -> ltq_dma_chan_open. The
+ *                 desc_alloc + desc_cfg pair installs a HDMA_PORT_DESC_NUM
+ *                 placeholder ring so ltq_dma_chan_open's
+ *                 pch->desc_configured WARN_ON guard is satisfied. Sub-4
+ *                 CBM later overwrites the descriptor contents and Sub-6
+ *                 owns the disable path; no rollback on failure.
+ *   port_id != 7: -EINVAL. Narrow scope per task title 'CBM EQM port 7
+ *                 admit'; no hdma_port_disable wrapper is added.
+ */
+#define HDMA_PORT_DESC_NUM 32
+
+/*
+ * IG-061: once the CBM-managed DMA2TX egress channel (port 10 / ch5) is armed,
+ * keep it armed for the device lifetime — AVM opens it ONCE in setup_DMA_channel
+ * at probe (cbm.c:5660, right after the EQM/DQM controllers go live) and never
+ * toggles it. Our port previously re-ran desc_cfg/chan_open on every netifd
+ * bridge-enslavement ndo_stop->ndo_open cycle; that left the DQM->DMA2TX D2P
+ * "descriptor ready / OWN" handshake stale — the channel reports ON but
+ * D2P[REQ]=0 and the DQM-reconstructed egress descriptor stays data_len=0/own=0
+ * (IG-060 proved the upstream TMU PPT BDYL=178 is correct, so the loss is here).
+ */
+static bool g_hdma_port10_armed;
+
+/*
+ * IG-062: CBM DQM egress-port (re-)arm, exported from cqm/grx500/cbm_dma.c.
+ * Re-zeros the DQM egress descriptors (own=0/data_len=0) and re-writes
+ * CFG_DMA_EGP (DQREQ|DQPCEN|EPMAP). Called immediately before the DMA2TX
+ * channel open so the DQM->DMA2TX binding is fresh at the channel-on instant,
+ * matching AVM's contiguous setup_dqm_dma_desc + CFG arm + chan_on (cbm.c:5660).
+ */
+extern int init_cbm_dqm_dma_port(int dqp);
+
+/*
+ * ===========================================================================
+ * IG-067 — SOFTWARE-MANAGED DMA2TX TX PATH (workaround for the silicon
+ * CBM-DQM empty-descriptor gate).
+ * ===========================================================================
+ *
+ * #4 (IG-066) proved on hardware that the CBM DQM dequeues every CPU-TX PDU
+ * (dqpc tracks eqpc) but writes the DMA2TX ch5 egress descriptor own=0/c=1/
+ * data_len=0 (an empty "complete, CPU-owned" descriptor) — with the DQM config
+ * byte-identical to AVM (8 audits). The DMA channel itself WORKS (it reads +
+ * processes the descriptor, underruns on its emptiness) and the PMAC is never
+ * reached. PMAC0 routes egress by DMA-channel index (nTxDmaChanId=5 -> GPHY5,
+ * gsw_pmac_ig_cfg default header), independent of who built the descriptor.
+ *
+ * So bypass the CBM EQM/DQM entirely for CPU TX: drive DMA2TX ch5 from a
+ * software own-bit ring. The critical, easily-missed requirement is per-channel
+ * SOFTWARE-POLL mode (DMA_C_SWPOLL): it takes ch5 off the controller-global
+ * CH_FL flow-control engine that otherwise waits forever on the dead DQM's D2P
+ * request (the exact reason a naive SW ring, IG-040, underran identically).
+ *
+ * Anti-hang vs IG-040: (1) ch5 CDBA points at our private dma_alloc_coherent
+ * ring, NOT the CBM DQM window 0x1e545000; (2) frames live in a private
+ * coherent buffer pool, never an FSQM segment; (3) the CBM EQM-enqueue path is
+ * not used for these frames; (4) SW-poll is configured before the channel is
+ * turned on. Caller (ndo_start_xmit) serialises hdma_swtx_xmit under tx_lock.
+ */
+
+/* AVM ltq_dma_chan_sw_poll_cfg (hdma.c:1306-1364) — per-channel SW-poll. */
+static void dma_chan_sw_poll_cfg(struct dmax_chan *pch, int enable)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	/* MUX always on; EN (bit31) gates SW-poll on/off. */
+	ltq_dma_w32_mask(pctrl, 0, DMA_C_SWPOLL_MUX, DMA_C_SWPOLL);
+	if (enable)
+		ltq_dma_w32_mask(pctrl, 0, DMA_C_SWPOLL_EN, DMA_C_SWPOLL);
+	else
+		ltq_dma_w32_mask(pctrl, DMA_C_SWPOLL_EN, 0, DMA_C_SWPOLL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+int ltq_dma_chan_sw_poll_cfg(u32 chan, int enable)
+{
+	struct dma_ctrl *pctrl;
+	struct dmax_chan *pch = dma_chan_l2p(chan);
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+	if (pctrl->ver <= DMA_VER_22)
+		return -EPERM;
+	dma_chan_sw_poll_cfg(pch, enable);
+	mutex_lock(&pch->ch_lock);
+	pch->sw_poll = enable;
+	mutex_unlock(&pch->ch_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ltq_dma_chan_sw_poll_cfg);
+
+/*
+ * ===========================================================================
+ * IG-068 — DMA1TX<->DMA2RX PERIPHERAL-TO-PERIPHERAL (P2P) BRIDGE
+ * ===========================================================================
+ *
+ * Faithful port of AVM hdma.c dma_chan_p2p_cfg (:1545), dma_chan_global_buf_
+ * len_cfg (:1564), dma_chan_desc_hw_cfg (:790), dma_p2p_cfg (:2291) and
+ * ltq_dma_p2p_cfg (:2313). The CBM setup_DMA_p2p (cqm/grx500/cbm.c) drives
+ * this to wire the GSWIP-R RX path (DMA2RX ch0..3) into the LAN-switch TX
+ * path (DMA1TX ch0..3): the TX channel inherits the RX channel's descriptor
+ * ring, enables P2P-copy (DMA_CCTRL_P2PCPY) and a global buffer length so the
+ * silicon copies each RX-DMA'd frame straight to the TX-DMA peripheral with
+ * no CPU/DRAM round trip.
+ *
+ * Bridge to the Sub-4B desc-alloc split (see ltq_dma_chan_desc_alloc, AS-013):
+ * our ltq_dma_chan_desc_alloc only allocates the ring — it deliberately does
+ * NOT call dma_chan_desc_hw_cfg (CDBA/CDLEN program + desc_configured=true)
+ * the way AVM's dma_chan_desc_alloc does. dma_p2p_cfg therefore programs the
+ * RX channel's CDBA/CDLEN here (matching what AVM's desc_alloc would have done
+ * before dma_p2p_cfg ran) so the RX channel reaches desc_configured=true and
+ * turn_on_DMA_p2p's ltq_dma_chan_on(rx) passes the WARN_ON(!desc_configured)
+ * guard (identical to AVM hdma.c:751).
+ */
+
+/* AVM hdma.c:790-802 verbatim. Programs CDBA/CDLEN + sets desc_configured. */
+static void dma_chan_desc_hw_cfg(struct dmax_chan *pch, dma_addr_t desc_base,
+				 int desc_num)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32(pctrl, desc_base, DMA_CDBA);
+	ltq_dma_w32(pctrl, desc_num, DMA_CDLEN);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	pch->desc_configured = true;
+}
+
+/* AVM hdma.c:1545-1562 verbatim. TX-only: P2P-copy bit in DMA_CCTRL. */
+static void dma_chan_p2p_cfg(struct dmax_chan *pch, int enable)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	if (dma_chan_rx(pch)) {
+		dev_err(pctrl->dev,
+			"RX channel has no need to configure P2P bit\n");
+		return;
+	}
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	if (enable)
+		ltq_dma_w32_mask(pctrl, 0, DMA_CCTRL_P2PCPY, DMA_CCTRL);
+	else
+		ltq_dma_w32_mask(pctrl, DMA_CCTRL_P2PCPY, 0, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+/* AVM hdma.c:1564-1580 verbatim. TX-only: global buffer length in DMA_CGBL. */
+static void dma_chan_global_buf_len_cfg(struct dmax_chan *pch, int data_len)
+{
+	unsigned long flags;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	if (dma_chan_rx(pch)) {
+		dev_err(pctrl->dev,
+			"RX channel has no need to configure P2P bit\n");
+		return;
+	}
+	if (data_len < 0 || data_len > DMA_MAX_PKT_SIZE)
+		return;
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32(pctrl, data_len, DMA_CGBL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+/*
+ * dma_p2p_cfg — AVM hdma.c:2291-2311. Copies the RX channel's descriptor
+ * ring onto the TX channel, enables P2P-copy on TX and configures the TX
+ * global buffer length.
+ *
+ * IG-068 bridge (see block comment above): the leading dma_chan_desc_hw_cfg
+ * on the RX channel (rch) is the only deviation from AVM-verbatim — AVM's
+ * ltq_dma_chan_desc_alloc already programmed RX CDBA/CDLEN; ours did not, so
+ * we do it here. This both arms the RX silicon ring and sets rch->
+ * desc_configured = true (required for turn_on_DMA_p2p's ltq_dma_chan_on(rx)).
+ */
+static void dma_p2p_cfg(struct dmax_chan *rch, struct dmax_chan *tch)
+{
+	/*
+	 * Assume RX and TX has been configured using
+	 * DMA descriptor and data buffer functions.
+	 * TX has to be released its old buffer for default cases.
+	 */
+	if (WARN_ON(rch->desc_len == 0))
+		return;
+	/* IG-068 bridge: program the RX ring HW (CDBA/CDLEN) + desc_configured. */
+	dma_chan_desc_hw_cfg(rch, rch->desc_phys, rch->desc_len);
+	mutex_lock(&tch->ch_lock);
+	tch->desc_len = rch->desc_len;
+	tch->desc_base = rch->desc_base;
+	tch->desc_phys = rch->desc_phys;
+	tch->pkt_size = rch->pkt_size;
+	tch->p2pcpy = 1;
+	tch->global_buffer_len = tch->pkt_size;
+	mutex_unlock(&tch->ch_lock);
+	dma_chan_desc_hw_cfg(tch, tch->desc_phys, tch->desc_len);
+	dma_chan_p2p_cfg(tch, 1);
+	dma_chan_global_buf_len_cfg(tch, tch->global_buffer_len);
+}
+
+/* AVM hdma.c:2313-2323 verbatim. Public entry used by CBM setup_DMA_p2p. */
+int ltq_dma_p2p_cfg(u32 rx_chan, u32 tx_chan)
+{
+	struct dmax_chan *rxch = dma_chan_l2p(rx_chan);
+	struct dmax_chan *txch = dma_chan_l2p(tx_chan);
+
+	if (WARN_ON((!rxch) || (!txch)))
+		return -EINVAL;
+	dma_p2p_cfg(rxch, txch);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ltq_dma_p2p_cfg);
+
+static void *g_swtx_bufpool;            /* coherent data-buffer pool */
+static dma_addr_t g_swtx_bufpool_phys;
+static int g_swtx_n;                    /* ring / pool slots */
+static int g_swtx_bufsz;                /* bytes per slot */
+static struct dmax_chan *g_swtx_pch;
+static bool g_swtx_inited;
+
+int hdma_swtx_init(u32 chan, int n, int buf_size)
+{
+	struct dmax_chan *pch;
+	struct dma_ctrl *pctrl;
+	int ret;
+
+	if (g_swtx_inited)
+		return 0;               /* armed once for the device lifetime */
+
+	ret = ltq_request_dma(chan, "DMA2TX_SWTX_CH5");
+	if (ret) {
+		pr_err("hdma_swtx_init: ltq_request_dma failed: %d\n", ret);
+		return ret;
+	}
+	pch = dma_chan_l2p(chan);
+	if (!pch) {
+		pr_err("hdma_swtx_init: dma_chan_l2p NULL\n");
+		return -EINVAL;
+	}
+	pctrl = dma_chan_get_controller(pch);
+	if (!pctrl)
+		return -EINVAL;
+
+	/* SW own-bit descriptor ring (NOT the CBM DQM window 0x1e545000). */
+	ret = ltq_dma_chan_desc_alloc(chan, n);
+	if (ret) {
+		pr_err("hdma_swtx_init: desc_alloc failed: %d\n", ret);
+		return ret;
+	}
+	ret = ltq_dma_chan_desc_cfg(chan, pch->desc_phys, n);
+	if (ret) {
+		pr_err("hdma_swtx_init: desc_cfg failed: %d\n", ret);
+		return ret;
+	}
+
+	/* Private coherent data-buffer pool, one slot per descriptor. */
+	g_swtx_bufpool = dma_alloc_coherent(pctrl->dev, (size_t)n * buf_size,
+					    &g_swtx_bufpool_phys, GFP_KERNEL);
+	if (!g_swtx_bufpool) {
+		pr_err("hdma_swtx_init: bufpool alloc failed\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * IG-067: plain channel setup with the ORIGINAL controller config (no
+	 * SWPOLL, no CH_FL/DS_FOD change). The CBM-managed path (CDBA=CBM window
+	 * 0x1e545000) DID fetch descriptors under this config (CIS DESCPT, CDPTNR
+	 * advancing); only the descriptor base differs here (our DRAM ring). This
+	 * isolates whether the silicon auto-polls a DRAM descriptor ring with the
+	 * working config + an own=1 descriptor — the two mode tweaks tried earlier
+	 * (SWPOLL, CH_FL/DS_FOD clear) both stopped the fetch entirely.
+	 */
+	ltq_dma_chan_irq_disable(chan);
+	ret = ltq_dma_chan_on(chan);
+	if (ret) {
+		pr_err("hdma_swtx_init: chan_on failed: %d\n", ret);
+		ltq_free_dma(chan);     /* don't leave ch5 wedged for retries */
+		return ret;
+	}
+
+	g_swtx_pch = pch;
+	g_swtx_n = n;
+	g_swtx_bufsz = buf_size;
+	g_swtx_inited = true;
+	pr_info("hdma_swtx_init: DMA2TX ch%d SW ring n=%d buf=%d desc_phys=0x%llx DMA_CTRL=0x%08x (CH_FL=%d FOD=%d CPOLL=0x%08x; CBM bypassed)\n",
+		pch->nr, n, buf_size, (unsigned long long)pch->desc_phys,
+		ltq_dma_r32(pctrl, DMA_CTRL),
+		!!(ltq_dma_r32(pctrl, DMA_CTRL) & DMA_CTRL_CH_FL),
+		!!(ltq_dma_r32(pctrl, DMA_CTRL) & DMA_CTRL_DS_FOD),
+		ltq_dma_r32(pctrl, DMA_CPOLL));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(hdma_swtx_init);
+
+int hdma_swtx_xmit(u32 chan, const void *data, int len)
+{
+	struct dmax_chan *pch = g_swtx_pch;
+	struct dma_ctrl *pctrl;
+	struct dma_tx_desc *ring, *tx;
+	dma_addr_t buf_phys;
+	void *buf;
+	unsigned long flags;
+	u32 cctrl;
+
+	if (!g_swtx_inited || !pch)
+		return -ENODEV;
+	if (len <= 0 || len > g_swtx_bufsz)
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+	ring = (struct dma_tx_desc *)(uintptr_t)pch->desc_base;
+
+	/* Reclaim descriptors the DMA finished (own back to CPU + complete). */
+	while (ring[pch->prev_desc].status.field.own == CPU_OWN &&
+	       ring[pch->prev_desc].status.field.c) {
+		memset(&ring[pch->prev_desc], 0, sizeof(*tx));
+		pch->prev_desc = (pch->prev_desc + 1) % pch->desc_len;
+	}
+
+	tx = &ring[pch->curr_desc];
+	if (tx->status.field.own == DMA_OWN)
+		return -EBUSY;          /* ring full */
+
+	buf = (u8 *)g_swtx_bufpool + (size_t)pch->curr_desc * g_swtx_bufsz;
+	buf_phys = g_swtx_bufpool_phys + (dma_addr_t)pch->curr_desc * g_swtx_bufsz;
+	memcpy(buf, data, len);
+
+	tx->dw1.all = 0;
+	tx->dw1.field.ep = 5;           /* GPHY5 */
+	tx->dw1.field.color = 1;        /* green */
+	tx->dw0.all = 0;
+	tx->data_pointer = buf_phys;    /* slot 8-aligned -> byte_offset 0 */
+	tx->status.all = 0;
+	tx->status.field.byte_offset = 0;
+	tx->status.field.data_len = len;
+	tx->status.field.sop = 1;
+	tx->status.field.eop = 1;
+	wmb();                          /* publish fields before ownership */
+	tx->status.field.own = DMA_OWN;
+	wmb();                          /* publish ownership before kick */
+
+	pch->curr_desc = (pch->curr_desc + 1) % pch->desc_len;
+
+	/* Ensure ON so SW-poll re-scans and picks up the new descriptor. */
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	cctrl = ltq_dma_r32(pctrl, DMA_CCTRL);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+	if (!(cctrl & DMA_CCTRL_ON))
+		ltq_dma_chan_on(chan);
+
+	return len;
+}
+EXPORT_SYMBOL_GPL(hdma_swtx_xmit);
+
+/*
+ * hdma_ig192_toe_dma3_reset — IG-192: reset-parity for the TOE DMA
+ * controller (AVM cid DMA3 @ ssx0+0x300000 = phys 0x1E300000).
+ *
+ * AVM 4.9 probes DMA3 unconditionally at boot (lantiq/xrx500.dtsi
+ * "dma3: dma@300000" in ssx0, no status=disabled) through the SAME
+ * ltq_dma_probe path as the LAN controllers: clk enable (GATE_TOE_CLK) ->
+ * DMA_ID read -> dma_cfg_init -> dma_ctrl_init (dma_ctrl_reset CTRL_RST +
+ * udelay, dma_ctrl_cfg, per-port dma_port_cfg, per-chan dma_chan_cfg with
+ * rst=DMA_CHAN_RST). Our port enables only the clock gate (IG-059 poke,
+ * GATE_TOE b22 per IG-158-A2) and never resets/configures the controller
+ * — a clocked-but-never-reset third master on the EQM DMA-ingress staging
+ * arbiter (IG-190 RANK 1). IG-190b proved clock-gate-OFF changes nothing;
+ * this is the untested reset half of the parity.
+ *
+ * Faithful replication of the AVM probe hardware effects using the same
+ * static primitives, with a hand-built pctrl carrying DMA3's DT props
+ * (4.9 lantiq/xrx500.dtsi:114-131): pkt-arb=2(pkt) burst=16 polling-cnt=24
+ * chan-fc=0 desc-fod=0 desc-in-sram=1 drb=0 byte-en=1 txendi=3 rxendi=3.
+ * The AVM dma_cfg_init DMA3/DMA4 "port_nrs--" quirk (AVM:4139) is
+ * replicated; ports/chans are then configured exactly as dma_ctrl_init's
+ * nested loop would. Deliberate non-hardware deltas: no devm (plain
+ * kzalloc, never freed — builtin), no request_irq / tasklet (channels
+ * stay DMA_CH_OFF and IRNEN bits are masked by dma_chan_cfg, so no IRQ
+ * can fire; AVM's request_irq writes no device register).
+ *
+ * Called from cbm_xrx500_probe AFTER the IG-059 CGU poke (clock on) and
+ * BEFORE cbm_hw_init arms the EQM IGP ports — AVM's macro-order.
+ */
+int hdma_ig192_toe_dma3_reset(void)
+{
+	struct dma_ctrl *pctrl = &ltq_dma_controller[DMA3];
+	struct dma_port *pport;
+	struct dmax_chan *pch;
+	u32 id;
+	int i, j;
+
+	if (pctrl->membase) {
+		pr_info("hdma: IG-192 TOE/DMA3 already initialized, skipping\n");
+		return 0;
+	}
+
+	pctrl->membase = ioremap(0x1E300000, 0x1000);
+	if (!pctrl->membase) {
+		pr_err("hdma: IG-192 TOE/DMA3 ioremap failed\n");
+		return -ENOMEM;
+	}
+	pctrl->cid = DMA3;
+	pctrl->name = dma_name[DMA3];
+	pctrl->dev = NULL;	/* no platform device — pr_* logging only */
+	spin_lock_init(&pctrl->ctrl_lock);
+	bitmap_zero(pctrl->dma_int_status, MAX_DMA_CHAN_PER_PORT);
+	atomic_set(&pctrl->dma_in_process, 0);
+
+	id = ltq_dma_r32(pctrl, DMA_ID);
+	if (id == 0 || id == 0xFFFFFFFFu) {
+		pr_err("hdma: IG-192 TOE/DMA3 DMA_ID reads 0x%08x (clock off?) — aborting reset\n",
+		       id);
+		iounmap(pctrl->membase);
+		pctrl->membase = NULL;
+		return -ENODEV;
+	}
+	pctrl->chans = MS(id, DMA_ID_CHNR);
+	pctrl->port_nrs = MS(id, DMA_ID_PRTNR);
+	pctrl->ver = MS(id, DMA_ID_REV);
+	/* AVM hdma.c:4139: DMA3/DMA4 report one port more than they expose */
+	if (pctrl->port_nrs)
+		pctrl->port_nrs--;
+	pr_info("hdma: IG-192 TOE/DMA3 DMA_ID=0x%08x chans=%d ports=%d(post-dec) ver=%d\n",
+		id, pctrl->chans, pctrl->port_nrs, pctrl->ver);
+
+	/* DMA3 DT props, 4.9 lantiq/xrx500.dtsi:114-131 */
+	pctrl->flags = DMA_CTL_64BIT | DMA_DESC_IN_SRAM | DMA_EN_BYTE_EN;
+	pctrl->arb_type = DMA_ARB_PKT;
+	pctrl->pollcnt = 24;
+	pctrl->labcnt = 0;
+	pctrl->orrc = 0;
+	pctrl->budget = 20;
+	pctrl->burst_mask = DMA_4DW_DESC_MASK;
+	pctrl->desc_size = DMA_4DW_DESC_SIZE;
+
+	if (pctrl->port_nrs) {
+		pctrl->ports = kcalloc(pctrl->port_nrs, sizeof(*pport),
+				       GFP_KERNEL);
+		if (!pctrl->ports)
+			return -ENOMEM;
+		pport = &pctrl->ports[0];
+		pport->chan_nrs = pctrl->chans;
+		pport->pid = 0;
+		pport->name = dma_name[DMA3];
+		pport->rxendi = 3;
+		pport->txendi = 3;
+		pport->rxbl = burst_len_to_burst_cfg(16);
+		pport->txbl = burst_len_to_burst_cfg(16);
+		pport->txwgt = DMA_TX_PORT_DEFAULT_WEIGHT;
+		pport->pkt_drop = DMA_PKT_DROP_DISABLE;
+		pport->flush_memcpy = 0;	/* AVM:4298 DMA3/DMA4 */
+		pport->chans = kcalloc(pport->chan_nrs, sizeof(*pch),
+				       GFP_KERNEL);
+		if (!pport->chans)
+			return -ENOMEM;
+		for (i = 0; i < pport->chan_nrs; i++) {
+			pch = &pport->chans[i];
+			pch->nr = i;
+			pch->onoff = DMA_CH_OFF;
+			pch->rst = DMA_CHAN_RST;
+			pch->pkt_size = DMA_PKT_SIZE_DEFAULT;
+			pch->lnr = -1;
+		}
+	}
+
+	/* The AVM dma_ctrl_init hardware sequence */
+	dma_ctrl_reset(pctrl);
+	dma_ctrl_cfg(pctrl);
+	for (i = 0; i < pctrl->port_nrs; i++) {
+		pport = &pctrl->ports[i];
+		dma_set_port_controller_data(pport, pctrl);
+		dma_port_cfg(pport);
+		for (j = 0; j < pport->chan_nrs; j++) {
+			pch = &pport->chans[j];
+			dma_set_chan_controller_data(pch, pctrl);
+			dma_set_chan_port_data(pch, pport);
+			dma_chan_cfg(pch);
+		}
+	}
+
+	pr_info("hdma: IG-192 TOE/DMA3 reset done: DMA_CTRL=0x%08x CPOLL=0x%08x\n",
+		ltq_dma_r32(pctrl, DMA_CTRL), ltq_dma_r32(pctrl, DMA_CPOLL));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(hdma_ig192_toe_dma3_reset);
+
+int hdma_port_enable(int port_id)
+{
+	const struct port7_chan_desc *tbl;
+	size_t n, i;
+	int ret;
+	u32 chan;
+	struct dmax_chan *pch;
+
+	/*
+	 * IG-061: the DMA2TX egress channel is armed once and kept armed. A repeat
+	 * ndo_open (netifd) is a no-op so the live DQM coupling is never disturbed.
+	 */
+	if (port_id == 10 && g_hdma_port10_armed)
+		return 0;
+
+	/*
+	 * IG-039: dispatch on the CBM dequeue port. Port 7 is the original
+	 * Sub-4B "CBM EQM port 7 admit" channel (kept so the hdma smoke-test
+	 * still passes); port 10 is eth0/LAN1's AVM-correct egress channel
+	 * (DMA2TX channel 5 -> GPHY5). Any other port is out of scope.
+	 */
+	if (port_id == 7) {
+		tbl = port7_channels;
+		n = ARRAY_SIZE(port7_channels);
+	} else if (port_id == 10) {
+		tbl = port10_channels;
+		n = ARRAY_SIZE(port10_channels);
+	} else {
+		return -EINVAL;
+	}
+
+	for (i = 0; i < n; i++) {
+		const struct port7_chan_desc *e = &tbl[i];
+
+		chan = _DMA_C(e->cid, e->pid, e->nid);
+		ret = ltq_request_dma(chan, e->label);
+		if (ret) {
+			pr_err("hdma_port_enable(%d): ltq_request_dma(%s) failed: %d\n",
+			       port_id, e->label, ret);
+			return ret;
+		}
+
+		if (e->cbm_deq) {
+			/*
+			 * IG-041: CBM-managed dequeue channel. Point the
+			 * channel's descriptor base directly at the CBM DQM
+			 * descriptor window (MMIO) instead of a software ring —
+			 * the CBM writes the dequeued frame's buffer pointer +
+			 * OWN bit there at run time and the DMA reads it from
+			 * there (AVM setup_DMA_channel cbm.c:4416). No
+			 * dma_alloc_coherent ring; ltq_dma_chan_desc_cfg sets
+			 * desc_configured so ltq_dma_chan_open's guard passes,
+			 * and leaves pch->desc_base NULL so hdma_port_disable's
+			 * ltq_dma_chan_desc_free is a safe no-op (does not try
+			 * to free the MMIO window).
+			 *
+			 * The previous software-ring path (dma_alloc_coherent,
+			 * own=0) meant the CBM dequeue engine wrote frames to
+			 * the DQM window while the DMA looked at a different
+			 * buffer -> no consumer -> hang (IG-040 iteration 4).
+			 */
+
+			/*
+			 * IG-062: re-arm the DQM egress port (re-zero descriptors
+			 * + re-write CFG_DMA_EGP DQREQ/EPMAP) IMMEDIATELY before
+			 * we point the channel at the DQM window and turn it on.
+			 * AVM runs setup_dqm_dma_desc + the per-port CFG arm and
+			 * the channel open as ONE contiguous ordered unit right
+			 * after DQM_CTRL=0x11 (cbm.c:5660); our port split it
+			 * across probe (init_cbm_dqm_dma_port at cbm.c:617) and
+			 * here at ndo_open. IG-060 proved the TMU PPT BDYL=178 is
+			 * correct and the DQM never completes the egress descriptor
+			 * (own=0/data_len=0, D2P[REQ]=0); freshening the DQM->DMA2TX
+			 * binding at the channel-on instant is the one AVM-order
+			 * divergence left. cbm_deq (=10) is also the dqp.
+			 */
+			ret = init_cbm_dqm_dma_port(e->cbm_deq);
+			if (ret) {
+				pr_err("hdma_port_enable(%d): init_cbm_dqm_dma_port(%d) failed: %d\n",
+				       port_id, e->cbm_deq, ret);
+				return ret;
+			}
+
+			ret = ltq_dma_chan_desc_cfg(chan,
+						    CBM_DQM_DESC_PHYS(e->cbm_deq),
+						    CBM_DQM_DESC_NUM);
+			if (ret) {
+				pr_err("hdma_port_enable(%d): ltq_dma_chan_desc_cfg(%s, DQM-window) failed: %d\n",
+				       port_id, e->label, ret);
+				return ret;
+			}
+			pr_info("hdma_port_enable(%d): %s CBM-managed, desc@phys 0x%08x x%u\n",
+				port_id, e->label,
+				(u32)CBM_DQM_DESC_PHYS(e->cbm_deq),
+				CBM_DQM_DESC_NUM);
+			goto chan_on;
+		}
+
+		ret = ltq_dma_chan_desc_alloc(chan, HDMA_PORT_DESC_NUM);
+		if (ret) {
+			pr_err("hdma_port_enable(%d): ltq_dma_chan_desc_alloc(%s) failed: %d\n",
+			       port_id, e->label, ret);
+			return ret;
+		}
+		pch = dma_chan_l2p(chan);
+		if (!pch) {
+			pr_err("hdma_port_enable(%d): dma_chan_l2p(%s) returned NULL\n",
+			       port_id, e->label);
+			return -EINVAL;
+		}
+		ret = ltq_dma_chan_desc_cfg(chan, pch->desc_phys,
+					    HDMA_PORT_DESC_NUM);
+		if (ret) {
+			pr_err("hdma_port_enable(%d): ltq_dma_chan_desc_cfg(%s) failed: %d\n",
+			       port_id, e->label, ret);
+			return ret;
+		}
+chan_on:
+		/*
+		 * IG-061: AVM setup_DMA_channel (cbm.c:4416-4457) runs
+		 * desc_cfg -> ltq_dma_chan_irq_disable -> ltq_dma_chan_on. Our
+		 * ltq_dma_chan_open only does chan_on; add the explicit CIE=0
+		 * to make the open sequence byte-identical to AVM.
+		 */
+		ltq_dma_chan_irq_disable(chan);
+		ret = ltq_dma_chan_open(chan);
+		if (ret) {
+			pr_err("hdma_port_enable(%d): ltq_dma_chan_open(%s) failed: %d\n",
+			       port_id, e->label, ret);
+			return ret;
+		}
+		pr_info("hdma_port_enable(%d): opened %s (cid=%u pid=%u nid=%u)\n",
+			port_id, e->label, e->cid, e->pid, e->nid);
+	}
+
+	/* IG-061: latch the CBM-managed egress channel as permanently armed. */
+	if (port_id == 10)
+		g_hdma_port10_armed = true;
+	return 0;
+}
+
+/*
+ * hdma_port_disable — Sub-6 ST-003b symmetric inverse of hdma_port_enable.
+ *
+ * Closes Plan-Reviewer ST-004 critical-4: Sub-4B never lands a teardown
+ * helper, so ndo_stop in ST-004 had no way to honestly reverse
+ * hdma_port_enable's channel acquisition. Without this, every ndo_stop
+ * leaked the DMA channels hdma_port_enable opened.
+ *
+ * Teardown ordering — strict reverse of hdma_port_enable's
+ * (request -> desc_alloc -> desc_cfg -> chan_open):
+ *
+ *   (1) ltq_dma_chan_close   reverses ltq_dma_chan_open (off + irq_disable)
+ *   (2) ltq_dma_chan_desc_free reverses ltq_dma_chan_desc_alloc
+ *       (also rolls back desc_cfg state via desc_configured=false in
+ *        ltq_dma_chan_desc_free's body)
+ *   (3) ltq_free_dma         reverses ltq_request_dma
+ *
+ * Per-port channel source-of-truth: port7_channels[] (the same static
+ * const lookup table hdma_port_enable iterates). The AC-003b-1 wording
+ * "channels recorded in the per-port hdma_port_state struct" refers
+ * generically to whatever per-port channel-tracking state the driver
+ * carries; for Sub-4B that state is port7_channels[] at file scope.
+ *
+ * Failure handling: a single failing step records the error code into
+ * `partial` and the loop continues. The function returns the first
+ * non-zero step's errno on partial failure so the caller (ST-004
+ * ndo_stop) can log it without losing the rest of the teardown. AVM
+ * has no analogous wrapper; the partial-failure pattern is Sub-4B's
+ * choice — symmetric with hdma_port_enable's "stop on first error"
+ * stance but biased toward draining as much state as possible at
+ * teardown time (matches the kernel-driver convention that close /
+ * remove paths must not leak even when intermediate steps fail).
+ *
+ * Visibility: matches hdma_port_enable's intra-composite linkage
+ * (per CQ-004 B intel_xrx500.c lives in the same intel-xrx500-gswip
+ * composite). NO EXPORT_SYMBOL_GPL — the symbol resolves at link time
+ * via the composite module's static linker pass per AC-003b-2.
+ *
+ * AVM source: NEW (Sub-6 ST-003b symmetric inverse). No AVM analogue
+ * because AVM never carried an hdma_port_enable wrapper either.
+ */
+int hdma_port_disable(int port_id)
+{
+	const struct port7_chan_desc *tbl;
+	size_t n, i;
+	int rc;
+	int first_err = 0;
+	u32 chan;
+
+	/*
+	 * IG-061: NEVER tear down the CBM-managed DMA2TX egress channel (port 10).
+	 * AVM opens it once at probe and keeps it armed for the device lifetime;
+	 * closing+reopening it across a netifd ndo_stop->ndo_open cycle breaks the
+	 * DQM->DMA2TX D2P coupling (channel ON but D2P[REQ]=0, egress data_len=0).
+	 * The matching hdma_port_enable no-ops the re-open via g_hdma_port10_armed,
+	 * so the channel is requested+armed exactly once and never leaked-then-
+	 * re-requested. (Port 7 / the smoke-test channel still tears down normally.)
+	 */
+	if (port_id == 10)
+		return 0;
+
+	/*
+	 * IG-039: must mirror hdma_port_enable's port dispatch. eth0/LAN1 now
+	 * uses port 10 (DMA2TX channel 5); if disable only handled port 7 the
+	 * channel-5 allocation would leak across the netifd bridge-enslavement
+	 * ndo_stop -> ndo_open cycle, so the re-open fails with -EBUSY and eth0
+	 * never comes back up.
+	 */
+	if (port_id == 7) {
+		tbl = port7_channels;
+		n = ARRAY_SIZE(port7_channels);
+	} else if (port_id == 10) {
+		tbl = port10_channels;
+		n = ARRAY_SIZE(port10_channels);
+	} else {
+		return -EINVAL;
+	}
+
+	for (i = 0; i < n; i++) {
+		const struct port7_chan_desc *e = &tbl[i];
+
+		chan = _DMA_C(e->cid, e->pid, e->nid);
+
+		/* (1) inverse of ltq_dma_chan_open. */
+		rc = ltq_dma_chan_close(chan);
+		if (rc) {
+			pr_err("hdma_port_disable(%d): ltq_dma_chan_close(%s) failed: %d\n",
+			       port_id, e->label, rc);
+			if (!first_err)
+				first_err = rc;
+		}
+
+		/*
+		 * (2) inverse of ltq_dma_chan_desc_alloc /
+		 *     ltq_dma_chan_desc_cfg. ltq_dma_chan_desc_free is
+		 *     idempotent (returns 0 on NULL desc_base) so a
+		 *     prior partial-teardown path is safe.
+		 */
+		rc = ltq_dma_chan_desc_free(chan);
+		if (rc) {
+			pr_err("hdma_port_disable(%d): ltq_dma_chan_desc_free(%s) failed: %d\n",
+			       port_id, e->label, rc);
+			if (!first_err)
+				first_err = rc;
+		}
+
+		/* (3) inverse of ltq_request_dma. */
+		rc = ltq_free_dma(chan);
+		if (rc) {
+			pr_err("hdma_port_disable(%d): ltq_free_dma(%s) failed: %d\n",
+			       port_id, e->label, rc);
+			if (!first_err)
+				first_err = rc;
+		} else {
+			pr_info("hdma_port_disable(%d): released %s (cid=%u pid=%u nid=%u)\n",
+				port_id, e->label, e->cid, e->pid, e->nid);
+		}
+	}
+	return first_err;
+}
+
