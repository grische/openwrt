+/*
+ * hdma_port_enable — NEW Sub-4B-authored wrapper — no AVM analogue;
+ * per CQ-001 C, this is the ONLY non-AVM-verbatim symbol in this header.
+ * Opens the per-controller channel set CBM EQM port_id is wired to.
+ * Returns 0 on success, -ENOSYS until ST-005 lands the body.
+ *
+ * Sub-6 canonical bring-up ordering (per Plan-Reviewer ST-004 critical-3
+ * adjudication of the cbm_dp_enable double-call ambiguity):
+ *
+ *   ndo_open:
+ *     hdma_port_enable(port_id)
+ *       -> cbm_dp_enable(... 0 ...)        // TRANSITIVE via
+ *       -> dp_register_subif(...)          //    dp_register_subif_private
+ *
+ * Sub-6 canonical teardown ordering (Sub-6 ST-003b symmetric inverse,
+ * closes Plan-Reviewer ST-004 critical-4):
+ *
+ *   ndo_stop:
+ *     dp_deregister_subif(...)             // TRANSITIVE
+ *       -> cbm_dp_enable(... CBM_PORT_F_DISABLE ...)
+ *     hdma_port_disable(port_id)
+ *
+ * The reverse-order pairing (enable: hdma -> dp; disable: dp -> hdma)
+ * ensures DMA channels are still held open while the datapath unprograms
+ * the CTP / BridgePort / QIDT entries that reference them.
+ */
+int hdma_port_enable(int port_id);
+
+/*
+ * IG-192: reset-parity for the TOE DMA controller (AVM cid DMA3 @
+ * 0x1E300000) — replicates the AVM 4.9 boot-time DMA3 probe hardware
+ * sequence (CTRL_RST + ctrl/port/chan cfg, channels off). Called from
+ * cbm_xrx500_probe between the IG-059 CGU poke (TOE clock on) and
+ * cbm_hw_init. Full rationale at the definition in hdma.c.
+ */
+int hdma_ig192_toe_dma3_reset(void);
+
+/*
+ * IG-067 software-managed DMA2TX TX path (workaround for the CBM-DQM
+ * empty-descriptor gate). hdma_swtx_init() arms DMA2TX ch5 as a SW own-bit
+ * ring in per-channel SW-poll mode (bypassing the CBM DQM); hdma_swtx_xmit()
+ * copies a raw Ethernet frame into a private coherent buffer and posts a
+ * DMA-owned descriptor. The PMAC routes ch5 -> GPHY5 by nTxDmaChanId. Caller
+ * serialises hdma_swtx_xmit (tx_lock). ltq_dma_chan_sw_poll_cfg is the AVM
+ * per-channel SW-poll knob it depends on.
+ */
+int ltq_dma_chan_sw_poll_cfg(u32 chan, int enable);
+int hdma_swtx_init(u32 chan, int n, int buf_size);
+int hdma_swtx_xmit(u32 chan, const void *data, int len);
+
+/*
+ * IG-068 DMA1TX<->DMA2RX peripheral-to-peripheral (P2P) bridge config
+ * (AVM hdma.c:2313). The CBM setup_DMA_p2p (cqm/grx500/cbm.c) calls this to
+ * give the TX channel (tx_chan) the RX channel's (rx_chan) descriptor ring
+ * and enable the silicon P2P-copy path. Returns 0 on success, -EINVAL if
+ * either encoded channel handle does not resolve.
+ */
+int ltq_dma_p2p_cfg(u32 rx_chan, u32 tx_chan);
+
+/*
+ * hdma_port_disable — Sub-6 ST-003b symmetric inverse of hdma_port_enable.
+ *
+ * Releases the DMA channels that hdma_port_enable(port_id) opened, in
+ * reverse order: ltq_dma_chan_close -> ltq_dma_chan_desc_free ->
+ * ltq_free_dma per channel. Per Sub-4B AS-008 the only supported
+ * port_id is 7; non-7 callers receive -EINVAL (symmetric with
+ * hdma_port_enable's port-range guard).
+ *
+ * Returns 0 on success; non-zero on partial failure (each failing step
+ * is logged via pr_err and teardown continues for the remaining
+ * channels so a single stuck channel does not strand the others).
+ */
+int hdma_port_disable(int port_id);
