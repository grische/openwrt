+	} __packed dw1;
+	dma_addr_t data_pointer; /* dw2 */
+	union {
+		struct {
+			u32 data_len : 16;
+			u32 mpoa_mode : 2;
+			u32 mpoa_pt : 1;
+			u32 qid : 4;
