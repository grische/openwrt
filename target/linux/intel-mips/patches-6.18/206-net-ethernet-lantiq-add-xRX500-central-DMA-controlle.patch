+/*
+ * dma_chan_cfg — AVM hdma.c:2179-2233 with the auto-descriptor-allocation
+ * tail (AVM:2225-2228, the dma_chan_desc_alloc + dma_chan_data_buf_alloc
+ * call pair guarded by !dma_chan_desc_alloc_by_device) STRIPPED per
+ * AC-003-6. Sub-4/Sub-6 own descriptor seeding (AS-013) and will invoke
+ * ltq_dma_chan_desc_cfg() to set CDBA/CDLEN with their own buffer rings.
+ *
+ * Per AC-003-6 dma_chan_cfg also resets CDBA / CDLEN / CDPTNR explicitly
+ * (not in AVM source) to leave the silicon in a known-clean state while
+ * the per-channel devm_request_irq is being registered. Writes happen
+ * inside the DMA_CS-selected window (silicon requires DMA_CS to point at
+ * the channel before per-channel register writes take effect).
+ */
+
+/*
+ * IG-197: default per-channel buffer callbacks — AVM hdma.c:2165-2179
+ * verbatim. The AS-013 strip removed these AND their assignment, leaving
+ * pch->alloc NULL tree-wide, which turned ltq_dma_chan_data_buf_alloc
+ * into a silent no-op. setup_DMA_p2p's receive-ring seeding of DMA2RX
+ * ch0 (the GSW-L egress -> GSW-R ingress bridge channel, cbm.c:311-312 —
+ * the SOLE seeding path for that ring in AVM's design) therefore handed
+ * the hardware 32 CPU-owned zero descriptors on every boot this port
+ * ever made: zero receive capacity at the exact stage the RX flood
+ * vanishes (ledger IG-197).
+ */
+/* CKSEG1 uncached alias of the p2p bridge RX ring seeded below (IG-197d). */
+void __iomem *g_ig197_ring_va;
+
+static char *common_buffer_alloc(int len, int *byte_offset, void **opt)
+{
+	char *buffer = kmalloc(len, GFP_ATOMIC);
+
+	*byte_offset = 0;
+	return buffer;
+}
+
+static int common_buffer_free(char *dataptr, void *opt)
+{
+	kfree(dataptr);
+	return 0;
+}
+
+static int dma_chan_cfg(struct dmax_chan *pch)
+{
+	u32 reg = 0;
+	int cid;
+	int pid;
+	unsigned long flags;
+	struct dma_ctrl *pctrl;
+	struct dma_port *pport;
+
+	if (WARN_ON(!pch))
+		return -EINVAL;
+	pctrl = dma_chan_get_controller(pch);
+	pport = dma_chan_get_port(pch);
+
+	if (unlikely(!pport))
+		return -EINVAL;
+
+	cid = pctrl->cid;
+	pid = pport->pid;
+	reg |= (pch->lpbk_ch_nr << DMA_CCTRL_LBCHNR_S);
+	reg |= (pch->lpbk_en ? DMA_CCTRL_LBEN : 0);
+	reg |= (pch->p2pcpy ? DMA_CCTRL_P2PCPY : 0);
+	reg |= (pch->pden ? DMA_CCTRL_PDEN : 0);
+
+	reg |= (pch->txwgt << DMA_CCTRL_TXWGT_S);
+
+	reg |= (pch->onoff ? DMA_CCTRL_ON : 0);
+	reg |= (pch->rst ? DMA_CCTRL_RST : 0);
+	dma_chan_cctrl_cfg(pch, reg);
+	dma_chan_set_class(pch, pch->nr);
+	/*
+	 * IG-165: the AC-003-6 "explicit CDBA/CDLEN/CDPTNR reset" that lived
+	 * here was the ONLY ours-only MMIO write on the whole DMA bring-up
+	 * path (AVM writes none of these in dma_chan_cfg and NEVER writes
+	 * CDPTNR anywhere — it is the engine's descriptor cursor). Deleted
+	 * to restore AVM-exact behavior. CIS/CIE clear-and-disable matches
+	 * AVM verbatim (silicon requires DMA_CS to point at the channel
+	 * before per-channel register writes take effect).
+	 *
+	 * IG-165b: the V3-window readback that briefly lived here proved the
+	 * window DOES NOT EXIST on the GRX500 DMA IP — reads of 0x110/0x120/
+	 * 0x140/0x150 ALIAS back onto the low register file (0x110 -> 0x10 =
+	 * DMA_CTRL; the observed "hdrm" values were each controller's exact
+	 * DMA_CTRL), so the "HDRM clear" actually zeroed DMA_CTRL on all
+	 * four controllers. Removed. Two facts bank from that boot: (1)
+	 * DMA_C_HDRM cannot be the 8-bytes-then-stop mechanism (no such
+	 * register here); (2) the boot ran with DMA_CTRL=0 everywhere and
+	 * the truncation signature was IDENTICAL — the store pathology is
+	 * insensitive to the entire DMA_CTRL config (PKTARB/DS_FOD/ENBE/
+	 * MBRSTCNT all zero changed nothing).
+	 */
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	/* Clear all interrupts and disable. */
+	ltq_dma_w32(pctrl, 0, DMA_CIE);
+	ltq_dma_w32(pctrl, DMA_CI_ALL, DMA_CIS);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+
+	/*
+	 * Disable related top-level interrupts. AVM uses the cn<32 split
+	 * (DMA_IRNEN / DMA_IRNCR for channels 0-31, DMA_IRNEN1 / DMA_IRNCR1
+	 * for 32-63) per AC-003-5.
+	 */
+	if (pch->nr < 32) {
+		ltq_dma_w32_mask(pctrl, (1u << (pch->nr & 0x1f)), 0,
+				 DMA_IRNEN);
+		ltq_dma_w32_mask(pctrl, 0, (1u << (pch->nr & 0x1f)),
+				 DMA_IRNCR);
+	} else {
+		ltq_dma_w32_mask(pctrl, (1u << (pch->nr & 0x1f)), 0,
+				 DMA_IRNEN1);
+		ltq_dma_w32_mask(pctrl, 0, (1u << (pch->nr & 0x1f)),
+				 DMA_IRNCR1);
+	}
+	/*
+	 * IG-197: default buffer callbacks, AVM hdma.c:2220-2221 verbatim.
+	 * The AS-013 strip left pch->alloc NULL tree-wide, which silently
+	 * no-op'd ltq_dma_chan_data_buf_alloc — see the IG-197 walk below.
+	 */
+	pch->alloc = &common_buffer_alloc;
+	pch->free = &common_buffer_free;
+	mutex_init(&pch->ch_lock);
+	spin_lock_init(&pch->irq_lock);
+	/*
+	 * AVM:2225-2228 auto-descriptor-allocation tail stripped per
+	 * AC-003-6. Sub-4 / Sub-6 own descriptor seeding (AS-013) and will
+	 * invoke ltq_dma_chan_desc_cfg() with their own buffer rings.
+	 */
+	dev_dbg(pctrl->dev, "%s port %d chan %d done\n",
+		dma_name[cid], pid, pch->nr);
+	return 0;
+}
+
+/*
+ * do_dma_tasklet — AVM hdma.c:2907-2957 with the DMA0 dispatch branch
+ * (AVM:2921-2934, the !dma_is_64bit special-case for the 8-DW-desc
+ * controller) STRIPPED per AC-003-2. Sub-4B only binds the 64-bit
+ * controllers (DMA1TX/DMA1RX/DMA2TX), so only the dma_is_64bit branch
+ * survives.
+ *
+ * Per AC-003-11 the per-channel callback invocation carries an explicit
+ * NULL-check (Sub-4 / Sub-6 register the intr_handler callbacks later;
+ * at ST-003 commit NO caller has done so, so an unconditional dispatch
+ * on the first DMA IRQ would oops on NULL deref).
+ *
+ * Per AC-003-2 the budget-and-recheck pattern processes up to
+ * pctrl->budget set-bits per invocation and re-schedules on (a) budget
+ * exhausted OR (b) bitmap non-empty after dropping the dma_in_process
+ * flag (the atomic-flag race recovery).
+ *
+ * Departure from AVM: the per-direction inspection-handlers
+ * (dma_rx_chan_int_handler / dma_tx_chan_int_handler) which AVM uses to
+ * walk descriptors and conditionally dispatch the client callback are
+ * COLLAPSED here into a direct pch->intr_handler() invocation. Sub-4 /
+ * Sub-6 own descriptor-walking in their own callback bodies (AS-013).
+ * The flags arg encodes direction (TRANSMIT_CPT_INT for TX, RCV_INT for
+ * RX) so the client callback can branch on direction.
+ *
+ * The per-iteration clear_bit happens BEFORE invoking the callback so a
+ * re-entrant set_bit from a fast follow-up IRQ on the same channel is
+ * preserved (the bit gets re-set and the next iteration picks it up).
+ */
+static void do_dma_tasklet(unsigned long data)
+{
+	int ch_nr;
+	int flags;
+	struct dma_port *pport;
+	struct dmax_chan *pch;
+	struct dma_ctrl *pctrl = (struct dma_ctrl *)data;
+	int budget = pctrl->budget;
+
+	while (!bitmap_empty(pctrl->dma_int_status, pctrl->chans)) {
+		ch_nr = find_first_bit(pctrl->dma_int_status, pctrl->chans);
+		if (budget-- < 0) {
+			tasklet_schedule(&pctrl->dma_tasklet);
+			return;
+		}
+		/*
+		 * 64-bit-controller branch only (DMA0 dispatch stripped per
+		 * AC-003-2). All Sub-4B controllers (DMA1TX/DMA1RX/DMA2TX)
+		 * have port_nrs==1 so the channel always lives under
+		 * pctrl->ports[0].
+		 */
+		pport = &pctrl->ports[0];
+		pch = &pport->chans[ch_nr];
+		clear_bit(ch_nr, pctrl->dma_int_status);
+		/*
+		 * AC-003-11 — silicon-mandatory NULL-check before
+		 * dereference. Sub-4 / Sub-6 register the callbacks LATER;
+		 * at ST-003 commit NO caller has registered any
+		 * intr_handler, so an unconditional dispatch would oops.
+		 */
+		if (pch->intr_handler) {
+			flags = dma_chan_tx(pch) ? TRANSMIT_CPT_INT : RCV_INT;
+			pch->intr_handler(pch->lnr, pch->priv, flags);
+		}
+	}
+	/*
+	 * Sanity check: a new IRQ may have raced in during the gap between
+	 * the while loop exit and the in-process clear. Drop the flag, then
+	 * recheck the bitmap and reschedule if non-empty per AC-003-2.
+	 */
+	atomic_set(&pctrl->dma_in_process, 0);
+	if (!bitmap_empty(pctrl->dma_int_status, pctrl->chans)) {
+		atomic_set(&pctrl->dma_in_process, 1);
+		tasklet_schedule(&pctrl->dma_tasklet);
+	}
+}
+
+/* AVM hdma.c:2959-2962 verbatim. */
+static inline int dma_irq_to_chan_nr(struct dma_ctrl *pctrl, int irq)
+{
+	return irq - pctrl->irq_base;
+}
+
+/*
+ * dma_chan_interrupt — AVM hdma.c:2964-2988 verbatim. Per AC-003-4 +
+ * review_focus: the CIS-clear MUST precede set_bit (the spin_lock_irqsave
+ * window provides the ordering; set_bit happens after spin_unlock).
+ */
+static irqreturn_t dma_chan_interrupt(int irq, void *dev_id)
+{
+	unsigned long flags;
+	struct dmax_chan *pch = (struct dmax_chan *)dev_id;
+	struct dma_ctrl *pctrl = dma_chan_get_controller(pch);
+
+	/* Disable this channel interrupt. */
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32(pctrl, pch->nr, DMA_CS);
+	ltq_dma_w32_mask(pctrl, DMA_CI_ALL, 0, DMA_CIE);
+	/* Record and clear status to prevent dummy interrupts (level irq). */
+	pch->cis = ltq_dma_r32(pctrl, DMA_CIS);
+	ltq_dma_w32(pctrl, DMA_CI_ALL, DMA_CIS);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+
+	/* Record this channel interrupt for the tasklet. */
+	set_bit(dma_irq_to_chan_nr(pctrl, irq), pctrl->dma_int_status);
+
+	/* If not in process, invoke the tasklet. */
+	if (!atomic_read(&pctrl->dma_in_process)) {
+		atomic_set(&pctrl->dma_in_process, 1);
+		tasklet_schedule(&pctrl->dma_tasklet);
+	}
+	return IRQ_HANDLED;
+}
+
+/*
+ * dma_disable_irq / dma_enable_irq / dma_ack_irq / dma_mask_and_ack_irq
+ * — AVM hdma.c:3031-3096 with the AVM `cn > 32` boundary CORRECTED to
+ * `cn >= 32` per AC-003-5's contract text ("cn<=31 → IRNEN / IRNCR;
+ * cn>=32 → IRNEN1 / IRNCR1"). AVM's `cn > 32` is an off-by-one — it
+ * sends cn==32 to the low bank, but cn==32 is bit 0 of the high bank.
+ * The dma_chan_cfg boundary at AVM:2213 uses the correct `nr < 32`, so
+ * the AVM source itself is inconsistent. AC-003-5 + the dma_chan_cfg
+ * split-point both endorse the >=32 boundary; we follow the spec
+ * contract.
+ */
+static void dma_disable_irq(struct irq_data *d)
+{
+	unsigned long flags;
+	unsigned int reg_off;
+	struct dma_ctrl *pctrl = itoc(d);
+	unsigned int cn;
+
+	if (unlikely(!pctrl))
+		return;
+
+	cn = d->irq - pctrl->irq_base;
+	reg_off = (cn >= 32) ? DMA_IRNEN1 : DMA_IRNEN;
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32_mask(pctrl, BIT((cn & 0x1f)), 0, reg_off);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+static void dma_enable_irq(struct irq_data *d)
+{
+	unsigned long flags;
+	unsigned int reg_off;
+	struct dma_ctrl *pctrl = itoc(d);
+	unsigned int cn;
+
+	if (unlikely(!pctrl))
+		return;
+
+	cn = d->irq - pctrl->irq_base;
+	reg_off = (cn >= 32) ? DMA_IRNEN1 : DMA_IRNEN;
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32_mask(pctrl, 0, BIT((cn & 0x1f)), reg_off);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+static void dma_ack_irq(struct irq_data *d)
+{
+	unsigned int reg_off;
+	struct dma_ctrl *pctrl = itoc(d);
+	unsigned int cn;
+
+	if (unlikely(!pctrl))
+		return;
+
+	cn = d->irq - pctrl->irq_base;
+	reg_off = (cn >= 32) ? DMA_IRNCR1 : DMA_IRNCR;
+	ltq_dma_w32(pctrl, BIT((cn & 0x1f)), reg_off);
+}
+
+static void dma_mask_and_ack_irq(struct irq_data *d)
+{
+	unsigned long flags;
+	unsigned int reg_off;
+	struct dma_ctrl *pctrl = itoc(d);
+	unsigned int cn;
+
+	if (unlikely(!pctrl))
+		return;
+
+	cn = d->irq - pctrl->irq_base;
+	reg_off = (cn >= 32) ? DMA_IRNEN1 : DMA_IRNEN;
+	spin_lock_irqsave(&pctrl->ctrl_lock, flags);
+	ltq_dma_w32_mask(pctrl, BIT((cn & 0x1f)), 0, reg_off);
+	reg_off = (cn >= 32) ? DMA_IRNCR1 : DMA_IRNCR;
+	ltq_dma_w32(pctrl, BIT((cn & 0x1f)), reg_off);
+	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
+}
+
+/*
+ * dma_irq_handler — AVM hdma.c:3098-3120 verbatim. Parent chained
+ * handler: reads the top-level IRNCR (and IRNCR1 when chans > 32) and
+ * dispatches to the per-channel virq via generic_handle_irq().
+ */
+static void dma_irq_handler(struct irq_desc *desc)
+{
+	int offset;
+	unsigned long irncr;
+	unsigned long irncr1 = 0;
+	struct dma_ctrl *pctrl = irq_desc_get_handler_data(desc);
+
+	if (unlikely(!pctrl))
+		return;
+	irncr = ltq_dma_r32(pctrl, DMA_IRNCR);
+	if (pctrl->chans > 32)
+		irncr1 = ltq_dma_r32(pctrl, DMA_IRNCR1);
+
+	if (pctrl->chans <= 32) {
+		for_each_set_bit(offset, &irncr, pctrl->chans)
+			generic_handle_irq(pctrl->irq_base + offset);
+	} else {
+		for_each_set_bit(offset, &irncr, 32)
+			generic_handle_irq(pctrl->irq_base + offset);
+		for_each_set_bit(offset, &irncr1, pctrl->chans - 32)
+			generic_handle_irq(pctrl->irq_base + 32 + offset);
+	}
+}
+
+/* AVM hdma.c:3122-3128 verbatim. */
+static struct irq_chip dma_irq_chip = {
+	.name = "dma_irq",
+	.irq_mask = dma_disable_irq,
+	.irq_unmask = dma_enable_irq,
+	.irq_ack = dma_ack_irq,
+	.irq_mask_ack = dma_mask_and_ack_irq,
+};
+
+/*
+ * dma_irq_map — AVM hdma.c:3130-3140 verbatim (modulo dev_dbg call
+ * adapted). Sets the per-irq chip + handler + chip_data so itoc() works
+ * in the disable/enable/ack callbacks.
+ */
+static int dma_irq_map(struct irq_domain *d, unsigned int irq,
+		       irq_hw_number_t hw)
+{
+	struct dma_ctrl *pctrl = d->host_data;
+
+	irq_set_chip_and_handler_name(irq, &dma_irq_chip,
+				      handle_level_irq, "mux");
+	irq_set_chip_data(irq, pctrl);
+	dev_dbg(pctrl->dev, "dma_irq_map irq %d --> hw %ld\n", irq, hw);
+	return 0;
+}
+
+/* AVM hdma.c:3142-3145 verbatim. */
+static const struct irq_domain_ops dma_irq_domain_ops = {
+	.xlate = irq_domain_xlate_onetwocell,
+	.map = dma_irq_map,
+};
+
+/*
+ * dma_irq_chip_init — AVM hdma.c:3153-3181 with v6.18 API translations
+ * per AC-003-3 / CQ-004 A:
+ *   - the legacy 'irq-domain-add-legacy' helper (renamed in v5.18) is
+ *     replaced with irq_domain_create_legacy + explicit fwnode argument
+ *     (of_node_to_fwnode(node)).
+ *   - the legacy 'set-up-irq' helper (removed in v5.17) is replaced with
+ *     irq_set_chained_handler_and_data(chained_irq, dma_irq_handler,
+ *     pctrl).
+ *   - the AVM dma_cascade irqaction struct dropped — only needed by the
+ *     legacy helper; the chained-handler API folds handler + data into
+ *     one call.
+ *   - the DMA3 disable_irq branch at AVM:3177-3178 dropped per AS-008.
+ *
+ * Allocates pctrl->chans per-channel virqs from the irq descriptor pool,
+ * creates a legacy domain mapping (size = pctrl->chans, first_irq =
+ * pctrl->irq_base, first_hwirq = 0), and registers the chained parent
+ * handler on the GIC virq (interrupts property in DT). Per AC-003-3 the
+ * domain create call uses the v6.18 signature: (fwnode, size, first_irq,
+ * first_hwirq, ops, host_data).
+ */
+static int dma_irq_chip_init(struct dma_ctrl *pctrl)
+{
+	struct resource irqres;
+	struct device_node *node = pctrl->dev->of_node;
+	struct irq_domain *domain;
+
+	if (of_irq_to_resource_table(node, &irqres, 1) != 1)
+		return 0;
+
+	pctrl->irq_base = irq_alloc_descs(-1, 0, pctrl->chans,
+					  numa_node_id());
+	if ((int)pctrl->irq_base < 0) {
+		dev_err(pctrl->dev, "Can't allocate IRQ numbers\n");
+		return -ENODEV;
+	}
+	pctrl->chained_irq = irqres.start;
+	domain = irq_domain_create_legacy(of_node_to_fwnode(node),
+					  pctrl->chans, pctrl->irq_base, 0,
+					  &dma_irq_domain_ops, pctrl);
+	if (!domain) {
+		dev_err(pctrl->dev, "Can't create legacy IRQ domain\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * v6.18: irq_set_chained_handler_and_data folds the AVM
+	 * legacy-helper + irq_set_handler_data + irq_set_chained_handler
+	 * sequence into one call.
+	 */
+	irq_set_chained_handler_and_data(irqres.start, dma_irq_handler,
+					 pctrl);
+	return 0;
+}
