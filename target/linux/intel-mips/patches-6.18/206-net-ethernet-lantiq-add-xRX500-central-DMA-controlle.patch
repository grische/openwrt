+			u32 enc : 1;
+			u32 dec : 1;
+			u32 nat : 1;
+			u32 tcp_err : 1;
+			u32 session_id : 12;
+		} __packed field;
+		u32 all;
+	} __packed dw1;
+	dma_addr_t data_pointer; /* dw2 */
+	union {
+		struct {
+			u32 data_len : 16;
+			u32 mpoa_mode : 2;
+			u32 mpoa_pt : 1;
