diff --git a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_basic.c b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_basic.c
index 19aa84b53fb4..7634745f8251 100644
--- a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_basic.c
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_basic.c
@@ -63,56 +63,3 @@ EXPORT_SYMBOL_GPL(cbm_set_val);
  *
  * @mode: 0 = packet counter, 1 = byte counter.
  */
-int cbm_counter_mode_set(int idx, int mode)
-{
-	u32 val;
-	u32 curr_mode;
-	u32 qen_mask, msel_mask, msel_pos;
-
-	if (!g_cbm_eqm_base || !g_cbm_dqm_base) {
-		pr_warn_once("cbm: counter_mode_set(idx=%d) before CBM probe, skipping\n",
-			     idx);
-		return -ENODEV;
-	}
-
-	switch (idx) {
-	case 0:
-		qen_mask  = EQM_QEN_MASK;
-		msel_mask = EQM_MSEL_MASK;
-		msel_pos  = EQM_MSEL_POS;
-		val = cbm_eqm_r32(CBM_EQM_CTRL);
-		curr_mode = (val & msel_mask) >> msel_pos;
-		if ((u32)mode == curr_mode)
-			return 0;
-		/* (1) clear QEN to freeze counter logic */
-		val &= ~qen_mask;
-		cbm_eqm_w32(CBM_EQM_CTRL, val);
-		/* (2) program new MSEL while counter is frozen */
-		val = (val & ~msel_mask) | (((u32)mode << msel_pos) & msel_mask);
-		cbm_eqm_w32(CBM_EQM_CTRL, val);
-		/* (3) restore QEN */
-		val |= qen_mask;
-		cbm_eqm_w32(CBM_EQM_CTRL, val);
-		return 0;
-
-	case 1:
-		qen_mask  = DQM_QEN_MASK;
-		msel_mask = DQM_MSEL_MASK;
-		msel_pos  = DQM_MSEL_POS;
-		val = cbm_dqm_r32(CBM_DQM_CTRL);
-		curr_mode = (val & msel_mask) >> msel_pos;
-		if ((u32)mode == curr_mode)
-			return 0;
-		val &= ~qen_mask;
-		cbm_dqm_w32(CBM_DQM_CTRL, val);
-		val = (val & ~msel_mask) | (((u32)mode << msel_pos) & msel_mask);
-		cbm_dqm_w32(CBM_DQM_CTRL, val);
-		val |= qen_mask;
-		cbm_dqm_w32(CBM_DQM_CTRL, val);
-		return 0;
-
-	default:
-		return -EINVAL;
-	}
-}
-EXPORT_SYMBOL_GPL(cbm_counter_mode_set);
diff --git a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_buf.c b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_buf.c
index 2e89f0547853..ed3c9fe1a82a 100644
--- a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_buf.c
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_buf.c
@@ -344,50 +344,6 @@ EXPORT_SYMBOL_GPL(cbm_buf_pool_phys_base);
  *             (chunk - pool->virt_base) so callers can populate DMA
  *             descriptors directly.
  */
-void *cbm_buf_alloc(u32 size, u32 *pool_phys, u32 flags)
-{
-	struct cbm_pool *pool;
-	void *chunk;
-	unsigned long irq_flags;
-
-	(void)flags;  /* dispatch is by SIZE, @flags unused. */
-
-	if (size <= DEFAULT_STD_FRM_SIZE) {
-		pool = &g_cbm_pools[CBM_POOL_STD];
-	} else if (size <= DEFAULT_JBO_FRM_SIZE) {
-		pool = &g_cbm_pools[CBM_POOL_JBO];
-	} else {
-		pr_err("cbm: cbm_buf_alloc(size=%u): exceeds jbo_frm_size cap %u — no pool can service\n",
-		       size, DEFAULT_JBO_FRM_SIZE);
-		return NULL;
-	}
-
-	if (!pool->virt_base) {
-		pr_err("cbm: cbm_buf_alloc(%s): pool not initialised (probe path missed of_reserved_mem_lookup?)\n",
-		       pool->name);
-		return NULL;
-	}
-
-	spin_lock_irqsave(&pool->lock, irq_flags);
-	chunk = pool->free_head;
-	if (chunk)
-		pool->free_head = *(void **)chunk;
-	spin_unlock_irqrestore(&pool->lock, irq_flags);
-
-	if (!chunk) {
-		pr_err_ratelimited("cbm: cbm_buf_alloc(%s): free-list empty (frm_num=%u)\n",
-				   pool->name, pool->frm_num);
-		return NULL;
-	}
-
-	if (pool_phys)
-		*pool_phys = (u32)(pool->phys_base +
-				   ((phys_addr_t)((u8 *)chunk -
-						  (u8 *)pool->virt_base)));
-
-	return chunk;
-}
-EXPORT_SYMBOL_GPL(cbm_buf_alloc);
 
 /*
  * cbm_buf_phys_to_virt - map a CBM pool PHYSICAL address back to its
@@ -420,47 +376,3 @@ EXPORT_SYMBOL_GPL(cbm_buf_phys_to_virt);
  *
  * @size: byte size originally requested.
  */
-int cbm_buf_free(void *buf, u32 size)
-{
-	struct cbm_pool *pool;
-	uintptr_t addr;
-	uintptr_t lo;
-	uintptr_t hi;
-	unsigned long irq_flags;
-
-	if (!buf)
-		return -EINVAL;
-
-	/* Pick the pool the same way alloc did. */
-	if (size <= DEFAULT_STD_FRM_SIZE) {
-		pool = &g_cbm_pools[CBM_POOL_STD];
-	} else if (size <= DEFAULT_JBO_FRM_SIZE) {
-		pool = &g_cbm_pools[CBM_POOL_JBO];
-	} else {
-		pr_err("cbm: cbm_buf_free(size=%u): exceeds jbo_frm_size cap %u\n",
-		       size, DEFAULT_JBO_FRM_SIZE);
-		return -EINVAL;
-	}
-
-	if (!pool->virt_base)
-		return -EINVAL;
-
-	/* Range check — the buf must point inside the chosen pool. */
-	addr = (uintptr_t)buf;
-	lo   = (uintptr_t)pool->virt_base;
-	hi   = lo + pool->frm_num * pool->frm_size;
-	if (addr < lo || addr >= hi) {
-		pr_err_ratelimited("cbm: cbm_buf_free(%s): buf %p outside pool [%p, +0x%zx)\n",
-				   pool->name, buf, pool->virt_base,
-				   (size_t)(pool->frm_num * pool->frm_size));
-		return -EINVAL;
-	}
-
-	spin_lock_irqsave(&pool->lock, irq_flags);
-	*(void **)buf = pool->free_head;
-	pool->free_head = buf;
-	spin_unlock_irqrestore(&pool->lock, irq_flags);
-
-	return 0;
-}
-EXPORT_SYMBOL_GPL(cbm_buf_free);
