--- /dev/null
+++ b/arch/mips/intel-mips/irq.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2016 Intel Corporation.
+ */
+#include <linux/init.h>
+#include <linux/irqchip.h>
+#include <linux/of_irq.h>
+#include <asm/irq.h>
+#include <asm/irq_cpu.h>
+#include <asm/mips-cps.h>
+#include <asm/time.h>
+
+void __init arch_init_irq(void)
+{
+	struct device_node *intc_node;
+
+	pr_info("EIC is %s\n", cpu_has_veic ? "on" : "off");
+	pr_info("VINT is %s\n", cpu_has_vint ? "on" : "off");
+
+	intc_node = of_find_compatible_node(NULL, NULL,
+					    "mti,cpu-interrupt-controller");
+	if (!cpu_has_veic && !intc_node)
+		mips_cpu_irq_init();
+
+	irqchip_init();
+}
+
+int get_c0_perfcount_int(void)
+{
+	return gic_get_c0_perfcount_int();
+}
+EXPORT_SYMBOL_GPL(get_c0_perfcount_int);
+
+unsigned int get_c0_compare_int(void)
+{
+	return gic_get_c0_compare_int();
+}
diff --git a/arch/mips/intel-mips/prom.c b/arch/mips/intel-mips/prom.c
new file mode 100644
index 0000000000000..f414c419ecddc
--- /dev/null
+++ b/arch/mips/intel-mips/prom.c
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2014 Lei Chuanhua <Chuanhua.lei@lantiq.com>
+ * Copyright (C) 2016 Intel Corporation.
+ */
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/of_platform.h>
+#include <linux/of_fdt.h>
+#include <linux/regmap.h>
+#include <linux/mfd/syscon.h>
+#include <linux/dma-map-ops.h>
+#include <linux/printk.h>
+#include <asm/bootinfo.h>
+#include <asm/mips-cps.h>
+#include <asm/mipsregs.h>
+#include <asm/prom.h>
+#include <asm/smp-ops.h>
+
+#define CPC_BASE_ADDR		0x12310000
+#define IOPORT_RESOURCE_START   0x10000000
+#define IOMEM_RESOURCE_START    0x10000000
+
+const char *get_system_type(void)
+{
+	return "Intel MIPS interAptiv SoC";
+}
+
+void prom_free_prom_memory(void)
+{
+}
+
+static void __init prom_init_cmdline(void)
+{
+	int i;
+	int argc;
+	char **argv;
+
+	/*
+	 * If u-boot pass parameters, it is ok, however, if without u-boot
+	 * JTAG or other tool has to reset all register value before it goes
+	 * emulation most likely belongs to this category
+	 */
+	if (fw_arg0 == 0 || fw_arg1 == 0)
+		return;
+
+	/*
+	 * a0: fw_arg0 - the number of string in init cmdline
+	 * a1: fw_arg1 - the address of string in init cmdline
+	 *
+	 * In accordance with the MIPS UHI specification,
+	 * the bootloader can pass the following arguments to the kernel:
+	 * - $a0: -2.
+	 * - $a1: KSEG0 address of the flattened device-tree blob.
+	 */
+	if (fw_arg0 == -2)
+		return;
+
+	argc = fw_arg0;
+	argv = (char **)KSEG1ADDR(fw_arg1);
+
+	arcs_cmdline[0] = '\0';
+
+	for (i = 0; i < argc; i++) {
+		char *p = (char *)KSEG1ADDR(argv[i]);
+
+		if (argv[i] && *p) {
+			strlcat(arcs_cmdline, p, sizeof(arcs_cmdline));
+			strlcat(arcs_cmdline, " ", sizeof(arcs_cmdline));
+		}
+	}
+}
+
+static int __init plat_enable_iocoherency(void)
+{
+	if (!mips_cps_numiocu(0))
+		return 0;
+
+	/* Nothing special needs to be done to enable coherency */
+	pr_info("Coherence Manager IOCU detected\n");
+	/* Second IOCU for MPE or other master access register */
+	write_gcr_reg0_base(0xa0000000);
+	write_gcr_reg0_mask(0xf8000000 | CM_GCR_REGn_MASK_CMTGT_IOCU1);
+	return 1;
+}
+
+static void __init plat_setup_iocoherency(void)
+{
+	/*
+	 * GRX350/xRX500 has a Coherence Manager IOCU. When present, DMA
+	 * masters snoop the CPU caches, so dma_alloc_coherent must hand out
+	 * CACHED (PAGE_OFFSET-based) addresses — NOT the non-coherent uncached
+	 * alias. On this platform RAM is at PHYS_OFFSET=0x20000000, and the
+	 * generic UNCAC_BASE=0xa0000000 + __pa() overflows KSEG1 into the
+	 * TLB-mapped CKSEG2 segment (e.g. 0xc22f3000), which is unmapped and
+	 * faults on access (and is_vmalloc_addr() then mis-triggers vunmap in
+	 * dma_direct_free). So leaving DMA non-coherent breaks every descriptor
+	 * ring. Mirror mainline malta-setup.c: when the IOCU exists, enable
+	 * hardware coherency. (The prior logic never set dma_default_coherent
+	 * and even panicked when no IOCU was found.)
+	 */
+	/*
+	 * IG-166: SOFTWARE coherency unconditionally — matching AVM 4.9,
+	 * which detects the same IOCU but deliberately leaves hw_coherentio
+	 * off (grx500/prom.c:117 commented out) and runs full wback/inv
+	 * maintenance. Our masters are programmed with direct-DDR 0x2xxxxxxx
+	 * bus addresses (the NON-snooping route; Intel's coherent mode would
+	 * require the 0xA0000000 IOCU-window aliases per AVM
+	 * dma-coherence.h:21-40), so claiming coherency here skipped ALL
+	 * cache maintenance on a path the hardware does not snoop. The
+	 * region-0 IOCU1 GCR write above stays (AVM does it too). NOTE: the
+	 * dma_alloc_coherent/UNCAC_ADDR overflow that motivated the old
+	 * `true` arm (0xa0000000 + __pa -> CKSEG2 fault) is dormant — no
+	 * boot-path driver allocs coherent memory (phy_fw staged via
+	 * virt_to_phys since IG-xxx) — and needs the spaces.h alias fix
+	 * (UNCAC = 0xA0000000 + phys - PHYS_OFFSET) if ever re-triggered.
+	 */
+	plat_enable_iocoherency();
+	dma_default_coherent = false;
+	pr_info("IG-166: Software DMA cache coherency enforced (AVM parity)\n");
+}
+
+static void free_init_pages_eva_intel(void *begin, void *end)
+{
+	free_init_pages("unused kernel", __pa_symbol((unsigned long *)begin),
+			__pa_symbol((unsigned long *)end));
+}
+
+static void plat_early_init_devtree(void)
+{
+	void *dtb;
+	const u32 *w;
+	const u32 *p;
+
+	/*
+	 * DEBUG (Phase-1 bringup): map out where EVA's decompression diverges
+	 * from the on-disk vmlinux. Bytes at __dtb_start (0x80def9c0) read as
+	 * a different DTB than what's in vmlinux at file offset 0x8ef9c0;
+	 * .text/.init.text clearly decompressed correctly because we reached
+	 * this point. Dump several known addresses so we can identify exactly
+	 * where on-disk and runtime diverge.
+	 */
+	pr_info("intel-mips DTB DEBUG: fw_arg0=%lx fw_arg1=%lx __dtb_start=%lx __dtb_end=%lx\n",
+		fw_arg0, fw_arg1,
+		(unsigned long)__dtb_start, (unsigned long)__dtb_end);
+
+	p = (const u32 *)0x80500000UL;
+	pr_info("intel-mips DTB DEBUG: VA 80500000 (file 0): %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3]);
+	p = (const u32 *)0x80a00000UL;
+	pr_info("intel-mips DTB DEBUG: VA 80a00000 (file 500000): %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3]);
+	p = (const u32 *)0x80c00000UL;
+	pr_info("intel-mips DTB DEBUG: VA 80c00000 (file 700000): %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3]);
+	p = (const u32 *)0x80d00000UL;
+	pr_info("intel-mips DTB DEBUG: VA 80d00000 (file 800000): %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3]);
+	p = (const u32 *)0x80de9740UL;
+	pr_info("intel-mips DTB DEBUG: VA 80de9740 (file 8e9740 .init.data): %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3]);
+
+	p = (const u32 *)__dtb_start;
+	pr_info("intel-mips DTB DEBUG: __dtb_start[0..7]: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+
+	dtb = get_fdt();
+	if (!dtb)
+		panic("no dtb found");
+
+	w = (const u32 *)dtb;
+	pr_info("intel-mips DTB DEBUG: get_fdt()=%lx first 32 bytes: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		(unsigned long)dtb, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+
+	__dt_setup_arch(dtb);
+}
+
+void __init plat_mem_setup(void)
+{
+	ioport_resource.start = IOPORT_RESOURCE_START;
+	ioport_resource.end = ~0UL; /* No limit */
+	iomem_resource.start = IOMEM_RESOURCE_START;
+	iomem_resource.end = ~0UL; /* No limit */
+
+	set_io_port_base((unsigned long)KSEG1);
+
+	strscpy(arcs_cmdline, boot_command_line, COMMAND_LINE_SIZE);
+
+	plat_early_init_devtree();
+	plat_setup_iocoherency();
+
+	if (IS_ENABLED(CONFIG_EVA))
+		free_init_pages_eva = free_init_pages_eva_intel;
+	else
+		free_init_pages_eva = 0;
+}
+
+void __init device_tree_init(void)
+{
+	unflatten_and_copy_device_tree();
+}
+
+phys_addr_t mips_cpc_default_phys_base(void)
+{
+	return CPC_BASE_ADDR;
+}
+
+/*
+ * IG-171 (RX-capture gate, IG-170 fork A): the IG-170 triple audit left ONE
+ * untested real divergence against the working AVM 4.9 system on the
+ * PMAC/DMA1RX->CBM capture path: core 0's CM coherence-domain membership.
+ * IG-166 skips the smp-cps CCA-force + GCR_CL_COHERENCE join under
+ * INTEL_MIPS — and only ever validated the SKIP; the working system boots
+ * with the core in the domain. Hypothesis: the EQM/FSQM control path
+ * (free-list pop / buffer exchange) issues coherent requests that stall
+ * when the core is outside the domain => FSQM OFSC never dips, eqpc==0,
+ * IG-158 "accepts-once". Run the join LATE (arch_initcall: console live,
+ * still ahead of the CBM/GSW/DMA hardware init at later initcall levels)
+ * with the state printed and flushed around every step so a hang
+ * localises to one specific write. Boot-hang risk accepted — that risk is
+ * why IG-166 skipped it. Revert-ready.
+ */
+static int __init ig171_cm_join(void)
+{
+	u32 cca, coh;
+
+	if (!mips_cm_present()) {
+		pr_info("IG-171: mips_cm_present()=0 - no GCRs to read/join\n");
+		return 0;
+	}
+
+	cca = read_c0_config() & CONF_CM_CMASK;
+	coh = read_gcr_cl_coherence();
+	pr_info("IG-171: pre cca=%u cl_coherence=0x%02x cl_config=0x%08x gcr_config=0x%016llx base=0x%016llx access=0x%08x rev=0x%08x err_control=0x%08x error_cause=0x%016llx l2_config=0x%08x\n",
+		cca, coh, read_gcr_cl_config(),
+		(unsigned long long)read_gcr_config(),
+		(unsigned long long)read_gcr_base(),
+		read_gcr_access(), read_gcr_rev(), read_gcr_err_control(),
+		(unsigned long long)read_gcr_error_cause(),
+		read_gcr_l2_config());
+	pr_flush(1000, true);
+
+	if ((coh & 0xff) != 0xff) {
+		pr_info("IG-171: joining coherence domain: cl_coherence 0x%02x -> 0xff ...\n",
+			coh);
+		pr_flush(1000, true);
+		write_gcr_cl_coherence(0xff);
+		pr_info("IG-171: join write survived; cl_coherence=0x%02x\n",
+			read_gcr_cl_coherence());
+	} else {
+		pr_info("IG-171: core 0 ALREADY fully joined (0xff) - firmware did it; join lever is a no-op\n");
+	}
+	pr_flush(1000, true);
+
+	if (cca != 5) {
+		pr_info("IG-171: forcing Config.K0 CCA %u -> 5 (coherent CWB) ...\n",
+			cca);
+		pr_flush(1000, true);
+		change_c0_config(CONF_CM_CMASK, 0x5);
+		pr_info("IG-171: CCA force survived; cca=%u\n",
+			(u32)(read_c0_config() & CONF_CM_CMASK));
+	} else {
+		pr_info("IG-171: Config.K0 already CCA5\n");
+	}
+	pr_flush(1000, true);
+
+	return 0;
+}
+arch_initcall(ig171_cm_join);
+
+void __init prom_init(void)
+{
+	prom_init_cmdline();
+
+	/*
+	 * IG-166: mips_cpc_probe() skipped — it would execute
+	 * write_gcr_cpc_base(0x12310000|CPCEN), claiming a CM decode window
+	 * that no working GRX500 configuration enables (AVM has no
+	 * CONFIG_MIPS_CPC; vendor SMP is CMP+VMB, firmware-launched). Keep
+	 * the CM/fabric state byte-identical to the working 4.9 system.
+	 */
+
+	if (!register_cps_smp_ops())
+		return;
+
+	if (!register_vsmp_smp_ops())
+		return;
+}
diff --git a/arch/mips/intel-mips/time.c b/arch/mips/intel-mips/time.c
new file mode 100644
index 0000000000000..deb462c21df6d
--- /dev/null
+++ b/arch/mips/intel-mips/time.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2016 Intel Corporation.
+ */
+
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/clocksource.h>
+#include <linux/of.h>
+
+#include <asm/time.h>
+
+void __init plat_time_init(void)
+{
+	unsigned long cpuclk;
+	struct device_node *np;
+	struct clk *clk;
+
+	of_clk_init(NULL);
+
+	np = of_get_cpu_node(0, NULL);
+	if (!np) {
+		pr_err("Failed to get CPU node\n");
+		return;
+	}
+
+	clk = of_clk_get(np, 0);
+	if (IS_ERR(clk)) {
+		pr_err("Failed to get CPU clock: %ld\n", PTR_ERR(clk));
+		return;
+	}
+
+	cpuclk = clk_get_rate(clk);
+	/* the chip resolution is the half of the clock*/
+	mips_hpt_frequency = cpuclk / 2;
+	clk_put(clk);
+
+	write_c0_compare(read_c0_count());
+	pr_info("CPU Clock: %ldHz  mips_hpt_frequency %dHz\n",
+		cpuclk, mips_hpt_frequency);
+	timer_probe();
+}
