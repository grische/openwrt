+
+   \return Return value as follows:
+   - GSW_statusOk: if successful
+   - An error code in case an error occurs
+
+*/
+#define GSW_IRQ_GET _IOWR(GSW_COMMON_MAGIC, 0x03, GSW_irq_t)
