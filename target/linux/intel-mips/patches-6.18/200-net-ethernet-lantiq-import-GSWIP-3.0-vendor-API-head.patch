+/* Bit: 'PEN_1' */
+/* Description: 'Polling State Machine Enable' */
+#define GSWT_MDCCFG_0_PEN_1_OFFSET 0x007
+#define GSWT_MDCCFG_0_PEN_1_SHIFT 1
