+/*
+ * ST-003 additions: slot-table API for the gsw_devs[LTQ_GSW_DEV_MAX] dispatch
+ * array. Co-located with ethsw_api_dev_t per the attempt-2 review decision.
+ *
+ * gsw_devs_register installs `dev` at index `devid`. Returns 0 on success,
+ * -EINVAL if devid >= LTQ_GSW_DEV_MAX or dev is NULL, -EEXIST if the slot is
+ * already occupied (caller-side accident, e.g. probing the same instance
+ * twice). The mutex inside the implementation serialises writes; readers of
+ * the slot table use lock-free RCU-style snapshot reads (see gsw_flow_core.c).
+ *
+ * gsw_devs_unregister clears the slot. Silently tolerates devid out-of-range.
+ */
+int gsw_devs_register(u32 devid, ethsw_api_dev_t *dev);
+void gsw_devs_unregister(u32 devid);
+
+/*
+ * Sub-2 / ST-004 cross-TU PCE bring-up prototypes.
+ *
+ * gsw_pce_attach_tbl_30 wires the GSWIP-3.0 PCE table-shape descriptor (the
+ * 31-entry gsw_pce_tbl_info_30[] array) plus the three PCE_TBL_KEY / MASK /
+ * VAL register-offset arrays into a per-instance ethsw_api_dev_t. Called
+ * exactly once per probe, immediately before gsw_pmicro_code_init runs, so
+ * that the PCE indirect-table helpers (gsw_pce_table_{read,write,key_read,
+ * key_write}) can dereference pethdev->pce_tbl_info / pce_tbl_reg.{key,mask,
+ * value}. Implementation lives in gsw_flow_pce.c (Sub-2 ST-001).
+ *
+ * gsw_pmicro_code_init runs the v108rn-mandated GSWIP-3.0 microcode load
+ * sequence: FDMA/SDMA disable loop with the GSW-R hole-skip -> GSWT_GCTRL_SE=1
+ * (FDMA arbiter activation gate) -> PCE_GCTRL_0.MC_VALID=0 -> 256-row
+ * microcode write via gsw_pce_table_write(PCE_PARS_INDEX) -> MC_VALID=1 ->
+ * RMON enable pair-of-loops -> BM_QUEUE_GCTRL.GL_MOD=0. @cdev follows the
+ * void * cdev convention shared with the gsw_r32 / gsw_w32 accessor family
+ * (see gsw_init.h:GSW_PDATA_GET). Returns GSW_statusOk on success,
+ * GSW_statusErr on row-write failure; the probe path maps GSW_statusErr to
+ * the kernel -EIO platform_driver contract (AC-004-3 / AC-004-12).
+ * Implementation lives in gsw_flow_pce.c (Sub-2 ST-003).
+ */
+void gsw_pce_attach_tbl_30(ethsw_api_dev_t *pethdev);
+int gsw_pmicro_code_init(void *cdev);
