+	/** Configures the traffic class to PCP (3-bit) mapping.
+	    The queue index starts counting from zero. */
+	//   u8	nPCP_DEI[16];
+
+	/** Configures the traffic class to CPCP (3-bit) mapping.
+	    The queue index starts counting from zero. */
+	u8 nCPCP[16];
+
+	/** Configures the traffic class to SPCP (3-bit) mapping.
+	    The queue index starts counting from zero. */
