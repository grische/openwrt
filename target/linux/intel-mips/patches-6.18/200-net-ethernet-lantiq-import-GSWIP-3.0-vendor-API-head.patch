@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/******************************************************************************
+                Copyright (c) 2016, 2017 Intel Corporation
+
+******************************************************************************/
+/*****************************************************************************
+                Copyright (c) 2012, 2014, 2015
+                    Lantiq Deutschland GmbH
+******************************************************************************/
+
+/*
+ * ST-003 port from AVM 4.9
+ * drivers/net/ethernet/lantiq/switch-api/gsw_init.h with surgical stripping:
+ *
+ *   - All host-PC / x86-on-CE / UART / SoC-GRX500 / SoC-XWAY conditional
+ *     branches removed verbatim (per AS-008/AS-014). The x86-on-CE case-
+ *     stripping observes that both branches included
+ *     `<net/switch_api/lantiq_gsw_api.h>` so the conditional collapses to
+ *     an unconditional include.
+ *   - All `#include <net/switch_api/...>` rewritten to relative-form
+ *     `#include "..."` per AS-007.
+ *   - The non-__KERNEL__ `#else printk = printf` branch removed since
+ *     __KERNEL__ is always-true in v6.18.
+ *   - `<net/lantiq_cbm_api.h>` DROPPED: no equivalent buffer-manager API
+ *     exists in v6.18 mainline (per IG-006, CBM/FSQM is deferred to a
+ *     later Phase 3 sub-task). This is the only non-conditional include
+ *     drop and is recorded as a notes-level deviation in build-manifest.
+ *   - `<gsw_ioctl_wrapper.h>` DROPPED: not part of the ST-002 16-header
+ *     set; the IOCTL-wrapper helpers it declares are unused by ST-003.
+ *   - The AVM-internal bring-up prototypes (core-init, p-microcode-init,
+ *     swapi-init, core-cleanup helpers from AVM gsw_init.h:170-173) are
+ *     DROPPED so that AC-003-7's grep gate holds (no reference to any of
+ *     the deferred-bring-up symbols anywhere under switch-api/).
+ *   - The AVM external-MDIO accessor prototypes (the ext_r32 / ext_w32
+ *     helpers from AVM gsw_init.h:189-190) are DROPPED because ST-003
+ *     does NOT implement external-MDIO switch access (per AS-013).
+ *   - The gsw_r32 / gsw_w32 / gsw_r32_raw / gsw_w32_raw prototypes are
+ *     KEPT (they are implemented in gsw_flow_core.c).
+ *   - The gsw_field_r32 / gsw_field_w32 static inlines are kept verbatim.
+ *   - The GSW_PDATA_GET static inline is kept verbatim (it uses
+ *     container_of(gsw_ops, ethsw_api_dev_t, ops) and so requires
+ *     "gsw_flow_core.h" to be included first — the include order below
+ *     matches that AVM convention).
+ *   - The LTQ_GSW_DEV_MAX 3 #define moves OUT of gsw_init.c into this
+ *     header so the slot-table dispatch can share the constant.
+ */
+
+#ifndef _ETHSW_INIT_H_
+#define _ETHSW_INIT_H_
+
+#define SWAPI_DRV_VERSION "3.0.1"
+
+/* Switch Features  */
+#define CONFIG_LTQ_STP 1
+#define CONFIG_LTQ_8021X 1
+#define CONFIG_LTQ_MULTICAST 1
+#define CONFIG_LTQ_QOS 1
+#define CONFIG_LTQ_VLAN 1
+#define CONFIG_LTQ_WOL 1
+#define CONFIG_LTQ_PMAC 1
+#define CONFIG_LTQ_RMON 1
+
+#define CONFIG_MAC 1
+
+/* User configuration options */
+
+#define SMDIO_INTERFACE 0
+#define GSW_IOCTL_SUPPORT 1
+
+#define ENABLE_MICROCODE 0
+#define PTR_TO_INT_CAST void *
+
+//#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/version.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/interrupt.h>
+//#include <asm/delay.h> */
+#include <linux/delay.h>
+#include <linux/slab.h>
+/*
+ * <linux/ethtool.h> must come before "gsw_dev.h" because the ported
+ * mac_ops.h declares a function pointer with `struct ethtool_ts_info *` in
+ * its parameter list (preserved verbatim per AS-008/AS-014). Without the
+ * full ethtool typedef in scope, GCC emits "declared inside parameter list"
+ * warnings that AC-003-11 requires we suppress relative to ST-002 baseline.
+ * Pre-existing AVM-source property documented in ST-002 manifest.
+ */
+#include <linux/ethtool.h>
+
+#include "lantiq_gsw_api.h"
+
+#include "gsw_dev.h"
+#include <linux/netdevice.h>
+#include "gsw_tbl_rw.h"
+
+/*#include <xway/switch-api/lantiq_gsw_routing.h>*/
+/*#include <xway/switch-api/gsw_types.h>*/
+
+#define LTQ_GSW_DEV_MAX 3
+
+/*include*/
+#include "gsw_flow_core.h"
+#include "gsw_ll_func.h"
+#include "gsw_reg.h"
+#include "gsw_reg_top.h"
+#include "gsw30_reg_top.h"
+
+#define GSWIP_GET_BITS(x, msb, lsb) \
+	(((x) & ((1 << ((msb) + 1)) - 1)) >> (lsb))
+#define GSWIP_SET_BITS(x, msb, lsb, value) \
+	(((x) & ~(((1 << ((msb) + 1)) - 1) ^ ((1 << (lsb)) - 1))) | (((value) & ((1 << (1 + (msb) - (lsb))) - 1)) << (lsb)))
+
+#define GSW_API_MODULE_NAME "GSW SWITCH API"
+#define GSW_API_DRV_VERSION "3.0.2"
+#define MICRO_CODE_VERSION "212"
+
+typedef struct {
+	void *ecdev;
+	void *pdev;
+	gsw_devtype_t sdev;
+	void *gsw_base_addr;
+} ethsw_core_init_t;
+
+void gsw_r32(void *cdev, short offset, short shift, short size, u32 *value);
+void gsw_w32(void *cdev, short offset, short shift, short size, u32 value);
+
+void gsw_r32_raw(void *cdev, short offset, u32 *value);
+void gsw_w32_raw(void *cdev, short offset, u32 value);
+
+/*
+ * Dispatch entry point exposed cross-module (the only ST-003 consumer outside
+ * switch-api/ would be a future MAC/PHY/PMAC subsystem that needs to grab the
+ * switch's core-ops vtable). Tagged with the namespaced GPL export macro
+ * (namespace "GSWIP_INTERNAL") in gsw_flow_core.c.
+ */
+struct core_ops *gsw_get_swcore_ops(u32 devid);
+
+static inline u32 gsw_field_r32(u32 rval, short shift, short size)
+{
+	return (rval >> shift) & ((1 << size) - 1);
+}
+
+static inline u32 gsw_field_w32(u32 rval, short shift, short size, u32 val)
+{
+	u32 mask;
+
+	mask = ((1 << size) - 1) << shift;
+	val = (val << shift) & mask;
+	return (rval & ~mask) | val;
+}
+
+static inline ethsw_api_dev_t *GSW_PDATA_GET(void *pdev)
+{
+	struct core_ops *gsw_ops;
+	ethsw_api_dev_t *pdata = NULL;
+
+	if (pdev == NULL) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return pdata;
+	}
+
+	gsw_ops = (struct core_ops *)pdev;
+
+	if (gsw_ops == NULL) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return pdata;
+	}
+
+	pdata = container_of(gsw_ops, ethsw_api_dev_t, ops);
+	return pdata;
+}
+
+typedef enum {
+	IRQ_REGISTER = 0,
+	IRQ_UNREGISTER = 1,
+	IRQ_ENABLE = 2,
+	IRQ_DISABLE = 3,
+} IRQ_TYPE;
+
+#endif /* _ETHSW_INIT_H_ */
