+	 */
+	int (*ss_set_inten)(void *, u32, u32, u32);
+	/* This function Gets the Interrupt Sts Register.
+	 * param[in/out]	IN:	ops Adaption ops Struct registered.
+	 * param[in/out]	IN:	module	0 - XGMAC
+	 *					4 - LINK
