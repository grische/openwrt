+/**
+ * intel_xrx500_get_gswl_dev() - recover the GSW-L ethsw_api_dev_t.
+ *
+ * Returns the per-instance ethsw_api_dev_t pointer registered by
+ * switch-api/gsw_init.c for devid=0 (GSW-L). The pointer is recovered
+ * via gsw_get_swcore_ops(0) followed by GSW_PDATA_GET (container_of
+ * over the embedded struct core_ops field).
+ *
+ * Returns NULL while GSW-L probe has not yet completed (the caller
+ * must treat this as -EPROBE_DEFER).
+ */
+static void *intel_xrx500_get_gswl_dev(void)
+{
+	struct core_ops *ops = gsw_get_swcore_ops(0);
+
+	if (!ops)
+		return NULL;
+
+	return GSW_PDATA_GET(ops);
+}
+
+/**
+ * intel_xrx500_port_from_config() - recover per-port struct from phylink_config.
+ * @config: phylink_config pointer handed in by a phylink_mac_ops callback.
+ *
+ * The phylink_config field is embedded by value inside
+ * struct intel_xrx500_port, so container_of recovers the owning port.
+ */
+static inline struct intel_xrx500_port *
+intel_xrx500_port_from_config(struct phylink_config *config)
+{
+	return container_of(config, struct intel_xrx500_port, phylink_config);
+}
+
+/*
+ * ===========================================================================
+ * phylink_mac_ops
+ * ===========================================================================
+ *
+ * mac_get_caps returns the static cap bitmap (10/100/1000FD + pause
+ * caps for phylink validation). Phylink uses this to negotiate the
+ * resolved link speed before calling mac_link_up.
+ *
+ * mac_select_pcs returns NULL because there is no internal PCS on the
+ * GSW-L instance for these LAN ports - the PHYs talk directly to the
+ * GSWIP MAC over the internal interface (AS-012). Phylink tolerates a
+ * NULL PCS pointer in PHY-attached mode.
+ *
+ * mac_config is a no-op, and per IG-103 mac_link_down / mac_link_up
+ * perform NO register writes either: link->MAC coupling on GSWIP-3.0
+ * is the hardware MDIO poller's job (MDC_CFG_0.PEN_2..5, enabled in
+ * mdio_xrx500.c), matching how AVM-stock operates this silicon. The
+ * pre-IG-103 software path (MAC_CTRL_0 programming + PHY_ADDR force,
+ * IG-099/IG-100) is retired — see the history comment above
+ * mac_link_up.
+ */
+
+/**
+ * intel_xrx500_mac_get_caps() - return MAC capabilities for an interface mode.
+ * @config:    phylink_config (carries the static mac_capabilities bitmap).
+ * @interface: PHY interface mode under negotiation.
+ *
+ * Returns config->mac_capabilities verbatim per AC-003-3. The static
+ * MAC_1000FD|MAC_100FD|MAC_10FD bitmap set at probe time satisfies all
+ * four LAN ports - there is no interface-mode-specific narrowing.
+ */
+static unsigned long intel_xrx500_mac_get_caps(struct phylink_config *config,
+					       phy_interface_t interface)
+{
+	return config->mac_capabilities;
+}
+
+/**
+ * intel_xrx500_mac_select_pcs() - select a PCS for the interface mode.
+ * @config:    phylink_config.
+ * @interface: PHY interface mode under negotiation.
+ *
+ * Returns NULL per AS-012: no internal PCS exists on the GSW-L for the
+ * four LAN ports. The PHYs talk directly to the GSWIP MAC over the
+ * internal interface.
+ */
+static struct phylink_pcs *
+intel_xrx500_mac_select_pcs(struct phylink_config *config,
+			    phy_interface_t interface)
+{
+	return NULL;
+}
