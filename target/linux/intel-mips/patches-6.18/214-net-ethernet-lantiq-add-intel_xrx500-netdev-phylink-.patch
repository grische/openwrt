+/*
+ * Full definition of struct dp_subif, mirroring the layout used by
+ * datapath/datapath_api.c (which defines its own local copy by the same
+ * convention — see the "IMPORTANT: each TU that needs these uses its own
+ * local definition" comment block in datapath_api.c). datapath_api.h
+ * only forward-declares the tag because cross-TU passing is by-pointer;
+ * to stack-allocate a dp_subif instance here we need the full layout.
+ * Field order/sizes MUST match datapath_api.c's local copy bit-for-bit
+ * or dp_register_subif's reads/writes through the pointer will land in
+ * the wrong slot.
+ */
+struct dp_subif {
+	s32 port_id;
+	int inst;
+	int subif_num;
+	s32 subif;
+};
+
+#define INTEL_XRX500_DRV_NAME "intel-xrx500"
+
+/*
+ * Sentinel `struct module` used as the `owner` argument when calling
+ * AVM-ported dp_alloc_port_ext / dp_register_subif / dp_dealloc_port_ext.
+ *
+ * AVM's datapath_api.c rejects `owner == NULL` (`"Allocate port failed
+ * for owner NULL"`, datapath_api.c:411) and dereferences `owner->name` in
+ * its dev_err / hashing paths. For loadable-module builds the kernel's
+ * THIS_MODULE expands to `&__this_module`, which is stable + has a name.
+ * For builtin builds (our default, CONFIG_INTEL_XRX500_GSWIP_API=y per
+ * IG-011) THIS_MODULE expands to NULL — and the datapath check rejects
+ * the call.
+ *
+ * We need a non-NULL, stable, named pointer that we can hand to the
+ * AVM-ported API instead. A static `struct module` with .name set
+ * does the job: address-stable for the life of the .ko/.o, dereference-
+ * safe, and the name shows up in dp_dev / dev_err diagnostics.
+ *
+ * The sentinel is NEVER passed to module_get/put — datapath_api.c uses
+ * `owner` only as an identity pointer + for .name. The unused struct
+ * fields stay zero-init which is benign for that read-only usage.
+ */
+static struct module intel_xrx500_module_sentinel = {
+	.name = INTEL_XRX500_DRV_NAME,
+};
+#define INTEL_XRX500_DP_OWNER (&intel_xrx500_module_sentinel)
+
+/*
+ * Per-port MAC register stride (GSWIP-3.0).
+ *
+ * MAC_PSTAT_LSTAT lives at word-offset MAC_PSTAT_LSTAT_OFFSET = 0x900
+ * for port 0. AVM 4.9 gsw_flow_core.c:12764 accesses per-port copies
+ * via the expression `MAC_PSTAT_LSTAT_OFFSET + (0xC * pidx)`. So each
+ * port consumes 12 word-offsets (= 48 bytes) and the per-port stride
+ * is 0xC words.
+ *
+ * Sub-register offsets within the per-port window (from gsw_reg.h
+ * lines 3152-3520):
+ *   MAC_PSTAT      0x900  port status
+ *   MAC_PISR       0x901  port interrupt status
+ *   MAC_PIER       0x902  port interrupt enable
+ *   MAC_CTRL_0     0x903  GMII (speed) / FDUP / FCON / FCS / PADEN / BM
+ *   MAC_CTRL_1     0x904  IPG / SHORTPRE / DEFERMODE
+ *   MAC_CTRL_2     0x905  LCHKS / LCHKL / MLEN
+ *   MAC_CTRL_3     0x906  RCNT (retry count)
+ *   MAC_CTRL_4     0x907  WAIT / LPIEN / GWAIT (EEE LPI timing)
+ *   MAC_CTRL_5     0x908  PJPS_BP / PJPS_NOBP
+ *   MAC_LPITMER0   0x909  LPI timer LSB
+ *   MAC_LPITMER1   0x90A  LPI timer MSB
+ *   MAC_TESTEN     0x90B  test enables
+ *
+ * The plan refers to these registers by their AVM functional name
+ * MAC_PCFG (port configuration) - that maps to MAC_CTRL_0 in the
+ * gsw_reg.h naming, since MAC_CTRL_0 carries the speed (GMII),
+ * full-duplex (FDUP), and flow-control (FCON) fields that mac_link_up
+ * must program.
+ */
+#define INTEL_XRX500_MAC_PORT_STRIDE  0xC
+
+/*
+ * Speed encoding for MAC_CTRL_0[GMII] field (bits 0..1, size 2).
+ *
+ * GSWIP-3.0 datasheet encodings (datasheet table referenced from
+ * the gsw_reg.h bit description "GMII/MII interface mode selection"):
+ *   00 = MII mode (10 Mbps half-duplex baseline)
+ *   01 = MII 100 Mbps
+ *   10 = GMII 1000 Mbps
+ *   11 = reserved
+ *
+ * Clearing the GMII field to 00 in mac_link_down places the port in
+ * its lowest-rate idle mode (per AC-003-3). When asserting mac_link_up
+ * (AC-003-3) we additionally assert the FCS bit (bit 7 of MAC_CTRL_0)
+ * which is the "Transmit FCS Control" enable - the per-port MAC enable
+ * bit in MAC_CTRL_0 terminology. (There is no dedicated single-bit
+ * "MAC enable" in MAC_CTRL_0; FCS=1 is the operationally-equivalent
+ * gate that mac_link_down clears alongside the speed/duplex/flow
+ * fields.)
+ */
+#define INTEL_XRX500_GMII_10M   0x0u
+#define INTEL_XRX500_GMII_100M  0x1u
+#define INTEL_XRX500_GMII_1000M 0x2u
+
+/*
+ * FDUP encoding for MAC_CTRL_0[FDUP] field (bits 2..3, size 2).
+ *
+ *   00 = half-duplex
+ *   01 = full-duplex
+ *   10 = reserved
+ *   11 = reserved
+ */
+#define INTEL_XRX500_FDUP_HALF  0x0u
+#define INTEL_XRX500_FDUP_FULL  0x1u
+
+/*
+ * FCON encoding for MAC_CTRL_0[FCON] field (bits 4..6, size 3).
+ *
+ *   000 = no flow control
+ *   001 = symmetric pause (RX + TX)
+ *   010 = TX pause only
+ *   011 = RX pause only
+ *   1xx = auto-negotiated (handled by phylink)
+ *
+ * IG-100 CORRECTION: the comment block above transcribed the encodings
+ * wrong. Real hardware encoding (AVM lantiq_gsw.h:1959-1967, written
+ * verbatim to FCON at gsw_flow_core.c:4271; mainline lantiq_gswip.h
+ * GSWIP_MAC_CTRL_0_FCON_* agrees): 0=AUTO, 1=RX-only, 2=TX-only,
+ * 3=RXTX (symmetric), 4=NONE. Constants fixed to match.
+ */
+#define INTEL_XRX500_FCON_NONE  0x4u
+#define INTEL_XRX500_FCON_SYM   0x3u
+#define INTEL_XRX500_FCON_TX    0x2u
+#define INTEL_XRX500_FCON_RX    0x1u
+
+/*
+ * ST-005 polled-DMA TX path tunables.
+ *
+ * DMA_TX_RING_DEPTH — power-of-two descriptor-ring slot count programmed
+ *   into silicon CDLEN at ndo_open step 4. Value 32 chosen as a safe
+ *   initial: small enough that the 32 * 16 = 512-byte ring fits inside
+ *   a single L1 cache line set (FB7560 24Kc MIPS L1: 64-byte lines, 8-way
+ *   = 32 KiB total — 512B carves cleanly without thrashing), large enough
+ *   to absorb a CPU stall mid-busy-poll without rolling over the head
+ *   pointer on the next ndo_start_xmit invocation. 32 also matches
+ *   Sub-4B's HDMA_PORT_DESC_NUM precedent (hdma.c:2322) — keeps the two
+ *   TX-side ring depths consistent.
+ *
+ * INTEL_XRX500_TX_POLL_TIMEOUT_US — 5000us hard cap on the busy-poll
+ *   wait per AC-005-3. 5ms chosen because (a) it is the IG-020 latency
+ *   trigger threshold quoted in the AC ("ping latency <50ms median") so
+ *   exceeding it indicates the DMA engine has stalled; (b) it is large
+ *   enough that even a worst-case CBM congestion + jumbo-frame burst
+ *   (8192 bytes at line-rate 1Gbps = 65us nominal + ~10x for CBM stages)
+ *   does not falsely trigger; and (c) lock-held-during-wait per AC-005-7
+ *   means longer caps would unacceptably increase preemption latency on
+ *   sibling CPUs.
+ *
+ * INTEL_XRX500_TX_POLL_INCREMENT_US — 100us per busy-poll iteration.
+ *   Gives 50 max iterations under the 5000us cap. Hardware-side rough
+ *   nominal completion latency for an MTU-sized frame at 1Gbps is
+ *   ~12us; 100us provides headroom while keeping the loop tight enough
+ *   that an early-completion path drops out quickly.
+ */
+#define DMA_TX_RING_DEPTH                  32U
+#define INTEL_XRX500_TX_POLL_TIMEOUT_US    5000U
+#define INTEL_XRX500_TX_POLL_INCREMENT_US  100U
+
+/*
+ * IG-123 (GAP A2): the per-port DMA1TX_LAN_SWITCH_CLASS{0..3} TX channel
+ * lookup table (struct intel_xrx500_tx_chan_desc intel_xrx500_tx_chan_tbl[])
+ * is REMOVED. It was the "4 dedicated DMA1TX channels" admit design, but
+ * ndo_start_xmit never enqueues to those channels — the CPU-TX path rides the
+ * CBM EQM CPU port -> DMA2TX ch5 via cbm_cpu_enqueue_hw (proven by IG-116/119
+ * CPU-TX frames at GPHY5). Holding DMA1TX ch0 here was the SOLE reason the AVM
+ * host-RX p2p bridge (setup_DMA_p2p) had to be disabled (-EBUSY on ch0).
+ * Retiring this claim frees DMA1TX ch0 for the bridge so RX delivers, while TX
+ * stays unchanged on DMA2TX ch5. (Mapping kept in git history.)
+ */
+
+/*
+ * Cross-TU CBM buffer-pool prototypes.
+ *
+ * cbm_buf_alloc / cbm_buf_free are defined in cqm/grx500/cbm_buf.c. Their
+ * authoritative declarations live in cqm/grx500/cbm.h, which is outside
+ * this driver's natural include path (we already use the
+ * "switch-api/..." / "dma/..." / "tmu/..." / "datapath/..." pattern from
+ * ST-003/ST-004; adding a "cqm/grx500/..." include for two function
+ * prototypes is heavier than needed). Mirror the prototypes here per the
+ * Sub-4 cbm.c precedent (cbm.c declares cbm_buf_init_pools /
+ * cbm_buf_pool_phys_base as extern at file scope rather than widening
+ * cbm.h) — same intra-composite linkage discipline.
+ *
+ * Per AC-005-2 (c) the call site uses size-based dispatch: the size
+ * argument routes to std (<= 2048) or jbo (<= 8192) pool automatically.
+ * The third u32 *pool_phys out-param receives the physical address of
+ * the returned chunk; this is REQUIRED for our path because the CBM
+ * pools live in `no-map` reserved-memory regions per Sub-6 ST-002, so
+ * virt_to_phys() against the cbm_buf_alloc return is undefined. The
+ * plan text reads "cbm_buf_alloc(skb->len, NULL, 0)" + "virt_to_phys(buf)"
+ * — that combination would oops on `no-map` memory. We pass a &pool_phys
+ * out-param to retrieve the correct address; the substitution is a
+ * physical-address-acquisition adjustment recorded in the manifest notes.
+ */
+void *cbm_buf_alloc(u32 size, u32 *pool_phys, u32 flags);
+int cbm_buf_free(void *buf, u32 size);
+
+/*
+ * IG-052: the CPU-TX buffer MUST come from the FSQM hardware free-segment
+ * pool (a BUFREQ checkout), not the software carve (cbm_buf_alloc). Only an
+ * FSQM-checked-out segment establishes the CBM in-flight cell state, without
+ * which the DQM dequeue descriptor's data_len reconstructs to 0 and the
+ * DMA2TX transmits 0 bytes (nothing egresses). Defined in cqm/grx500/cbm_dma.c
+ * (BUFREQ new_sptr pop) + cbm_buf.c (phys->virt); mirrored here per the same
+ * intra-composite extern discipline as cbm_buf_alloc above.
+ *
+ * IG-146: cbm_fsqm_buf_alloc gained a @flags pool-select arg (std=new_sptr,
+ * jumbo=new_jptr) when dma_p7/dma_p8 became dual std+jumbo. The CPU-TX path
+ * here always wants a STANDARD segment (MTU 1500 + 8B PMAC < 2048). The flag
+ * macro is defined locally because this TU deliberately does not include
+ * cqm/grx500/cbm.h (same discipline as the prototypes above; value per AVM
+ * lantiq_cbm_api.h:114).
+ */
+#define CBM_PORT_F_STANDARD_BUF  0x1U
+void *cbm_fsqm_buf_alloc(int pid, u32 flags, u32 *buf_phys);
+int cbm_fsqm_buf_free(int pid, u32 buf_phys);
+
+/*
+ * cbm_cpu_enqueue_hw — fire-and-forget CPU TX enqueue to the CBM EQM
+ * CPU ingress port (cqm/grx500/cbm_dma.c; faithful port of AVM
+ * cpu_enqueue_hw). Declared here for the same intra-composite linkage
+ * reason as cbm_buf_alloc above (authoritative decl in
+ * include/net/cqm_cbm_api.h).
+ */
+int cbm_cpu_enqueue_hw(int pid, u32 dw0, u32 dw1, u32 data_phys, u32 dw3);
+
+/*
+ * IG-068: turn_on_DMA_p2p — enable the AVM DMA1TX<->DMA2RX peripheral-to-
+ * peripheral bridge channels at ndo_open (defined in cqm/grx500/cbm.c, a
+ * faithful port of AVM cbm.c:4996). AVM calls cbm_turn_on_DMA_p2p() from
+ * ltq_eth_open (ltq_eth_drv_xrx500.c:407). Gated by cbm_p2p_setup_done /
+ * cbm_p2p_turned_on inside the callee: a no-op (returns -EPERM) until
+ * setup_DMA_p2p ran at probe, and idempotent after the first open. Declared
+ * here per the same intra-composite extern discipline as cbm_cpu_enqueue_hw
+ * above (no cqm/grx500/cbm.h include in this TU).
+ */
+int turn_on_DMA_p2p(void);
+
+/*
+ * IG-095 ST-004: cbm_rx_set_netdev — bind (dev) / unbind (NULL) the single
+ * netdev the Sub-4 LS-tasklet RX engine delivers received frames to. Defined
+ * in cqm/grx500/cbm_intr.c (it stores the pointer in the engine's
+ * g_cbm_rx_netdev). The LAN-port netdev (eth0 for the GPHY5/port-7 path) is
+ * only known at ndo_open, so the binding is set on the ndo_open success path
+ * and cleared in ndo_stop, matching the port up/down lifetime. Accepts NULL:
+ * do_cbm_tasklet then drops-and-recycles each frame (ST-002 AC-002-5), so an
+ * unbind racing an in-flight tasklet is safe (no leak, no oops). Declared here
+ * per the same intra-composite extern discipline as turn_on_DMA_p2p /
+ * cbm_cpu_enqueue_hw above (no cqm/grx500/cbm.h include in this TU).
+ */
+void cbm_rx_set_netdev(struct net_device *dev);
+
+/*
+ * IG-056: AVM's cbm_cpu_pkt_tx_grx500 places the CPU-TX frame at
+ * new_buf + CBM_FIXED_RX_OFFSET inside the FSQM segment (cbm.c:2107,2113),
+ * NOT at the segment base. We had placed it at the base; the descriptor
+ * data_len lands correctly at the EQM enqueue (IG-055 read-back: +0xC=0x..44)
+ * but the DQM reconstructs the dequeue data_len as 0 (PMAC TOOSHORT, nothing
+ * egresses; IG-054). The frame's segment-relative offset is the only proven
+ * per-frame layout difference from AVM, so mirror it exactly.
+ *
+ * Must equal cqm/grx500/cbm_regs.h CBM_FIXED_RX_OFFSET (kept out of this file
+ * per the intra-composite extern discipline above):
+ *   CBM_GRX550_DMA_DATA_OFFSET(128, static_assert'd in cbm.h:391)
+ *   + NET_IP_ALIGN + NET_SKB_PAD  (both from <linux/skbuff.h>).
+ * The low 3 bits (=2) are carried in DWORD3.byte_offset, like AVM setup_desc.
+ */
+#define XRX500_CBM_TX_DATA_OFFSET (128u + NET_IP_ALIGN + NET_SKB_PAD)
