+ * @state:  resolved link-state pointer.
+ *
+ * No-op per AC-003-3: link parameters are entirely conveyed via
+ * mac_link_up; the GSWIP MAC does not require a separate prepare/
+ * finish dance for our PHY_INTERFACE_MODE_INTERNAL configuration.
+ */
+static void intel_xrx500_mac_config(struct phylink_config *config,
+				    unsigned int mode,
+				    const struct phylink_link_state *state)
+{
+	/* Intentionally empty - see kdoc above. */
+}
