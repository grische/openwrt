+/**
+ * intel_xrx500_mac_link_down() - notification that the link has gone down.
+ * @config:    phylink_config (recover per-port struct via container_of).
+ * @mode:      autonegotiation mode.
+ * @interface: PHY interface mode.
+ *
+ * IG-103: no-op — the hardware MDIO poller owns MAC deactivation (see
+ * body comment). No netif_carrier_off call: phylink has already done
+ * that for us (per phylink.h:mac_link_down kdoc).
+ */
+static void intel_xrx500_mac_link_down(struct phylink_config *config,
+				       unsigned int mode,
+				       phy_interface_t interface)
+{
+	/*
+	 * IG-103: intentionally empty. With the GSWIP-3.0 hardware MDIO
+	 * polling unit enabled (MDC_CFG_0.PEN_2..5, mdio_xrx500.c) the
+	 * poller observes the PHY's link drop and deactivates the port
+	 * MAC itself — exactly how AVM runs (its adjust_link is an empty
+	 * stub, ltq_eth_drv_xrx500.c:1736-1740). The previous MAC_CTRL_0
+	 * field-clears + PHY_ADDR LNKST force-down (IG-099/IG-100) were
+	 * (a) a mode AVM never operates on this silicon and (b) aimed at
+	 * the WRONG MAC entry anyway — the GSWIP-3.0 legacy MAC PDI is
+	 * (port-1)-indexed (AVM gsw_flow_core.c:12684,13066-13076; corpus
+	 * v108pd/v108rr: GPHY5 link lights MAC entry 4 / byte 0x24C0,
+	 * while 0xC*5 addresses entry 5 = port 6).
+	 */
+}
+
+/*
+ * IG-046 -> IG-099 -> IG-103 history: IG-046 ("keep p5 MAC inactive")
+ * was retracted by IG-099; IG-099/IG-100 then actively programmed
+ * MAC_CTRL_0 + PHY_ADDR force words from mac_link_up. IG-103 retires
+ * that force path entirely: the AVM 4.9 completeness audit showed the
+ * working system NEVER writes MAC_CTRL_0 for GSW-L LAN ports on real
+ * hardware (the "0x93f=0x182" reference was CONFIG_USE_EMULATOR-only
+ * code, ltq_eth_drv_xrx500.c:968-979) and never holds PHY_ADDR force
+ * fields at steady state (corpus: PHY_ADDR_5=0x1805 AUTO on the working
+ * box). Link->MAC coupling is the hardware poller's job (MDC_CFG_0.PEN,
+ * see mdio_xrx500.c IG-103 comment); MAC_CTRL_0 stays at its reset
+ * default 0x0180 (corpus working value, both stock + Lane H).
+ */
+
+/**
+ * intel_xrx500_mac_link_up() - notification that the link has come up.
+ * @config:    phylink_config (recover per-port struct via container_of).
+ * @phy:      attached struct phy_device (unused - LPI deferred).
+ * @mode:      autonegotiation mode.
+ * @interface: PHY interface mode.
+ * @speed:     resolved link speed (SPEED_10 / 100 / 1000).
+ * @duplex:    resolved duplex (DUPLEX_FULL / DUPLEX_HALF).
+ * @tx_pause:  TX pause-frame admission status.
+ * @rx_pause:  RX pause-frame admission status.
+ *
+ * IG-103: logs the resolved link state only — the GSWIP-3.0 hardware
+ * MDIO poller performs the link->MAC coupling (see body comment).
+ */
+static void intel_xrx500_mac_link_up(struct phylink_config *config,
+				     struct phy_device *phy,
+				     unsigned int mode,
+				     phy_interface_t interface, int speed,
+				     int duplex, bool tx_pause, bool rx_pause)
+{
+	struct intel_xrx500_port *port = intel_xrx500_port_from_config(config);
+	unsigned int pidx = port->dp_port_id;
+
+	/*
+	 * IG-103: no register writes — AVM steady-state parity. The
+	 * hardware MDIO poller (MDC_CFG_0.PEN_2..5) conveys link/speed/
+	 * duplex/pause from the GPHY into MDIO_STAT_p and the port MAC
+	 * activates itself; AVM performs ZERO software writes at LAN
+	 * link-up (adjust_link stub, ltq_eth_drv_xrx500.c:1736-1740).
+	 * The retired IG-099 MAC_CTRL_0 programming also addressed MAC
+	 * entry pidx = port 6's MAC on the (port-1)-indexed GSWIP-3.0
+	 * MAC PDI — see the IG-103 note above mac_link_up. The retired
+	 * IG-100 PHY_ADDR force additionally wrote an FCONRX encoding (2)
+	 * that no reference uses (AVM gsw_flow_core.c:12156-12161 and
+	 * mainline lantiq_gswip.h:46-48 both say enable=1) — moot now.
+	 */
+
+	/*
+	 * AC-004-9: emit a per-port info line confirming the resolved
+	 * speed/duplex/flow-control. This is the affirmative signal
+	 * userspace ifconfig/ethtool will reconcile against once the link
+	 * comes up after ndo_open's phylink_start (step 4).
+	 */
+	netdev_info(port->netdev,
+		    "intel-xrx500: %s link up (speed=%dMbps duplex=%s flow=%s%s dp_port_id=%u)\n",
+		    netdev_name(port->netdev), speed,
+		    (duplex == DUPLEX_FULL) ? "full" : "half",
+		    tx_pause ? "tx" : "",
+		    rx_pause ? "rx" : (tx_pause ? "" : "none"),
+		    pidx);
+}
+
+static const struct phylink_mac_ops intel_xrx500_phylink_ops = {
+	.mac_get_caps   = intel_xrx500_mac_get_caps,
+	.mac_select_pcs = intel_xrx500_mac_select_pcs,
+	.mac_config     = intel_xrx500_mac_config,
+	.mac_link_down  = intel_xrx500_mac_link_down,
+	.mac_link_up    = intel_xrx500_mac_link_up,
+};
