+/**
+ * intel_xrx500_ethtool_get_link_ksettings() - phylink-routed link settings get.
+ * @dev:      source netdev.
+ * @ksettings: caller-allocated settings sink.
+ *
+ * AC-003-6: defers to phylink_ethtool_ksettings_get for the resolved
+ * link parameters.
+ */
+static int
+intel_xrx500_ethtool_get_link_ksettings(struct net_device *dev,
+					struct ethtool_link_ksettings *ksettings)
+{
+	struct intel_xrx500_port *port = netdev_priv(dev);
+
+	if (!port->phylink)
+		return -ENODEV;
+
+	return phylink_ethtool_ksettings_get(port->phylink, ksettings);
+}
