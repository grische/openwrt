+/*
+ * Local fallback definitions of the DP_F_* flag bits the AVM public-API
+ * enum carries in include/net/datapath_api.h. The same pattern is used in
+ * datapath_api.c — defining them with #ifndef so a future Sub-6.x that
+ * promotes the enum into a shared header does not generate a redefinition
+ * diagnostic. Byte values are AVM-canonical and must NOT drift from the
+ * datapath_api.c local fallbacks (the .o ABI must match across both TUs).
+ */
+#ifndef DP_F_DEREGISTER
+#define DP_F_DEREGISTER			0x00000001
+#endif
+#ifndef DP_F_FAST_ETH_LAN
+#define DP_F_FAST_ETH_LAN		0x00000002
+#endif
