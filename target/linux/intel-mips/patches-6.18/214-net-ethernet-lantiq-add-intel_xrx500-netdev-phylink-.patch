--- /dev/null
+++ b/drivers/net/ethernet/lantiq/include/intel_xrx500.h
@@ -0,0 +1,264 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Intel xRX500 netdev / phylink integration driver - intra-module API.
+ *
+ * Phase 3 Sub-6 ST-003: this header declares the per-port state object
+ * shared between intel_xrx500.c probe-time scaffolding (this subtask) and
+ * the future ndo_open / ndo_stop / ndo_start_xmit consumers
+ * (ST-004 / ST-005).
+ *
+ * Visibility note (CQ-004 B): every symbol declared here is
+ * INTRA-MODULE-ONLY. intel_xrx500.o lives inside the
+ * intel-xrx500-gswip composite (drivers/net/ethernet/lantiq/Makefile)
+ * alongside switch-api/, datapath/, cqm/, dma/ and tmu/. Future
+ * Phase-3 sub-tasks consuming these definitions reach them as ordinary
+ * file-local linkage; no EXPORT_SYMBOL / EXPORT_SYMBOL_GPL is used and
+ * none is required.
+ */
+
+#ifndef _LANTIQ_INTEL_XRX500_H_
+#define _LANTIQ_INTEL_XRX500_H_
+
+#include <linux/atomic.h>
+#include <linux/dma-mapping.h>
+#include <linux/netdevice.h>
+#include <linux/phylink.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/u64_stats_sync.h>
+
+/*
+ * Forward declarations.
+ *
+ * struct dma_tx_desc is the 16-byte 4-DW silicon descriptor defined in
+ * dma/hdma.h (the Sub-4B driver-private header). intel_xrx500.h carries
+ * only a pointer to it (port->tx_ring) so the forward declaration here
+ * keeps consumers of intel_xrx500.h from being forced to pull hdma.h
+ * into their translation unit. The .c TU that actually dereferences
+ * port->tx_ring (intel_xrx500.c) includes dma/hdma.h directly.
+ */
+struct dma_tx_desc;
+
+/*
+ * AVM grx_common.dtsi orientation (per CQ-002 A + AC-003-10):
+ *
+ *   eth0 = physical LAN1 (silkscreen) = dp_port_id 5
+ *   eth1 = physical LAN2              = dp_port_id 4
+ *   eth2 = physical LAN3              = dp_port_id 3
+ *   eth3 = physical LAN4              = dp_port_id 2
+ *
+ * Note: the orientation is INVERSE the "natural" silicon counting order
+ * (eth0 -> dp_port_id 2 .. eth3 -> dp_port_id 5 would be natural). The
+ * AVM-orientation table is the chassis-side ground truth that lights the
+ * correct LAN1..LAN4 LED on the FB7560 front panel.
+ *
+ * The number of LAN netdevs is exactly four (AS-010) - no eth4 netdev
+ * exists; the PMAC<->CPU link is internal and unbacked.
+ */
+#define INTEL_XRX500_NUM_PORTS  4
+
+/**
+ * struct intel_xrx500_port_stats - per-port traffic counters.
+ * @rx_packets: frames received and delivered to the stack.
+ * @rx_bytes:   bytes received (post-CRC strip).
+ * @tx_packets: frames successfully posted to the egress DMA.
+ * @tx_bytes:   bytes posted to egress.
+ * @rx_dropped: receive-path drops (allocation failure, queue full, ...).
+ * @tx_dropped: transmit-path drops.
+ * @syncp:      seqcount-based torn-read protection for the u64_stats_t
+ *              fields above.
+ *
+ * AC-003-5 + AC-005-5: the four packet/byte counters use u64_stats_t
+ * under a per-port struct u64_stats_sync so ndo_get_stats64 reads them
+ * under u64_stats_fetch_begin / u64_stats_fetch_retry torn-read
+ * protection (required because the per-counter pair tx_packets +
+ * tx_bytes must be sampled consistently). The two drop counters use
+ * atomic_long_t because they (a) are incremented from drop fastpaths
+ * that have no obligation to advance under the same seqcount sequence
+ * as the packet/byte pair, and (b) atomic_long_t avoids forcing the
+ * caller to acquire u64_stats_update_begin in the drop-only path. On
+ * 64-bit architectures (BITS_PER_LONG == 64) the u64_stats_sync
+ * discipline collapses to a no-op; on 32-bit architectures
+ * u64_stats_init must be called before any update.
+ *
+ * The struct is initialised to all zeros at alloc_etherdev_mq time -
+ * netdev_priv() backs the per-port struct directly so the per-CPU
+ * seqcount initial state is zero / un-pinned and the two atomic_long_t
+ * counters start at 0 (ATOMIC_LONG_INIT(0) being a zero-bit pattern).
+ * ndo_start_xmit (ST-005) increments tx_packets / tx_bytes under
+ * u64_stats_update_begin / end and tx_dropped via atomic_long_inc.
+ */
+struct intel_xrx500_port_stats {
+	u64_stats_t		rx_packets;
+	u64_stats_t		rx_bytes;
+	u64_stats_t		tx_packets;
+	u64_stats_t		tx_bytes;
+	atomic_long_t		rx_dropped;
+	atomic_long_t		tx_dropped;
+	struct u64_stats_sync	syncp;
+};
+
+/**
+ * struct intel_xrx500_port - per-LAN-port state object.
+ * @netdev:           the per-port net_device allocated via
+ *                    alloc_etherdev_mq at probe time.
+ * @phylink:          phylink instance returned by phylink_create.
+ *                    NULL between alloc_etherdev_mq and phylink_create.
+ * @phylink_config:   configuration block embedded by value so the
+ *                    phylink_create call has a stable address; the
+ *                    mac_capabilities and supported_interfaces fields
+ *                    are populated before phylink_create is called per
+ *                    AC-003-2 review focus #1.
+ * @port_idx:         per-port index 0..3 - matches the DT child node
+ *                    reg = <N> property. Used as the array index back
+ *                    into priv->ports[] from phylink callbacks.
+ * @dp_port_id:       the AVM-orientation dp-port-id taken from DT
+ *                    (eth0=5, eth1=4, eth2=3, eth3=2 per AC-003-10).
+ *                    Identical to the GSWIP silicon port-number for
+ *                    these four LAN ports - directly indexes into
+ *                    MAC_CTRL_0[port] et seq.
+ * @cbm_deq_port:     the CBM dequeue-port number for this LAN port:
+ *                    eth0=10, eth1=9, eth2=8, eth3=7 (IG-039:
+ *                    cbm_deq_port = dp_port_id + 5, matching AVM
+ *                    epg_lookup_table dp5->CBM_P10 + DT DQ10).
+ * @tmu_egress_port:  the TMU egress-port number for this LAN port:
+ *                    eth0=10, eth1=9, eth2=8, eth3=7 (IG-040:
+ *                    tmu_egress_port == cbm_deq_port = dp_port_id + 5,
+ *                    matching AVM conf_dqm_dma_port's unified port number).
+ *                    Used when wiring the TMU port-enable sequence.
+ * @phy_node:         the DT node carrying the phy-handle (= one of
+ *                    &gphy_lan1..&gphy_lan4); used by
+ *                    phylink_of_phy_connect at probe time. Held by an
+ *                    of_node_get reference released in
+ *                    intel_xrx500_remove.
+ * @port_node:        the per-port DT node (port@N) whose fwnode is
+ *                    handed to phylink_create. Held by an of_node_get
+ *                    reference released in intel_xrx500_remove.
+ * @parent:           back-pointer to the owning
+ *                    struct intel_xrx500_priv (for dev_err routing).
+ * @stats:            per-port traffic counters (AC-003-5).
+ * @dp_alloc_flags:   DP_F_* flag mask passed to dp_alloc_port_ext /
+ *                    dp_register_subif (AC-004-1). Initialized to
+ *                    DP_F_FAST_ETH_LAN at probe time (the four FB7560
+ *                    LAN ports are all fast-Ethernet LAN class). The
+ *                    same value (OR'd with DP_F_DEREGISTER) is passed
+ *                    on the ndo_stop teardown path so the alloc/dealloc
+ *                    pair use bit-for-bit identical base flags.
+ * @dp_subif_id:      the @subif handle returned by dp_register_subif on
+ *                    success (the VAP/CTP identifier inside the dp_port).
+ *                    Stored across the open lifetime so ndo_stop can
+ *                    pass the same value back into dp_register_subif's
+ *                    DP_F_DEREGISTER dispatch (AC-004-2). Undefined when
+ *                    @state_subif_registered is false.
+ * @state_open:       AC-004-5: progressively-set flag tracking whether
+ *                    ndo_open's full 4-step bring-up has completed
+ *                    (set at the end of ndo_open's happy path, cleared
+ *                    at the end of ndo_stop). AC-004-6: re-entry while
+ *                    set yields -EALREADY; ndo_stop while clear is a
+ *                    no-op returning 0.
+ * @state_subif_registered: AC-004-5: progressively-set flag tracking
+ *                    whether ndo_open's step 3 (dp_alloc_port_ext +
+ *                    dp_register_subif) has completed. ndo_stop checks
+ *                    this before invoking the matching teardown so a
+ *                    partial ndo_open (whose failure-path inline
+ *                    rollback also clears the flag) followed by
+ *                    ndo_stop tears down exactly the steps that
+ *                    completed, not more.
+ *
+ * One instance is allocated per LAN port (4 total per AS-010). The
+ * struct sits at netdev_priv(netdev) for that port's netdev, so any
+ * ndo_* callback can recover it via netdev_priv(dev).
+ */
+struct intel_xrx500_port {
+	struct net_device		*netdev;
+	struct phylink			*phylink;
+	struct phylink_config		phylink_config;
+	u32				port_idx;
+	u32				dp_port_id;
+	u32				cbm_deq_port;
+	u32				tmu_egress_port;
+	struct device_node		*phy_node;
+	struct device_node		*port_node;
+	struct intel_xrx500_priv	*parent;
+	struct intel_xrx500_port_stats	stats;
+	/* ST-004: ndo_open / ndo_stop state machine. */
+	u32				dp_alloc_flags;
+	s32				dp_subif_id;
+	bool				state_open;
+	bool				state_subif_registered;
+	/*
+	 * ST-005: per-port polled-DMA TX path state.
+	 *
+	 * @tx_lock:               protects @tx_head and @tx_ring access.
+	 *                         Held across the entire ndo_start_xmit body
+	 *                         including the busy-poll wait per AC-005-7
+	 *                         (polled-DMA accepts the lock-held cost; an
+	 *                         async/tasklet path would release during wait).
+	 *                         Acquired via spin_lock_irqsave/restore so
+	 *                         the lock is safe against soft-irq context
+	 *                         in case future RX completion paths share it.
+	 * @tx_chan:               encoded DMA channel handle (one of
+	 *                         DMA1TX_LAN_SWITCH_CLASS0..3) chosen by
+	 *                         per-port slot index — see the dma_tx_chan
+	 *                         table in intel_xrx500.c. The CPU egress
+	 *                         channel set DMA1TX_LAN_SWITCH_CLASS0..3 is
+	 *                         the CPU -> GSWIP-MAC admit family per
+	 *                         lantiq_dmax.h.
+	 * @tx_ring:               kernel-virtual base of the 16-byte 4-DW
+	 *                         descriptor ring (DMA_TX_RING_DEPTH entries).
+	 *                         Allocated once at ndo_open step 4 via
+	 *                         dma_alloc_coherent (per Plan-Reviewer high-1
+	 *                         "allocated ONCE per port at TX-init time").
+	 *                         NULL between ndo_stop and the next ndo_open.
+	 * @tx_ring_phys:          bus address paired with @tx_ring; passed
+	 *                         to ltq_dma_chan_desc_cfg to program silicon
+	 *                         CDBA, also retained for dma_free_coherent.
+	 * @tx_head:               next slot index to write, range
+	 *                         [0..DMA_TX_RING_DEPTH-1]. Advanced modulo
+	 *                         DMA_TX_RING_DEPTH after a successful
+	 *                         transmit (AC-005-3). Polled-synchronous
+	 *                         discipline means head and tail track each
+	 *                         other 1-for-1; we only need head.
+	 * @state_tx_initialized:  AC-004-5-style flag tracking whether the
+	 *                         ndo_open step 4 (tx-init) has completed.
+	 *                         ndo_stop checks this before invoking the
+	 *                         symmetric tx-teardown so a partial open
+	 *                         (whose failure path also clears the flag)
+	 *                         tears down exactly what completed.
+	 */
+	spinlock_t			tx_lock;
+	u32				tx_chan;
+	struct dma_tx_desc		*tx_ring;
+	dma_addr_t			tx_ring_phys;
+	u32				tx_head;
+	bool				state_tx_initialized;
+};
+
+/**
+ * struct intel_xrx500_priv - per-platform_device top-level state.
+ * @pdev:    the bound platform_device.
+ * @dev:     convenience back-pointer for dev_err / dev_info.
+ * @ports:   per-port state pointers; NULL slots are unallocated. The
+ *           4-slot fixed-size array matches AS-010 (no eth4) and
+ *           INTEL_XRX500_NUM_PORTS == 4.
+ * @gswl_dev: cached ethsw_api_dev_t pointer for GSW-L (devid=0),
+ *           recovered via gsw_get_swcore_ops(0) + container_of at
+ *           probe time. Carries gswl_base / gsw_base for direct
+ *           gsw_w32 register writes from mac_link_up / mac_link_down.
+ *           See AC-003-3 / Plan-Reviewer critical-2 resolution: no
+ *           MAC_PortCfgSet helper exists in switch-api/, so direct
+ *           gsw_w32 access to MAC_CTRL_0[port] is the agreed path.
+ *           NULL until probe completes - probe returns -EPROBE_DEFER
+ *           if gsw_get_swcore_ops(0) returns NULL at probe time.
+ *
+ * Allocated once via devm_kzalloc at probe time, freed automatically
+ * on probe failure or driver unbind.
+ */
+struct intel_xrx500_priv {
+	struct platform_device		*pdev;
+	struct device			*dev;
+	struct intel_xrx500_port	*ports[INTEL_XRX500_NUM_PORTS];
+	void				*gswl_dev;
+};
+
+#endif /* _LANTIQ_INTEL_XRX500_H_ */
diff --git a/drivers/net/ethernet/lantiq/intel_xrx500.c b/drivers/net/ethernet/lantiq/intel_xrx500.c
new file mode 100644
index 0000000000000..cc3d775e9f1b7
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/intel_xrx500.c
@@ -0,0 +1,2303 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Intel xRX500 netdev / phylink integration driver.
+ *
+ * Phase 3 Sub-6 ST-003: stands up the mainline-facing surface that
+ * wires Sub-1..Sub-5 (GSWIP HAL, datapath, CBM, hdma, TMU) up to the
+ * Linux networking stack.
+ *
+ * Scope of ST-003:
+ *
+ *   - platform_driver bound to a new DT node 'intel,xrx500-net' under
+ *     seale_avm_fritz7560.dtsi carrying 4 child port@N nodes (per-port:
+ *     reg = <port_idx>, intel,dp-port-id = <D>, phy-handle = <&gphyN>).
+ *
+ *   - At probe time, for each of the 4 LAN ports:
+ *       (a) alloc_etherdev_mq with 1 TX queue,
+ *       (b) populate phylink_config (mac_capabilities = 10/100/1000 FD,
+ *           supported_interfaces bitmap with PHY_INTERFACE_MODE_INTERNAL
+ *           set BEFORE phylink_create per review focus #1),
+ *       (c) phylink_create(config, of_fwnode_handle(port_node),
+ *           PHY_INTERFACE_MODE_INTERNAL, &intel_xrx500_phylink_ops),
+ *       (d) phylink_of_phy_connect(phylink, port_node, 0),
+ *       (e) register netdev_ops + ethtool_ops,
+ *       (f) dev->min_mtu = ETH_MIN_MTU, dev->max_mtu = 9216,
+ *       (g) register_netdev.
+ *
+ *   - intel_xrx500_phylink_ops:
+ *       * mac_get_caps returns config->mac_capabilities,
+ *       * mac_select_pcs returns NULL (no internal PCS - AS-012),
+ *       * mac_config is a no-op,
+ *       * mac_link_down / mac_link_up perform NO register writes
+ *         (IG-103): the GSWIP-3.0 hardware MDIO poller (MDC_CFG_0.PEN,
+ *         mdio_xrx500.c) couples link state into the port MAC, exactly
+ *         as AVM-stock runs. mac_link_up only logs the resolved state.
+ *
+ *   - ndo_open / ndo_stop / ndo_start_xmit are honest STUBS that
+ *     return -ENETDOWN / 0 / NETDEV_TX_OK+drop respectively, with
+ *     TODO comments naming the consuming ST-004 / ST-005 sub-tasks
+ *     (per AC-003-4 + review focus #7).
+ *
+ *   - ndo_get_stats64 reads from per-port struct intel_xrx500_port_stats
+ *     under u64_stats_fetch_begin / u64_stats_fetch_retry (AC-003-5).
+ *     Initial state is all zero; ST-005 fills in xmit-side increments.
+ *
+ *   - ethtool_ops binds phylink-routed ksettings_get/set + get_drvinfo
+ *     (driver='intel-xrx500', version=UTS_RELEASE) + get_link via
+ *     ethtool_op_get_link (AC-003-6 / AS-007).
+ *
+ *   - EPROBE_DEFER from phylink_of_phy_connect or from
+ *     gsw_get_swcore_ops(0) [GSW-L not yet registered] is fully
+ *     rolled back: any earlier per-port success is undone via
+ *     phylink_destroy + free_netdev before -EPROBE_DEFER propagates
+ *     to the platform-driver core (AC-003-7 / review focus #4).
+ *
+ *   - PMAC<->CPU link is acknowledged with a single pr_info at probe
+ *     completion - no eth4 netdev (AS-010 / AC-003-9).
+ *
+ * AVM-orientation per-port mapping (AC-003-10 + AC-003-11), cited
+ * against ff/sources/source-files-FRITZ.Box_7560-07.30/sources/kernel/
+ * linux/arch/mips/boot/dts/lantiq/avm/grx_common.dtsi (interface@1..@4):
+ *
+ *   ifaces in grx_common.dtsi:
+ *     lan4 interface@1 reg=<1> intel,dp-port-id=<2> phy-handle=<&phy2> avm,name="eth3"
+ *     lan3 interface@2 reg=<2> intel,dp-port-id=<3> phy-handle=<&phy3> avm,name="eth2"
+ *     lan2 interface@3 reg=<3> intel,dp-port-id=<4> phy-handle=<&phy4> avm,name="eth1"
+ *     lan1 interface@4 reg=<4> intel,dp-port-id=<5> phy-handle=<&phy5> avm,name="eth0"
+ *
+ *   ST-003 mapping (eth0..eth3 in registration order):
+ *     eth0=LAN1, dp_port_id=5, cbm_deq_port=7, tmu_egress_port=15, phy@5
+ *     eth1=LAN2, dp_port_id=4, cbm_deq_port=6, tmu_egress_port=14, phy@4
+ *     eth2=LAN3, dp_port_id=3, cbm_deq_port=5, tmu_egress_port=13, phy@3
+ *     eth3=LAN4, dp_port_id=2, cbm_deq_port=4, tmu_egress_port=12, phy@2
+ *
+ *   cbm_deq_port derivation: the 5.10 reference DTS for this board
+ *   declares interrupt-names = "cbm-dqm4", "cbm-dqm5", "cbm-dqm6",
+ *   "cbm-dqm7" and the AVM xrx500.dtsi commentary at the
+ *   lantiq,cbm-config DQ0..DQ3 entries places those four IRQs on
+ *   physical LAN4..LAN1 (silicon ports 2..5) - so DQ port numbers run
+ *   4..7 inversely against dp_port_id 2..5 (AC-003-11).
+ *
+ *   tmu_egress_port derivation: dp_port_id + 10 (12..15). Anchored
+ *   against the boot-log section 4 GPHY enumeration in
+ *   ff/6.18-port/boot-logs/phase1-busybox-shell-2026-05-21.log; the
+ *   four GE PHYs sit at silicon addresses 0x02..0x05 matching
+ *   dp_port_id 2..5.
+ *
+ * Compatible-string collision audit (review focus #3): grep across
+ * /project/linux-6.18.y/drivers for the literal strings
+ * 'intel,xrx500-net' and 'lantiq,xrx500-net' returned zero hits at
+ * commit time.
+ *
+ * No netif_carrier_on / netif_start_queue at probe (review focus #10):
+ * those are phylink's responsibility once mac_link_up fires.
+ *
+ * Probe-vs-register ordering (review focus #9): register_netdev is
+ * called AFTER phylink_of_phy_connect succeeds; calling them in
+ * reverse order leaves a netdev visible to userspace with no PHY for
+ * a brief window.
+ *
+ * Remove tears down in strict reverse order (review focus #11):
+ * unregister_netdev -> phylink_disconnect_phy -> phylink_destroy ->
+ * free_netdev (AC-003-8).
+ */
