+/*
+ * ===========================================================================
+ * Probe / Remove
+ * ===========================================================================
+ */
+
+/**
+ * intel_xrx500_port_destroy() - tear down a single per-port struct.
+ * @priv: owning struct intel_xrx500_priv.
+ * @i:    port slot index (0..3).
+ *
+ * Reverse-order helper for AC-003-7 EPROBE_DEFER rollback and AC-003-8
+ * symmetric remove. Calls unregister_netdev only if the netdev has
+ * been registered (port->netdev->reg_state == NETREG_REGISTERED);
+ * phylink_disconnect_phy / phylink_destroy only if phylink is non-NULL.
+ *
+ * Drops the of_node references taken at probe time via of_node_put.
+ */
+static void intel_xrx500_port_destroy(struct intel_xrx500_priv *priv, int i)
+{
+	struct intel_xrx500_port *port = priv->ports[i];
+
+	if (!port)
+		return;
+
+	if (port->netdev && port->netdev->reg_state == NETREG_REGISTERED)
+		unregister_netdev(port->netdev);
+
+	if (port->phylink) {
+		phylink_disconnect_phy(port->phylink);
+		phylink_destroy(port->phylink);
+		port->phylink = NULL;
+	}
+
+	of_node_put(port->phy_node);
+	of_node_put(port->port_node);
+
+	if (port->netdev) {
+		free_netdev(port->netdev);
+		port->netdev = NULL;
+	}
+
+	priv->ports[i] = NULL;
+}
+
+/**
+ * intel_xrx500_port_setup() - allocate and configure a single per-port netdev.
+ * @priv:      owning private state.
+ * @port_node: DT child node carrying the port configuration.
+ * @port_idx:  port slot index (= reg = <N> from DT).
+ *
+ * Per AC-003-2:
+ *   (a) alloc_etherdev_mq with 1 TX queue,
+ *   (b) reads intel,dp-port-id from DT, derives cbm_deq_port +
+ *       tmu_egress_port from the AVM-orientation table,
+ *   (c) populates phylink_config with mac_capabilities and
+ *       supported_interfaces (PHY_INTERFACE_MODE_INTERNAL) BEFORE
+ *       calling phylink_create (review focus #1),
+ *   (d) phylink_create(config, of_fwnode_handle(port_node),
+ *       PHY_INTERFACE_MODE_INTERNAL, &intel_xrx500_phylink_ops),
+ *   (e) phylink_of_phy_connect(phylink, port_node, 0) - propagates
+ *       -EPROBE_DEFER if MDIO bus not yet up (review focus #4),
+ *   (f) wires netdev_ops + ethtool_ops, sets dev->min_mtu/max_mtu,
+ *   (g) register_netdev (review focus #9 - AFTER phy_connect).
+ *
+ * Returns 0 on success or a negative errno (including -EPROBE_DEFER)
+ * on failure. On failure no per-slot artifacts are left dangling -
+ * the caller-side rollback walks slot indices 0..(i-1) only.
+ */
+static int intel_xrx500_port_setup(struct intel_xrx500_priv *priv,
+				   struct device_node *port_node,
+				   u32 port_idx)
+{
+	struct intel_xrx500_port *port;
+	struct net_device *netdev;
+	struct phylink *phylink;
+	u32 dp_port_id;
+	int ret;
+
+	ret = of_property_read_u32(port_node, "intel,dp-port-id", &dp_port_id);
+	if (ret) {
+		dev_err(priv->dev,
+			"intel-xrx500: port@%u missing intel,dp-port-id\n",
+			port_idx);
+		return ret;
+	}
+
+	/*
+	 * Bounds-check dp_port_id. The four FB7560 LAN ports map to
+	 * silicon ports 2..5 - any other value is a DT typo and we
+	 * must surface it rather than silently accept it.
+	 */
+	if (dp_port_id < 2 || dp_port_id > 5) {
+		dev_err(priv->dev,
+			"intel-xrx500: port@%u intel,dp-port-id=%u out of range [2..5]\n",
+			port_idx, dp_port_id);
+		return -EINVAL;
+	}
+
+	/*
+	 * alloc_etherdev_mq with 1 TX queue per AC-003-2(a). Returns NULL
+	 * on allocation failure (rare under standard kernel pressure but
+	 * we must check). sizeof(*port) backs netdev_priv() - the port
+	 * struct sits inline at the priv tail.
+	 */
+	netdev = alloc_etherdev_mq(sizeof(*port), 1);
+	if (!netdev)
+		return -ENOMEM;
+
+	SET_NETDEV_DEV(netdev, priv->dev);
+
+	port = netdev_priv(netdev);
+	port->netdev          = netdev;
+	port->port_idx        = port_idx;
+	port->dp_port_id      = dp_port_id;
+	/*
+	 * Per-port mapping table (IG-039 + IG-040: unified egress port):
+	 *
+	 *   dp_port_id  cbm_deq_port == tmu_egress_port   tmu_queue
+	 *      5            10                              20     (eth0 = LAN1)
+	 *      4             9                              19     (eth1 = LAN2)
+	 *      3             8                              18     (eth2 = LAN3)
+	 *      2             7                              17     (eth3 = LAN4)
+	 *
+	 * Closed-form: cbm_deq_port = tmu_egress_port = dp_port_id + 5.
+	 *
+	 * IG-040: AVM conf_dqm_dma_port uses ONE number for both the TMU egress
+	 * port (EPMT/EPN index passed to tmu_create_flat_egress_path) and the
+	 * CBM DQM DMA dequeue port (init_cbm_dqm_dma_port). dp5 -> 10 -> DMA2TX
+	 * channel 5 -> PMAC port 5 -> GPHY5 (DT DQ10 <10 20 2 5 1 2>). The old
+	 * tmu_egress_port = dp+10 (EPN 15) drained the TMU egress path to an
+	 * egress port the DMA dequeue port (10) never read, so frames never
+	 * reached the DMA2TX channel (iteration-3: tx_packets advanced, zero on
+	 * wire). cbm_deq_port was earlier dp+2 (=7, the LAN4 binding) — IG-039.
+	 */
+	port->cbm_deq_port    = dp_port_id + 5u;
+	port->tmu_egress_port = dp_port_id + 5u;
+	port->parent          = priv;
+	/*
+	 * ST-004 AC-004-1: dp_alloc_flags carries the DP_F_* class bits
+	 * passed to dp_alloc_port_ext + dp_register_subif from ndo_open
+	 * (and ORed with DP_F_DEREGISTER for the ndo_stop teardown).
+	 * The four FB7560 LAN ports are all fast-Ethernet LAN class —
+	 * DP_F_FAST_ETH_LAN is the AVM-canonical bit.
+	 */
+	port->dp_alloc_flags  = DP_F_FAST_ETH_LAN;
+	port->dp_subif_id     = -1;
+	port->state_open      = false;
+	port->state_subif_registered = false;
+	/*
+	 * ST-005 per-port TX state. tx_lock initialized here so
+	 * intel_xrx500_ndo_start_xmit can take it safely even if userspace
+	 * calls xmit before ndo_open (the state_tx_initialized guard then
+	 * dispatches to the drop path). tx_chan / tx_ring / tx_ring_phys /
+	 * tx_head / state_tx_initialized are all zero/NULL at this point
+	 * from alloc_etherdev_mq's zero-init.
+	 */
+	spin_lock_init(&port->tx_lock);
+	port->tx_chan = 0;
+	port->tx_ring = NULL;
+	port->tx_ring_phys = 0;
+	port->tx_head = 0;
+	port->state_tx_initialized = false;
+
+	port->port_node = of_node_get(port_node);
+	port->phy_node  = of_parse_phandle(port_node, "phy-handle", 0);
+
+	u64_stats_init(&port->stats.syncp);
+
+	/*
+	 * phylink_config population per AC-003-2(c) + review focus #1.
+	 * The supported_interfaces bitmap MUST be populated BEFORE
+	 * phylink_create - otherwise phylink_create returns an error
+	 * pointer.
+	 */
+	port->phylink_config.dev  = &netdev->dev;
+	port->phylink_config.type = PHYLINK_NETDEV;
+	/*
+	 * BUGFIX (phylink validation): the prior cap bitmap was only
+	 * MAC_1000FD|MAC_100FD|MAC_10FD. phylink_validate() for
+	 * PHY_INTERFACE_MODE_INTERNAL turns mac_capabilities into a
+	 * linkmode mask via phylink_caps_to_linkmodes() and ANDs it with
+	 * the attached PHY's advertisement. The xRX500 GPHY advertises
+	 * Pause + Asym_Pause (ethtool linkmode bits 7 + 9 == 0x280), but
+	 * with no MAC_*_PAUSE caps phylink_caps_to_linkmodes() never sets
+	 * those bits in the MAC support mask, so the support(0x6280) vs
+	 * advert(0x280) intersection failed and phylink_validate returned
+	 * -EINVAL ("validation of internal ... failed"), which in turn
+	 * made phylink_of_phy_connect() return -22. Advertising both pause
+	 * directions makes phylink_caps_to_linkmodes() set the Pause /
+	 * Asym_Pause linkmode bits so the intersection is non-empty and
+	 * validation passes — letting eth0 come up even before MDIO works.
+	 */
+	port->phylink_config.mac_capabilities =
+		MAC_SYM_PAUSE | MAC_ASYM_PAUSE |
+		MAC_1000FD | MAC_100FD | MAC_10FD;
+	__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+		  port->phylink_config.supported_interfaces);
+
+	netdev->netdev_ops  = &intel_xrx500_netdev_ops;
+	netdev->ethtool_ops = &intel_xrx500_ethtool_ops;
+
+	/*
+	 * AC-003-2(g) + AC-005-4 - min/max MTU bounds. The netdev core
+	 * enforces these BEFORE invoking ndo_change_mtu, so even with a
+	 * trivial ndo_change_mtu body (intel_xrx500_ndo_change_mtu just
+	 * returns 0) userspace MTU set requests are bounded to the
+	 * supported range. 9216 chosen per AVM grx_common.dtsi jumbo-frame
+	 * configuration anchor (CBM_JBO_BUF_SIZE = 8192 + 1024-byte
+	 * pmac/header headroom = 9216).
+	 */
+	netdev->min_mtu = ETH_MIN_MTU;
+	netdev->max_mtu = 9216;
+
+	/*
+	 * AC-003-2(d) - phylink_create. PHY_INTERFACE_MODE_INTERNAL per
+	 * review focus #2 (the GPHYs are wired directly to the GSWIP MAC
+	 * over the internal interface, with no external pin interface
+	 * exposed). The of_fwnode_handle(port_node) wrapper hands the
+	 * per-port DT node to phylink so it can resolve fixed-link or
+	 * managed-link properties from there if needed.
+	 */
+	phylink = phylink_create(&port->phylink_config,
+				 of_fwnode_handle(port_node),
+				 PHY_INTERFACE_MODE_INTERNAL,
+				 &intel_xrx500_phylink_ops);
+	if (IS_ERR(phylink)) {
+		ret = PTR_ERR(phylink);
+		dev_err(priv->dev,
+			"intel-xrx500: phylink_create(port@%u) failed: %d\n",
+			port_idx, ret);
+		of_node_put(port->phy_node);
+		of_node_put(port->port_node);
+		free_netdev(netdev);
+		return ret;
+	}
+	port->phylink = phylink;
+
+	/*
+	 * AC-003-2(e) - phylink_of_phy_connect. May return -EPROBE_DEFER
+	 * if the MDIO bus (ST-002b) is not yet up - propagated up the
+	 * call stack to the platform-driver core via the caller's
+	 * rollback path (AC-003-7).
+	 */
+	ret = phylink_of_phy_connect(phylink, port_node, 0);
+	if (ret) {
+		if (ret != -EPROBE_DEFER)
+			dev_err(priv->dev,
+				"intel-xrx500: phylink_of_phy_connect(port@%u) failed: %d\n",
+				port_idx, ret);
+		phylink_destroy(phylink);
+		port->phylink = NULL;
+		of_node_put(port->phy_node);
+		of_node_put(port->port_node);
+		free_netdev(netdev);
+		return ret;
+	}
+
+	/*
+	 * IG-103 AVM PHY-advertisement parity (applied before phylink_start
+	 * triggers autoneg, so the first negotiation already matches the
+	 * working system):
+	 *
+	 * (1) Strip Pause/Asym_Pause from the GPHY advertisement. AVM
+	 *     masks SUPPORTED_Pause out of phydev->supported at attach
+	 *     (ltq_eth_drv_xrx500.c:1806-1807) — the working box never
+	 *     negotiates pause (corpus MDIO_STAT_5=0x0074, pause bits 0).
+	 *     With the HW poller now conveying resolved pause into the
+	 *     MAC, advertising pause would diverge from the only proven
+	 *     configuration.
+	 *
+	 * (2) Disable EEE advertisement. AVM zeroes the EEE advert on
+	 *     exactly this port (grx350_common.dtsi:19-21 &lan1
+	 *     avm,eee-adv=<0x0>, applied via phy_ethtool_set_eee at
+	 *     ltq_eth_drv_xrx500.c:1810-1816). Without phy_support_eee()
+	 *     our phylib keeps the PHY11G firmware-default EEE advert
+	 *     (phy_probe: eee_enabled = !linkmode_empty(advertising_eee)),
+	 *     so the GPHY could negotiate EEE/LPI clock-stop with the
+	 *     host NIC while the MAC side (MAC_CTRL_4.LPIEN=0) is never
+	 *     configured for it.
+	 */
+	if (netdev->phydev) {
+		phy_remove_link_mode(netdev->phydev,
+				     ETHTOOL_LINK_MODE_Pause_BIT);
+		phy_remove_link_mode(netdev->phydev,
+				     ETHTOOL_LINK_MODE_Asym_Pause_BIT);
+		phy_disable_eee(netdev->phydev);
+	}
+
+	/*
+	 * Set a sane MAC address before register_netdev so userspace
+	 * sees a non-zero hwaddr from the moment the netdev appears.
+	 * Random per-port MACs are acceptable for ST-003 scope; the
+	 * board-specific persistent MAC fetch is a Sub-6.x follow-up.
+	 */
+	eth_hw_addr_random(netdev);
+
+	/*
+	 * AC-003-2(h) + review focus #9 - register_netdev AFTER
+	 * phylink_of_phy_connect has succeeded. The netdev is visible
+	 * to userspace only after the PHY is bound.
+	 */
+	ret = register_netdev(netdev);
+	if (ret) {
+		dev_err(priv->dev,
+			"intel-xrx500: register_netdev(port@%u) failed: %d\n",
+			port_idx, ret);
+		phylink_disconnect_phy(phylink);
+		phylink_destroy(phylink);
+		port->phylink = NULL;
+		of_node_put(port->phy_node);
+		of_node_put(port->port_node);
+		free_netdev(netdev);
+		return ret;
+	}
+
+	/*
+	 * Diagnostic line on per-port success. The chassis-side LAN
+	 * label (LAN1..LAN4) reads naturally against dp_port_id 5..2.
+	 */
+	dev_info(priv->dev,
+		 "intel-xrx500: %s registered (port@%u dp_port_id=%u deq=%u tmu=%u)\n",
+		 netdev_name(netdev), port_idx, port->dp_port_id,
+		 port->cbm_deq_port, port->tmu_egress_port);
+
+	priv->ports[port_idx] = port;
+	return 0;
+}
+
+static int intel_xrx500_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct intel_xrx500_priv *priv;
+	struct device_node *port_node;
+	int ret = 0;
+	int i;
+	int registered = 0;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->pdev = pdev;
+	priv->dev  = dev;
+
+	/*
+	 * Recover the GSW-L per-instance ethsw_api_dev_t pointer via the
+	 * switch-api/ slot-table dispatcher. If GSW-L (devid=0) is not
+	 * yet registered, defer probe so the driver-core requeues us.
+	 * (IG-103: mac_link_up/down no longer write registers, but the
+	 * defer-until-GSW-L-registered ordering is kept — probe order
+	 * still wants switch-api up before the netdevs appear.)
+	 */
+	priv->gswl_dev = intel_xrx500_get_gswl_dev();
+	if (!priv->gswl_dev) {
+		dev_dbg(dev, "intel-xrx500: GSW-L not yet registered; deferring probe\n");
+		return -EPROBE_DEFER;
+	}
+
+	platform_set_drvdata(pdev, priv);
+
+	/*
+	 * Iterate child port@N nodes and instantiate per-port netdevs.
+	 * On failure of any port, walk back through earlier-instantiated
+	 * ports calling intel_xrx500_port_destroy (AC-003-7 idempotent
+	 * rollback) before propagating the error.
+	 */
+	for_each_available_child_of_node(dev->of_node, port_node) {
+		u32 port_idx;
+
+		ret = of_property_read_u32(port_node, "reg", &port_idx);
+		if (ret) {
+			dev_err(dev, "intel-xrx500: child node %pOFn missing reg\n",
+				port_node);
+			of_node_put(port_node);
+			goto err_rollback;
+		}
+
+		if (port_idx >= INTEL_XRX500_NUM_PORTS) {
+			dev_err(dev, "intel-xrx500: port@%u out of range [0..%u]\n",
+				port_idx, INTEL_XRX500_NUM_PORTS - 1);
+			of_node_put(port_node);
+			ret = -EINVAL;
+			goto err_rollback;
+		}
+
+		if (priv->ports[port_idx]) {
+			dev_err(dev, "intel-xrx500: duplicate port@%u\n", port_idx);
+			of_node_put(port_node);
+			ret = -EINVAL;
+			goto err_rollback;
+		}
+
+		ret = intel_xrx500_port_setup(priv, port_node, port_idx);
+		if (ret) {
+			of_node_put(port_node);
+			goto err_rollback;
+		}
+		registered++;
+	}
+
+	if (registered != INTEL_XRX500_NUM_PORTS) {
+		dev_err(dev,
+			"intel-xrx500: expected %d port child nodes, found %d\n",
+			INTEL_XRX500_NUM_PORTS, registered);
+		ret = -EINVAL;
+		goto err_rollback;
+	}
+
+	/*
+	 * AC-003-9 / AS-010: single summary line at probe completion.
+	 * PMAC<->CPU is an internal link only - no eth4 netdev is
+	 * created.
+	 */
+	pr_info("intel-xrx500: %d LAN netdevs registered (eth0..eth%d); PMAC<->CPU link up (internal, no netdev)\n",
+		INTEL_XRX500_NUM_PORTS, INTEL_XRX500_NUM_PORTS - 1);
+
+	return 0;
+
+err_rollback:
+	/*
+	 * Walk in reverse order to mirror the symmetric remove path.
+	 * Each slot may be either NULL (never set up) or fully wired -
+	 * intel_xrx500_port_destroy handles both cases.
+	 */
+	for (i = INTEL_XRX500_NUM_PORTS - 1; i >= 0; i--)
+		intel_xrx500_port_destroy(priv, i);
+
+	return ret;
+}
+
+static void intel_xrx500_remove(struct platform_device *pdev)
+{
+	struct intel_xrx500_priv *priv = platform_get_drvdata(pdev);
+	int i;
+
+	if (!priv)
+		return;
+
+	/*
+	 * AC-003-8 + review focus #11: strict reverse-order teardown.
+	 * intel_xrx500_port_destroy internally orders the unwind as
+	 * unregister_netdev -> phylink_disconnect_phy -> phylink_destroy
+	 * -> free_netdev (matching the inverse of port_setup's wiring).
+	 */
+	for (i = INTEL_XRX500_NUM_PORTS - 1; i >= 0; i--)
+		intel_xrx500_port_destroy(priv, i);
+}
+
+static const struct of_device_id intel_xrx500_of_match[] = {
+	{ .compatible = "intel,xrx500-net" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, intel_xrx500_of_match);
+
+static struct platform_driver intel_xrx500_driver = {
+	.probe  = intel_xrx500_probe,
+	.remove = intel_xrx500_remove,
+	.driver = {
+		.name = INTEL_XRX500_DRV_NAME,
+		.of_match_table = intel_xrx500_of_match,
+	},
+};
+
+/*
+ * Composite-module init: device_initcall() instead of module_init() so
+ * that this TU can coexist with gsw_init.c's module_platform_driver()
+ * macro inside the same intel-xrx500-gswip composite (see the matching
+ * commentary in switch-api/mdio_xrx500.c).
+ *
+ * Ordering: device_initcall fires after subsys_initcall and
+ * arch_initcall, so the lantiq pinmux / GSWIP HAL / MDIO bus driver
+ * have all completed their probe calls before this one binds.
+ * EPROBE_DEFER on gsw_get_swcore_ops(0) or on phylink_of_phy_connect
+ * is the safety net for any residual ordering surprises.
+ */
+static int __init intel_xrx500_init(void)
+{
+	/*
+	 * AC-005-6 module-init marker — emitted exactly once per module
+	 * (regardless of how many ports later bind). Together with the
+	 * per-port "TX path POLLED (ring depth %u)" line emitted from
+	 * intel_xrx500_open_step4_tx, this is the IG-020 anchor. Wording
+	 * is byte-for-byte the AC-005-6 contract; do NOT reword.
+	 */
+	pr_info("intel-xrx500: TX path: POLLED (M3-only; SUB-6.1 owns async)\n");
+	return platform_driver_register(&intel_xrx500_driver);
+}
+device_initcall(intel_xrx500_init);
+
+MODULE_ALIAS("platform:intel-xrx500-net");
