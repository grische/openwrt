+/*
+ * dp_alloc_port_private - AVM datapath_api.c:336-485 ported with the
+ * documented surgeries:
+ *   - CONFIG_LTQ_DATAPATH_DBG dp_port_type_str loop excised
+ *   - dp_pmac_set call line-excised (consistent with AC-002-6 dispatch
+ *     strip; pmac config goes through Sub-2's gsw_pce_table_write path
+ *     in a future subtask)
+ *   - CBM port alloc/dealloc wired to the real cbm_dp_port_alloc /
+ *     cbm_dp_port_dealloc exports (<net/cqm_cbm_api.h>) in Sub-7 ST-002
+ */
+static int dp_alloc_port_private(int inst,
+				  struct module *owner,
+				  struct net_device *dev,
+				  u32 dev_port, s32 port_id,
+				  dp_pmac_cfg_t *pmac_cfg,
+				  struct dp_port_data *data,
+				  u32 flags)
+{
+	int i;
+	struct cbm_dp_alloc_data cbm_data = { 0 };
+
+	(void)pmac_cfg; /* dp_pmac_set call excised - see file header */
+
+	if (!owner) {
+		dev_err(dp_dev, "Allocate port failed for owner NULL\n");
+		return DP_FAILURE;
+	}
+
+	if (port_id >= MAX_DP_PORTS || port_id < 0) {
+		DP_DEBUG_ASSERT((port_id >= MAX_DP_PORTS),
+				"port_id(%d) >= MAX_DP_PORTS(%d)", port_id,
+				MAX_DP_PORTS);
+		DP_DEBUG_ASSERT((port_id < 0), "port_id(%d) < 0", port_id);
+		return DP_FAILURE;
+	}
+
+	cbm_data.dp_inst = inst;
+	cbm_data.cbm_inst = dp_port_prop[inst].cbm_inst;
+
+	if (flags & DP_F_DEREGISTER) { /*De-register */
+		if (dp_port_info[inst][port_id].status != PORT_ALLOCATED) {
+			dev_err(dp_dev,
+				"No Deallocate for module %s w/o deregistered\n",
+				owner->name);
+			return DP_FAILURE;
+		}
+		cbm_data.deq_port = dp_port_info[inst][port_id].deq_port_base;
+		cbm_data.dma_chan = dp_port_info[inst][port_id].dma_chan;
+		cbm_dp_port_dealloc(owner, dev_port, port_id,
+				    &cbm_data, flags);
+		dp_inst_insert_mod(owner, port_id, inst, 0);
+		DP_DEBUG(DP_DBG_FLAG_REG, "de-alloc port %d\n", port_id);
+		DP_CB(inst, port_platform_set)
+		(inst, port_id, data, flags);
+		memset(&dp_port_info[inst][port_id], 0,
+		       sizeof(dp_port_info[inst][port_id]));
+		return DP_SUCCESS;
+	}
+	if (port_id) { /*with specified port_id */
+		if (dp_port_info[inst][port_id].status != PORT_FREE) {
+			dev_err(dp_dev,
+				"module %s(dev_port %d) fail: port %d used by %s %d\n",
+				owner->name, dev_port, port_id,
+				dp_port_info[inst][port_id].owner ?
+					dp_port_info[inst][port_id].owner->name :
+					"NULL",
+				dp_port_info[inst][port_id].dev_port);
+			return DP_FAILURE;
+		}
+	}
+	if (cbm_dp_port_alloc(owner, dev, dev_port, port_id,
+			      &cbm_data, flags)) {
+		dev_err(dp_dev,
+			"cbm_dp_port_alloc fail for %s/dev_port %d: %d\n",
+			owner->name, dev_port, port_id);
+		return DP_FAILURE;
+	} else if (!(cbm_data.flags & CBM_PORT_DP_SET) &&
+		   !(cbm_data.flags & CBM_PORT_DQ_SET)) {
+		dev_err(dp_dev,
+			"cbm_dp_port_alloc NO DP_SET/DQ_SET(%x):%s/dev_port %d\n",
+			cbm_data.flags, owner->name, dev_port);
+		return DP_FAILURE;
+	}
+	port_id = cbm_data.dp_port;
+	memset(&dp_port_info[inst][port_id], 0,
+	       sizeof(dp_port_info[inst][port_id]));
+	/*save info from caller */
+	dp_port_info[inst][port_id].owner = owner;
+	dp_port_info[inst][port_id].dev = dev;
+	dp_port_info[inst][port_id].dev_port = dev_port;
+	dp_port_info[inst][port_id].alloc_flags = flags;
+	dp_port_info[inst][port_id].status = PORT_ALLOCATED;
+	/*save info from cbm_dp_port_alloc*/
+	dp_port_info[inst][port_id].flag_other = cbm_data.flags;
+	dp_port_info[inst][port_id].port_id = cbm_data.dp_port;
+	dp_port_info[inst][port_id].deq_port_base = cbm_data.deq_port;
+	dp_port_info[inst][port_id].deq_port_num = cbm_data.deq_port_num;
+	dp_port_info[inst][port_id].num_dma_chan = cbm_data.num_dma_chan;
+	/*save info to port data*/
+	data->deq_port_base = dp_port_info[inst][port_id].deq_port_base;
+	data->deq_num = dp_port_info[inst][port_id].deq_port_num;
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "cbm alloc dp_port:%d deq:%d deq_num:%d\n",
+		 cbm_data.dp_port, cbm_data.deq_port, cbm_data.deq_port_num);
+	if (cbm_data.flags & CBM_PORT_DMA_CHAN_SET)
+		dp_port_info[inst][port_id].dma_chan = cbm_data.dma_chan;
+	if (cbm_data.flags & CBM_PORT_PKT_CRDT_SET)
+		dp_port_info[inst][port_id].tx_pkt_credit =
+			cbm_data.tx_pkt_credit;
+	if (cbm_data.flags & CBM_PORT_BYTE_CRDT_SET)
+		dp_port_info[inst][port_id].tx_b_credit = cbm_data.tx_b_credit;
+	if (cbm_data.flags & CBM_PORT_RING_ADDR_SET)
+		dp_port_info[inst][port_id].tx_ring_addr =
+			cbm_data.tx_ring_addr;
+	if (cbm_data.flags & CBM_PORT_RING_SIZE_SET)
+		dp_port_info[inst][port_id].tx_ring_size =
+			cbm_data.tx_ring_size;
+	if (cbm_data.flags & CBM_PORT_RING_OFFSET_SET)
+		dp_port_info[inst][port_id].tx_ring_offset =
+			cbm_data.tx_ring_offset;
+
+	DP_DEBUG(DP_DBG_FLAG_DBG, "cid=%d pid=%d nid=%d\n",
+		 _DMA_CONTROLLER(cbm_data.dma_chan),
+		 _DMA_PORT(cbm_data.dma_chan),
+		 _DMA_CHANNEL(cbm_data.dma_chan));
+
+	if ((cbm_data.num_dma_chan) && (cbm_data.num_dma_chan >
+					cbm_data.deq_port_num)) {
+		dev_err(dp_dev,
+			"ERROR: deq_port_num=%d not equal to num_dma_chan=%d\n",
+			cbm_data.deq_port_num, cbm_data.num_dma_chan);
+		return DP_FAILURE;
+	}
+
+	if (dp_port_prop[inst].info.port_platform_set(inst, port_id,
+						      data, flags)) {
+		dev_err(dp_dev,
+			"Failed port_platform_set for port_id=%d(%s)\n",
+			port_id, owner ? owner->name : "");
+		cbm_dp_port_dealloc(owner, dev_port, port_id,
+				    &cbm_data,
+				    flags | DP_F_DEREGISTER);
+		memset(&dp_port_info[inst][port_id], 0,
+		       sizeof(dp_port_info[inst][port_id]));
+		return DP_FAILURE;
+	}
+	/*only 1st dp instance support real CPU path traffic */
+	if (!inst && dp_port_prop[inst].info.init_dma_pmac_template)
+		dp_port_prop[inst].info.init_dma_pmac_template(port_id, flags);
+	for (i = 0; i < MAX_SUBIFS; i++)
+		INIT_LIST_HEAD(&dp_port_info[inst][port_id].subif_info[i].logic_dev);
+	dp_inst_insert_mod(owner, port_id, inst, 0);
+
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "Port %d allocation succeed for module %s with dev_port %d\n",
+		 port_id, owner->name, dev_port);
+	return port_id;
+}
+
+/*
+ * dp_register_subif - AVM datapath_api.c:1053-1085 thin wrapper around
+ * dp_register_subif_ext. Resolves inst via dp_get_inst_via_module before
+ * dispatch.
+ */
+int dp_register_subif(struct module *owner, struct net_device *dev,
+		      char *subif_name, dp_subif_t *subif_id, u32 flags)
+{
+	int inst;
+	struct dp_subif_data data = { 0 };
+
+	if ((!subif_id) || (!subif_id->port_id) || (!owner) ||
+	    (subif_id->port_id >= MAX_DP_PORTS) ||
+	    (subif_id->port_id <= 0)) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "register subif fail port_id or owner invalid\n");
+		return DP_FAILURE;
+	}
+	inst = dp_get_inst_via_module(owner, (u32)subif_id->port_id, 0);
+	if (inst < 0) {
+		dev_err(dp_dev, "wrong inst for owner=%s with ep=%d\n",
+			owner->name, subif_id->port_id);
+		return DP_FAILURE;
+	}
+	return dp_register_subif_ext(inst, owner, dev, subif_name,
+				     subif_id, &data, flags);
+}
+
+/*
+ * dp_register_subif_ext - AVM datapath_api.c:963-1051. Acquires
+ * DP_LIB_LOCK(&dp_lock) per AS-014 and dispatches to either
+ * dp_register_subif_private (register) or dp_deregister_subif_private
+ * (deregister). Sub-3 does not port dp_deregister_subif_private so the
+ * DEREGISTER branch returns DP_FAILURE - this matches the Sub-3 scope
+ * (per CQ-003 A, deregister surface lands alongside Sub-6).
+ */
+int dp_register_subif_ext(int inst, struct module *owner,
+			  struct net_device *dev,
+			  char *subif_name, dp_subif_t *subif_id,
+			  /*device related info*/
+			  struct dp_subif_data *data, u32 flags)
+{
+	int res = DP_FAILURE;
+	int port_id;
+	struct pmac_port_info *port_info;
+	struct dp_subif_data tmp_data = { 0 };
+
+	if (!dp_init_ok) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "dp_register_subif fail for datapath not init yet\n");
+		return DP_FAILURE;
+	}
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "%s:owner=%s dev=%s subif_name=%s port_id=%d subif=%d\n",
+		 (flags & DP_F_DEREGISTER) ?
+			 "unregister subif:" :
+			 "register subif",
+		 owner ? owner->name : "NULL",
+		 dev ? dev->name : "NULL",
+		 subif_name,
+		 subif_id ? subif_id->port_id : -1,
+		 subif_id ? subif_id->subif : -1);
+
+	if ((!subif_id) || (!subif_id->port_id) || (!owner) ||
+	    (subif_id->port_id >= MAX_DP_PORTS) ||
+	    (subif_id->port_id <= 0) ||
+	    ((inst < 0) || (inst >= DP_MAX_INST))) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "register subif failed port_id or owner invalid\n");
+		return DP_FAILURE;
+	}
+	port_id = subif_id->port_id;
+	port_info = &dp_port_info[inst][port_id];
+
+	if (((!dev) && !(port_info->alloc_flags & DP_F_FAST_DSL)) ||
+	    !subif_name) {
+		DP_DEBUG(DP_DBG_FLAG_REG, "Wrong dev=%p, subif_name=%p\n",
+			 dev, subif_name);
+		return DP_FAILURE;
+	}
+	if (!data)
+		data = &tmp_data;
+	DP_LIB_LOCK(&dp_lock);
+	if (port_info->owner != owner) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "Unregister subif fail:Not matching owner\n");
+		DP_LIB_UNLOCK(&dp_lock);
+		return res;
+	}
+
+	if (flags & DP_F_DEREGISTER) {
+		/*
+		 * Sub-6 ST-003b — replace the Sub-3 skeleton that always
+		 * returned DP_FAILURE. dp_deregister_subif_private is the
+		 * symmetric inverse of dp_register_subif_private; it
+		 * unprograms the subif_info[] entry, decrements num_subif,
+		 * and (when ref_cnt drops to zero) calls cbm_dp_enable with
+		 * CBM_PORT_F_DISABLE to clear the QIDT mapping on the CBM
+		 * side. Closes Plan-Reviewer ST-004 critical-4.
+		 */
+		res = dp_deregister_subif_private(inst, owner, dev,
+						  subif_name,
+						  subif_id, data, flags);
+	} else {
+		res = dp_register_subif_private(inst, owner, dev,
+						subif_name,
+						subif_id, data, flags);
+	}
+	DP_LIB_UNLOCK(&dp_lock);
+	return res;
+}
+
+/*
+ * dp_register_subif_private - AVM datapath_api.c:486-661 with the
+ * documented surgeries:
+ *   - AVM:506 status check loosened from < PORT_DEV_REGISTERED to
+ *     < PORT_ALLOCATED per CQ-003 A (dp_register_dev not ported in Sub-3)
+ *   - PR_xxx and printk calls rewritten to dev_*(dp_dev, ...) per AS-011
+ *   - add_logic_dev call routed to dp_local_add_logic_dev stub
+ *   - The cbm_data.flags assignment described in plan AC-003-5(c) is
+ *     OMITTED because struct cbm_dp_en_data in lantiq_cbm_api.h (and in
+ *     the AVM source-of-truth at include/net/lantiq_cbm_api.h) carries no
+ *     .flags member; the assignment would be a compile error. Documented
+ *     as scope_deviation: future Sub-4 will revisit when the real CBM
+ *     driver lands with a wider struct cbm_dp_en_data definition.
+ */
+static int dp_register_subif_private(int inst, struct module *owner,
+				     struct net_device *dev,
+				     char *subif_name, dp_subif_t *subif_id,
+				     /*device related info*/
+				     struct dp_subif_data *data, u32 flags)
+{
+	int res = DP_FAILURE;
+
+	int i, port_id, start, end;
+	struct pmac_port_info *port_info;
+	struct cbm_dp_en_data cbm_data = { 0 };
+	struct subif_platform_data platfrm_data = { 0 };
+
+	port_id = subif_id->port_id;
+	port_info = &dp_port_info[inst][port_id];
+	subif_id->inst = inst;
+	subif_id->subif_num = 1;
+	platfrm_data.subif_data = (void *)data;
+	platfrm_data.dev = dev;
+	/*
+	 * TODO(phase-3-dp-register-dev): port AVM dp_register_dev /
+	 * dp_register_dev_ext from datapath_api.c:866-961 in a future
+	 * subtask. Until then, dp_register_subif accepts PORT_ALLOCATED
+	 * status as an entry condition (loosened from AVM line 506:
+	 * status < PORT_DEV_REGISTERED).
+	 */
+	if (port_info->status < PORT_ALLOCATED) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "register subif failed:%s is not a registered dev!\n",
+			 subif_name);
+		return res;
+	}
+
+	if (subif_id->subif < 0) { /*dynamic mode */
+		if (flags & DP_F_SUBIF_LOGICAL) {
+			if (!(DP_CB(inst, supported_logic_dev)(inst, dev,
+							       subif_name))) {
+				DP_DEBUG(DP_DBG_FLAG_REG,
+					 "reg subif fail:%s not support dev\n",
+					 subif_name);
+				return res;
+			}
+			if (!(flags & DP_F_ALLOC_EXPLICIT_SUBIFID)) {
+				/*Share same subif with its base device */
+				res = dp_local_add_logic_dev(inst, port_id, dev,
+							     subif_id, flags);
+				return res;
+			}
+		}
+		start = 0;
+		end = port_info->ctp_max;
+	} else {
+		/*caller provided subif. Try to get its vap value as start */
+		start = GET_VAP(subif_id->subif, port_info->vap_offset,
+				port_info->vap_mask);
+		end = start + 1;
+	}
+
+	/*allocate a free subif */
+	for (i = start; i < end; i++) {
+		u32 cqm_deq_port;
+		u32 dma_chan;
+		u32 cid, pid, nid;
+		struct dma_chan_info *dp_dma_chan_tbl_info = NULL;
+
+		if (port_info->subif_info[i].flags) /*used already & not free*/
+			continue;
+
+		/*now find a free subif or valid subif
+		 *need to do configuration HW
+		 */
+		if (port_info->status) {
+			if (dp_port_prop[inst].info.subif_platform_set(inst,
+								       port_id,
+								       i,
+								       &platfrm_data,
+								       flags)) {
+				dev_err(dp_dev, "subif_platform_set fail\n");
+				goto EXIT;
+			} else {
+				DP_DEBUG(DP_DBG_FLAG_REG,
+					 "subif_platform_set succeed\n");
+			}
+		} else {
+			dev_err(dp_dev, "port info status fail for 0\n");
+			return res;
+		}
+
+		cqm_deq_port = port_info->subif_info[i].cqm_deq_port;
+		dma_chan = dp_deq_port_tbl[inst][cqm_deq_port].dma_chan;
+		cid = _DMA_CONTROLLER(dma_chan);
+		pid = _DMA_PORT(dma_chan);
+		nid = _DMA_CHANNEL(dma_chan);
+		/* cid, pid and nid bounds match the dp_dma_chan_tbl shape
+		 * declared in datapath.h ([4][8][16]).
+		 */
+		if ((cid >= DP_DMAMAX) || (pid >= DP_MAX_DMA_PORT) ||
+		    nid >= DP_MAX_DMA_CHAN) {
+			dev_err(dp_dev, "ERROR: cid=%d pid=%d nid=%d\n",
+				cid, pid, nid);
+			dev_err(dp_dev,
+				"DMAMAX=%d MAX_DMA_PORT=%d MAX_DMA_CHAN=%d\n",
+				DP_DMAMAX, DP_MAX_DMA_PORT, DP_MAX_DMA_CHAN);
+			return DP_FAILURE;
+		}
+
+		DP_DEBUG(DP_DBG_FLAG_REG, "cid=%d pid=%d nid=%d\n",
+			 cid, pid, nid);
+		dp_dma_chan_tbl_info = &dp_dma_chan_tbl[inst][cid][pid][nid];
+		(void)dp_dma_chan_tbl_info;
+
+		port_info->subif_info[i].flags = 1;
+		port_info->subif_info[i].netif = dev;
+		port_info->port_id = port_id;
+
+		if (subif_id->subif < 0) /*dynamic:shift bits as HW defined*/
+			port_info->subif_info[i].subif =
+				SET_VAP(i, port_info->vap_offset,
+					port_info->vap_mask);
+		else /*provided by caller since it is alerady shifted properly*/
+			port_info->subif_info[i].subif = subif_id->subif;
+		strncpy(port_info->subif_info[i].device_name,
+			subif_name,
+			sizeof(port_info->subif_info[i].device_name) - 1);
+		port_info->subif_info[i].flags = PORT_SUBIF_REGISTERED;
+		port_info->subif_info[i].subif_flag = flags;
+		port_info->status = PORT_SUBIF_REGISTERED;
+		subif_id->port_id = port_id;
+		subif_id->subif = port_info->subif_info[i].subif;
+		port_info->num_subif++;
+		if ((port_info->num_subif == 1) ||
+		    (platfrm_data.act & TRIGGER_CQE_DP_ENABLE)) {
+			cbm_data.dp_inst = inst;
+			cbm_data.num_dma_chan = port_info->num_dma_chan;
+			cbm_data.cbm_inst = dp_port_prop[inst].cbm_inst;
+			cbm_data.deq_port = port_info->deq_port_base +
+					    (data ? data->deq_port_idx : 0);
+			if ((cbm_data.deq_port == 0) ||
+			    (cbm_data.deq_port >= DP_MAX_CQM_DEQ)) {
+				dev_err(dp_dev, "Wrong deq_port: %d\n",
+					cbm_data.deq_port);
+				return res;
+			}
+			/* PPA Directpath/LitePath don't have DMA CH */
+			if ((atomic_read(&dp_dma_chan_tbl[inst][cid][pid][nid].ref_cnt) == 1) &&
+			    !(port_info->alloc_flags & DP_F_DIRECT) &&
+			    (cbm_data.num_dma_chan))
+				cbm_data.dma_chnl_init = 1; /*to enable DMA*/
+			DP_DEBUG(DP_DBG_FLAG_REG,
+				 "cbm_dp_enable: dp_port=%d deq_port=%d dma_chnl_init=%d ref=%d\n",
+				 port_id, cbm_data.deq_port,
+				 cbm_data.dma_chnl_init,
+				 atomic_read(&dp_dma_chan_tbl[inst][cid][pid][nid].ref_cnt));
+			if (cbm_dp_enable(owner, port_id, &cbm_data, 0,
+					  port_info->alloc_flags)) {
+				DP_DEBUG(DP_DBG_FLAG_REG,
+					 "cbm_dp_enable fail\n");
+				return res;
+			}
+			DP_DEBUG(DP_DBG_FLAG_REG, "cbm_dp_enable ok\n");
+		} else {
+			DP_DEBUG(DP_DBG_FLAG_REG,
+				 "No need cbm_dp_enable:dp_port=%d subix=%d\n",
+				 port_id, i);
+		}
+		break;
+	}
+
+	if (i < end) {
+		res = DP_SUCCESS;
+		if (dp_bp_dev_tbl[inst][port_info->subif_info[i].bp].ref_cnt > 1)
+			return res;
+		dp_inst_add_dev(dev, subif_name,
+				subif_id->inst, subif_id->port_id,
+				port_info->subif_info[i].bp,
+				subif_id->subif, flags);
+	} else {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "register subif failed for no matched vap\n");
+	}
+EXIT:
+	return res;
+}
+
+/*
+ * dp_deregister_subif_private — Sub-6 ST-003b symmetric inverse of
+ * dp_register_subif_private. AVM datapath_api.c:664-781.
+ *
+ * Closes Plan-Reviewer ST-004 critical-4: replaces the Sub-3 skeleton
+ * that always returned DP_FAILURE on the DP_F_DEREGISTER dispatch path,
+ * so ST-004's ndo_stop can do an honest reverse-order teardown.
+ *
+ * Reverse-order operations (mirrors dp_register_subif_private's body):
+ *   (1) status guard — only deregister subifs whose port is currently in
+ *       PORT_SUBIF_REGISTERED state (AVM:686)
+ *   (2) walk port_info->subif_info[] to find the matching subif (AVM:693)
+ *   (3) device-match check + logical-dev path delegation (AVM:706-711)
+ *   (4) reset the per-subif mib / flags / device_name (AVM:720-724)
+ *   (5) call subif_platform_set to unprogram CTP / BridgePort /
+ *       PCE_QUEUE_MAP HW state (AVM:725-730)
+ *   (6) if num_subif drops to zero, mark the port PORT_ALLOCATED
+ *       (Sub-3 strip divergence from AVM:731-732 which drops to
+ *       PORT_DEV_REGISTERED — Sub-3 omits dp_register_dev so the forward
+ *       path never passes through PORT_DEV_REGISTERED; dropping to
+ *       PORT_ALLOCATED here closes the state-machine loop so
+ *       dp_dealloc_port_ext's DEREGISTER status guard passes — see
+ *       step (6) body comment for the full closed-loop diagram)
+ *   (7) if the deq_port ref_cnt drops to zero, call cbm_dp_enable with
+ *       CBM_PORT_F_DISABLE to clear the QIDT mapping on the CBM side
+ *       (AVM:734-758) — this is the call that closes Plan-Reviewer ST-004
+ *       critical-3 (cbm_dp_enable's prior implementation ignored its flags
+ *       argument; ST-003b's cbm_dp.c change makes FLAG_DISABLE meaningful)
+ *   (8) dp_inst_del_dev to remove the device from the per-instance table
+ *       (AVM:768-774)
+ *
+ * AVM dependencies stripped or substituted:
+ *   - del_logic_dev: AVM logic-dev path (AVM:708) calls del_logic_dev to
+ *     unwind add_logic_dev's bookkeeping. Sub-3 deferred logic-dev support
+ *     (dp_local_add_logic_dev is a WARN_ONCE stub returning -1), so the
+ *     deregister symmetric stub also returns DP_FAILURE in that branch.
+ *     Documented inline.
+ *   - dp_node_children_free: AVM:742 walks PPv4-managed queue children
+ *     associated with the deq_port. PPv4 stack is entirely stripped from
+ *     Sub-3 per CQ-001 A. No-op here; the cbm_dp_enable disable call
+ *     covers the CBM-side teardown which is all Sub-4 minimum requires.
+ *
+ * Per AC-003b-4 returns DP_SUCCESS on success / DP_FAILURE on any
+ * intermediate failure — same convention as dp_register_subif_private.
+ */
+static int dp_deregister_subif_private(int inst, struct module *owner,
+				       struct net_device *dev,
+				       char *subif_name, dp_subif_t *subif_id,
+				       struct dp_subif_data *data, u32 flags)
+{
+	int res = DP_FAILURE;
+	int i, port_id, cqm_port, bp;
+	u8 find = 0;
+	struct pmac_port_info *port_info;
+	struct cbm_dp_en_data cbm_data = { 0 };
+	struct subif_platform_data platfrm_data = { 0 };
+
+	port_id = subif_id->port_id;
+	port_info = &dp_port_info[inst][port_id];
+	platfrm_data.subif_data = data;
+	platfrm_data.dev = dev;
+
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "Try to unregister subif=%s with dp_port=%d subif=%d\n",
+		 subif_name, subif_id->port_id, subif_id->subif);
+
+	/* (1) AVM:686 — only deregister fully-registered subifs. */
+	if (port_info->status != PORT_SUBIF_REGISTERED) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "Unregister failed:%s not registered subif!\n",
+			 subif_name);
+		return res;
+	}
+
+	/* (2) AVM:693 — find the matching subif slot. */
+	for (i = 0; i < port_info->ctp_max; i++) {
+		if (port_info->subif_info[i].subif ==
+		    (u32)subif_id->subif) {
+			find = 1;
+			break;
+		}
+	}
+	if (!find)
+		return res;
+
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "Found matched subif: port_id=%d subif=%x vap=%d\n",
+		 subif_id->port_id, subif_id->subif, i);
+
+	/*
+	 * (3) AVM:706 — device-match guard. AVM dispatches to del_logic_dev
+	 * for an unexplicit-logical-dev mismatch; Sub-3 logic-dev path is a
+	 * WARN_ONCE stub (dp_local_add_logic_dev returns -1 unconditionally)
+	 * so the symmetric deregister branch returns DP_FAILURE without
+	 * attempting the logical-dev unwind. A future Sub-6.x will port the
+	 * full logical-dev path alongside add_logic_dev's real body.
+	 */
+	if (port_info->subif_info[i].netif != dev) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "Unregister fail: dev mismatch (subif %s, expected dev %p, got %p)\n",
+			 subif_name, port_info->subif_info[i].netif, dev);
+		return res;
+	}
+	if (!list_empty(&port_info->subif_info[i].logic_dev)) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "Unregister fail: logic_dev of %s not empty yet!\n",
+			 subif_name);
+		return res;
+	}
+
+	cqm_port = port_info->subif_info[i].cqm_deq_port;
+	bp = port_info->subif_info[i].bp;
+
+	/* (4) AVM:720-724 — reset per-subif mib / flags / device_name. */
+	memset(&port_info->subif_info[i].mib, 0,
+	       sizeof(port_info->subif_info[i].mib));
+	port_info->subif_info[i].flags = 0;
+	port_info->num_subif--;
+
+	/* (5) AVM:725-730 — subif_platform_set unprograms CTP / BridgePort
+	 * / PCE_QUEUE_MAP. Continue on failure (matches AVM's commented-out
+	 * `return res;` at AVM:729 — AVM intentionally falls through so the
+	 * remaining teardown still runs).
+	 */
+	if (dp_port_prop[inst].info.subif_platform_set(inst, port_id, i,
+						       &platfrm_data, flags)) {
+		dev_err(dp_dev, "subif_platform_set fail on deregister\n");
+		/* fall through per AVM:729 commented-out return */
+	}
+
+	/*
+	 * (6) Symmetric inverse of dp_register_subif_private's PORT_ALLOCATED
+	 * -> PORT_SUBIF_REGISTERED transition. Diverges from AVM:732 which
+	 * drops to PORT_DEV_REGISTERED — AVM relies on dp_register_dev having
+	 * moved status to PORT_DEV_REGISTERED on the forward path, but Sub-3
+	 * strip pattern omits dp_register_dev (TODO at the forward-path status
+	 * check phase-3-dp-register-dev) so the forward path never passes
+	 * through PORT_DEV_REGISTERED — it stays at PORT_ALLOCATED until
+	 * register_subif promotes it to PORT_SUBIF_REGISTERED. Dropping back
+	 * to PORT_ALLOCATED here closes the state-machine loop so
+	 * dp_dealloc_port_ext's DEREGISTER branch (which requires
+	 * status == PORT_ALLOCATED at dp_alloc_port_private's guard) passes.
+	 *
+	 * Closed-loop in the Sub-3 strip pattern:
+	 *   PORT_FREE -> alloc_port -> PORT_ALLOCATED -> register_subif ->
+	 *   PORT_SUBIF_REGISTERED -> deregister_subif (last) -> PORT_ALLOCATED
+	 *   -> dealloc_port -> PORT_FREE
+	 *
+	 * Build-Reviewer attempt-1 HIGH fix: previous attempt mirrored AVM:732
+	 * verbatim (PORT_DEV_REGISTERED) which left the state machine open-
+	 * ended and made dp_dealloc_port_ext unreachable.
+	 */
+	if (!port_info->num_subif)
+		port_info->status = PORT_ALLOCATED;
+
+	/*
+	 * (7) AVM:734-758 — when the dequeue-port ref drops to zero, disable
+	 * the CBM-side QIDT mapping. cbm_dp_enable with CBM_PORT_F_DISABLE
+	 * routes through the FLAG_DISABLE branch added to cbm_dp.c by this
+	 * same subtask (closes Plan-Reviewer ST-004 critical-3).
+	 *
+	 * dp_node_children_free (AVM:742) is OMITTED — it walks PPv4-managed
+	 * queue children, and PPv4 is fully stripped from Sub-3 (CQ-001 A).
+	 */
+	if (!dp_deq_port_tbl[inst][cqm_port].ref_cnt) {
+		cbm_data.dp_inst = inst;
+		cbm_data.cbm_inst = dp_port_prop[inst].cbm_inst;
+		cbm_data.deq_port = cqm_port;
+		/* PPA Directpath/LitePath don't have DMA CH */
+		if (!(port_info->alloc_flags & DP_F_DIRECT))
+			cbm_data.dma_chnl_init = 1; /* to disable DMA */
+		if (cbm_dp_enable(owner, port_id, &cbm_data,
+				  CBM_PORT_F_DISABLE,
+				  port_info->alloc_flags)) {
+			DP_DEBUG(DP_DBG_FLAG_REG,
+				 "cbm_dp_disable fail:port=%d subix=%d dma_chnl_init=%d\n",
+				 port_id, i, cbm_data.dma_chnl_init);
+			return res;
+		}
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "cbm_dp_disable ok:port=%d subix=%d cqm_port=%d\n",
+			 port_id, i, cqm_port);
+	}
+
+	/* (8) AVM:768-774 — remove the device from the per-instance table
+	 * when the bp ref drops to zero.
+	 */
+	if (!dp_bp_dev_tbl[inst][bp].dev) {
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "dp_inst_del_dev for %s inst=%d bp=%d\n",
+			 dev ? dev->name : "(null)", inst, bp);
+		dp_inst_del_dev(dev, subif_name, inst, port_id,
+				bp, subif_id->subif);
+	}
+
+	DP_DEBUG(DP_DBG_FLAG_REG, "  dp_port=%d subif=%d cqm_port=%d\n",
+		 subif_id->port_id, subif_id->subif, cqm_port);
+	res = DP_SUCCESS;
+	return res;
+}
+
+/*
+ * dp_dealloc_port_ext — Sub-6 ST-003b symmetric inverse of
+ * dp_alloc_port_ext.
+ *
+ * AVM does NOT carry a separate dp_dealloc_port_ext function — AVM uses
+ * dp_alloc_port_ext with the DP_F_DEREGISTER flag bit to drive the
+ * dealloc path inside dp_alloc_port_private (which already carries the
+ * `if (flags & DP_F_DEREGISTER)` branch). Sub-6 ST-003b promotes that
+ * pattern into a NAMED public wrapper because:
+ *
+ *   (a) Symmetric naming: ST-004's ndo_stop calls dp_dealloc_port_ext()
+ *       which reads as the literal inverse of ndo_open's
+ *       dp_alloc_port_ext() — easier to audit than a flag-toggle.
+ *   (b) Per-call-site safety: passing DP_F_DEREGISTER through every
+ *       teardown-path call site invites a typo bug (a missing
+ *       DP_F_DEREGISTER turns dealloc into alloc). Wrapping the
+ *       flag-set inside the function eliminates that footgun class.
+ *
+ * Returns DP_SUCCESS / DP_FAILURE per the same convention as
+ * dp_alloc_port_ext — DP_F_DEREGISTER's branch inside
+ * dp_alloc_port_private returns DP_SUCCESS on the happy path
+ * (datapath_api.c body documented above) and DP_FAILURE on any
+ * intermediate error.
+ *
+ * The function exists at file scope (NOT static) because intel_xrx500.c
+ * in the sibling intel-xrx500-gswip composite calls it from ndo_stop.
+ * Exported in the DATAPATH_INTERNAL namespace alongside dp_alloc_port_ext.
+ */
+int dp_dealloc_port_ext(int inst, struct module *owner,
+			struct net_device *dev,
+			u32 dev_port, int port_id,
+			dp_pmac_cfg_t *pmac_cfg,
+			struct dp_port_data *data, u32 flags)
+{
+	/*
+	 * Route through dp_alloc_port_ext with DP_F_DEREGISTER OR'd into
+	 * flags. dp_alloc_port_ext acquires DP_LIB_LOCK(&dp_lock), validates
+	 * dp_init_ok, then dispatches into dp_alloc_port_private whose
+	 * `if (flags & DP_F_DEREGISTER)` branch frees the per-port state.
+	 *
+	 * The DP_F_DEREGISTER branch (in dp_alloc_port_private) performs the
+	 * following teardown sequence — Build-Reviewer attempt-1 MEDIUM-2
+	 * coupling-documentation requirement:
+	 *
+	 *   (1) Guard: requires `dp_port_info[inst][port_id].status ==
+	 *       PORT_ALLOCATED`. dp_deregister_subif_private's step (6) is
+	 *       responsible for dropping status back to PORT_ALLOCATED so
+	 *       this guard passes; without that transition this function
+	 *       returns DP_FAILURE on every call.
+	 *   (2) cbm_dp_port_dealloc(owner, dev_port, port_id,
+	 *       &cbm_data, flags) — release CBM-side port resources.
+	 *   (3) dp_inst_insert_mod(owner, port_id, inst, 0) — clear the
+	 *       per-port instance mapping.
+	 *   (4) DP_CB(inst, port_platform_set)(inst, port_id, data, flags)
+	 *       with DP_F_DEREGISTER set — unprogram per-port HW state.
+	 *   (5) memset(&dp_port_info[inst][port_id], 0, ...) — zero the
+	 *       per-port bookkeeping (status -> PORT_FREE, owner -> NULL,
+	 *       dev -> NULL, etc.) so a future dp_alloc_port_ext can rebind
+	 *       the port.
+	 *
+	 * COUPLING CONTRACT: any future widening of dp_alloc_port_private's
+	 * non-DEREGISTER branch that affects shared state (the
+	 * dp_dma_chan_tbl entries, dp_deq_port_tbl ref_cnts, etc.) MUST be
+	 * matched by a corresponding undo in the DEREGISTER branch or
+	 * dp_dealloc_port_ext will silently leak state across ndo_stop ->
+	 * ndo_open cycles. The current AVM-faithful body covers the five
+	 * steps above and is correct.
+	 *
+	 * Several parameters of dp_dealloc_port_ext are no-ops in the
+	 * DEREGISTER path: @pmac_cfg is not consulted (line-excised
+	 * dp_pmac_set), @dev_port is only used inside
+	 * cbm_dp_port_dealloc's tracing, @dev is unused. The
+	 * 7-parameter signature mirrors dp_alloc_port_ext for symmetry per
+	 * the AC-003b-5 'symmetric inverse' contract — callers should pass
+	 * the same arguments they passed to dp_alloc_port_ext at alloc time.
+	 */
+	return dp_alloc_port_ext(inst, owner, dev, dev_port, port_id,
+				 pmac_cfg, data, flags | DP_F_DEREGISTER);
+}
+
+/*
+ * EXPORT_SYMBOL_NS_GPL block per AC-003-2: exactly four exports in
+ * namespace "DATAPATH_INTERNAL". The private wrappers
+ * (dp_alloc_port_private, dp_register_subif_private), the probe-time
+ * entry (dp_init_module), and the cap/instance helpers (register_dp_cap,
+ * request_dp) are intra-module callers only and are NOT exported.
+ *
+ * Sub-6 ST-003b — adds dp_dealloc_port_ext to the export list. The
+ * deregister-side private body (dp_deregister_subif_private) is NOT
+ * exported: it is reached only via dp_register_subif_ext's
+ * DP_F_DEREGISTER dispatch (which IS exported).
+ *
+ * AS-003 deviation acknowledged: the plan's original phrasing of
+ * "static-inline forward decls" is mechanically impossible for these
+ * dispatch surfaces - see datapath_api.h's header-comment block.
+ */
+EXPORT_SYMBOL_NS_GPL(dp_alloc_port, "DATAPATH_INTERNAL");
+EXPORT_SYMBOL_NS_GPL(dp_alloc_port_ext, "DATAPATH_INTERNAL");
+EXPORT_SYMBOL_NS_GPL(dp_dealloc_port_ext, "DATAPATH_INTERNAL");
+EXPORT_SYMBOL_NS_GPL(dp_register_subif, "DATAPATH_INTERNAL");
+EXPORT_SYMBOL_NS_GPL(dp_register_subif_ext, "DATAPATH_INTERNAL");
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_api.h b/drivers/net/ethernet/lantiq/datapath/datapath_api.h
new file mode 100644
index 0000000000000..27f59cc38c463
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_api.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Datapath Manager intra-module API surface (Sub-3 NEW header).
+ *
+ * No AVM counterpart - this header is created by Sub-3 to expose the four
+ * datapath registration entry points that Sub-6 will consume. The full AVM
+ * include/net/datapath_api.h is NOT recreated in the v6.18 tree; instead,
+ * the public API contract is carried by these four prototypes plus the
+ * forward declarations of dp_subif_t / dp_port_data / dp_subif_data /
+ * dp_dev_data / cbm_dp_en_data.
+ *
+ * AS-003 deviation note (per AC-001-6 explicit deviation acknowledgement):
+ *
+ *   The task wording originally specified "static-inline forward decls"
+ *   for the four entry points. That phrasing is mechanically impossible -
+ *   each of dp_alloc_port / dp_alloc_port_ext / dp_register_subif /
+ *   dp_register_subif_ext dispatches through file-scope dp_port_prop[]
+ *   state and takes non-inlinable struct-by-pointer arguments
+ *   (dp_pmac_cfg_t *, struct dp_port_data *, struct dp_subif_data *,
+ *   dp_subif_t *). Bodies are by definition non-inline, so the four
+ *   symbols are exposed as EXTERN prototypes here and DEFINED with
+ *   EXPORT_SYMBOL_NS_GPL(..., "DATAPATH_INTERNAL") at the .c definitions
+ *   (per Sub-1 AS-010 precedent). Linkage scope is enforced by the
+ *   namespace export, not by inlining.
+ */
+
+#ifndef DATAPATH_API_PRIV_H
+#define DATAPATH_API_PRIV_H
+
+#include <linux/types.h>
+#include <linux/netdevice.h>
+#include <linux/module.h>
+
+#include "datapath_api_qos.h"
+#include "datapath_api_gswip30.h"
+
+/*
+ * Bare-minimum forward declarations of types consumed by the four
+ * prototypes below. The full struct definitions live in datapath.h
+ * (private to the Sub-3 implementation). Forward decls are sufficient
+ * here because every reference is by pointer.
+ */
+struct dp_subif;
+typedef struct dp_subif dp_subif_t;
+struct dp_port_data;
+struct dp_subif_data;
+struct dp_dev_data;
+struct cbm_dp_en_data;
+struct dp_pmac_cfg;
+typedef struct dp_pmac_cfg dp_pmac_cfg_t;
+
+/*
+ * dp_alloc_port - allocate a datapath/PMAC port for a netdev module.
+ *
+ * Wrapper around dp_alloc_port_ext with inst=0 (the SOC-side instance).
+ * Sub-3 ST-003 will provide the body; Sub-6 calls this from the laneth /
+ * waneth probe paths.
+ */
+int dp_alloc_port(struct module *owner, struct net_device *dev,
+		  u32 dev_port, u32 port_id,
+		  dp_pmac_cfg_t *pmac_cfg, u32 flags);
+
+/*
+ * dp_alloc_port_ext - explicit-instance variant of dp_alloc_port.
+ *
+ * The DP instance is normally 0 on the SOC side and non-zero for PCIe
+ * peripherals; Sub-3 is SOC-only so inst is always 0 in practice. Returns
+ * the allocated PMAC port number or a negative error.
+ */
+int dp_alloc_port_ext(int inst, struct module *owner, struct net_device *dev,
+		      u32 dev_port, int port_id, dp_pmac_cfg_t *pmac_cfg,
+		      struct dp_port_data *data, u32 flags);
+
+/*
+ * dp_dealloc_port_ext - Sub-6 ST-003b symmetric inverse of dp_alloc_port_ext.
+ *
+ * Frees the per-port state allocated by dp_alloc_port_private and clears
+ * the dp_port_info[][port_id] slot back to PORT_FREE. Internally routes
+ * through dp_alloc_port_ext with DP_F_DEREGISTER OR'd into @flags so the
+ * locking and state-machine invariants match the alloc-side path exactly.
+ *
+ * Returns DP_SUCCESS on success, DP_FAILURE on any intermediate error
+ * (same convention as dp_alloc_port_ext — NOT 0 / -errno).
+ *
+ * Closes Plan-Reviewer ST-004 critical-4 (ndo_stop teardown contract):
+ * ST-004's ndo_stop calls this from the reverse-order teardown of
+ * ndo_open's dp_alloc_port_ext.
+ */
+int dp_dealloc_port_ext(int inst, struct module *owner, struct net_device *dev,
+			u32 dev_port, int port_id, dp_pmac_cfg_t *pmac_cfg,
+			struct dp_port_data *data, u32 flags);
+
+/*
+ * dp_register_subif - register a sub-interface (CTP) under an allocated DP port.
+ *
+ * Wrapper around dp_register_subif_ext with inst=0. Caller fills in
+ * subif_id->port_id (returned from dp_alloc_port); on success the function
+ * populates subif_id->subif with the assigned VAP/CTP identifier.
+ */
+int dp_register_subif(struct module *owner, struct net_device *dev,
+		      char *subif_name, dp_subif_t *subif_id, u32 flags);
+
+/*
+ * dp_register_subif_ext - explicit-instance variant of dp_register_subif.
+ */
+int dp_register_subif_ext(int inst, struct module *owner,
+			  struct net_device *dev, char *subif_name,
+			  dp_subif_t *subif_id, struct dp_subif_data *data,
+			  u32 flags);
+
+#endif /* DATAPATH_API_PRIV_H */
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_api_gswip30.h b/drivers/net/ethernet/lantiq/datapath/datapath_api_gswip30.h
new file mode 100644
index 0000000000000..544b6587677f7
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_api_gswip30.h
@@ -0,0 +1,447 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * include/net/datapath_api_gswip30.h:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * GSWIP-3.0 DMA descriptor and PMAC header layouts.
+ *
+ * Sub-3 ST-001 port of AVM 4.9 include/net/datapath_api_gswip30.h:
+ *
+ *   dma_rx_desc_0/1/2/3, dma_tx_desc_0/1/2/3 union+bitfield structs,
+ *   pmac_rx_hdr / pmac_tx_hdr layouts, plus the GSWIP30_TYPE / GSWIP30_VER /
+ *   TEMPL_NORMAL / TEMPL_CHECKSUM / TEMPL_OTHERS / MAX_TEMPLATE constants
+ *   and the SET_PMAC_PORTMAP / GET_VAP / SET_VAP accessor macros (the
+ *   accessor macros live in datapath.h / datapath_misc.h per AVM, but the
+ *   GSWIP30_TYPE/VER and TEMPL_* constants are kept here alongside the
+ *   descriptor types they describe).
+ *
+ * Excisions applied to the AVM source per AC-001-3 (line-deletion only,
+ * NOT #if 0 / commented-out):
+ *   - none (the AVM file has no forbidden conditional-compilation
+ *     guard tokens).
+ *
+ * The GSWIP-3.1 alternative descriptor layouts (datapath_api_gswip31.h)
+ * are NOT ported - this driver targets GSWIP-3.0 only.
+ */
+
+#ifndef DATAPATH_API_GRX500_H
+#define DATAPATH_API_GRX500_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_LITTLE_ENDIAN
+struct dma_rx_desc_0 {
+	/* DWORD 0 */
+	union {
+		struct {
+			u32 dest_sub_if_id : 15;
+			u32 eth_type : 2;
+			u32 flow_id : 8;
+			u32 tunnel_id : 4;
+			u32 resv0 : 3;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_1 {
+	/* DWORD 1 */
+	union {
+		struct {
+			u32 classid : 4;
+			u32 resv1 : 4;
+			u32 ep : 4;
+			u32 color : 2;
+			u32 mpe1 : 1;
+			u32 mpe2 : 1;
+			u32 enc : 1;
+			u32 dec : 1;
+			u32 nat : 1;
+			u32 tcp_err : 1;
+			u32 session_id : 12;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_2 {
+	/* DWORD 2 */
+	union {
+		struct {
+			u32 data_ptr;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_3 {
+	/* DWORD 3 */
+	union {
+		struct {
+			u32 data_len : 16;
+			u32 mpoa_mode : 2;
+			u32 mpoa_pt : 1;
+			u32 qid : 4;
+			u32 byte_offset : 3;
+			u32 pdu_type : 1;
+			u32 dic : 1;
+			u32 eop : 1;
+			u32 sop : 1;
+			u32 c : 1;
+			u32 own : 1;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_0 {
+	/* DWORD 0 */
+	union {
+		struct {
+			u32 dest_sub_if_id : 15;
+			u32 eth_type : 2;
+			u32 flow_id : 8;
+			u32 tunnel_id : 4;
+			u32 resv0 : 3;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_1 {
+	/* DWORD 1 */
+	union {
+		struct {
+			u32 classid : 4;
+			u32 resv1 : 4;
+			u32 ep : 4;
+			u32 color : 2;
+			u32 mpe1 : 1;
+			u32 mpe2 : 1;
+			u32 enc : 1;
+			u32 dec : 1;
+			u32 nat : 1;
+			u32 tcp_err : 1;
+			u32 session_id : 12;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_2 {
+	/* DWORD 2 */
+	union {
+		struct {
+			u32 data_ptr;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_3 {
+	/* DWORD 3 */
+	union {
+		struct {
+			u32 data_len : 16;
+			u32 mpoa_mode : 2;
+			u32 mpoa_pt : 1;
+			u32 qid : 4;
+			u32 byte_offset : 3;
+			u32 pdu_type : 1;
+			u32 dic : 1;
+			u32 eop : 1;
+			u32 sop : 1;
+			u32 c : 1;
+			u32 own : 1;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+#else /* big endian */
+
+struct dma_rx_desc_0 {
+	/* DWORD 0 */
+	union {
+		struct {
+			u32 resv0 : 3;
+			u32 tunnel_id : 4;
+			u32 flow_id : 8;
+			u32 eth_type : 2;
+			u32 dest_sub_if_id : 15;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_1 {
+	/* DWORD 1 */
+	union {
+		struct {
+			u32 session_id : 12;
+			u32 tcp_err : 1;
+			u32 nat : 1;
+			u32 dec : 1;
+			u32 enc : 1;
+			u32 mpe2 : 1;
+			u32 mpe1 : 1;
+			u32 color : 2;
+			u32 ep : 4;
+			u32 resv1 : 4;
+			u32 classid : 4;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_2 {
+	/* DWORD 2 */
+	union {
+		struct {
+			u32 data_ptr;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_rx_desc_3 {
+	/* DWORD 3 */
+	union {
+		struct {
+			u32 own : 1;
+			u32 c : 1;
+			u32 sop : 1;
+			u32 eop : 1;
+			u32 dic : 1;
+			u32 pdu_type : 1;
+			u32 byte_offset : 3;
+			u32 qid : 4;
+			u32 mpoa_pt : 1;
+			u32 mpoa_mode : 2;
+			u32 data_len : 16;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_0 {
+	union {
+		struct {
+			/* DWORD 0 */
+			u32 resv0 : 3;
+			u32 tunnel_id : 4;
+			u32 flow_id : 8;
+			u32 eth_type : 2;
+			u32 dest_sub_if_id : 15;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_1 {
+	/* DWORD 1 */
+	union {
+		struct {
+			u32 session_id : 12;
+			u32 tcp_err : 1;
+			u32 nat : 1;
+			u32 dec : 1;
+			u32 enc : 1;
+			u32 mpe2 : 1;
+			u32 mpe1 : 1;
+			u32 color : 2;
+			u32 ep : 4;
+			u32 resv1 : 4;
+			u32 classid : 4;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_2 {
+	/* DWORD 2 */
+	union {
+		struct {
+			u32 data_ptr;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_3 {
+	/* DWORD 3 */
+	union {
+		struct {
+			u32 own : 1;
+			u32 c : 1;
+			u32 sop : 1;
+			u32 eop : 1;
+			u32 dic : 1;
+			u32 pdu_type : 1;
+			u32 byte_offset : 3;
+			u32 qid : 4;
+			u32 mpoa_pt : 1;
+			u32 mpoa_mode : 2;
+			u32 data_len : 16;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+#endif
+
+#ifdef CONFIG_CPU_BIG_ENDIAN
+/* Note: pmac normally not DWORD aligned. Most time 2 bytes alignment */
+struct pmac_rx_hdr {
+	/* byte 0 */
+	u8 res1 : 1;
+	u8 ver_done : 1;
+	u8 ip_offset : 6;
+
+	/* byte 1 */
+	u8 tcp_h_offset : 5;
+	u8 tcp_type : 3;
+
+	/* byte 2 */
+	u8 sppid : 4;
+	u8 class : 4;
+
+	/* byte 3 */
+	u8 res2 : 6;
+	u8 pkt_type : 2;
+
+	/* byte 4 */
+	u8 res3 : 1;
+	u8 redirect : 1;
+	u8 res4 : 1;
+	u8 src_sub_inf_id : 5; /* high:mc:1 + vap:4 */
+
+	/* byte 5 */
+	u8 src_sub_inf_id2 : 8; /* low:mc:1 + vap:4 */
+
+	/* byte 6 */
+	u8 port_map : 8; /* high:port map */
+
+	/* byte 7 */
+	u8 port_map2 : 8; /* low:port map */
+} __packed;
+
+struct pmac_tx_hdr {
+	/* byte 0 */
+	u8 tcp_chksum : 1;
+	u8 res1 : 1;
+	u8 ip_offset : 6;
+
+	/* byte 1 */
+	u8 tcp_h_offset : 5;
+	u8 tcp_type : 3;
+
+	/* byte 2 */
+	u8 sppid : 4;
+	u8 res : 4;
+
+	/* byte 3 */
+	u8 port_map_en : 1;
+	u8 res2 : 1;
+	u8 time_dis : 1;
+	u8 class_en : 1;
+	u8 res3 : 2;
+	u8 pkt_type : 2;
+
+	/* byte 4 */
+	u8 fcs_ins_dis : 1;
+	u8 redirect : 1;
+	u8 time_stmp : 1;
+	u8 src_sub_inf_id : 5; /* high:mc:1 + vap:4 */
+
+	/* byte 5 */
+	u8 src_sub_inf_id2 : 8; /* low:mc:1 + vap:4 */
+
+	/* byte 6 */
+	u8 port_map : 8; /* high:port map */
+
+	/* byte 7 */
+	u8 port_map2 : 8; /* low:port map */
+} __packed;
+
+#else
+
+/* Note: pmac normally not DWORD aligned. Most time 2 bytes alignment */
+struct pmac_rx_hdr {
+	/* byte 0 */
+	u8 ip_offset : 6;
+	u8 ver_done : 1;
+	u8 res1 : 1;
+
+	/* byte 1 */
+	u8 tcp_type : 3;
+	u8 tcp_h_offset : 5;
+
+	/* byte 2 */
+	u8 class : 4;
+	u8 sppid : 4;
+
+	/* byte 3 */
+	u8 pkt_type : 2; /* refer to PMAC_TCP_TYPE */
+	u8 res2 : 6;
+
+	/* byte 4 */
+	u8 src_sub_inf_id : 5; /* high:mc:1 + vap:4 */
+	u8 res4 : 1;
+	u8 redirect : 1;
+	u8 res3 : 1;
+
+	/* byte 5 */
+	u8 src_sub_inf_id2 : 8; /* low:mc:1 + vap:4 */
+
+	/* byte 6 */
+	u8 port_map : 8; /* high:port map */
+
+	/* byte 7 */
+	u8 port_map2 : 8; /* low:port map */
+} __packed;
+
+struct pmac_tx_hdr {
+	/* byte 0 */
+	u8 ip_offset : 6;
+	u8 res1 : 1;
+	u8 tcp_chksum : 1;
+
+	/* byte 1 */
+	u8 tcp_type : 3;
+	u8 tcp_h_offset : 5;
+
+	/* byte 2 */
+	u8 res : 4;
+	u8 sppid : 4;
+
+	/* byte 3 */
+	u8 pkt_type : 2; /* refer to PMAC_TCP_TYPE */
+	u8 res3 : 2;
+	u8 class_en : 1;
+	u8 time_dis : 1;
+	u8 res2 : 1;
+	u8 port_map_en : 1;
+
+	/* byte 4 */
+	u8 src_sub_inf_id : 5; /* high:mc:1 + vap:4 */
+	u8 time_stmp : 1;
+	u8 redirect : 1;
+	u8 fcs_ins_dis : 1;
+
+	/* byte 5 */
+	u8 src_sub_inf_id2 : 8; /* low:mc:1 + vap:4 */
+
+	/* byte 6 */
+	u8 port_map : 8; /* high:port map */
+
+	/* byte 7 */
+	u8 port_map2 : 8; /* low:port map */
+} __packed;
+
+#endif
+
+#endif /* DATAPATH_API_GRX500_H */
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_api_qos.h b/drivers/net/ethernet/lantiq/datapath/datapath_api_qos.h
new file mode 100644
index 0000000000000..826532b7b9925
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_api_qos.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * include/net/datapath_api_qos.h:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * Datapath QoS HAL typedefs.
+ *
+ * Sub-3 ST-001 port of AVM 4.9 include/net/datapath_api_qos.h, restricted
+ * per the plan to "only the typedefs needed for dp_pmac_cfg_t and
+ * dp_subif_data". The vast bulk of the QoS API surface (dp_node_link_add,
+ * dp_link_add, dp_shaper_conf_set, the full enum hierarchies for arbi
+ * methods / shaper commands / queue-map modes) is unused in Sub-3 and
+ * will be reintroduced piecewise by Sub-4+ as needed.
+ *
+ * No forbidden conditional-compilation tokens exist in the AVM source,
+ * so AC-001-3's line-excision strip-list is a no-op for this header.
+ */
+
+#ifndef DP_QOS_API_H
+#define DP_QOS_API_H
+
+#include <linux/types.h>
+
+/* @brief enum DP_API_STATUS - shared between the QoS API and the main API */
+enum DP_API_STATUS_QOS {
+	DP_QOS_FAILURE = -1,
+	DP_QOS_SUCCESS = 0,
+};
+
+/* Common QoS-link-node identifier carried through subif registration. */
+enum dp_node_type {
+	DP_NODE_UNKNOWN = 0,
+	DP_NODE_QUEUE,
+	DP_NODE_SCH,
+	DP_NODE_PORT
+};
+
+union dp_node_id {
+	int q_id;
+	int sch_id;
+	int cqm_deq_port;
+};
+
+#endif /* DP_QOS_API_H */
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_api_skb.h b/drivers/net/ethernet/lantiq/datapath/datapath_api_skb.h
new file mode 100644
index 0000000000000..9c961bc84fdb7
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_api_skb.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * include/net/datapath_api_skb.h:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * Datapath skb-attached metadata definitions.
+ *
+ * Sub-3 ST-001 port of AVM 4.9 include/net/datapath_api_skb.h, with the
+ * forbidden conditional-compilation families (the MPE fasthook test
+ * harness in particular) line-excised per AC-001-3. After excision the
+ * ltq_dp_skb wrapper struct collapses to an empty body (all its members
+ * lived behind the stripped guards); kept as a forward-declarable type
+ * so future Sub-4 code can re-introduce members if needed.
+ */
+
+#ifndef DATAPATH_API_SKB_H
+#define DATAPATH_API_SKB_H
+
+#include <linux/types.h>
+#include <linux/skbuff.h>
+
+/*
+ * Wrapper carrying datapath-specific metadata attached to an skb.
+ * After ST-001 strip-list excisions this is an empty struct - the AVM
+ * source put all its members behind the MPE fasthook-test and Eth OAM
+ * compile-time guards. ST-001 leaves the type definition in place as a
+ * no-op struct so Sub-4/Sub-6 can extend it.
+ */
+struct ltq_dp_skb {
+	int _ltq_dp_skb_placeholder; /* avoid empty-struct UB warnings */
+};
+
+static inline void dp_skb_cp(const struct ltq_dp_skb *old,
+			     struct ltq_dp_skb *new)
+{
+	(void)old;
+	(void)new;
+}
+
+static inline void dp_skb_free(struct sk_buff *skb)
+{
+	(void)skb;
+}
+
+#endif /* DATAPATH_API_SKB_H */
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_inst.h b/drivers/net/ethernet/lantiq/datapath/datapath_inst.h
new file mode 100644
index 0000000000000..dcf735e7a67fe
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_inst.h
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * include/net/datapath_inst.h:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * Per-instance datapath HW-cap descriptor and dispatch table.
+ *
+ * Sub-3 ST-001 port of AVM 4.9 include/net/datapath_inst.h. Excisions
+ * applied per AC-001-3 (line-deletion, NOT #if 0 / commented-out):
+ *
+ *   - the switchdev compile-time guarded block inside struct inst_info
+ *     (swdev_flag + the 8 swdev_* / dp_mac_* / dp_cfg_vlan ops) is
+ *     line-excised. The remaining op pointers stay byte-for-byte
+ *     identical to AVM.
+ *
+ * Other deltas vs AVM:
+ *
+ *   - The AVM-side #include directives were `<net/switch_api/...>`. They
+ *     are rewritten to relative form `"../switch-api/..."` per AC-001-7
+ *     so the v6.18 tree's switch-api/ headers (Sub-1 port) resolve.
+ *
+ * AS-009 was wrong about DP_MAX_INST = 2; AVM include/net/datapath_api.h:73
+ * is unambiguously DP_MAX_INST=1. That definition lives in datapath.h
+ * (the local Sub-3 private surface), NOT here, because AVM segregates the
+ * macro into the public datapath_api.h surface (which Sub-3 only forward-
+ * declares). For self-containment of this header (so dp_port_prop[1] in
+ * datapath_api.c can dereference the right type without first including
+ * datapath.h) we replicate the value here unguarded.
+ *
+ * The cap-array reads (ETHSW_CAP_1_PPORTS / ETHSW_CAP_1_VPORTS) which AVM
+ * carries through this header are NOT replicated - Sub-3 keeps the
+ * cap-table-shape declarations only; cap-table population is Sub-4 work.
+ */
+
+#ifndef DATAPATH_INST_H
+#define DATAPATH_INST_H
+
+#include <linux/types.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+
+/*
+ * struct core_ops + struct mac_ops are declared in the Sub-1 ported
+ * switch-api headers (gsw_dev.h includes mac_ops.h, which in turn
+ * relies on ethtool_ts_info from linux/ethtool.h - a header NOT
+ * pre-included in every .c file that pulls in datapath_inst.h).
+ * Sub-3 references both types only by pointer, so forward-declarations
+ * suffice and avoid forcing the ethtool.h prerequisite onto the
+ * datapath compile-shells. Any caller that actually dereferences
+ * struct core_ops fields must include the gsw_dev header itself.
+ */
+struct core_ops;
+struct mac_ops;
+
+#define DP_MAX_GSW_HANDLE 2  /* max GSW instance per SOC */
+#define DP_MAX_MAC_HANDLE 11 /* max MAC instance per SOC */
+
+#ifndef DP_MAX_INST
+#define DP_MAX_INST 1 /* verified against AVM include/net/datapath_api.h:73 */
+#endif
+
+/* Forward decls of types referenced only by pointer below. */
+struct logic_dev;
+struct subif_platform_data;
+struct pmac_port_info;
+struct pmac_port_info2;
+struct gsw_itf;
+struct dp_port_data;
+struct dp_dev_data;
+struct dp_subif_data;
+struct dp_pmapper;
+struct dp_tc_vlan;
+struct dp_tc_vlan_info;
+/* struct dp_cap is fully defined below (Sub-3 ST-002 addition) */
+struct pmac_tx_hdr;
+struct pmac_rx_hdr;
+struct dma_tx_desc_0;
+struct dma_tx_desc_1;
+struct dma_tx_desc_2;
+struct dma_tx_desc_3;
+struct dma_rx_desc_0;
+struct dma_rx_desc_1;
+struct dma_rx_desc_2;
+struct dma_rx_desc_3;
+struct dp_subif;
+typedef struct dp_subif dp_subif_t;
+struct dp_pmac_cfg;
+typedef struct dp_pmac_cfg dp_pmac_cfg_t;
+
+/* enum for DP HW capability type */
+enum DP_HW_CAP_TYPE {
+	GSWIP30_TYPE = 0,
+	GSWIP31_TYPE
+};
+
+/* enum for DP HW version */
+enum DP_HW_CAP_VER {
+	GSWIP30_VER = 0,
+	GSWIP31_VER
+};
+
+/*
+ * Sub-3 ST-002 addition (scope_deviation vs ST-001's placeholder):
+ *
+ * AVM 4.9's struct inst_info has `struct dp_cap cap;` as a value member
+ * (drivers/net/ethernet/lantiq/datapath/datapath_inst.h:58 in AVM). ST-001
+ * left a placeholder `int cap;` field with a forward declaration of
+ * struct dp_cap, anticipating the full struct port would land in ST-002.
+ * Without the full struct, AC-002-6 / AC-002-7's required writes of
+ * `cap.info.cap.tx_hw_chksum = 1;` etc. inside register_dp_cap_gswip30
+ * cannot compile.
+ *
+ * DP_MAX_NAME, struct dp_umt_cap_mode, struct dp_umt_cap, and struct dp_cap
+ * are ported verbatim from AVM include/net/datapath_api.h:1131-1178. They
+ * live here (rather than in the to-be-created datapath_api.h) because
+ * struct inst_info embeds dp_cap by value and inst_info itself is in this
+ * header; placing dp_cap anywhere else would force a circular include.
+ */
+#ifndef DP_MAX_NAME
+#define DP_MAX_NAME 20
+#endif
+
+struct dp_umt_cap_mode {
+	u32 enable : 1;
+	u32 rx_accumulate : 1;
+	u32 rx_incremental : 1;
+	u32 tx_accumulate : 1;
+	u32 tx_incremental : 1;
+};
+
+struct dp_umt_cap {
+	struct dp_umt_cap_mode umt_hw_auto;
+	struct dp_umt_cap_mode umt_hw_user;
+	struct dp_umt_cap_mode umt_sw;
+};
+
+/* struct dp_cap: dp capability per instance (AVM datapath_api.h:1149-1178). */
+struct dp_cap {
+	int inst;
+	u32 tx_hw_chksum : 1;
+	u32 rx_hw_chksum : 1;
+	u32 hw_tso : 1;
+	u32 hw_gso : 1;
+	u32 hw_ptp : 1;
+	char qos_eng_name[DP_MAX_NAME];
+	char pkt_eng_name[DP_MAX_NAME];
+	int max_num_queues;
+	int max_num_scheds;
+	int max_num_deq_ports;
+	int max_num_qos_ports;
+	int max_num_dp_ports;
+	int max_num_subif_per_port;
+	int max_num_subif;
+	int max_num_bridge_port;
+	struct dp_umt_cap umt;
+};
+
+struct dp_inst_info {
+	int inst;
+	enum DP_HW_CAP_TYPE type;
+	enum DP_HW_CAP_VER ver;
+	struct core_ops *ops[DP_MAX_GSW_HANDLE];
+	struct mac_ops *mac_ops[DP_MAX_MAC_HANDLE];
+	int cbm_inst;
+	int qos_inst;
+};
+
+/*
+ * Per-HW-capability dispatch table. Sub-3 keeps the layout byte-for-byte
+ * faithful to AVM with the exception of the switchdev compile-time
+ * guarded block which is line-excised per AC-001-3.
+ */
+struct inst_info {
+	enum DP_HW_CAP_TYPE type;
+	enum DP_HW_CAP_VER ver;
+	int max_ports;
+	int max_port_subifs;
+	struct dp_cap cap; /* AVM datapath_inst.h:58 - value-embedded */
+	int (*dp_platform_set)(int inst, u32 flag);
+	int (*port_platform_set)(int inst, u8 ep, struct dp_port_data *data,
+				 uint32_t flags);
+	int (*dev_platform_set)(int inst, u8 ep, struct dp_dev_data *data,
+				uint32_t flags);
+	int (*subif_platform_set_unexplicit)(int inst, int port_id,
+					     struct logic_dev *dev,
+					     u32 flag);
+	int (*port_platform_set_unexplicit)(int inst, int port_id,
+					    struct logic_dev *dev,
+					    u32 flag);
+	int (*subif_platform_set)(int inst, int portid, int subif_ix,
+				  struct subif_platform_data *data,
+				  u32 flags);
+	int (*proc_print_ctp_bp_info)(struct seq_file *s, int inst,
+				      struct pmac_port_info *port,
+				      int subif_index, u32 flag);
+	void (*init_dma_pmac_template)(int portid, uint32_t flags);
+	int (*not_valid_rx_ep)(int ep);
+	void (*set_pmac_subif)(struct pmac_tx_hdr *pmac, int32_t subif);
+	void (*update_port_vap)(int inst, u32 *ep, int *vap,
+				struct sk_buff *skb,
+				struct pmac_rx_hdr *pmac, char *decryp);
+	int (*check_csum_cap)(void);
+	void (*get_dma_pmac_templ)(int index, struct pmac_tx_hdr *pmac,
+				   struct dma_tx_desc_0 *desc_0,
+				   struct dma_tx_desc_1 *desc_1,
+				   struct pmac_port_info2 *dp_info);
+	int (*get_itf_start_end)(struct gsw_itf *itf_info, u16 *start,
+				 u16 *end);
+	void (*dump_rx_dma_desc)(struct dma_rx_desc_0 *desc_0,
+				 struct dma_rx_desc_1 *desc_1,
+				 struct dma_rx_desc_2 *desc_2,
+				 struct dma_rx_desc_3 *desc_3);
+	void (*dump_tx_dma_desc)(struct dma_tx_desc_0 *desc_0,
+				 struct dma_tx_desc_1 *desc_1,
+				 struct dma_tx_desc_2 *desc_2,
+				 struct dma_tx_desc_3 *desc_3);
+	void (*dump_rx_pmac)(struct pmac_rx_hdr *pmac);
+	void (*dump_tx_pmac)(struct pmac_tx_hdr *pmac);
+	int (*supported_logic_dev)(int inst, struct net_device *dev,
+				   char *subif_name);
+	int (*dp_pmac_set)(int inst, u32 port, dp_pmac_cfg_t *pmac_cfg);
+	int (*dp_set_gsw_parser)(u8 flag, u8 cpu, u8 mpe1, u8 mpe2, u8 mpe3);
+	int (*dp_get_gsw_parser)(u8 *cpu, u8 *mpe1, u8 *mpe2, u8 *mpe3);
+	int (*dp_qos_platform_set)(int cmd_id, void *cfg, int flag);
+	int (*dp_get_port_vap_mib)(dp_subif_t *subif_id, void *priv,
+				   void *stats,
+				   u32 flags);
+	int (*dp_clear_netif_mib)(dp_subif_t *subif, void *priv, u32 flag);
+	int (*dp_set_gsw_pmapper)(int inst, int bport, int lport,
+				  struct dp_pmapper *mapper, u32 flag);
+	int (*dp_get_gsw_pmapper)(int inst, int bport, int lport,
+				  struct dp_pmapper *mapper, u32 flag);
+	int (*dp_tc_vlan_set)(struct core_ops *ops, struct dp_tc_vlan *vlan,
+			      struct dp_tc_vlan_info *info,
+			      int flag);
+};
+
+struct dp_inst {
+	enum DP_HW_CAP_TYPE type;
+	enum DP_HW_CAP_VER ver;
+	struct inst_info info;
+};
+
+struct dp_hw_cap {
+	u8 valid;
+	struct inst_info info;
+};
+
+struct inst_property {
+	u8 valid;
+	struct inst_info info;
+	/* driver should know which HW to configure, esp for PCIe case */
+	struct core_ops *ops[DP_MAX_GSW_HANDLE];
+	struct mac_ops *mac_ops[DP_MAX_MAC_HANDLE];
+	int cbm_inst;
+	int qos_inst;
+	void *priv_hal; /* private data per HAL */
+};
+
+int register_dp_cap_gswip30(int flag);
+int register_dp_hw_cap(struct dp_hw_cap *info, u32 flag);
+
+/* request a new DP instance based on its HW type/version */
+int dp_request_inst(struct dp_inst_info *info, u32 flag);
+
+#endif /* DATAPATH_INST_H */
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_instance.c b/drivers/net/ethernet/lantiq/datapath/datapath_instance.c
new file mode 100644
index 0000000000000..441a660e227ab
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_instance.c
@@ -0,0 +1,268 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * datapath/datapath_instance.c:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * Per-instance bookkeeping helpers for the GSWIP-3.0 datapath HAL.
+ *
+ * Sub-3 ST-003 replaces ST-001's empty stubs with the minimal seven-stub
+ * set per AS-017 + the Plan-Reviewer storage-spec fix.
+ *
+ * Function order (AC-003-6, by source grep):
+ *   register_dp_hw_cap, dp_request_inst, dp_inst_init, dp_inst_add_dev,
+ *   dp_inst_del_dev, dp_get_inst_via_module, dp_inst_insert_mod.
+ *   Total 7 functions.
+ *
+ * Storage spec (AC-003-7): dp_inst_storage[DP_MAX_INST][16][16] sized to
+ * [1][16][16] - bounds match AVM's per-instance (port x ctp) layout. Each
+ * slot carries {dev, subif_name, inst, ep, bp, ctp, flag, valid}.
+ *
+ * AC-003-7 deviation note on locking:
+ *
+ *   AC-003-7 literally reads "All seven function bodies access this array
+ *   under mutex_lock(&dp_lock) ... and release under mutex_unlock". A strict
+ *   per-helper acquisition would deadlock at runtime because
+ *   dp_register_subif_ext (datapath_api.c) acquires dp_lock and then calls
+ *   dp_register_subif_private which calls dp_inst_add_dev. Linux struct
+ *   mutex is non-recursive (cf. Documentation/locking/mutex-design.rst).
+ *
+ *   The interpretation applied here: helpers MUST be invoked with dp_lock
+ *   already held by the caller. Those that have callers which do not hold
+ *   dp_lock (dp_inst_init, register_dp_hw_cap, dp_request_inst,
+ *   dp_get_inst_via_module) acquire dp_lock themselves; helpers called
+ *   from already-locked contexts (dp_inst_add_dev, dp_inst_del_dev,
+ *   dp_inst_insert_mod) only assert lockdep_assert_held. This matches the
+ *   AVM 4.9 reference pattern (datapath_instance.c never re-locks
+ *   internally - the dp_register_subif/_ext caller chain holds the mutex
+ *   throughout). Documented as a scope_deviation in the Sub-3 build
+ *   manifest.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/if.h>
+
+#include "datapath.h"
+#include "datapath_api.h"
+
+/*
+ * dp_inst_storage_entry: bookkeeping slot per AS-017 + Plan-Reviewer
+ * storage-spec fix. Field layout matches the plan's enumerated set
+ * verbatim.
+ */
+struct dp_inst_storage_entry {
+	struct net_device *dev;
+	char subif_name[IFNAMSIZ];
+	int inst;
+	int ep;
+	int bp;
+	int ctp;
+	u32 flag;
+	bool valid;
+};
+
+/*
+ * dp_inst_storage[DP_MAX_INST][16][16]: file-scope static bookkeeping
+ * mesh. The [DP_MAX_INST=1][16=MAX_DP_PORTS][16=ctp_max] dimensions give
+ * ~1 KiB total at runtime per AS-017's prior text.
+ */
+static struct dp_inst_storage_entry
+	dp_inst_storage[DP_MAX_INST][MAX_DP_PORTS][MAX_DP_PORTS];
+
+int register_dp_hw_cap(struct dp_hw_cap *info, u32 flag)
+{
+	(void)flag;
+	if (!info)
+		return -1;
+	mutex_lock(&dp_lock);
+	/*
+	 * Single-instance case: copy cap info into dp_port_prop[0]. AVM
+	 * datapath_instance.c register_dp_hw_cap maintains a hw_cap_list
+	 * and matches by type/ver; Sub-3 simplifies because there is only
+	 * one HAL (GSWIP-3.0) per AS-018.
+	 */
+	dp_port_prop[0].info = info->info;
+	mutex_unlock(&dp_lock);
+	return 0;
+}
+
+int dp_request_inst(struct dp_inst_info *info, u32 flag)
+{
+	(void)info;
+	(void)flag;
+	/*
+	 * Minimal stub per AS-017: bump dp_inst_num to 1 the first time we
+	 * are called, then no-op. Real per-instance state is set up by
+	 * request_dp() in datapath_api.c (ops[0]/ops[1] population +
+	 * dp_platform_set call).
+	 */
+	mutex_lock(&dp_lock);
+	if (dp_inst_num == 0)
+		dp_inst_num = 1;
+	mutex_unlock(&dp_lock);
+	return 0;
+}
+
+int dp_inst_init(void)
+{
+	/*
+	 * AVM datapath_instance.c dp_inst_init walks the dp_dev_list /
+	 * dp_dev_list_free hash heads. Sub-3 has no hash-list surface (it
+	 * lives in the future Sub-4/Sub-6 work). The minimal stub clears
+	 * the single dp_port_prop[0] slot - the corresponding zero of
+	 * dp_port_info / dp_port_info2 is implicit because they are
+	 * file-scope BSS allocations.
+	 */
+	mutex_lock(&dp_lock);
+	memset(&dp_port_prop[0], 0, sizeof(dp_port_prop[0]));
+	memset(dp_inst_storage, 0, sizeof(dp_inst_storage));
+	mutex_unlock(&dp_lock);
+	return 0;
+}
+
+int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
+		    int port_id, int bp, int subif, u32 flag)
+{
+	int i;
+
+	/*
+	 * Caller (dp_register_subif_private via dp_register_subif_ext) holds
+	 * dp_lock - see file-header AC-003-7 deviation note. No additional
+	 * locking here; lockdep_assert_held documents the requirement.
+	 */
+	lockdep_assert_held(&dp_lock);
+
+	if (inst < 0 || inst >= DP_MAX_INST)
+		return -1;
+	if (port_id < 0 || port_id >= MAX_DP_PORTS)
+		return -1;
+	if (subif < 0 || subif >= MAX_DP_PORTS)
+		return -1;
+
+	for (i = 0; i < MAX_DP_PORTS; i++) {
+		struct dp_inst_storage_entry *e =
+			&dp_inst_storage[inst][port_id][i];
+
+		if (e->valid)
+			continue;
+
+		e->dev = dev;
+		if (subif_name) {
+			strncpy(e->subif_name, subif_name, IFNAMSIZ - 1);
+			e->subif_name[IFNAMSIZ - 1] = '\0';
+		} else {
+			e->subif_name[0] = '\0';
+		}
+		e->inst = inst;
+		e->ep = port_id;
+		e->bp = bp;
+		e->ctp = subif;
+		e->flag = flag;
+		e->valid = true;
+		return 0;
+	}
+	return -1;
+}
+
+int dp_inst_del_dev(struct net_device *dev, char *subif_name, int inst,
+		    int port_id, int bp, int subif)
+{
+	int i;
+
+	(void)bp;
+	(void)subif;
+
+	/* Caller-held dp_lock - see file-header AC-003-7 deviation note. */
+	lockdep_assert_held(&dp_lock);
+
+	if (inst < 0 || inst >= DP_MAX_INST)
+		return -1;
+	if (port_id < 0 || port_id >= MAX_DP_PORTS)
+		return -1;
+
+	for (i = 0; i < MAX_DP_PORTS; i++) {
+		struct dp_inst_storage_entry *e =
+			&dp_inst_storage[inst][port_id][i];
+
+		if (!e->valid)
+			continue;
+		if (e->dev != dev)
+			continue;
+		if (subif_name &&
+		    strncmp(e->subif_name, subif_name, IFNAMSIZ) != 0)
+			continue;
+		e->valid = false;
+		return 0;
+	}
+	return -1;
+}
+
+int dp_get_inst_via_module(struct module *owner, u32 port_id, u32 dev_port)
+{
+	int ret;
+
+	(void)dev_port;
+
+	if (port_id >= MAX_DP_PORTS)
+		return -1;
+
+	/*
+	 * SUB-7 fix (IG-022 closeout, 2026-05-29): the original SUB-3 stub
+	 * walked `dp_inst_storage[0][port_id][*].valid`, but that array is
+	 * only populated by dp_inst_add_dev which runs INSIDE
+	 * dp_register_subif_private — i.e. AFTER this lookup. Chicken-and-
+	 * egg: first dp_register_subif call always returned -1, producing
+	 * the "wrong inst for owner=... ep=N" error and blocking M3 ping.
+	 *
+	 * The right matching for "is this (owner, port_id) currently
+	 * allocated?" is dp_port_info[inst][port_id].status==PORT_ALLOCATED
+	 * AND .owner==owner. dp_alloc_port_private populates those fields
+	 * synchronously before returning, so dp_register_subif sees the
+	 * mapping immediately.
+	 *
+	 * Top-level caller path: dp_register_subif (no caller-held dp_lock).
+	 * Acquire dp_lock here.
+	 */
+	mutex_lock(&dp_lock);
+	/*
+	 * Accept both PORT_ALLOCATED (dp_alloc_port done, subif not yet
+	 * registered) AND PORT_SUBIF_REGISTERED (dp_register_subif done) —
+	 * line 800 of datapath_api.c advances status to PORT_SUBIF_REGISTERED
+	 * after dp_register_subif_private completes, and we still want
+	 * dp_get_inst_via_module to find the port during the matching
+	 * deregister/dealloc tear-down sequence.
+	 */
+	if (dp_port_info[0][port_id].status >= PORT_ALLOCATED &&
+	    dp_port_info[0][port_id].owner == owner)
+		ret = 0;
+	else
+		ret = -1;
+	mutex_unlock(&dp_lock);
+	return ret;
+}
+
+int dp_inst_insert_mod(struct module *owner, u16 ep, u32 inst, u32 flag)
+{
+	(void)owner;
+	(void)ep;
+	(void)inst;
+	(void)flag;
+	/*
+	 * True no-op per AS-017. AVM datapath_instance.c carries a
+	 * dp_mod_hash linked-list of (owner, ep, inst) tuples used by
+	 * dp_get_inst_via_module; Sub-3 substitutes the simpler
+	 * dp_inst_storage walk and so does not need module-hash tracking
+	 * at this layer.
+	 *
+	 * Caller (dp_alloc_port_private via dp_alloc_port_ext) holds
+	 * dp_lock - see file-header AC-003-7 deviation note. No locking
+	 * here.
+	 */
+	return 0;
+}
diff --git a/drivers/net/ethernet/lantiq/datapath/datapath_misc.c b/drivers/net/ethernet/lantiq/datapath/datapath_misc.c
new file mode 100644
index 0000000000000..98ee3e75e76a0
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/datapath_misc.c
@@ -0,0 +1,923 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * datapath/gswip30/datapath_misc.c:
+ * Copyright (C) Intel Corporation
+ * Author: Shao Guohua <guohua.shao@intel.com>
+ */
+/*
+ * GSWIP-3.0 datapath HAL — Sub-3 ST-002 port of AVM 4.9
+ * drivers/net/ethernet/lantiq/datapath/gswip30/datapath_misc.c (732 LoC
+ * original; this port lands ~520 LoC after the documented surgery).
+ *
+ * AC-002 surgical excisions applied to the AVM source (all line-deletion,
+ * NOT `#if 0` / NOT commented-out blocks):
+ *
+ *   - init_dma_pmac_template (AVM:60-223): KEEP only the
+ *     `if (flags & DP_F_FAST_ETH_LAN)` branch (AVM:79-90) and the final
+ *     'else DP_F_DIRECT' branch (AVM:197-222). DROP the four other
+ *     flag branches verbatim (DP_F_FAST_ETH_WAN AVM:91-101,
+ *     DP_F_DIRECTLINK AVM:102-141, DP_F_FAST_DSL AVM:142-176,
+ *     DP_F_FAST_WLAN AVM:177-196). Per AC-002-3.
+ *
+ *   - register_dp_cap_gswip30 (AVM:618-732): DROP the strip-list
+ *     assignments (dp_pmac_set, dp_set_gsw_parser, dp_get_gsw_parser,
+ *     dp_get_port_vap_mib, dp_clear_netif_mib, proc_print_ctp_bp_info).
+ *     The cap struct is zero-initialised by memset at function entry so
+ *     unassigned fields default to NULL. Per AC-002-6.
+ *
+ *   - mib_init (AVM:361-371) becomes a no-op shell: the
+ *     CONFIG_LTQ_DATAPATH_MIB block is excised; gsw_mib_reset_30 stubs
+ *     are replaced with a dev_dbg trace because Sub-1/Sub-2 own MIB and
+ *     task constraint #6 drops MIB in Phase 3.
+ *
+ *   - dp_platform_set (AVM:386-405): dp_sub_proc_install_30 (no proc
+ *     surface in Phase 3 per AS-001), dp_get_gsw_parser_30 (task
+ *     constraint #5), and dp_coc_cpufreq_init calls are excised.
+ *
+ *   - port_platform_set (AVM:413-444): CONFIG_LTQ_DATAPATH_MIB block
+ *     (AVM:434-440) is excised; unconditional `return 0` is preserved.
+ *     gswip30_program_queue_map(inst, ep) is invoked just before the
+ *     return (Sub-3 invention per CQ-002 D, once-per-port placement).
+ *
+ *   - PR_INFO/PR_ERR/DP_DEBUG calls in the ported functions are
+ *     rewritten to dev_info(dp_dev, ...) / dev_err(dp_dev, ...) /
+ *     dev_dbg(dp_dev, ...) (AC-002-9). DP_DEBUG macros in datapath.h
+ *     are redefined to dev_dbg thunks per AS-011.
+ *
+ * NEW helper:
+ *   - gswip30_program_queue_map(inst, portid): Sub-3 invention per
+ *     CQ-002 D answer. Iterates 16 traffic classes and programs
+ *     PCE_QUEUE_MAP_INDEX via Sub-2's gsw_pce_table_write. cdev is
+ *     acquired via container_of(dp_port_prop[inst].ops[0],
+ *     ethsw_api_dev_t, ops) (canonical mechanism per Plan-Reviewer fix,
+ *     verified via Sub-1 AS-014's value-embedding of struct core_ops as
+ *     a value member of ethsw_api_dev_t at gsw_flow_core.h:984).
+ */
+
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/bug.h>
+#include <linux/build_bug.h>
+#include <linux/atomic.h>
+#include <linux/skbuff.h>
+#include <linux/netdevice.h>
+#include <linux/if_vlan.h>
+#include <linux/device.h>
+#include <linux/printk.h>
+
+/*
+ * Sub-4 ST-001 swap: datapath_cbm_stubs.h was deleted (`git rm`) per
+ * AS-003. The CBM symbol surface (cbm_dp_enable / cbm_counter_mode_set /
+ * get_lookup_qid_via_index) now lives at <net/cqm_cbm_api.h> as bare
+ * extern declarations resolved inside the same intel-xrx500-gswip.ko
+ * composite per CQ-001 A. The static-inline-then-extern C11 §6.2.2
+ * linkage conflict that the old include order documented is gone now
+ * that the static-inline stub bodies no longer exist.
+ */
+#include <net/cqm_cbm_api.h>
+#include "datapath.h"
+#include "datapath_misc.h"
+#include "../switch-api/gsw_flow_core.h"
+#include "../switch-api/gsw_tbl_rw.h"
+
+/*
+ * Minimal local types and macros not available in datapath.h.
+ *
+ * (1) struct dp_subif_data: AVM's full struct lives in
+ *     include/net/datapath_api.h (not recreated in Sub-3 ST-001). Only
+ *     `deq_port_idx` is dereferenced from datapath_misc.c (subif_hw_set,
+ *     subif_hw_reset). ST-003's dp_register_subif_ext port will lift this
+ *     into a shared header once more fields are needed.
+ *
+ * (2) _DMA_CONTROLLER / _DMA_PORT / _DMA_CHANNEL: AVM places these in
+ *     linux/dma/lantiq_dmax.h which is dropped from datapath.h per the
+ *     ST-001 strip list. Define them locally with the same bit layout as
+ *     AVM (controller<<24 | port<<16 | channel) so subif_hw_set's
+ *     dma_chan decoding matches AVM byte-for-byte.
+ *
+ * (3) DP_FAILURE: AVM macro returning -1 on subif_hw_set / subif_hw_reset
+ *     failure paths. Local define keeps the AVM source readable.
+ */
+struct dp_subif_data {
+	s8 deq_port_idx;
+};
+
+#define _DMA_CONTROLLER(nr) (((nr) >> 24) & 0xFF)
+#define _DMA_PORT(nr)       (((nr) >> 16) & 0xFF)
+#define _DMA_CHANNEL(nr)    ((nr) & 0xFFFF)
+
+#ifndef DP_FAILURE
+#define DP_FAILURE (-1)
+#endif
+
+/*
+ * Local fallbacks for the DP_F_* flag bits the AVM source-of-truth defines
+ * in include/net/datapath_api.h:120-130 as `enum { DP_F_DEREGISTER = BIT(0),
+ * DP_F_FAST_ETH_LAN = BIT(1), ... DP_F_LOOPBACK = BIT(6), DP_F_DIRECTLINK =
+ * BIT(7) }`. ST-002 doesn't pull the AVM enum into Sub-3's datapath.h (the
+ * enum will land in Sub-6 alongside the AVM dp_alloc_port_data surface), so
+ * the local defines must match the AVM byte values exactly to keep the
+ * compiled .o ABI-compatible with future cross-TU callers.
+ *
+ *   DP_F_DEREGISTER   = BIT(0) = 0x01 — subif_platform_set dispatch flag.
+ *   DP_F_FAST_ETH_LAN = BIT(1) = 0x02 — init_dma_pmac_template LAN branch.
+ *   DP_F_LOOPBACK     = BIT(6) = 0x40 — update_port_vap tunnel-loop branch.
+ *
+ * #ifndef guards let any later subtask import the AVM enum first and have
+ * the local defines compile out cleanly per C11 6.10.1 / 6.10.3 semantics.
+ */
+#ifndef DP_F_DEREGISTER
+#define DP_F_DEREGISTER 0x00000001
+#endif
+#ifndef DP_F_FAST_ETH_LAN
+#define DP_F_FAST_ETH_LAN 0x00000002
+#endif
+#ifndef DP_F_LOOPBACK
+#define DP_F_LOOPBACK 0x00000040
