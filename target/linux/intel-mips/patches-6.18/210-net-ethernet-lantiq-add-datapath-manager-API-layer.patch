+ * and resolve to a stub-less unresolved external — Sub-3 has no such
+ * caller, and any future caller MUST pull in datapath_cbm_stubs.h or
+ * provide its own definition.
+ */
+extern uint8_t get_lookup_qid_via_index(uint32_t index);
