+	u8 res1 : 1;
+	u8 tcp_chksum : 1;
+
+	/* byte 1 */
+	u8 tcp_type : 3;
+	u8 tcp_h_offset : 5;
+
+	/* byte 2 */
+	u8 res : 4;
+	u8 sppid : 4;
+
+	/* byte 3 */
+	u8 pkt_type : 2; /* refer to PMAC_TCP_TYPE */
+	u8 res3 : 2;
+	u8 class_en : 1;
+	u8 time_dis : 1;
+	u8 res2 : 1;
+	u8 port_map_en : 1;
+
+	/* byte 4 */
+	u8 src_sub_inf_id : 5; /* high:mc:1 + vap:4 */
+	u8 time_stmp : 1;
+	u8 redirect : 1;
+	u8 fcs_ins_dis : 1;
+
+	/* byte 5 */
+	u8 src_sub_inf_id2 : 8; /* low:mc:1 + vap:4 */
+
+	/* byte 6 */
+	u8 port_map : 8; /* high:port map */
+
+	/* byte 7 */
+	u8 port_map2 : 8; /* low:port map */
+} __packed;
+
+#endif
