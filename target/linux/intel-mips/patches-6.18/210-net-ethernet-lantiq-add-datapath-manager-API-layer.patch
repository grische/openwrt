+/*
+ * Sub-3 ST-002 (AC-002-13): forward declaration of the lookup-qid helper.
+ * Provider is the static-inline stub in datapath_cbm_stubs.h matching
+ * AVM include/net/lantiq_cbm_api.h:1501; consumer is dump_tx_dma_desc in
