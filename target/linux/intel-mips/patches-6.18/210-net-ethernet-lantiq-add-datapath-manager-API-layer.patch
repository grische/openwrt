+			u32 own : 1;
+			u32 c : 1;
+			u32 sop : 1;
+			u32 eop : 1;
+			u32 dic : 1;
+			u32 pdu_type : 1;
+			u32 byte_offset : 3;
+			u32 qid : 4;
+			u32 mpoa_pt : 1;
+			u32 mpoa_mode : 2;
+			u32 data_len : 16;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_0 {
