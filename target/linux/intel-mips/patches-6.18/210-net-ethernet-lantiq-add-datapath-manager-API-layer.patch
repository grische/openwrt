+	dev_info(dp_dev,
+		 "  color=%02d ep=%02d resv1=%d classid=%02d\n",
+		 desc_1->field.color, desc_1->field.ep, desc_1->field.resv1,
+		 desc_1->field.classid);
+	dev_info(dp_dev, "  DW2:data_ptr=0x%08x\n", desc_2->field.data_ptr);
