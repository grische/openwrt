+		struct {
+			u32 data_ptr;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+struct dma_tx_desc_3 {
+	/* DWORD 3 */
+	union {
+		struct {
+			u32 data_len : 16;
+			u32 mpoa_mode : 2;
+			u32 mpoa_pt : 1;
+			u32 qid : 4;
+			u32 byte_offset : 3;
+			u32 pdu_type : 1;
+			u32 dic : 1;
+			u32 eop : 1;
+			u32 sop : 1;
+			u32 c : 1;
+			u32 own : 1;
+		} __packed field;
+		u32 all;
+	};
+} __packed;
+
+#else /* big endian */
+
+struct dma_rx_desc_0 {
+	/* DWORD 0 */
+	union {
+		struct {
+			u32 resv0 : 3;
+			u32 tunnel_id : 4;
