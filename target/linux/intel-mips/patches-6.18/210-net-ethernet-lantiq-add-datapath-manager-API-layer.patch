+/*
+ * Datapath manager private header (port of AVM 4.9
+ * drivers/net/ethernet/lantiq/datapath/datapath.h, 783 LoC original).
+ *
+ * Sub-3 ST-001 strip-list excisions per AC-001-3 (line-deletion only,
+ * NOT `if 0` / NOT commented-out blocks): the twenty forbidden
+ * compile-time guard families listed in the plan are removed verbatim.
+ * See /workflows/FB7560-6.18-PHASE-3-SUB-3/plan.json AC-001-3 for the
+ * full list of stripped guard tokens; this header repeats none of them.
+ *
+ * Macros DP_MAX_INST, MAX_DP_PORTS, MAX_SUBIFS, PMAC_CPU_ID match AVM
+ * verbatim (AVM include/net/datapath_api.h:73, datapath.h:42, :41, :44
+ * respectively). The DP_MAX_INST=1 value is the architectural constant
+ * (NOT the AS-009 misread of 2).
+ *
+ * The DP_LIB_LOCK / DP_LIB_UNLOCK macros (originally selected via the
+ * SoC-family compile-time guard) are pinned to the mutex form because
+ * that guard family is in the strip list. v6.18 uses struct mutex
+ * everywhere for these locks.
+ *
+ * #include rewrites per AC-001-7:
+ *   <net/lantiq_cbm_api.h>          ->  "lantiq_cbm_api.h"
+ *   <net/datapath_api_qos.h>        ->  "datapath_api_qos.h"
+ *   <net/datapath_inst.h>           ->  "datapath_inst.h"
+ *   <linux/dma/lantiq_dmax.h>       ->  dropped (Sub-3 doesn't reference
+ *                                        any lantiq_dmax type)
+ *   <linux/klogging.h>              ->  dropped (LOGF_* macros covered by
+ *                                        the printk fallback below)
+ *   <net/pp_qos_drv.h> + slim       ->  dropped (PPv4 family stripped)
+ *   <net/switchdev.h>               ->  dropped (switchdev family stripped)
+ *   "datapath_swdev.h"              ->  dropped (datapath-switchdev family
+ *                                        stripped)
+ */
