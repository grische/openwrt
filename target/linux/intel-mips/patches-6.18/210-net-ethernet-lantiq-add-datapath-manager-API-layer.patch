+/*
+ * get_itf_start_end — AVM:608-616 verbatim. Optional out-pointer fill of
+ * the CTP-interface start/end range.
+ */
+static int get_itf_start_end(struct gsw_itf *itf_info, u16 *start, u16 *end)
+{
+	if (!itf_info)
+		return -1;
+	if (start)
+		*start = itf_info->start;
+	if (end)
+		*end = itf_info->end;
+
+	return 0;
+}
