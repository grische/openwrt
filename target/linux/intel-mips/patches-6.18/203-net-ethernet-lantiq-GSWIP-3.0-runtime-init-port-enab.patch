From cc4113227e2a1a3037d3503faa25fc2c3b7fe276 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Mon, 10 Aug 2026 09:17:43 +0000
Subject: net: ethernet: lantiq: GSWIP-3.0 runtime init - port enables, PMAC,
 special tag

Complete the switch-core initialization that runs after the parser
microcode is valid. This is the half of gsw_pmicro_code_init() that
turns the statically-configured switch into a forwarding one, ported
from the vendor switch_core_init enable tail and the vendor ethernet
driver's PMAC setup, matching the register state of a working stock
device:

 - Re-enable per-port FDMA/SDMA: the microcode-load sequence
   disables every port's FDMA/SDMA engines; without the enable tail
   the SDMA egress scheduler stays off and frames count as
   transmitted but never reach the wire. The full three-bit
   port-enable sweep (FDMA_PCTRL.EN, SDMA_PCTRL.PEN, and the
   PCE port state) is applied to all ports of both switch
   instances, with the GSW-R port-hole skip (ports 2..14 are
   unpopulated on GSW-R except the trunk).

 - Link-robustness parity writes: ANEG_EEE clock-stop, the MAC
   pause-frame source address registers, and the GSW-L maximum
   frame length (1518).

 - PMAC configuration for both switch instances: the global config
   plus the ingress table (per-DMA-channel default PMAC header and
   channel-to-port routing) and the egress table (traffic-class
   addressed, FCS/L2-header handling). Without these tables the
   PMAC discards DMA-delivered frames instead of forwarding them
   to the PHYs.

 - Special-tag ingress on the CPU/PMAC ports plus per-port PCE
   forwarding state, and flood maps restricted to the CPU port
   (monitor/unknown-unicast/multicast maps = 0x1) so flooded
   traffic goes to the host instead of being mirrored across LAN
   ports.

 - gsw_hw_reinit()/gsw_hw_reinit_gswl(): pulse the whole-core
   switch reset (ETHSW_SWRES.R0) and re-run the full init sequence.
   The MDIO driver uses this once at bring-up to re-initialize the
   switch under a live PHY link, reproducing the vendor driver's
   GSW_HW_Init behavior; the TOP-block MDIO master must be re-armed
   by the caller afterwards.

Register sequences derived from the AVM FRITZ!Box 7560 GPL release
(Linux 4.9.198): switch-api gsw_flow_core.c and the vendor ethernet
driver's PMAC/special-tag setup (ltq_eth_drv_xrx500.c, gsw_defconf.c).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../ethernet/lantiq/switch-api/gsw_flow_pce.c | 656 ++++++++++++++++++
 1 file changed, 656 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
index 7576df83e2b40..e629e8867411d 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
@@ -568,6 +568,459 @@ int gsw_pce_table_key_write(void *cdev, pctbl_prog_t *ptdata)
  * pethdev->lock_pce is NOT taken: probe context is implicitly single-threaded
  * per devid (per AS-015).
  */
+/*
+ * IG-044: PMAC configuration (GSWIP-3.0, PMAC0) — direct register port of
+ * AVM's gsw_defconf.c pmac_glbl_cfg / pmac_ig_cfg / pmac_eg_cfg through
+ * GSW_PMAC_{GLBL,IG,EG}_CfgSet (gsw_flow_core.c) + xwayflow_pmac_table_write
+ * (gsw_tbl_rw.c). The PMAC config subsystem was entirely unported; without it
+ * the PMAC drops the DMA2TX-delivered frame instead of forwarding it to GPHY5
+ * (iteration-8 finding: the CBM path delivers the frame to DMA2TX ch5, but it
+ * never egresses). 3.0-only (no Freeze, no 3.1 branches), PMAC0 only
+ * (pmac_addr_off is identity for pmacId=0). Register word-offsets/shifts are
+ * verbatim from gsw_reg.h.
+ */
+#define PMAC_REG_CTRL_0   0xD03
+#define PMAC_REG_CTRL_2   0xD05
+#define PMAC_REG_CTRL_3   0xD06
+#define PMAC_REG_CTRL_4   0xD07
+#define PMAC_REG_TBL_VAL4 0xD40
+#define PMAC_REG_TBL_VAL3 0xD41
+#define PMAC_REG_TBL_VAL2 0xD42
+#define PMAC_REG_TBL_VAL1 0xD43
+#define PMAC_REG_TBL_VAL0 0xD44
+#define PMAC_REG_TBL_ADDR 0xD45
+#define PMAC_REG_TBL_CTRL 0xD46  /* [2:0]=ptcaddr [5]=opmod [15]=BAS */
+#define PMAC_TBL_IGCFG_IDX 1
+#define PMAC_TBL_EGCFG_IDX 2
+
+/* xwayflow_pmac_table_write (3.0): poll BAS, write ADDR/CTRL/OPMOD/VAL4..0,
+ * set BAS, poll BAS clear. */
+static void gsw_pmac_tbl_write(void *cdev, u16 ptaddr, u8 ptcaddr,
+			       const u16 val[5])
+{
+	u32 bas;
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		gsw_r32_raw(cdev, PMAC_REG_TBL_CTRL, &bas);
+		if (!(bas & (1u << 15)))
+			break;
+	}
+	gsw_w32(cdev, PMAC_REG_TBL_ADDR, 0, 12, ptaddr);
+	gsw_w32(cdev, PMAC_REG_TBL_CTRL, 0, 3, ptcaddr);
+	gsw_w32(cdev, PMAC_REG_TBL_CTRL, 5, 1, 1);   /* OPMOD = write */
+	gsw_w32(cdev, PMAC_REG_TBL_VAL4, 0, 16, val[4]);
+	gsw_w32(cdev, PMAC_REG_TBL_VAL3, 0, 16, val[3]);
+	gsw_w32(cdev, PMAC_REG_TBL_VAL2, 0, 16, val[2]);
+	gsw_w32(cdev, PMAC_REG_TBL_VAL1, 0, 16, val[1]);
+	gsw_w32(cdev, PMAC_REG_TBL_VAL0, 0, 16, val[0]);
+	gsw_w32(cdev, PMAC_REG_TBL_CTRL, 15, 1, 1);  /* BAS = trigger */
+	for (i = 0; i < 1000; i++) {
+		gsw_r32_raw(cdev, PMAC_REG_TBL_CTRL, &bas);
+		if (!(bas & (1u << 15)))
+			break;
+	}
+}
+
+/*
+ * IG-116 (executed-path completeness audit): the old gsw_pmac_glbl_cfg here
+ * was ported from AVM gsw_defconf.c gsw_pmac_init_nondpu()/pmac_glbl_cfg
+ * (gsw_defconf.c:515-538,659-678) — DEAD CODE on GRX350: its only call site
+ * sits inside an IS_VRSN_31 branch (AVM gsw_flow_core.c:3092) and the oracle
+ * boot log carries no PMAC_GLBL_CFG_SET lines. The working box NEVER writes
+ * PMAC_CTRL_0/2/3/4 — GSW-L 0xD03/0xD05[3:2]/0xD06/0xD07 stay at silicon
+ * reset (only 0xD05[1:0] LCHKS is cleared, by the eth driver, ported below
+ * at the IG-081 site). Our FLAGEN=1 in particular flipped the PMAC egress
+ * table lookup into processing-flags mode, which the working system never
+ * operates (its EG writes prove FLAGEN==0: GSW_PMAC_EG_CfgSet's TC-addressed
+ * branch requires regval==0, AVM gsw_flow_core.c:16235).
+ *
+ * Replacement: write ONLY what the working system writes — FLAGEN=0
+ * (oracle-effective value, also guards stale EVA/warm-boot state, same class
+ * as IG-082) and MLEN=0, which AVM's legacy_core_init writes EXPLICITLY for
+ * GSW-L ("discard jumbo frames on the GSWIP-L", gsw_flow_core.c:2823-2830,
+ * paired with the MAC_FLEN=1518 we already port). Everything else stays at
+ * reset, exactly like the oracle.
+ */
+static void gsw_pmac_glbl_cfg(void *cdev)
+{
+	gsw_w32(cdev, PMAC_REG_CTRL_4,  0, 1, 0);  /* FLAGEN=0: TC-mode (oracle-proven) */
+	gsw_w32(cdev, PMAC_REG_CTRL_2,  3, 1, 0);  /* MLEN=0 (AVM gsw_flow_core.c:2828) */
+}
+
+/* AVM pmac_ig_cfg (NON_DPU, PMAC0): channels 0..16. bClassEna+bErrPktsDisc on
+ * IG-048: this is the AVM *ethernet-driver* GSW-L ingress config
+ * (ltq_eth_drv_xrx500.c:929-954), which REFINES the generic gsw_defconf one.
+ * For every TX DMA channel i it installs a per-channel DEFAULT PMAC header
+ * whose port-map routes the channel to its physical port:
+ *   defPmacHdr[2] = ((i&8)>>3)*2 + 1   (CLASS default 1/3)
+ *   defPmacHdr[3] = 0x90               (PMAP_EN | CLASS_EN in the hdr byte)
+ *   defPmacHdr[7] = 1 << (i & 7)       (PMAP: channel 5 -> 0x20 = GPHY5)
+ * plus all the "use default" flags (val[4]=0xFF: PmacPresent | SpIdDefault |
+ * eSubId | ClassEna | PmapEna | ClassDefault | PmapDefault | ErrPktsDisc).
+ * With bPmapDefault, the PMAC routes the frame by this default port-map
+ * (i.e. by DMA channel), so the DMA2TX-ch5-delivered frame goes to GPHY5.
+ * The prior gsw_defconf config left defPmacHdr=0 (port-map 0 -> routed
+ * nowhere) and ch5 bPmacPresent=0 -> the PMAC had nothing to route by
+ * (iter 9-12: frame reaches DMA2TX/PMAC but never egresses).
+ *
+ * defPmacHdr packs into val[0..3] as val[n] = (hdr[2n]<<8)|hdr[2n+1]. */
+static void gsw_pmac_ig_cfg(void *cdev)
+{
+	int i;
+
+	for (i = 0; i <= 15; i++) {
+		u16 val[5] = { 0, 0, 0, 0, 0 };
+
+		/* val[1] = defPmacHdr[2]<<8 | defPmacHdr[3] */
+		val[1] = (u16)((((((i & 8) >> 3) * 2) + 1) << 8) | 0x90);
+		/* val[3] = defPmacHdr[6]<<8 | defPmacHdr[7]; [6]=0, [7]=1<<(i&7) */
+		val[3] = (u16)(1u << (i & 0x7));
+		/* all "default/enable" flags set */
+		val[4] = 0x00FF;
+
+		gsw_pmac_tbl_write(cdev, (u16)(i & 0x0F), PMAC_TBL_IGCFG_IDX, val);
+	}
+}
+
+/*
+ * IG-116: GSW-L PMAC egress table — byte-faithful port of the body the
+ * working oracle actually executes, the ethernet driver's GSW-L EG loop
+ * (AVM ltq_eth_drv_xrx500.c:883-908): 64 entries, dest port 0 ONLY,
+ * TC-ADDRESSED (FLAGEN==0), nRxDmaChanId=0 (IG-123, SINGLE_RX_CH0_ONLY=1 arm;
+ * was wrongly min(TC,3)), bPmacEna=1, every other field 0. Encoding per AVM
+ * GSW_PMAC_EG_CfgSet (gsw_flow_core.c:
+ * 16208-16330, GSWIP-3.0 / bProcFlagsSelect==0 / regval==0 branch):
+ *   ptaddr = (dest & 0xF) | (TC & 0xF)<<4 | (flowMsb & 3)<<8
+ *   val[0] = 0 (nRes2DW0/nRes1DW0/nResDW1 all 0)
+ *   val[1] = nRxDmaChanId & 0xF
+ *   val[2] = bPmacEna<<0   (bFcsEna=0, bRemL2Hdr=0)
+ * The previous flag-addressed dest 0..11 x flow x MPE loop came from the
+ * never-executed-on-GRX350 gsw_defconf body (see gsw_pmac_glbl_cfg above);
+ * its rows land on different physical addresses than the TC-mode lookup
+ * uses. Rows for dest 1..15 stay at reset — exactly like the oracle.
+ */
+static void gsw_pmac_eg_cfg(void *cdev)
+{
+	int tc, j;
+
+	for (tc = 0; tc <= 15; tc++) {
+		for (j = 0; j <= 3; j++) {
+			u16 val[5] = { 0, 0, 0, 0, 0 };
+			u16 ptaddr = (u16)(((tc & 0x0F) << 4) |
+					   ((j & 0x3) << 8)); /* dest = 0 */
+
+			/*
+			 * IG-123 (GAP C): nRxDmaChanId = 0 for EVERY CPU-bound
+			 * entry, mirroring AVM's SINGLE_RX_CH0_ONLY=1 build
+			 * (ltq_eth_drv_xrx500.c:886-889). The previous min(TC,3)
+			 * was the dead #else arm; it scattered CPU RX onto DMA
+			 * classes 0..3 while the p2p bridge provisions ONLY ch0,
+			 * so any TC>=1 frame was dropped at CBM enqueue. Funnel
+			 * all CPU RX to channel 0.
+			 */
+			val[1] = 0;                         /* nRxDmaChanId=0 (SINGLE_RX_CH0_ONLY) */
+			val[2] = 1u << 0;                   /* bPmacEna=1 */
+			gsw_pmac_tbl_write(cdev, ptaddr,
+					   PMAC_TBL_EGCFG_IDX, val);
+		}
+	}
+}
+
+/*
+ * IG-080: GSW-R PMAC config — faithful port of AVM's GSW-R arm of
+ * ltq_gsw_pmac_init (ltq_eth_drv_xrx500.c:987-1138, after gsw_get_swcore_ops(1)).
+ * Our port previously configured the PMAC for GSW-L only (gsw_pmac_{glbl,ig,eg}_cfg
+ * under sdev==LTQ_FLOW_DEV_INT); the GSW-R PMAC ingress/egress tables were left at
+ * reset. GSW-R is a BLIND SPOT of our GSW-L-only oracle (it reads 0x1c000000, not
+ * the GSW-R window 0x1a000000), which is why every prior register comparison
+ * "matched" yet the CPU-TX frame never reached GSW-L (RX_Good[p0]=0).
+ *
+ * GSW-R has its OWN ingress field set (NOT GSW-L's 0xFF): val[4] reads 0xD1
+ * (ch0..3) / 0x81 (ch4..14) / 0xD3 (ch15) on the live working testbed (v108th
+ * probe). val[4] bit map (AVM gsw_flow_core.c:16041-16087):
+ *   b0 bPmacPresent  b1 bSpIdDefault  b2 eSubId  b3 bClassEna
+ *   b4 bPmapEna      b5 bClassDefault b6 bPmapDefault  b7 bErrPktsDisc
+ * AVM issues NO PMAC global-cfg for GSW-R, so FLAGEN stays reset-0 and the egress
+ * table is traffic-class-addressed (gsw_flow_core.c:16235), not flag-addressed
+ * like our GSW-L gsw_pmac_eg_cfg. Pure PMAC table writes (gsw_pmac_tbl_write ->
+ * gsw_w32 on the GSW-R window); no DMA, additive, cannot affect boot/link/RX.
+ */
+static void gsw_pmac_ig_cfg_r(void *cdev)
+{
+	int i;
+
+	for (i = 0; i <= 15; i++) {
+		u16 val[5] = { 0, 0, 0, 0, 0 };
+		int pmap_def = ((i < 4) || (i == 15)) ? 1 : 0;
+
+		if (i == 15) {
+			val[1] = 0x0080;  /* defPmacHdr[2]=0, [3]=0x80 */
+			val[3] = 0x8000;  /* defPmacHdr[6]=0x80, [7]=0x00 */
+		} else {
+			val[1] = (u16)((i & 0x0F) << 12); /* hdr[2]=i<<4, hdr[3]=0 */
+			val[3] = 0xFFFF;                  /* hdr[6]=hdr[7]=0xFF */
+		}
+		val[4] = (u16)(0x01                    /* b0 bPmacPresent */
+			    | ((i == 15) ? 0x02 : 0)   /* b1 bSpIdDefault */
+			    | (pmap_def ? 0x10 : 0)    /* b4 bPmapEna */
+			    | (pmap_def ? 0x40 : 0)    /* b6 bPmapDefault */
+			    | 0x80);                   /* b7 bErrPktsDisc */
+
+		gsw_pmac_tbl_write(cdev, (u16)(i & 0x0F), PMAC_TBL_IGCFG_IDX, val);
+	}
+}
+
+/*
+ * AVM GSW-R PMAC egress (ltq_eth_drv_xrx500.c:1009-1066): destPort k=0..15,
+ * traffic class i=0..15, flowMsb j=0..3; TC-addressed (FLAGEN=0).
+ *   ptaddr = (k & 0xF) | ((i & 0xF) << 4) | ((j & 0x3) << 8)
+ *   nRxDmaChanId = (k <= 13) ? 0 : 5  (GRX350-B / soc_rev==2 path; differs from
+ *     the else-branch only for k=14/15, outside the CPU<->GPHY5 datapath)
+ *   bPmacEna=1 always; bFcsEna=(k==13); bRemL2Hdr + numBytesRem=1 for k==14.
+ * val[2]: b0 bPmacEna, b1 bFcsEna, b2 bRemL2Hdr, [15:8] numBytesRem
+ * (gsw_flow_core.c:16311-16327).
+ */
+static void gsw_pmac_eg_cfg_r(void *cdev)
+{
+	int k, i, j;
+
+	for (k = 0; k <= 15; k++) {
+		for (i = 0; i <= 15; i++) {
+			for (j = 0; j <= 3; j++) {
+				u16 val[5] = { 0, 0, 0, 0, 0 };
+				u16 ptaddr = (u16)((k & 0x0F)
+						   | ((i & 0x0F) << 4)
+						   | ((j & 0x03) << 8));
+
+				val[1] = (u16)((k <= 13) ? 0 : 5); /* nRxDmaChanId */
+				val[2] |= (1u << 0);               /* bPmacEna=1 */
+				if (k == 13)
+					val[2] |= (1u << 1);       /* bFcsEna */
+				if (k == 14) {
+					val[2] |= (1u << 2);       /* bRemL2Hdr */
+					val[2] |= (1u << 8);       /* numBytesRem=1 */
+				}
+				gsw_pmac_tbl_write(cdev, ptaddr,
+						   PMAC_TBL_EGCFG_IDX, val);
+			}
+		}
+	}
+}
+
+/*
+ * IG-072: faithful port of the Special-Tag-Ingress (bSpecialTagIngress=1)
+ * portion of AVM's GSW_CPU_PortCfgSet (gsw_flow_core.c:16766-16975, the
+ * IGSTEN write at :16815-16817), driven from ltq_gsw_pmac_init
+ * (ltq_eth_drv_xrx500.c:957-964 on GSW-L port 0, :1097-1113 on GSW-R ports
+ * 0..14).
+ *
+ * AVM's register-level write (gsw_flow_core.c:16815):
+ *   gsw_w32(cdev, (PCE_PCTRL_0_IGSTEN_OFFSET + (0xa * pidx)),
+ *           PCE_PCTRL_0_IGSTEN_SHIFT, PCE_PCTRL_0_IGSTEN_SIZE,
+ *           parm->bSpecialTagIngress);
+ * with the per-port stride 0xa. PCE_PCTRL_0_IGSTEN_OFFSET=0x480, SHIFT=11,
+ * SIZE=1 (our gsw_reg.h:2381-2383, byte-identical to AVM gsw_reg.h:2381-2383).
+ *
+ * Why this is the gate: our PMAC ingress route-by-DMA-channel table
+ * (gsw_pmac_ig_cfg above, defPmacHdr matches AVM) inserts the CPU-TX special
+ * tag, but the GSWIP PCE parser only CONSUMES that special tag (and forwards
+ * the frame by its port-map to GPHY5) when the ingress port has IGSTEN set.
+ * Without it the special tag is misparsed and the frame is dropped before
+ * egress (SDMA[p5]=0), exactly our symptom.
+ *
+ * Scope (kept minimal/clean per the experiment): the IGSTEN bit ONLY. We do
+ * NOT touch MAC_CTRL_0 bFcsGenerate here -- that register is the separate FCS
+ * candidate already programmed in intel_xrx500.c:642/761 and is explicitly
+ * out of scope. AVM also writes PMAC_HD_CTL.AST/RXSH inside the
+ * (pidx==cport && gipver!=3.0) branch, but our port hardcodes
+ * gipver=LTQ_GSWIP_3_0 (gsw_init.c:181) and drives the CPU/PMAC special tag
+ * through the PMAC ingress table (gsw_pmac_ig_cfg, bPmacPresent), so the
+ * legacy single-PMAC PMAC_HD_CTL path is not the GSWIP-3.0 ingress mechanism;
+ * IGSTEN is the gipver-independent PCE-side enable. AVM's IGSTEN write is
+ * keyed on pidx = parm->nPortId (NOT gswdev->cport), so it is independent of
+ * the cport field.
+ */
+static void gsw_cpu_special_tag_ingress(void *cdev)
+{
+	ethsw_api_dev_t *gswdev = (ethsw_api_dev_t *)cdev;
+	u8 pidx;
+
+	if (gswdev == NULL)
+		return;
+
+	if (gswdev->sdev == LTQ_FLOW_DEV_INT) {
+		/*
+		 * GSW-L: AVM enables Special-Tag-Ingress on the single CPU/PMAC
+		 * port (ltq_eth_drv_xrx500.c:958 nPortId=0 ->
+		 * GSW_3X_SOC_CPU_PORT). pidx=0 -> offset 0x480 + 0xa*0 = 0x480.
+		 */
+		pidx = (u8)GSW_3X_SOC_CPU_PORT;
+		gsw_w32(cdev, (PCE_PCTRL_0_IGSTEN_OFFSET + (0xa * pidx)),
+			PCE_PCTRL_0_IGSTEN_SHIFT,
+			PCE_PCTRL_0_IGSTEN_SIZE, 1);
+		/*
+		 * IG-075: complete the GSW-L CPU-port PCE control to the MEASURED
+		 * working value PCE_PCTRL_0[p0]=0x4807 (OpenWrt-4.9 testbed live
+		 * capture, v108nf-pctrl probe: gswl p0=0x4807, p1..p6=0x0007,
+		 * p7+=0). IG-072 set only IGSTEN (bit11). The working CPU port ALSO
+		 * has SPFDIS (bit14) -- AVM writes it unconditionally at bring-up
+		 * (ltq_eth_drv_xrx500.c:981 "gsw_reg_set_bit(ops, 0x480, 0x4000)",
+		 * GSW-L CPU port0 only) -- plus PSTATE=FORWARDING (bits0-2=7) on the
+		 * forwarding ports. SPFDIS governs whether a CPU-injected frame
+		 * (src = device MAC) is admitted vs dropped at PCE ingress as
+		 * spoofed; missing it is a candidate gate for our RX_Good[p0]=0
+		 * (live-proven that working CPU-TX traverses GSW-L p0->p5). Additive
+		 * field-RMW only -- cannot affect boot/link/RX.
+		 */
+		{
+			u8 p;
+
+			/* SPFDIS (bit14) on the CPU port -- faithful to AVM. */
+			gsw_w32(cdev, (PCE_PCTRL_0_SPFDIS_OFFSET + (0xa * pidx)),
+				PCE_PCTRL_0_SPFDIS_SHIFT,
+				PCE_PCTRL_0_SPFDIS_SIZE, 1);
+
+			/*
+			 * PSTATE=FORWARDING on GSW-L ports 0..6 (live CPU-TX path
+			 * is p0 ingress -> p5 egress; golden RMON shows p0..p6
+			 * carrying traffic). Belt-and-suspenders vs the reset
+			 * default.
+			 */
+			for (p = 0; p <= 6; p++)
+				gsw_w32(cdev,
+					(PCE_PCTRL_0_PSTATE_OFFSET + (0xa * p)),
+					PCE_PCTRL_0_PSTATE_SHIFT,
+					PCE_PCTRL_0_PSTATE_SIZE,
+					PORT_STATE_FORWARDING);
+
+		}
+
+		/*
+		 * IG-081 (updated IG-116): clear the PMAC short-frame length check
+		 * (LCHKS) on the GSW-L PMAC = AVM ltq_gsw_pmac_init's final step
+		 * ("gsw_reg_clr_bit(ops, 0xd05, 0x3)", ltq_eth_drv_xrx500.c:983-984,
+		 * right after the 0x480 SPFDIS set we port as IG-075). Since IG-116
+		 * gsw_pmac_glbl_cfg no longer pre-sets LCHKS=1 (that came from the
+		 * never-executed-on-GRX350 gsw_defconf body), this write is now a
+		 * pure AVM-parity clear from reset state, same end state 0.
+		 * Field-RMW only.
+		 */
+		{
+			gsw_w32(cdev, PMAC_REG_CTRL_2, 0, 2, 0); /* LCHKS = SHORT_LEN_DIS */
+		}
+
+		/*
+		 * IG-082: complete the AVM GSW_CPU_PortCfgSet port for GSW-L CPU
+		 * port 0 -- the writes we folded away when reducing IG-072 to
+		 * "IGSTEN only". AVM's GSW_CPU_PortCfgSet (gsw_flow_core.c:16766,
+		 * called for GSW-L p0 at ltq_eth_drv_xrx500.c:958-964 with cpu_port_cfg
+		 * memset-0 except bSpecialTagIngress=1) ALSO writes, for the CPU port:
+		 *   SDMA_PCTRL_FCSIGN[p0] = bFcsCheck = 0          (:16953, off 0xbc0)
+		 *   FDMA_PCTRL_ST_TYPE[p0] = 0 (bSpecialTagEthType != FLOWID) (:16962, 0xa80)
+		 *   FDMA_PCTRL_STEN[p0]   = bSpecialTagEgress = 0  (:16794, off 0xa80)
+		 *   FDMA_PASR_{CPU,MPE1,MPE2,MPE3} = 0 (eParserCfg NIL)   (:16865.., 0xa47)
+		 *
+		 * All write the GSWIP-3.0 RESET-DEFAULT 0 -- so a cold-reset part is
+		 * unaffected. BUT these are SHARED FDMA/SDMA registers and we ramboot
+		 * via EVA *after* AVM's bootloader has run its own network stack, so
+		 * they can be left DIRTY (non-zero) and our slimmed port never clears
+		 * them (same bug class as IG-081's LCHKS). FDMA_PASR (CPU/MPE parser
+		 * select) and FDMA_PCTRL.ST_TYPE (special-tag interpretation) sit on
+		 * the CPU-port ingress/parser path -> a stale non-zero value could
+		 * mis-parse the special-tagged CPU-TX frame so it is never admitted at
+		 * GSW-L p0 (RX_Good[p0]=0). The pre-read below REVEALS any such stale
+		 * EVA state; faithful additive field-RMW, all to 0.
+		 */
+		{
+			u8 cp = (u8)GSW_3X_SOC_CPU_PORT;   /* GSW-L CPU port = 0 */
+
+
+			/* FDMA CPU/MPE parser-select = NIL(0) -- single reg 0xa47 */
+			gsw_w32(cdev, FDMA_PASR_CPU_OFFSET, FDMA_PASR_CPU_SHIFT,
+				FDMA_PASR_CPU_SIZE, 0);
+			gsw_w32(cdev, FDMA_PASR_MPE1_OFFSET, FDMA_PASR_MPE1_SHIFT,
+				FDMA_PASR_MPE1_SIZE, 0);
+			gsw_w32(cdev, FDMA_PASR_MPE2_OFFSET, FDMA_PASR_MPE2_SHIFT,
+				FDMA_PASR_MPE2_SIZE, 0);
+			gsw_w32(cdev, FDMA_PASR_MPE3_OFFSET, FDMA_PASR_MPE3_SHIFT,
+				FDMA_PASR_MPE3_SIZE, 0);
+			/* FDMA per-port special-tag egress + type = 0 */
+			gsw_w32(cdev, (FDMA_PCTRL_STEN_OFFSET + (0x6 * cp)),
+				FDMA_PCTRL_STEN_SHIFT, FDMA_PCTRL_STEN_SIZE, 0);
+			gsw_w32(cdev, (FDMA_PCTRL_ST_TYPE_OFFSET + (0x6 * cp)),
+				FDMA_PCTRL_ST_TYPE_SHIFT, FDMA_PCTRL_ST_TYPE_SIZE, 0);
+			/* SDMA per-port FCS-ignore = bFcsCheck = 0 */
+			gsw_w32(cdev, (SDMA_PCTRL_FCSIGN_OFFSET + (0x6 * cp)),
+				SDMA_PCTRL_FCSIGN_SHIFT, SDMA_PCTRL_FCSIGN_SIZE, 0);
+
+		}
+
+		/*
+		 * IG-167 (supersedes IG-123 GAP B): flood maps = 0x1 — the
+		 * working system's GSW-L value. PCE_PMAP_2 (DMCPMAP, bcast+
+		 * unknown-mcast, word 0x454) and PCE_PMAP_3 (UUCMAP, unknown-
+		 * unicast, 0x455): hardware floods go to the CPU PORT ONLY;
+		 * LAN-to-LAN forwarding is the Linux bridge's job in software.
+		 * Provenance: 0x1 is the silicon reset default AVM leaves
+		 * UNTOUCHED on GSW-L (live-oracle-verified 2026-07-02:
+		 * PMAP_2=PMAP_3=0x0001 under working traffic, to-CPU frames
+		 * store port_map=BIT(0) + full parser fields + body); AVM also
+		 * writes the same 0x1 EXPLICITLY on GSW-R (ltq_eth_drv_
+		 * xrx500.c:1131-1133, mirrored in our INT_R branch below). Our
+		 * IG-123 "|= 0x7F" flooded every bcast/unknown frame to all
+		 * seven ports — five of them link-dead so their copies never
+		 * drain — and correlates with the IG-160..163 malformed-store
+		 * signature (port_map=BIT(7)/BIT(1) == DW1.ep, sppid=0, parser
+		 * fields zero, body absent) plus the accepts-once EQM wedge.
+		 * Pre/post readback kept for stale-EVA visibility.
+		 */
+		{
+
+			gsw_w32(cdev, PCE_PMAP_3_UUCMAP_OFFSET,
+				PCE_PMAP_3_UUCMAP_SHIFT,
+				PCE_PMAP_3_UUCMAP_SIZE, 0x1);
+			gsw_w32(cdev, PCE_PMAP_2_DMCPMAP_OFFSET,
+				PCE_PMAP_2_DMCPMAP_SHIFT,
+				PCE_PMAP_2_DMCPMAP_SIZE, 0x1);
+
+		}
+	} else if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
+		/*
+		 * GSW-R: AVM enables Special-Tag-Ingress on ports 0..14
+		 * (ltq_eth_drv_xrx500.c:1098 "for (k = 0; k < 15; k++)").
+		 */
+		for (pidx = 0; pidx < 15; pidx++) {
+			gsw_w32(cdev, (PCE_PCTRL_0_IGSTEN_OFFSET + (0xa * pidx)),
+				PCE_PCTRL_0_IGSTEN_SHIFT,
+				PCE_PCTRL_0_IGSTEN_SIZE, 1);
+		}
+
+		/*
+		 * IG-081: disable LCHKS on the GSW-R PMAC too -- AVM clears it for
+		 * both instances (ltq_eth_drv_xrx500.c:1135-1136, identical
+		 * "gsw_reg_clr_bit(ops, 0xd05, 0x3)"). We issue no gsw_pmac_glbl_cfg
+		 * for GSW-R, so this is idempotent vs the reset default, but kept
+		 * faithful + belt-and-suspenders (GSW-R is the off-CPU-path blind
+		 * spot; cf. IG-080).
+		 */
+		{
+			gsw_w32(cdev, PMAC_REG_CTRL_2, 0, 2, 0); /* LCHKS = SHORT_LEN_DIS */
+		}
+
+		/*
+		 * IG-167: AVM-exact GSW-R flood maps — verbatim ltq_gsw_pmac_init
+		 * tail (AVM ltq_eth_drv_xrx500.c:1131-1133, gsw_reg_set_val(0x454,
+		 * 0x1) + (0x455, 0x1) on the GSW-R ops, right before the LCHKS
+		 * clear above). Floods → CPU port only.
+		 */
+		gsw_w32(cdev, PCE_PMAP_2_DMCPMAP_OFFSET,
+			PCE_PMAP_2_DMCPMAP_SHIFT, PCE_PMAP_2_DMCPMAP_SIZE, 0x1);
+		gsw_w32(cdev, PCE_PMAP_3_UUCMAP_OFFSET,
+			PCE_PMAP_3_UUCMAP_SHIFT, PCE_PMAP_3_UUCMAP_SIZE, 0x1);
+	}
+}
+
 int gsw_pmicro_code_init(void *cdev)
 {
 	/* See gsw_pce_table_write for the cdev-accessor rationale. */
@@ -666,6 +1119,209 @@ int gsw_pmicro_code_init(void *cdev)
 	gsw_w32(cdev, BM_QUEUE_GCTRL_GL_MOD_OFFSET, BM_QUEUE_GCTRL_GL_MOD_SHIFT,
 		Gl_Mod_Size, 0);
 
+	/*
+	 * Port the AVM switch_core_init enable tail (gsw_flow_core.c
+	 * ~3072-3087): after the microcode is VALID and GCTRL_SE=1 is armed,
+	 * ENABLE the per-port FDMA/SDMA egress engines. Our original port only
+	 * ever cleared FDMA_PCTRL.EN / SDMA_PCTRL.PEN (the "Disable all physical
+	 * port" loop above) and never re-enabled them, so the SDMA egress
+	 * scheduler stayed OFF and could not drain the TMU egress queue to the
+	 * LAN MAC/GPHY -- frames advanced tx_packets but never reached the wire
+	 * (gswr p5 SDMA_PSTAT0 dormant 0x0000 vs working 0x00ff).
+	 *
+	 * FDMA: enable every port the disable loop covered (same bounds + the
+	 * GSW-R j==1->15 hole-skip).
+	 */
+	for (j = 0; j < no_ports; j++) {
+		if (gswdev->sdev == LTQ_FLOW_DEV_INT_R && j == 1)
+			j = 15;
+		gsw_w32(cdev, (FDMA_PCTRL_EN_OFFSET + (j * 0x6)),
+			FDMA_PCTRL_EN_SHIFT, FDMA_PCTRL_EN_SIZE, 1);
+	}
+
+	/*
+	 * The FDMA loop above carries the GSW-R j==1->15 skip, which EXCLUDES
+	 * LAN ports 2-5 from FDMA_PCTRL.EN on GSW-R -- so GSW-R LAN ingress
+	 * (the GSW-L->GSW-R bridge direction) is left disabled. AVM enables
+	 * FDMA for all ports via the tpnum bound; our pnum+skip bound dropped
+	 * 2-5 on GSW-R. Arm them explicitly, mirroring the SDMA LAN-port loop
+	 * below, so FDMA + SDMA are both live for the LAN egress/bridge path.
+	 */
+	{
+		static const u16 fdma_lan_ports[] = { 2, 3, 4, 5 };
+		u16 k;
+
+		for (k = 0; k < ARRAY_SIZE(fdma_lan_ports); k++) {
+			u16 p = fdma_lan_ports[k];
+
+			gsw_w32(cdev, (FDMA_PCTRL_EN_OFFSET + (p * 0x6)),
+				FDMA_PCTRL_EN_SHIFT, FDMA_PCTRL_EN_SIZE, 1);
+		}
+	}
+
+	/*
+	 * SDMA: arm the egress ports EXPLICITLY (ports 0,1 + LAN ports 2,3,4,5)
+	 * on BOTH instances. We do NOT reuse the j==1->15 skip here: that skip
+	 * would exclude port 5 on GSW-R, which is precisely the long-hunted
+	 * dormant LAN egress port. Iterate the LAN ports directly so p5 is armed.
+	 */
+	{
+		/*
+		 * IG-116: include p6 — AVM's enable loop runs j=0..pnum-1 with
+		 * silicon pnum=7 on GSW-L (gsw_flow_core.c:2832-2852), so the
+		 * oracle has SDMA_PCTRL.PEN[p6]=1 while our explicit list left
+		 * it 0 (audit F-4): a real ingress-enable divergence on the
+		 * dead switch, even though p6 is off the LAN path.
+		 */
+		static const u16 sdma_ports[] = { 0, 1, 2, 3, 4, 5, 6 };
+		u16 k;
+
+		for (k = 0; k < ARRAY_SIZE(sdma_ports); k++) {
+			u16 p = sdma_ports[k];
+
+			gsw_w32(cdev, (SDMA_PCTRL_PEN_OFFSET + (p * 0x6)),
+				SDMA_PCTRL_PEN_SHIFT, SDMA_PCTRL_PEN_SIZE, 1);
+		}
+	}
+
+	/*
+	 * IG-198: AVM-exact port-enable completion. 4.9's enable sweep
+	 * (gsw_flow_core.c:2832-2852) runs j < (sdev==INT_R ? tpnum : pnum)
+	 * — on GSW-R that is tpnum = 16, ALL ports ("AVM|PHU: all ports may
+	 * and should be enabled on GSWIP-R"), each getting FDMA_PCTRL.EN=1
+	 * + SDMA_PCTRL.PEN=1 + BM_PCFG.CNTEN=1. Our explicit lists above
+	 * left GSW-R with FDMA.EN only on {0,2,3,4,5,15} and SDMA.PEN only
+	 * on {0..6}: the IG-197b boot proved frames now cross the p2p
+	 * bridge into GSW-R (both bridge cursors advancing) and then STALL
+	 * — the ring fills because GSW-R's PMAC-vport ingress/egress ports
+	 * are not enabled. Complete the coverage AVM-exactly (idempotent
+	 * set-1 writes over the partial lists above; tpnum hardcoded 16 =
+	 * silicon PPORTS on both GSWIP-3.0 instances).
+	 */
+	{
+		u16 lim = (gswdev->sdev == LTQ_FLOW_DEV_INT_R) ? 16 : no_ports;
+		u16 p;
+
+		for (p = 0; p < lim; p++) {
+			gsw_w32(cdev, (FDMA_PCTRL_EN_OFFSET + (p * 0x6)),
+				FDMA_PCTRL_EN_SHIFT, FDMA_PCTRL_EN_SIZE, 1);
+			gsw_w32(cdev, (SDMA_PCTRL_PEN_OFFSET + (p * 0x6)),
+				SDMA_PCTRL_PEN_SHIFT, SDMA_PCTRL_PEN_SIZE, 1);
+			gsw_w32(cdev, (BM_PCFG_CNTEN_OFFSET + (p * 2)),
+				BM_PCFG_CNTEN_SHIFT, BM_PCFG_CNTEN_SIZE, 1);
+		}
+	}
+
+	/*
+	 * IG-103 AVM-completeness parity (legacy_switch_core_init tail).
+	 * Three write groups AVM performs at switch-core init that our port
+	 * never carried over (AVM 4.9 gsw_flow_core.c cites per group):
+	 *
+	 * (1) ANEG_EEE_p.CLK_STOP_CAPABLE = 0x3 for every port, BOTH
+	 *     instances (gsw_flow_core.c:2854-2859, repeated in GSW_HW_Init
+	 *     :11866-11871). TOP-module per-port EEE clock-stop override,
+	 *     word 0x046 + 4*(p-1) + 0xF00; p5 = word 0xF56 / byte 0x3D58.
+	 *     AVM loops j = 0 .. pnum-2 (ANEG_EEE_1 .. ANEG_EEE_(pnum-1)).
+	 *
+	 * (2) MAC_PFSA_0/1/2 pause-frame source MAC 00:96:00:AC:9A:00,
+	 *     both instances (set_srcmac_pauseframe, gsw_flow_core.c:
+	 *     2711-2731; Lane-H corpus readback v108yk-laneh-boot.log:2144
+	 *     confirms 0x0000/0x9600/0xAC9A on the working box).
+	 *
+	 * (3) MAC_FLEN = 1518, GSW-L only (gsw_flow_core.c:2825-2826;
+	 *     corpus working value 0x05EE, v108rr-avm49:1396).
+	 */
+	for (j = 0; j + 1 < no_ports; j++)
+		gsw_w32(cdev, (short)(GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_OFFSET +
+				      (j * 4) + GSW30_TOP_OFFSET),
+			GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SHIFT,
+			GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SIZE, 0x3);
+
+	gsw_w32(cdev, MAC_PFSA_0_PFAD_OFFSET, MAC_PFSA_0_PFAD_SHIFT,
+		MAC_PFSA_0_PFAD_SIZE, 0x0000);
+	gsw_w32(cdev, MAC_PFSA_1_PFAD_OFFSET, MAC_PFSA_1_PFAD_SHIFT,
+		MAC_PFSA_1_PFAD_SIZE, 0x9600);
+	gsw_w32(cdev, MAC_PFSA_2_PFAD_OFFSET, MAC_PFSA_2_PFAD_SHIFT,
+		MAC_PFSA_2_PFAD_SIZE, 0xAC9A);
+
+	if (gswdev->sdev != LTQ_FLOW_DEV_INT_R)
+		gsw_w32(cdev, MAC_FLEN_LEN_OFFSET, MAC_FLEN_LEN_SHIFT,
+			MAC_FLEN_LEN_SIZE, 1518);
+
+
+	/*
+	 * IG-044: configure the PMAC (GSW-L / PMAC0 only). The PMAC is the
+	 * CPU/DMA-facing MAC that bridges DMA2TX ch5 -> GPHY5; its config tables
+	 * were entirely unported, so the DMA-delivered TX frame was dropped
+	 * instead of egressing. Runs after microcode + FDMA/SDMA enable, before
+	 * return (AVM order: glbl -> ig -> eg, after FDMA enable).
+	 */
+	if (gswdev->sdev == LTQ_FLOW_DEV_INT) {
+		gsw_pmac_glbl_cfg(cdev);
+		gsw_pmac_ig_cfg(cdev);
+		gsw_pmac_eg_cfg(cdev);
+	} else if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
+		/*
+		 * IG-080: GSW-R PMAC config (previously absent — GSW-R was a
+		 * blind spot of our GSW-L-only oracle). No glbl_cfg: AVM issues
+		 * none for GSW-R, so FLAGEN stays reset-0 -> TC-addressed egress.
+		 */
+		gsw_pmac_ig_cfg_r(cdev);
+		gsw_pmac_eg_cfg_r(cdev);
+	}
+
+	/*
+	 * IG-072: enable Special-Tag-Ingress on the CPU/PMAC port(s) so the PCE
+	 * parser consumes the special tag our PMAC ingress table inserts and
+	 * forwards the CPU-TX frame by its port-map (ch5 -> GPHY5). Per-instance
+	 * inside the helper: GSW-L port 0, GSW-R ports 0..14 (AVM order: after
+	 * the PMAC ingress/egress tables -- ltq_eth_drv_xrx500.c:957/1097).
+	 */
+	gsw_cpu_special_tag_ingress(cdev);
 
 	return GSW_statusOk;
 }
+
+/*
+ * IG-113: AVM GSW_HW_Init parity (gsw_flow_core.c:11787-11875) — pulse
+ * the whole-core switch reset (ETHSW_SWRES.R0, hardware self-clears)
+ * and re-run the FULL init: gsw_pmicro_code_init covers the PCE
+ * microcode, GCTRL.SE, BM CNTEN/RMON, FDMA/SDMA enables, the IG-103
+ * parity writes (ANEG_EEE/PFSA/FLEN) AND the PMAC glbl/ig/eg tables +
+ * special-tag (IG-044/072/080) — i.e. everything our boot ever writes
+ * into this switch instance. Purpose (one-shot experiment): reset the
+ * SWITCH side of the p5 GMII while the GPHY link is LIVE — the
+ * complementary half of IG-111 (PHY-side reboot, negative). NOTE: the
+ * TOP block (MDC_CFG_0/1) is wiped too; the CALLER must re-init the
+ * MDIO master + poller afterwards.
+ */
+int gsw_hw_reinit(void *cdev)
+{
+	u32 j = 1;
+	int spins = 0;
+
+	gsw_w32(cdev, ETHSW_SWRES_R0_OFFSET, ETHSW_SWRES_R0_SHIFT,
+		ETHSW_SWRES_R0_SIZE, 1);
+	do {
+		u32 raw = 0;
+
+		gsw_r32_raw(cdev, ETHSW_SWRES_R0_OFFSET, &raw);
+		j = raw & BIT(ETHSW_SWRES_R0_SHIFT);
+	} while (j && ++spins < 1000000);
+
+	pr_info("gsw: IG-113 SWRES self-cleared after %d polls; re-running full init\n",
+		spins);
+
+	return gsw_pmicro_code_init(cdev);
+}
+
+/* IG-113: GSW-L variant for the MDIO driver's one-shot hook. */
+int gsw_hw_reinit_gswl(void)
+{
+	struct core_ops *ops = gsw_get_swcore_ops(0);
+
+	if (!ops)
+		return -ENODEV;
+
+	return gsw_hw_reinit(GSW_PDATA_GET(ops));
+}
