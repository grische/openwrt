+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Derived from the AVM FRITZ!Box 7560 GPL release (Linux 4.9.198),
+ * drivers/net/ethernet/lantiq/xrx500_phy_fw.c and xrx500_phy_fw.h:
