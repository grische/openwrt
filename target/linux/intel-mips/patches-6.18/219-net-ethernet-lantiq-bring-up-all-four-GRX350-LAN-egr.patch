 		const struct port7_chan_desc *e = &tbl[i];
@@ -2326,8 +2376,7 @@ int hdma_port_enable(int port_id)
 			port_id, e->label, e->cid, e->pid, e->nid);
 	}
 
-	if (port_id == 10)
-		g_hdma_port10_armed = true;
+	hdma_deq_set_armed(port_id);
