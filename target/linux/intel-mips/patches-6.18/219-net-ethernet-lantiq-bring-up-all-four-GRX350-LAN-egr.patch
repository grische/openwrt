+			else
+				pr_info("cbm: DMA2TX ch%d opened at probe-end for deq %d (AVM order)\n",
+					deq - 5, deq);
+		}
 	}
 
 	cbm_eqm_rx_chan_open(DMA2RX_CBMP5_CLASS14, 5, CBM_PORT_F_STANDARD_BUF);
