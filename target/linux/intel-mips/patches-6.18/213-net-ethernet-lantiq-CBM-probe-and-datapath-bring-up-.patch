+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sub-4 ST-002 + ST-004 — CBM platform_driver probe + the three
+ * init_cbm_basic / cbm_intr_mapping_init / cbm_interrupt_init bodies.
+ *
+ * Brings up the 12 MMIO windows + 5 IRQs declared by the SoC-scope
+ * "lantiq,cbm-xrx500" DT node (added by ST-002 to xrx500.dtsi with
+ * status="disabled" per CQ-002 C / IG-013). Sub-6's board overlay will
+ * flip status="okay" and inject the reserved-memory phandles per IG-006.
+ *
+ * Ownership boundary for this TU:
+ *   - of_match_table {"lantiq,cbm-xrx500"}     -- ST-002
+ *   - cbm_xrx500_probe / cbm_xrx500_remove     -- ST-002
+ *   - cbm_hw_init top-level orchestration      -- ST-002 (this file)
+ *   - module_platform_driver() registration    -- ST-002 (at file end)
+ *   - init_fsqm()                              -- ST-003 body (fsqm.c)
+ *   - init_cbm_basic / cbm_intr_mapping_init   -- ST-004 body (this file)
+ *   - cbm_interrupt_init request_irq plumbing  -- ST-004 body (this file)
+ *   - cbm_isr_0..4 handler bodies              -- ST-005 (cbm_intr.c)
+ *
+ * ST-004 placement rationale: AVM cqm/grx500/cbm.c carries all three
+ * functions (init_cbm_basic at 1231-1256, cbm_intr_mapping_init at
+ * 1208-1225, cbm_interrupt_init at 2810-2870) in the SAME cbm.c TU; the
+ * ST-001 split into separate cbm_intr.c was scaffolding for ST-005's
+ * handler bodies, not a permanent home for cbm_interrupt_init.
+ * Concentrating ST-004's three function bodies in cbm.c matches the AVM
+ * source organisation and keeps the file-static cbm_pdev_cache /
+ * cbm_irqs[] cookies (used by init_cbm_basic to chain into
+ * cbm_interrupt_init) inside the same TU where they are populated by
+ * cbm_xrx500_probe — no need to widen their linkage.
+ *
+ * Why the DT node ships disabled: the probe pulls 4 MiB std + 2 MiB jbo
+ * placeholder pools from __get_free_pages (IG-012 divergence from the
+ * stock firmware's OFSC values). Activating that path before Sub-6 wires
+ * up reserved-memory regions would regress against the stock firmware
+ * (which expects OFSC=0x000023ff at AVM-sized pools). status="disabled"
+ * therefore keeps Sub-4 a build-only / DTC-only deliverable per CQ-002 C
+ * and AC-002-9.
+ *
+ * AVM source: AVM cqm/grx500/cbm.c:5485-5742 for the probe shape,
+ * cbm.c:2152-2156 for cbm_hw_init's init_fsqm + init_cbm_basic ordering,
+ * cbm.c:1208-1256 for cbm_intr_mapping_init + init_cbm_basic, cbm.c:2810-2870
+ * for cbm_interrupt_init, cbm.c:5480-5483 for the of_match_table
+ * compatible string.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/io.h>
+#include <linux/err.h>
+#include <linux/atomic.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/mod_devicetable.h>
+#include <linux/clk.h>
+#include <linux/printk.h>
+#include <linux/device.h>
+#include <linux/interrupt.h>  /* devm_request_irq, IRQF_SHARED, irqreturn_t */
+#include <linux/bits.h>       /* BIT() */
+#include <asm/io.h>           /* virt_to_phys */
+#include <asm/page.h>         /* __pa() */
+
+#include "cbm.h"
+#include "../../tmu/drv_tmu_ll.h"  /* tmu_init() — Sub-5 M0 EPOC zero-init entry */
+#include "../../dma/lantiq_dmax.h" /* IG-068: ltq_request_dma / ltq_dma_p2p_cfg
+				    * + DMA1TX_LAN_SWITCH_CLASS* /
+				    * DMA2RX_GSWIP_R_CLASS* channel macros
+				    * for setup_DMA_p2p / turn_on_DMA_p2p
+				    */
+
+/*
+ * ST-004 local register offsets for the SBA/JBA buffer-pool base address
+ * registers inside the CBM control window (g_cbm_base). Verbatim from
+ * AVM cqm/grx500/reg/cbm.h:2545/2563/2581/2599 — defined LOCALLY (not in
+ * cbm_regs.h) because cbm_regs.h is OUTSIDE ST-004's file_scope.modify
+ * list. Sub-6 may promote them once another TU needs them. Each #define
+ * cites its AVM reg/cbm.h source line.
+ */
+#define CBM_SBA_0  0x200  /* AVM cqm/grx500/reg/cbm.h:2545 — Std Buf Addr 0 (physical) */
+#define CBM_SBA_1  0x204  /* AVM cqm/grx500/reg/cbm.h:2563 — Std Buf Addr 1 (IOCU alias) */
+#define CBM_JBA_0  0x208  /* AVM cqm/grx500/reg/cbm.h:2581 — Jumbo Buf Addr 0 (physical) */
+#define CBM_JBA_1  0x20C  /* AVM cqm/grx500/reg/cbm.h:2599 — Jumbo Buf Addr 1 (IOCU alias) */
+
+/*
+ * IG-120 (dma_rx_channels): local mirrors for the EQM RX-admit channel open.
+ *   CBM_PORT_F_STANDARD_BUF — AVM lantiq_cbm_api.h:114 (= cbm_dma.c:74 mirror,
+ *     file-static there, so re-defined here for the cbm_eqm_rx_chan_open call).
+ *   CBM_DMADESC_PHYS_BASE — the DT "dma_desc" window (reg idx 11, phys
+ *     0x1e500000); file-static in hdma.c:2451, re-defined here so the EQM
+ *     descriptor window phys can be passed to ltq_dma_chan_desc_cfg. Value is
+ *     DT-anchored (same window setup_eqm_dma_desc writes via g_cbm_dma_desc).
+ */
+#define CBM_PORT_F_STANDARD_BUF  0x1U        /* AVM lantiq_cbm_api.h:114 */
+#define CBM_PORT_F_JUMBO_BUF     0x2U        /* IG-146: AVM lantiq_cbm_api.h:117 */
+#define CBM_DMADESC_PHYS_BASE    0x1e500000U /* DT cbm dma_desc window (reg idx 11) */
+
+/*
+ * ST-004 extern declarations.
+ *
+ * cbm_set_val — body in cbm_basic.c (ST-004 add). Declared extern here
+ *   (instead of in cbm.h) because cbm.h is OUTSIDE ST-004's
+ *   file_scope.modify and cbm.c is its only caller in the composite.
+ *
+ * cbm_buf_init_pools / cbm_buf_pool_phys_base — bodies in cbm_buf.c
+ *   (Sub-6 ST-002 carve allocator add). Declared extern here for the
+ *   same cbm.h-out-of-scope reason as cbm_set_val. cbm_xrx500_probe is
+ *   the sole init_pools caller; init_cbm_basic + cbm_hw_init are the
+ *   two phys_base readers (replacing the Sub-4 placeholder
+ *   virt_to_phys(g_cbm_buff.std_buf_addr) pattern that does not work
+ *   for memremap()'d no-map reserved-memory pointers).
+ *
+ * cbm_isr_0/4/5/6/7 — handler bodies arrive in ST-005 (cbm_intr.c).
+ *   Forward declared here so cbm_interrupt_init can take their addresses
+ *   for devm_request_irq. The 0/4/5/6/7 naming maps to the 5 DT
+ *   interrupts at GIC lines 174/178/179/180/181 (line indices within the
+ *   CBM IRN aggregator), per ST-005 AC-005-1. ST-004 originally named
+ *   them cbm_isr_0..4 sequentially; the ST-005 rename propagates here
+ *   mechanically (scope_deviation justified in ST-005's build-manifest:
+ *   "rename forced by AC-005-1 — cbm.c update is mechanical").
+ */
+extern void cbm_set_val(void __iomem *addr, u32 val, u32 mask, u32 shift);
+extern int cbm_buf_init_pools(struct device *dev);
+extern phys_addr_t cbm_buf_pool_phys_base(int which);
+
+/*
+ * Pool index constants — mirror cbm_buf.c's CBM_POOL_STD / CBM_POOL_JBO.
+ * Kept local because cbm.h is outside file_scope.modify and these two
+ * call sites are the only readers from cbm.c.
+ */
+#define CBM_POOL_STD  0
+#define CBM_POOL_JBO  1
+
+irqreturn_t cbm_isr_0(int irq, void *dev_id);
+irqreturn_t cbm_isr_4(int irq, void *dev_id);
+irqreturn_t cbm_isr_5(int irq, void *dev_id);
+irqreturn_t cbm_isr_6(int irq, void *dev_id);
+irqreturn_t cbm_isr_7(int irq, void *dev_id);
+
+/*
+ * Sub-6 ST-002 — the Sub-4 IG-012 placeholder pool-size constants were
+ * deleted here when the carve allocator landed. g_cbm_buff is populated
+ * exclusively via cbm_buf_init_pools() now; the per-pool frame sizes
+ * (2048 std / 8192 jbo) live as DEFAULT_STD_FRM_SIZE / DEFAULT_JBO_FRM_SIZE
+ * inside cbm_buf.c and are mirrored into g_cbm_buff at probe time.
+ */
+
+/*
+ * MMIO base pointers — populated by cbm_xrx500_probe from the 12 reg
+ * tuples in the DT node. ST-001 left these zero-initialised so an
+ * accidental dereference before probe yields a deterministic KASAN
+ * trap (clearer than a stale-pointer corruption).
+ */
+void __iomem *g_cbm_tmu_base;
+void __iomem *g_cbm_base;
+void __iomem *g_cbm_qidt_base;
+void __iomem *g_cbm_sbim_base;
+void __iomem *g_cbm_qeqcnt_base;
+void __iomem *g_cbm_qdqcnt_base;
+void __iomem *g_cbm_ls_base;
+void __iomem *g_cbm_eqm_base;
+void __iomem *g_cbm_dqm_base;
+void __iomem *g_cbm_fsqm_base[2];
+void __iomem *g_cbm_dma_desc_base;
+
+EXPORT_SYMBOL_GPL(g_cbm_tmu_base);
+EXPORT_SYMBOL_GPL(g_cbm_base);
+EXPORT_SYMBOL_GPL(g_cbm_qidt_base);
+EXPORT_SYMBOL_GPL(g_cbm_sbim_base);
+EXPORT_SYMBOL_GPL(g_cbm_qeqcnt_base);
+EXPORT_SYMBOL_GPL(g_cbm_qdqcnt_base);
+EXPORT_SYMBOL_GPL(g_cbm_ls_base);
+EXPORT_SYMBOL_GPL(g_cbm_eqm_base);
+EXPORT_SYMBOL_GPL(g_cbm_dqm_base);
+EXPORT_SYMBOL_GPL(g_cbm_fsqm_base);
+EXPORT_SYMBOL_GPL(g_cbm_dma_desc_base);
+
+/*
+ * Probe re-entry guard.
+ *
+ * The kernel driver-model contract should never double-probe a single
+ * platform_device, but AVM's source pattern uses a global g_cbm_ctrl
+ * which would silently corrupt if a second probe landed (e.g. due to a
+ * DT-overlay race). atomic_inc_return + dev_warn makes the failure
+ * mode loud and observable. AC-002-4 verifies this guard.
+ */
+static atomic_t cbm_probe_count = ATOMIC_INIT(0);
+
+/*
+ * Cached cookies for ST-004 + ST-005 consumers.
+ *
+ *   cbm_pdev_cache - so ST-004's cbm_intr_mapping_init can re-query
+ *                    platform_get_irq via the same pdev without
+ *                    changing init_cbm_basic's signature.
+ *   cbm_irqs       - 5 IRQ numbers collected in probe-step (c) for
+ *                    ST-005's request_irq array indexing.
+ *   cbm_clk        - kept for cbm_xrx500_remove's clk_disable_unprepare
+ *                    (devm only undoes the get, not the enable).
+ */
+static struct platform_device *cbm_pdev_cache;
+static int cbm_irqs[5];
+static struct clk *cbm_clk;
+
+/*
+ * Per-window ioremap lookup table — review_focus item:
+ *   "the ioremap loop iterates idx=0..11 — verify it uses a const struct
+ *    lookup table rather than 12 copy-pasted blocks (kernel C idiom)".
+ *
+ * Slot order MUST match the DT reg-names order EXACTLY (tmu first,
+ * dma_desc last); a mismatch would silently route every subsequent
+ * MMIO write to the wrong window. See AC-002-2 + review_focus item
+ * "Verify the 12-resource ioremap order ... matches the DT reg property
+ * order EXACTLY".
+ */
+struct cbm_ioremap_slot {
+	const char *name;
+	void __iomem **store;
+};
+
+static const struct cbm_ioremap_slot cbm_ioremap_table[] = {
+	{ "tmu",      &g_cbm_tmu_base },      /* idx 0 - TMU       */
+	{ "cbm",      &g_cbm_base },          /* idx 1 - CBM       */
+	{ "qidt",     &g_cbm_qidt_base },     /* idx 2 - QIDT      */
+	{ "sbim",     &g_cbm_sbim_base },     /* idx 3 - SBIM      */
+	{ "qeqcnt",   &g_cbm_qeqcnt_base },   /* idx 4 - QEQCNTR   */
+	{ "qdqcnt",   &g_cbm_qdqcnt_base },   /* idx 5 - QDQCNTR   */
+	{ "ls",       &g_cbm_ls_base },       /* idx 6 - LS        */
+	{ "eqm",      &g_cbm_eqm_base },      /* idx 7 - CBM EQM   */
+	{ "dqm",      &g_cbm_dqm_base },      /* idx 8 - CBM DQM   */
+	{ "fsqm0",    &g_cbm_fsqm_base[0] },  /* idx 9 - FSQM0     */
+	{ "fsqm1",    &g_cbm_fsqm_base[1] },  /* idx 10 - FSQM1    */
+	{ "dma_desc", &g_cbm_dma_desc_base }, /* idx 11 - CBM DMA  */
+};
+
+/*
+ * cbm_hw_init - ST-002 top-level orchestration.
+ *
+ * AVM cbm.c:2152-2156 reference ordering:
+ *   init_fsqm();        // both FSQM instances inside
+ *   init_cbm_basic();   // chains into cbm_intr_mapping_init +
+ *                       // cbm_interrupt_init per AVM cbm.c:1253-1254
+ *   LOGF_KLOG_INFO("CBM HW init\n");
+ *
+ * Sub-4 splits the AVM init_fsqm() call into per-instance
+ * init_fsqm(idx) so ST-003 owns instance-specific bring-up. The
+ * pr_info markers below match the stock firmware's format verbatim
+ * (substrings "post-init FSQM0 OFSC=0x", "post-init SBA_0=0x",
+ * "JBA_0=0x", "CBM_CTRL=0x") so the hardware tester's grep against
+ * r-corpus/2026-05-15-option-b-init-sequence-map.md still finds the
+ * lines.
+ *
+ * Sub-6 ST-002 — the "PLACEHOLDER " conditional prefix was dropped
+ * because g_cbm_buff.placeholder is now always false (Sub-4's
+ * __get_free_pages divergence is gone). The physical-address columns
+ * come from cbm_buf_pool_phys_base() rather than virt_to_phys() because
+ * the reserved-memory pools carry `no-map` — the kernel does not
+ * establish a linear mapping for them and virt_to_phys against the
+ * memremap result would be undefined.
+ *
+ * Returns 0 on success, propagating any failure from init_cbm_basic.
+ */
+/*
+ * IG-068: AVM DMA1TX<->DMA2RX peripheral-to-peripheral (P2P) bridge.
+ *
+ * Faithful port of AVM cqm/grx500/cbm.c setup_DMA_p2p (:4918) +
+ * turn_on_DMA_p2p (:4996) — the one un-ported AVM probe-time datapath step.
+ * setup_DMA_p2p() runs at the end of cbm_hw_init() (matching AVM's order:
+ * configure_ports -> ... but invoked here right after the EQM CPU-port arm,
+ * before cbm_hw_init returns / before the controllers are enabled).
+ * turn_on_DMA_p2p() runs from ndo_open (intel_xrx500.c) and is a no-op until
+ * setup ran (cbm_p2p_setup_done) and idempotent after the first call
+ * (cbm_p2p_turned_on).
+ *
+ * Deviation from AVM-verbatim:
+ *   - LOGF_KLOG_ERROR/INFO -> pr_err/pr_info (our tree has no LOGF macros).
+ *   - The RX channel's CDBA/CDLEN program + desc_configured=true (which AVM's
+ *     ltq_dma_chan_desc_alloc does internally) is performed inside our ported
+ *     ltq_dma_p2p_cfg()->dma_p2p_cfg() (hdma.c, AS-013 bridge), so this file
+ *     stays 1:1 with AVM. No ltq_dma_chan_desc_cfg call is needed here.
+ *   - IG-123: SINGLE_RX_CH0_ONLY is DEFINED =1 (AVM include/net/lantiq_cbm_api.h:72,
+ *     the real AVM default build — the earlier "left undefined" claim here was
+ *     FALSE). It is defined in dma/lantiq_dmax.h (included above), so ONLY the
+ *     CLASS0 pair (DMA1TX ch0 <-> DMA2RX ch0) is brought up; the CLASS1/2/3
+ *     pairs are #if-compiled out, exactly matching the working oracle.
+ */
+static u32 cbm_p2p_setup_done;
+static u32 cbm_p2p_turned_on;
+
+static void setup_DMA_p2p(void)
+{
+	/*do only p2p here.commented out other dma channel setup*/
+	int chan1 = DMA1TX_LAN_SWITCH_CLASS0;
+	int chan2 = DMA2RX_GSWIP_R_CLASS0;
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+	int chan1_1 = DMA1TX_LAN_SWITCH_CLASS1;
+	int chan2_1 = DMA2RX_GSWIP_R_CLASS1;
+	int chan1_2 = DMA1TX_LAN_SWITCH_CLASS2;
+	int chan2_2 = DMA2RX_GSWIP_R_CLASS2;
+	int chan1_3 = DMA1TX_LAN_SWITCH_CLASS3;
+	int chan2_3 = DMA2RX_GSWIP_R_CLASS3;
+#endif
+
+	if ((ltq_request_dma(chan1, "dma1 tx lan")) < 0)
+		pr_err(" %s failed to open chan for chan1\r\n", __func__);
+
+	if ((ltq_request_dma(chan2, "dma2 rx gswpr")) < 0)
+		pr_err(" %s failed to open chan for chan2\r\n", __func__);
+
+	/* rx decriptor setup */
+	if (ltq_dma_chan_desc_alloc(chan2, 32) == 0)
+		ltq_dma_chan_data_buf_alloc(chan2);
+
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+	if ((ltq_request_dma(chan1_1, "dma1 tx lan")) < 0)
+		pr_err(" %s failed to open chan for chan1_1\r\n", __func__);
+
+	if ((ltq_request_dma(chan2_1, "dma2 rx gswpr")) < 0)
+		pr_err(" %s failed to open chan for chan2_1\r\n", __func__);
+
+	/* rx decriptor setup */
+	if (ltq_dma_chan_desc_alloc(chan2_1, 32) == 0)
+		ltq_dma_chan_data_buf_alloc(chan2_1);
+
+	if ((ltq_request_dma(chan1_2, "dma1 tx lan")) < 0)
+		pr_err(" %s failed to open chan for chan1_2\r\n", __func__);
+
+	if ((ltq_request_dma(chan2_2, "dma2 rx gswpr")) < 0)
+		pr_err(" %s failed to open chan for chan2_2\r\n", __func__);
+
+	/* rx decriptor setup */
+	if (ltq_dma_chan_desc_alloc(chan2_2, 32) == 0)
+		ltq_dma_chan_data_buf_alloc(chan2_2);
+
+	if ((ltq_request_dma(chan1_3, "dma1 tx lan")) < 0)
+		pr_err(" %s failed to open chan for chan1_3\r\n", __func__);
+
+	if ((ltq_request_dma(chan2_3, "dma2 rx gswpr")) < 0)
+		pr_err(" %s failed to open chan for chan2_3\r\n", __func__);
+
+	/* rx decriptor setup */
+	if (ltq_dma_chan_desc_alloc(chan2_3, 32) == 0)
+		ltq_dma_chan_data_buf_alloc(chan2_3);
+#endif
+
+	/* Any other configuration ???? */
+	ltq_dma_p2p_cfg(chan2, chan1);
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+	ltq_dma_p2p_cfg(chan2_3, chan1_3);
+	ltq_dma_p2p_cfg(chan2_1, chan1_1);
+	ltq_dma_p2p_cfg(chan2_2, chan1_2);
+#endif
+	ltq_dma_chan_irq_disable(chan2);
+	ltq_dma_chan_irq_disable(chan1);
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+	ltq_dma_chan_irq_disable(chan2_3);
+	ltq_dma_chan_irq_disable(chan1_3);
+	ltq_dma_chan_irq_disable(chan2_1);
+	ltq_dma_chan_irq_disable(chan1_1);
+	ltq_dma_chan_irq_disable(chan2_2);
+	ltq_dma_chan_irq_disable(chan1_2);
+#endif
+	cbm_p2p_setup_done = 1;
+	pr_info("%s executed\n", __func__);
+}
+
+int turn_on_DMA_p2p(void)
+{
+	int chan1 = DMA1TX_LAN_SWITCH_CLASS0;
+	int chan2 = DMA2RX_GSWIP_R_CLASS0;
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+	int chan1_1 = DMA1TX_LAN_SWITCH_CLASS1;
+	int chan2_1 = DMA2RX_GSWIP_R_CLASS1;
+	int chan1_2 = DMA1TX_LAN_SWITCH_CLASS2;
+	int chan2_2 = DMA2RX_GSWIP_R_CLASS2;
+	int chan1_3 = DMA1TX_LAN_SWITCH_CLASS3;
+	int chan2_3 = DMA2RX_GSWIP_R_CLASS3;
+#endif
+
+	if (!cbm_p2p_setup_done || cbm_p2p_turned_on)
+		return -EPERM;
+
+	if (!cbm_p2p_turned_on) {
+		ltq_dma_chan_on(chan1);
+		ltq_dma_chan_on(chan2);
+#if !defined(SINGLE_RX_CH0_ONLY) || !SINGLE_RX_CH0_ONLY
+		ltq_dma_chan_on(chan1_1);
+		ltq_dma_chan_on(chan2_1);
+
+		ltq_dma_chan_on(chan1_2);
+		ltq_dma_chan_on(chan2_2);
+
+		ltq_dma_chan_on(chan1_3);
+		ltq_dma_chan_on(chan2_3);
+#endif
+		cbm_p2p_turned_on = 1;
+	}
+	return 0;
+}
+
+/*
+ * IG-120 (dma_rx_channels): open ONE EQM-port DMA2RX ingress channel — the
+ * GSWIP-R -> CBM RX-admit mover. Faithful port of the EQM branch of AVM
+ * setup_DMA_channel (cbm.c:4416-4457): ltq_request_dma -> ltq_dma_chan_desc_cfg
+ * (pointing at the EQM descriptor window already seeded by the M2SEED
+ * dma_port_enable loop) -> ltq_dma_chan_irq_disable -> ltq_dma_chan_on. The
+ * descriptor window phys is CBM_DMADESC_PHYS_BASE + CBM_EQM_DMA_DESC(pid,0,
+ * buf_type>>1); on this SoC the DT dma_desc window is already a raw phys, so no
+ * RPHYSADDR/kseg strip is needed (cf. the DQM TX path at hdma.c:2454). This
+ * does NOT reuse setup_DMA_p2p (which grabs DMA1TX ch0 = eth0 TX -> IG-072
+ * EBUSY): DMA2RX (cid=4) is a separate controller, disjoint from DMA2TX (cid=3)
+ * ch5. STD path only for the first-smoke subset; jumbo deferred (no HRM).
+ */
+static int cbm_eqm_rx_chan_open(int chan, int cbm_port, u32 buf_type)
+{
+	dma_addr_t desc;
+	int ret;
+
+	ret = ltq_request_dma((u32)chan, "dma2 rx eqm");
+	if (ret < 0) {
+		pr_err("cbm: IG-120 EQM RX ltq_request_dma(chan=%d) = %d\n",
+		       chan, ret);
+		return ret;
+	}
+
+	desc = (dma_addr_t)(CBM_DMADESC_PHYS_BASE +
+			    CBM_EQM_DMA_DESC(cbm_port, 0, (buf_type >> 1)));
+	ret = ltq_dma_chan_desc_cfg((u32)chan, desc, 2);
+	if (ret < 0) {
+		pr_err("cbm: IG-120 EQM RX desc_cfg(chan=%d) = %d\n", chan, ret);
+		return ret;
+	}
+
+	ltq_dma_chan_irq_disable((u32)chan);
+
+	ret = ltq_dma_chan_on((u32)chan);
+	if (ret < 0) {
+		pr_err("cbm: IG-120 EQM RX chan_on(chan=%d) = %d\n", chan, ret);
+		return ret;
+	}
+
+	pr_info("cbm: EQM RX chan %d opened (cbm_port %d, %s)\n",
+		chan, cbm_port,
+		(buf_type & CBM_PORT_F_STANDARD_BUF) ? "std" : "jumbo");
+	return 0;
+}
+
+int cbm_hw_init(struct platform_device *pdev)
+{
+	int ret;
+
+	/*
+	 * CHIPTOP/RCU parity with the AVM 4.9 boot state, applied BEFORE any
+	 * CBM/GSW reset or init runs (IG-181k/IG-195b/IG-195c):
+	 *
+	 *   RCU_IPT_ENDIAN (chiptop +0x4C) <- 0x0000c221 — the per-initiator
+	 *     NGI endian mask the working 4.9 system runs with (ours inherited
+	 *     0x0000c001 from EVA, bits 5/9 clear). Endian straps are sampled
+	 *     at block reset, so the value must be held across the whole
+	 *     datapath bring-up.
+	 *   IFMUX_CFG (chiptop +0x120) &= ~(BIT(22)|BIT(18)) — clear EVA's
+	 *     stray PCIE_RCLK mux bit; the working system's boot end-state is
+	 *     0x00000000 (4.9 chiptop_default_setup parity).
+	 *   RCU_IAP_WDT_RST_EN (rcu +0x50) <- 0x0000000F — the 4.9
+	 *     grx500_wdt.c:384 full-word write (VPE watchdog-reset enable),
+	 *     live on the working system.
+	 */
+	{
+		void __iomem *ct = ioremap(0x16080000, 0x200);
+		void __iomem *rcu = ioremap(0x16000000, 0x100);
+
+		if (ct) {
+			u32 pre;
+
+			__raw_writel(0x0000c221, ct + 0x4C);
+			pre = __raw_readl(ct + 0x120);
+			__raw_writel(pre & ~(BIT(22) | BIT(18)), ct + 0x120);
+			iounmap(ct);
+		}
+		if (rcu) {
+			__raw_writel(0x0000000F, rcu + 0x50);
+			iounmap(rcu);
+		}
+		pr_info("cbm: chiptop/RCU parity applied (ipt_endian, ifmux, wdt_rst_en)\n");
+	}
+
+	(void)pdev;  /* pdev cached in cbm_pdev_cache for ST-004's chain */
+
+	/* (a) (b) Two FSQM instances (per-instance bring-up — ST-003). */
+	init_fsqm(0);
+	init_fsqm(1);
+
+	/* (c) init_cbm_basic (ST-004 body chains into cbm_intr_mapping_init
+	 * + cbm_interrupt_init per AVM cbm.c:1253-1254).
+	 */
+	ret = init_cbm_basic();
+	if (ret) {
+		pr_err("cbm: init_cbm_basic failed: %d\n", ret);
+		return ret;
+	}
+
+	/* (d) v108sl post-init markers. The "cbm: " prefix is required so
+	 * the hardware tester's `dmesg | grep '^cbm:'` finds these lines.
+	 * Substring contracts (verified by AC-002-6):
+	 *   "post-init FSQM0 OFSC=0x"
+	 *   "post-init FSQM1 OFSC=0x"
+	 *   "post-init SBA_0=0x"
+	 *   "JBA_0=0x"
+	 *   "CBM_CTRL=0x"
+	 */
+	pr_info("cbm: post-init FSQM0 OFSC=0x%08x OFSQ=0x%08x\n",
+		fsqm_r32(0, OFSC),
+		fsqm_r32(0, OFSQ));
+	pr_info("cbm: post-init FSQM1 OFSC=0x%08x OFSQ=0x%08x\n",
+		fsqm_r32(1, OFSC),
+		fsqm_r32(1, OFSQ));
+	pr_info("cbm: post-init SBA_0=0x%08x JBA_0=0x%08x CBM_CTRL=0x%08x\n",
+		(u32)cbm_buf_pool_phys_base(CBM_POOL_STD),
+		(u32)cbm_buf_pool_phys_base(CBM_POOL_JBO),
+		xrx500_cbm_r32(CBM_CTRL));
+
+	/*
+	 * IG-042: arm the CBM EQM CPU ingress ports (pid 0..3) — the port-config
+	 * step, which AVM does (configure_ports -> init_cbm_eqm_cpu_port) BEFORE
+	 * enabling the controllers. IG-058: the EQM/DQM global-controller ENABLE
+	 * (+ the IG-057 enqueue-delay) is no longer done here — it moved to
+	 * cbm_enable_controllers(), which probe calls AFTER the CPU-TX DQM egress
+	 * port + TMU egress path are configured, to match AVM's order
+	 * (configure_ports -> CBM_DQM_CTRL/CBM_EQM_CTRL=0x11 -> queue_delay,
+	 * cbm.c:5605/5614/5621/5657). Previously we enabled the dequeue engine
+	 * here at probe but bound the deq10 egress port only at ndo_open (AFTER
+	 * enable); a DQM enabled before its per-port EPMAP binding can rebuild
+	 * the egress descriptor from a stale/zero PPT body-length (the data_len=0
+	 * / IG-054..057 symptom).
+	 *
+	 * IG-120 ORDER FIX: this CPU-port arming MUST run BEFORE the IG-038
+	 * M2SEED dma_port_enable loop below. IG-120 made setup_eqm_dma_desc pop
+	 * a GENUINE FSQM segment via cbm_fsqm_buf_alloc -> CBM_EQM_CPU_PORT(pid,
+	 * new_sptr); that BUFREQ pop is only serviced once the CPU port's cfg
+	 * BUFREQS bit is set, and BUFREQS is written ONLY here (cfg=0xFC7).
+	 * init_fsqm seeds the LLT free-list but writes NO CPU-port cfg, so with
+	 * the arming after the seed the pop returned the 0xFFFFF800 empty marker
+	 * and setup_eqm_dma_desc bailed -ENOMEM having written zero descriptors
+	 * (regressing the IG-038 SDMA_PSTAT0[p5] seed). AVM's config table
+	 * (cbm_config.c) lists all EQM_CPU_TYPE entries (tmu_port 0..3) strictly
+	 * BEFORE the EQM_DMA_TYPE entries, and configure_ports walks them in
+	 * order, so init_cbm_eqm_cpu_port always precedes the first BUFREQ pop.
+	 */
+	{
+		int p;
+
+		for (p = 0; p < 4; p++)
+			init_cbm_eqm_cpu_port(p);
+	}
+
+	/*
+	 * IG-038 (M2 datapath gate, probe): seed the CBM EQM DMA descriptor
+	 * ports 5..8 at probe, matching AVM's unconditional configure_ports ->
+	 * conf_eqm_dma_port -> dma_port_enable(5..8) at cbm_hw_init time
+	 * (corpus facts.md:484-507). g_cbm_buff (std pool) is populated by
+	 * cbm_buf_init_pools() in probe step (e/f), before this call — so the
+	 * descriptor buffers are valid.
+	 *
+	 * IG-146 (corrected IG-186): seed the STANDARD descriptor set for all
+	 * four EQM DMA ports (idx 0..3 -> pid 5..8), then the JUMBO set for
+	 * ALL FOUR as well: AVM cbm_config.c:262-270 / :280-288 give pid5/pid6
+	 * explicit jumbo rows (DMA2RX ch30/31 post-A21-remap) and
+	 * conf_eqm_dma_port fires dma_port_enable(JUMBO) for all four pids
+	 * (AVM cbm.c:5289), so AVM seeds 0x1e500800/0x1e501800 too.
+	 */
+	{
+		int p;
+
+		for (p = 0; p < 4; p++)
+			init_cbm_eqm_dma_port(p, CBM_PORT_F_STANDARD_BUF);
+		for (p = 0; p < 4; p++)
+			init_cbm_eqm_dma_port(p, CBM_PORT_F_JUMBO_BUF);
+		pr_info("cbm: EQM DMA ports 5-8 seeded (std + jumbo)\n");
+	}
+
+	/*
+	 * IG-192 (RX): arm EQM DMA IGP9 (TOE) + IGP15 (VRX318/LDMA). AVM's
+	 * boot-time configure_ports table (cbm_config.c) contains EQM_TOE
+	 * (tmu_port 9 -> conf_eqm_toe_port -> init_cbm_eqm_dma_toe_port,
+	 * cbm.c:1344-1351/5325-5335) and EQM_VRX318 (tmu_port 15 ->
+	 * conf_eqm_vrx318_port -> init_cbm_eqm_ldma_port, :1353-1374/
+	 * 5337-5349) entries UNCONDITIONALLY — no TOE/DSL driver gate. Our
+	 * port armed only IGP5-8, leaving IGP9/15 cfg=0 (silicon-confirmed,
+	 * IG-189b) where the live oracle holds cfg=0x701/0x1B01 + seeded
+	 * descriptors (IG-191 dp/mem ground truth). These two ports sit on
+	 * the same EQM DMA-ingress staging arbiter that must present IGP7's
+	 * descriptor for the PMAC0->DMA1RX P2D handshake — the exact stage
+	 * the RX gate lives at (IG-190 RANK 1).
+	 *
+	 * init_cbm_eqm_dma_port(4) == AVM init_cbm_eqm_dma_toe_port (idx 4 ->
+	 * pid 9): identical three-write body (cfg=0x701, pocc=0, 2 std seeds
+	 * at DMADESC+0x4000 = 0x1e504000 — oracle shows exactly those two
+	 * OWN=1 std descriptors and an all-zero jumbo window at +0x800).
+	 */
+	{
+		int sret = init_cbm_eqm_dma_port(4, CBM_PORT_F_STANDARD_BUF);
+
+		if (sret)
+			pr_err("cbm: init IGP9/TOE port failed: %d\n", sret);
+		sret = init_cbm_eqm_ldma_port();
+		if (sret)
+			pr_err("cbm: init_cbm_eqm_ldma_port failed: %d\n",
+			       sret);
+	}
+
+	/*
+	 * IG-068: bring up the AVM DMA1TX<->DMA2RX peripheral-to-peripheral
+	 * bridge. AVM invokes setup_DMA_p2p() from xrx500_cbm_probe right after
+	 * cbm_hw_init (cbm.c:5604), before configure_ports / controller enable.
+	 *
+	 * IG-072 DISABLED it (historical): setup_DMA_p2p() requests
+	 * DMA1TX_LAN_SWITCH_CLASS0 (dma1tx chan 0) at probe, which collided with
+	 * the vestigial per-LAN eth0 ndo_open step-4 TX claim of the same channel
+	 * (-EBUSY, ndo_open rolled back). That premise was based on IG-071's
+	 * conclusion that the p2p bridge was off the CPU-TX gate — which is TRUE
+	 * for TX, but the bridge is the ACTUAL host-RX DMA mover and our RX
+	 * delivers nothing without it (oracle-confirmed: working 4.9 ndo_open logs
+	 * "p2p channel already ON !" + a dummy dp_rx_enable).
+	 *
+	 * IG-123 RE-ENABLED: with SINGLE_RX_CH0_ONLY=1 the bridge needs ONLY
+	 * DMA1TX ch0, and IG-123 frees that channel by removing the vestigial
+	 * per-LAN DMA1TX TX claim in intel_xrx500_open_step4_tx (the eth0..3 xmit
+	 * path rides DMA2TX ch5 via cbm_cpu_enqueue_hw, never port->tx_chan). So
+	 * the collision is gone and setup_DMA_p2p() requests/p2p-pairs the ch0 pair
+	 * (DMA1TX ch0 <-> DMA2RX ch0); turn_on_DMA_p2p() (wired into ndo_open,
+	 * intel_xrx500.c) then ltq_dma_chan_on's it and host RX flows.
+	 */
+	if (!cbm_p2p_setup_done)
+		setup_DMA_p2p();
+
+	return 0;
+}
+
+/*
+ * IG-058: set true once probe has pre-configured a LAN port's DQM-DMA egress
+ * port + TMU flat egress path (BEFORE the controllers are enabled), so
+ * cbm_dp_enable (run later at ndo_open, after enable) skips rebuilding it and
+ * only programs the QIDT — preserving AVM's configure-before-enable order.
+ * Indexed by dp_port_id (2..5). Read by cbm_dp.c.
+ */
+bool g_cbm_egress_preconfig[6];
+
+/*
+ * IG-068: open the CBM-managed DMA2TX egress channel at probe-end (AVM order).
+ * Defined in dma/hdma.c; resolves intra-composite (intel-xrx500-gswip), like
+ * init_cbm_dqm_dma_port which hdma.c externs in the reverse direction.
+ */
+extern int hdma_port_enable(int port_id);
+extern int hdma_ig192_toe_dma3_reset(void); /* IG-192: TOE/DMA3 reset parity */
+
+/*
+ * IG-068 (Rank 3): CBM Load Spreader init — faithful port of AVM
+ * init_cbm_ls / init_cbm_ls_port / cbm_ls_spread_alg_set /
+ * cbm_ls_port_weight_set (cqm_common.c:84-172). AVM runs this unconditionally
+ * at probe, between DQM_CTRL=0x11 and EQM_CTRL=0x11 (cbm.c:5620). The LS block
+ * distributes CPU-bound dequeues; it is part of the complete CBM bring-up our
+ * hand-rolled probe omitted. LS register window = g_cbm_ls_base (ioremap idx 6).
+ * Offsets/values from AVM reg/cbm_ls.h + cqm_common.h: LS_GLBL_CTRL=0x900(EN
+ * bit0), LS_SPR_CTRL=0x904(SPR_SEL bit0=WRR, WP[n] 2 bits @ 16+2n), IRNEN_LS=
+ * 0x918, per-port ctrl @ n*0x100+0x10 = QTHH(7)<<8 | OVFL(0x2000)<<16 | enable
+ * nibble (0xF active / 0xD inactive). __raw_writel matches the CBM BE-MMIO
+ * convention (cf. cbm_eqm_w32, IG-059).
+ */
+#define CBM_LS_GLBL_CTRL    0x900u
+#define CBM_LS_SPR_CTRL     0x904u
+#define CBM_LS_IRNEN        0x918u
+#define CBM_LS_PORT_CTRL(i) ((u32)(i) * 0x100u + 0x10u)
+#define CBM_LS_PORT_NUM     4
+#define CBM_LS_PORT_ACTIVE   0x2000070Fu  /* 0xF | (7<<8) | (0x2000<<16) */
+#define CBM_LS_PORT_INACTIVE 0x2000070Du  /* 0xD | (7<<8) | (0x2000<<16) */
+
+static void cbm_init_load_spreader(void)
+{
+	u32 spr = 0;          /* SPR_SEL = SPREAD_WRR(0) in bit0 */
+	int i;
+
+	if (!g_cbm_ls_base) {
+		pr_warn("cbm: IG-068 LS base not mapped; skipping load-spreader init\n");
+		return;
+	}
+
+	/* Per-port control: only port 0 active on this nosmp / no
+	 * CONFIG_CBM_LS_ENABLE build (AVM init_cbm_ls_port: active iff idx==0). */
+	for (i = 0; i < CBM_LS_PORT_NUM; i++)
+		__raw_writel((i == 0) ? CBM_LS_PORT_ACTIVE : CBM_LS_PORT_INACTIVE,
+			     g_cbm_ls_base + CBM_LS_PORT_CTRL(i));
+
+	/* Spread alg = WRR, per-port weight 2 (WP[n] = bits [17+2n:16+2n]). */
+	for (i = 0; i < CBM_LS_PORT_NUM; i++)
+		spr |= (2u & 0x3u) << (16 + 2 * i);
+	__raw_writel(spr, g_cbm_ls_base + CBM_LS_SPR_CTRL);
+
+	__raw_writel(0xFF0000u, g_cbm_ls_base + CBM_LS_IRNEN);
+	__raw_writel(0x1u, g_cbm_ls_base + CBM_LS_GLBL_CTRL);   /* EN */
+	wmb();
+	pr_info("cbm: IG-068 load spreader init (SPR_CTRL=0x%08x GLBL=0x%08x)\n",
+		__raw_readl(g_cbm_ls_base + CBM_LS_SPR_CTRL),
+		__raw_readl(g_cbm_ls_base + CBM_LS_GLBL_CTRL));
+}
+
+/*
+ * IG-120/IG-127 (qidt_ep0_q35): program the CPU-ingress QIDT so every ep=0
+ * (PMAC0) ingress lookup resolves to CPU queue @qid_val (35). Reproduces the
+ * register effect of AVM queue_map_set(0, 35, {ep=0, flowid=0}, q_mask) for the
+ * DP_F_DEQ_CPU CPU port -> the cbm_qidt_set state-machine sweep (cbm.c:1479-
+ * 1663) -> cbm_qid_reg_set (cbm.c:1454-1476).
+ *
+ * IG-127 fix: our build is the !CONFIG_CBM_LS_ENABLE tasklet path (cbm_intr.c
+ * do_cbm_tasklet; no CBM_LS_ENABLE in .config), NOT the LS-active DP_F_DEQ_CPU1
+ * branch the original IG-120 comment cited. For that build AVM sets
+ * q_mask |= CBM_QUEUE_MAP_F_FLOWID_L_DONTCARE (cbm.c:5198-5199), so cbm_qidt_set
+ * SWEEPS flowid_low 0..1 (cbm.c:1621-1656), packing flowidl<<12 (& 0x1000;
+ * cbm.c:1454) so qid lands in BOTH flowidl quadrants (512 byte-slots). flowidh
+ * stays fixed 0 (flowid=0, flowid_hmask unset) and ep=0. The earlier code wrote
+ * only flowidl=0 (256 slots), leaving the flowidl=1 half at reset -- a host-RX
+ * CPU descriptor carrying flowidl=1 then resolved to a stale queue and never
+ * reached q35 -> DQM CPU port2 -> tasklet (zero 'IG-121 rx'). Max idx with
+ * flowidl=1 is 0x7FF (byte off 0x1FFC) -- within the 0x4000 qidt window.
+ * Strictly additive: the flowidl=0 slots are written exactly as before.
+ *
+ * IG-159 (B1): linkage promoted from static — the faithful conf_dqm_cpu_port
+ * walk (cbm_ports.c) invokes this as the DP_F_DEQ_CPU queue_map_set
+ * equivalent (spec S2.6). Prototype in cbm.h.
+ */
+void cbm_program_cpu_qidt(u8 qid_val)
+{
+	unsigned int fl, cls, mpe1, mpe2, enc, dec;
+
+	if (!g_cbm_qidt_base) {
+		pr_err("cbm: cpu_qidt: g_cbm_qidt_base not mapped\n");
+		return;
+	}
+
+	for (fl = 0; fl < 2; fl++)     /* IG-127: flowid_low dont-care sweep 0..1 */
+	    for (cls = 0; cls < 16; cls++)
+		for (mpe1 = 0; mpe1 < 2; mpe1++)
+			for (mpe2 = 0; mpe2 < 2; mpe2++)
+				for (enc = 0; enc < 2; enc++)
+					for (dec = 0; dec < 2; dec++) {
+						u32 qidt = ((fl << 12) & 0x1000U) |
+							   ((dec << 11) & 0x800U) |
+							   ((enc << 10) & 0x400U) |
+							   ((mpe2 << 9) & 0x200U) |
+							   ((mpe1 << 8) & 0x100U) |
+							   (cls & 0xFU); /* ep=0, flowidh=0 */
+						u32 idx = qidt >> 2;
+						u32 off = (qidt % 4) << 3;
+						u32 mask = 0xFFU << off;
+						u32 v;
+
+						v = __raw_readl(g_cbm_qidt_base + idx * 4);
+						v = (v & ~mask) |
+						    (((u32)qid_val & 0xFFU) << off);
+						__raw_writel(v, g_cbm_qidt_base + idx * 4);
+					}
+	wmb();
+	pr_info("cbm: IG-120/127 CPU ingress QIDT ep0->q%u programmed (512 slots, flowidl 0..1)\n",
+		qid_val);
+}
+
+/*
+ * IG-151 — program the FULL QIDT cube for one pinned ep -> @qid_val.
+ *
+ * WHY: the IG-150 hardware capture + the authoritative BE descriptor
+ * struct (AVM include/net/datapath_api_gswip30.h:159-177, dma_rx_desc_1:
+ * ep = DW1[11:8]) prove the delivered host-RX descriptor carries ep=7,
+ * NOT ep=0 as the earlier [23:20] mis-decode said. The HW QIDT key is
+ * therefore (ep<<4)|cls = 0x70 — OUTSIDE the ep=0 cube we program —
+ * so it resolves to the IG-149 drop-fill qid 255 (pre-IG-149: to
+ * uninitialized RAM). A QIDT-resolved drop rejects at the EQM admit
+ * stage with a DISC latch, no TMU contact, no PNA, no DICC — exactly
+ * the observed IG-140..150 signature.
+ *
+ * AVM PRECEDENT: at dp-port alloc AVM programs an ep-PINNED cube with
+ * every other dimension DONT-CARE to the port's queue (cbm.c:3345:
+ * qidt_set.ep = port_id; qidt_mask.ep_mask = 0; cbm_qidt_set(...,
+ * res[0].tmu_q) — mask default all-dontcare, cbm.c:4107). This
+ * function reproduces that register effect: 2(fh)*2(fl)*2(dec)*2(enc)*
+ * 2(mpe2)*2(mpe1)*16(cls) = 1024 slots with ep pinned.
+ */
+static void cbm_program_ep_qidt(u8 ep, u8 qid_val)
+{
+	unsigned int fh, fl, cls, mpe1, mpe2, enc, dec;
+
+	if (!g_cbm_qidt_base) {
+		pr_err("cbm: ep_qidt: g_cbm_qidt_base not mapped\n");
+		return;
+	}
+
+	for (fh = 0; fh < 2; fh++)
+	 for (fl = 0; fl < 2; fl++)
+	  for (cls = 0; cls < 16; cls++)
+	   for (mpe1 = 0; mpe1 < 2; mpe1++)
+	    for (mpe2 = 0; mpe2 < 2; mpe2++)
+	     for (enc = 0; enc < 2; enc++)
+	      for (dec = 0; dec < 2; dec++) {
+			u32 qidt = ((fh << 13) & 0x2000U) |
+				   ((fl << 12) & 0x1000U) |
+				   ((dec << 11) & 0x800U) |
+				   ((enc << 10) & 0x400U) |
+				   ((mpe2 << 9) & 0x200U) |
+				   ((mpe1 << 8) & 0x100U) |
+				   (((u32)ep << 4) & 0xF0U) |
+				   (cls & 0xFU);
+			u32 idx = qidt >> 2;
+			u32 off = (qidt % 4) << 3;
+			u32 mask = 0xFFU << off;
+			u32 v;
+
+			v = __raw_readl(g_cbm_qidt_base + idx * 4);
+			v = (v & ~mask) | (((u32)qid_val & 0xFFU) << off);
+			__raw_writel(v, g_cbm_qidt_base + idx * 4);
+	      }
+	wmb();
+	pr_info("cbm: IG-151 QIDT ep%u->q%u programmed (1024 slots, all dims dontcare)\n",
+		ep, qid_val);
+}
