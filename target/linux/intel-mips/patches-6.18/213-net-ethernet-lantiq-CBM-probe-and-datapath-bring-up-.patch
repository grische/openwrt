+/*
+ * cbm_enable_controllers - IG-058: enable the EQM + DQM global controllers and
+ * the EQM enqueue-delay. Split out of cbm_hw_init so probe can interpose the
+ * CPU-TX egress-port + TMU-egress-path config in between (AVM's
+ * configure_ports-before-CTRL=0x11 ordering, cbm.c:5605/5614/5621/5657).
+ * 0x11 = EN(bit0) | QEN(bit4), MSEL=0; direct write (not RMW), matching AVM.
+ */
+static void cbm_enable_controllers(void)
+{
+	cbm_dqm_w32(CBM_DQM_CTRL, 0x11);  /* DQM_EN | DQM_QEN */
+
+	/*
+	 * IG-068 (Rank 3): init the Load Spreader between DQM-enable and
+	 * EQM-enable, exactly where AVM runs init_cbm_ls (cbm.c:5620).
+	 */
+	cbm_init_load_spreader();
+
+	cbm_eqm_w32(CBM_EQM_CTRL, 0x11);  /* EQM_EN | EQM_QEN */
+	wmb();
+	pr_info("cbm: IG-042/058 controllers enabled (EQM_CTRL=0x%08x DQM_CTRL=0x%08x)\n",
+		cbm_eqm_r32(CBM_EQM_CTRL), cbm_dqm_r32(CBM_DQM_CTRL));
+
+	/*
+	 * IG-057: replicate AVM queue_delay_enable_set(1,0) (cbm.c:4694-4708,
+	 * :5657). EQM_CTRL |= PDEN(bit8)|SNOOPEN(bit6)|L=3(bits 11:9) -> 0x751;
+	 * DCNTR.DLY = CBM_EQM_DELAY_ENQ(0x10) for every IGP 0..15 (uniform
+	 * per-IGP window, dcntr @ +0x4c; AVM igp_delay_set cbm.c:4676 writes
+	 * delay & 0x3f directly for all 16). GRX350 is rev 2 (AVM rev>1 gate).
+	 */
+	{
+		u32 v = cbm_eqm_r32(CBM_EQM_CTRL);
+		int i;
+
+		v |= BIT(8) | BIT(6) | (3u << 9);
+		cbm_eqm_w32(CBM_EQM_CTRL, v);
+		for (i = 0; i <= 15; i++)
+			cbm_eqm_w32(CBM_EQM_CPU_PORT(i, dcntr), 0x10u & 0x3fu);
+		wmb();
+		pr_info("cbm: IG-057 EQM enqueue-delay enabled (EQM_CTRL=0x%08x want 0x751; DCNTR[0]=0x%08x want 0x10)\n",
+			cbm_eqm_r32(CBM_EQM_CTRL),
+			cbm_eqm_r32(CBM_EQM_CPU_PORT(0, dcntr)));
+	}
+}
