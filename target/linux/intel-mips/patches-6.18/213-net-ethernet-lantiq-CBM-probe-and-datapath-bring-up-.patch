+/*
+ * cbm_xrx500_probe - DT-bind entry point.
+ *
+ * Sub-4 ordering (a)..(h) refined by Sub-6 ST-002:
+ *   (a) atomic re-entry guard
+ *   (b) ioremap 12 MMIO windows
+ *   (c) collect 5 IRQs
+ *   (d) clk_get_optional + clk_prepare_enable
+ *   (e/f) cbm_buf_init_pools() — resolve reserved-memory cbm-std-pool /
+ *         cbm-jbo-pool via of_reserved_mem_lookup, devm_memremap, seed
+ *         the carve allocator, mirror dimensions into g_cbm_buff. Per
+ *         AC-002-7 a failure here MUST propagate -ENODEV (silently
+ *         carrying on with NULL pool bases would cause downstream
+ *         cbm_isr handlers to dereference NULL).
+ *   (g) cbm_hw_init(pdev)
+ *   (h-pre) tmu_init()
+ *   (h) dev_info banner — reserved-memory wording
+ *
+ * Sub-6 ST-002 flipped cbm@1e700000 status="okay" via the board overlay
+ * (seale_avm_fritz7560.dtsi &cbm block). The IG-013 unguarded-base
+ * audit was run prior to the flip — see the ST-002 commit message for
+ * the audit findings.
+ */
+static int cbm_xrx500_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	void __iomem *base;
+	int irqs[5];
+	int i;
+	int irq;
+	int ret;
+
+	/* (a) Re-entry guard. atomic_inc_return returns the new value so
+	 * the first probe sees 1 (passes), the second sees 2 (rejected).
+	 * The counter intentionally stays poisoned (>=2) after a duplicate
+	 * — the system is in an unexpected state and we want the next probe
+	 * also rejected.
+	 */
+	if (atomic_inc_return(&cbm_probe_count) > 1) {
+		dev_warn(dev, "cbm: duplicate probe rejected\n");
+		return -EBUSY;
+	}
+
+	/* (b) Loop ioremap the 12 MMIO windows in fixed DT-reg order. */
+	for (i = 0; i < (int)ARRAY_SIZE(cbm_ioremap_table); i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res) {
+			dev_err(dev,
+				"cbm: missing reg resource %s (idx %d)\n",
+				cbm_ioremap_table[i].name, i);
+			ret = -ENOENT;
+			goto err;
+		}
+		base = devm_ioremap_resource(dev, res);
+		if (IS_ERR(base)) {
+			dev_err(dev,
+				"cbm: ioremap %s (idx %d) failed: %ld\n",
+				cbm_ioremap_table[i].name, i,
+				PTR_ERR(base));
+			ret = PTR_ERR(base);
+			goto err;
+		}
+		*cbm_ioremap_table[i].store = base;
+	}
+
+	/* (c) Collect 5 IRQs. Stored in BOTH a local int[5] (per AC-002-3)
+	 * and the static cbm_irqs[5] (so ST-004's init_cbm_basic chain can
+	 * reach them without changing the init_cbm_basic signature).
+	 */
+	for (i = 0; i < 5; i++) {
+		irq = platform_get_irq(pdev, i);
+		if (irq < 0) {
+			dev_err(dev,
+				"cbm: platform_get_irq %d failed: %d\n",
+				i, irq);
+			ret = -EINVAL;
+			goto err;
+		}
+		irqs[i] = irq;
+		cbm_irqs[i] = irq;
+	}
+
+	/* (d) Optional clock. AS-002 declares CBM_CLK + GATE_CBM_CLK in
+	 * the DT clocks property; devm_clk_get_optional returns NULL if
+	 * the property is absent (lets the disabled-DT path stay valid).
+	 */
+	cbm_clk = devm_clk_get_optional(dev, NULL);
+	if (IS_ERR(cbm_clk)) {
+		ret = PTR_ERR(cbm_clk);
+		dev_err(dev, "cbm: clk_get failed: %d\n", ret);
+		cbm_clk = NULL;
+		goto err;
+	}
+	if (cbm_clk) {
+		ret = clk_prepare_enable(cbm_clk);
+		if (ret) {
+			dev_err(dev,
+				"cbm: clk_prepare_enable failed: %d\n",
+				ret);
+			cbm_clk = NULL;
+			goto err;
+		}
+	}
+
+	/* (e/f) Sub-6 ST-002 — resolve the two reserved-memory pools
+	 * (cbm-std-pool / cbm-jbo-pool) via of_reserved_mem_lookup, map
+	 * them with devm_memremap, and seed the embedded-free-list carve
+	 * allocator. cbm_buf_init_pools mirrors the per-pool dimensions
+	 * into g_cbm_buff (std_frm_size / jbo_frm_size / std_pool_size /
+	 * jbo_pool_size / std_frm_num / jbo_frm_num / std_buf_addr /
+	 * jbo_buf_addr / placeholder=false) so the legacy FSQM init reader
+	 * (fsqm.c:376) and init_cbm_basic see consistent values.
+	 *
+	 * AC-002-7 — at-probe lookup failure MUST propagate to the
+	 * platform-driver core. Silently continuing with NULL pool bases
+	 * would cause downstream cbm_isr handlers (and the Sub-6 polled-TX
+	 * path) to dereference NULL the moment the first packet arrives.
+	 */
+	ret = cbm_buf_init_pools(dev);
+	if (ret) {
+		dev_err(dev, "cbm: cbm_buf_init_pools failed: %d\n", ret);
+		goto err_clk;
+	}
+
+	/* Cache the pdev for ST-004 / ST-005 IRQ-installation paths. */
+	cbm_pdev_cache = pdev;
+
+	/*
+	 * IG-192 (RX): reset-parity for the TOE DMA controller (AVM cid
+	 * DMA3 @ ssx0+0x300000 = 0x1E300000). 4.9 probes it at boot with
+	 * GATE_TOE_CLK + full CTRL_RST + per-channel RST (hdma.c:4373-4379 /
+	 * dma_ctrl_init); our port enables ONLY the clock gate (IG-059 poke
+	 * above, GATE_TOE b22 per IG-158-A2) leaving a clocked-but-never-
+	 * reset third master on the EQM DMA-ingress staging arbiter (IG-190
+	 * RANK 1). IG-190b proved gating the clock OFF changes nothing — the
+	 * untested parity move is the RESET. Runs after the poke (clock on),
+	 * before cbm_hw_init arms the EQM IGP ports, matching AVM's macro
+	 * order (ssx0 DMA3 probe precedes the CBM port config).
+	 */
+	hdma_ig192_toe_dma3_reset();
+
+	/* (g) Bring up FSQM + CBM basic. Per the plan Step 3 ordering,
+	 * cbm_interrupt_init is called from inside ST-004's init_cbm_basic
+	 * (matching AVM cbm.c:1253-1254), NOT directly from probe — so we
+	 * do not invoke cbm_interrupt_init(pdev, irqs) here.
+	 */
+	ret = cbm_hw_init(pdev);
+	if (ret) {
+		dev_err(dev, "cbm: cbm_hw_init failed: %d\n", ret);
+		goto err_clk;
+	}
+
+	/* Reference the IRQ array so the compiler doesn't elide it; it is
+	 * also persisted to cbm_irqs[] (above) for ST-005's consumption.
+	 */
+	dev_dbg(dev, "cbm: IRQs collected [%d,%d,%d,%d,%d]\n",
+		irqs[0], irqs[1], irqs[2], irqs[3], irqs[4]);
+
+	/* (h-pre) Initialize TMU and zero the EPOC (Egress Port Occupancy/Output
+	 * Counter) table — the M0 milestone gate from the stock firmware.
+	 * tmu_init() reads g_cbm_tmu_base (set up by the ioremap loop above),
+	 * walks the seven sub-init routines (per CQ-002 A), and emits the
+	 * v108hk marker 'tmu: probe complete, EPOC zeroed at t=<jiffies>'
+	 * before returning 0. Failure here unwinds through err_clk because
+	 * the carve allocator's pool storage is devm-managed and releases
+	 * automatically when the device unbinds.
+	 */
+	ret = tmu_init();
+	if (ret) {
+		dev_err(dev, "cbm: tmu_init failed: %d\n", ret);
+		goto err_clk;
+	}
+
+	/*
+	 * IG-149 (PART B): whole-table QIDT drop-fill, faithful to AVM
+	 * cbm_hw_init (AVM cqm/grx500/cbm.c:5573; loop 5591-5595) which fills ALL
+	 * 0x1000 QIDT words with 0xFFFFFFFF (every byte-entry = qid 255 = the
+	 * always-valid drop queue) BEFORE any routing. This guarantees every
+	 * UNPROGRAMMED lookup key resolves to the valid drop queue instead of a
+	 * warm-boot-residual qid that may point at an unallocated queue. OURS
+	 * previously wrote only the 512 ep=0/flowidh=0 CPU slots
+	 * (cbm_program_cpu_qidt just below), leaving ~15.9k entries at warm-boot
+	 * residual. Must run BEFORE cbm_program_cpu_qidt(35) and the later
+	 * ndo_open cbm_dp_enable LAN routes so those overwrite the 255 baseline in
+	 * their slots (AVM order: fill -> queue_map_set routes).
+	 *
+	 * Faithfulness + decisive diagnostic: our CPU route is byte-identical to
+	 * AVM's DP_F_DEQ_CPU queue_map_set masks (AVM cbm.c:5189-5201: ep=0,
+	 * flowidh=0, flowidl/tc/mpe/en/de dontcare), so if the real host-RX
+	 * descriptor key is ep=0/flowidh=0 this fill cannot change its resolution
+	 * (still -> q35). If RX behaviour DOES change after this, the descriptor
+	 * carries a non-zero ep/flowidh that our 512-slot route misses.
+	 */
+	if (g_cbm_qidt_base) {
+		u32 qi;
+
+		for (qi = 0; qi < 0x1000; qi++)
+			__raw_writel(0xFFFFFFFFU, g_cbm_qidt_base + qi * 4);
+		wmb();
+		pr_info("cbm: IG-149 QIDT whole-table drop-fill done (0x1000 words = qid 255)\n");
+	} else {
+		pr_err("cbm: IG-149 QIDT drop-fill skipped: g_cbm_qidt_base not mapped\n");
+	}
+
+	/*
+	 * IG-159 (B1): faithful AVM conf_dqm_cpu_port walk over the three
+	 * DQM-CPU config rows (AVM cbm_config.c:6-29: port2/q35/DP_F_DEQ_CPU,
+	 * port1/q34/DP_F_DEQ_DL, port3/q36/DP_F_DEQ_MPE) — replaces the
+	 * open-coded port-2 bring-up that lived here since IG-095/IG-120
+	 * (init_cbm_dqm_cpu_port(2) + tmu_create_flat_egress_path(1,2,19,35,1)
+	 * + cbm_program_cpu_qidt(35)). Each row now runs the FULL AVM sequence
+	 * (cbm.c:5129-5229): RESERVE_PORTS -> dqm_port_info -> init_cbm_dqm_
+	 * cpu_port -> tmu_create_flat_egress_path -> assign_port_from_DT ->
+	 * queue_map_set (== cbm_program_cpu_qidt(35) for the DP_F_DEQ_CPU row,
+	 * byte-identical QIDT effect per spec S2.6) -> cbm_add_to_list. Ports
+	 * 1/3 are configured for AVM parity (q34/q36 TMU paths + CFG_CPU_EGP_1
+	 * /3), and the registry installs the pmac=0 -> DQ2/q35 CPU binding
+	 * that cbm_dp_port_resources_get resolves (cbm_ports.c).
+	 *
+	 * Placement: AFTER the IG-149 drop-fill, exactly where cbm_program_
+	 * cpu_qidt(35) ran — matching AVM probe order (whole-table QIDT
+	 * 0xFFFFFFFF fill at cbm.c:5591-5596 BEFORE configure_ports at :5605).
+	 *
+	 * Per spec S4 this does NOT change the stamped descriptor ep — no AVM
+	 * software write produces DW1[11:8]; HW/PCE decides. The ep observable
+	 * stays the IG-153 C breadcrumb (cbm_intr.c d=[..DW1..]); the IG-151
+	 * ep=7 cube below therefore stays in place through B1 (B2 deletes it
+	 * only after an ep=0 hardware proof).
+	 */
+	if (cbm_configure_dqm_cpu_ports() != CBM_SUCCESS)
+		pr_err("cbm: IG-159 DQM-CPU configure_ports walk FAILED\n");
+
+	/*
+	 * IG-151 EXPERIMENT — the IG-150 capture proves host-RX descriptors
+	 * carry ep=7 (DW1[11:8] per the authoritative gswip30 BE struct), so
+	 * the HW key 0x70 hits the drop-fill. Route the ep=7 cube to the CPU
+	 * queue 35 like the ep=0 cube. Decisive: if eqpc/dqpc/rx_deliv start
+	 * climbing, the RX gate was the QIDT ep-cube miss. The faithful
+	 * placement (AVM programs it at dp-port alloc, cbm.c:3345) follows
+	 * once the ep-semantics audit lands; this probe-time write has the
+	 * same register effect.
+	 */
+	cbm_program_ep_qidt(7, 35);
+
+	/*
+	 * IG-095 (ST-003): arm the LS RX engine NOW — alongside
+	 * init_cbm_dqm_cpu_port(2) above and BEFORE cbm_enable_controllers()
+	 * (and thus before the controllers/interrupts come up). Inside,
+	 * cbm_rx_engine_init() runs tasklet_init(&cbm_tasklet[0], do_cbm_tasklet,
+	 * 0) BEFORE set_bit(0, &g_cpu_port_alloc) (AC-003-3), so a hypothetically
+	 * early cbm_isr_4 LS schedule can never run against an uninitialised
+	 * tasklet. Bit 0 is the cpu/LS-output dequeue index (CQ-001 A), distinct
+	 * from the CPU DQM return port 2 brought up by init_cbm_dqm_cpu_port(2).
+	 */
+	cbm_rx_engine_init();
+
+	/*
+	 * (h-egress) IG-058: configure the CPU-TX LAN1 (dp5) DQM-DMA egress port
+	 * + TMU flat egress path NOW — after TMU init, BEFORE enabling the
+	 * controllers — mirroring AVM configure_ports->conf_dqm_dma_port
+	 * (cbm.c:5605), which runs before CBM_DQM_CTRL/CBM_EQM_CTRL=0x11
+	 * (cbm.c:5614/5621) and queue_delay_enable_set (cbm.c:5657). Previously
+	 * we enabled the controllers in cbm_hw_init and bound this egress port
+	 * only at ndo_open (after enable); a DQM enabled before its EPMAP binding
+	 * can rebuild the egress descriptor from a stale/zero PPT body-length
+	 * (data_len=0; IG-054..057). dp5 -> tmu_port=10, tmu_queue=20,
+	 * base_sbid=4 (=20-SBID_START; promoted to cbm.h by IG-159).
+	 * cbm_dp_enable (later at ndo_open) sees g_cbm_egress_preconfig[5]
+	 * and programs only the QIDT.
+	 */
+	init_cbm_dqm_dma_port(10);
+	tmu_create_flat_egress_path(1, 10, 4, 20, 1);
+	g_cbm_egress_preconfig[5] = true;
+	pr_info("cbm: IG-058 dp5 egress preconfigured at probe (deq10/q20/sbid4) before controller enable\n");
+
+	/* IG-058: enable EQM/DQM controllers + enqueue-delay AFTER the egress
+	 * path is built (AVM order). Was previously the tail of cbm_hw_init.
+	 */
+	cbm_enable_controllers();
+
+	/*
+	 * IG-068 (Rank 1, holistic faithful re-port): open the DMA2TX-ch5 egress
+	 * channel HERE, at probe-end, contiguously after the controllers are
+	 * enabled + the enqueue-delay is set — matching AVM's order (cbm.c:5660:
+	 * the dequeue_dma_port_init loop opens every DMA-egress channel at probe,
+	 * right after DQM_CTRL=0x11 + queue_delay_enable_set). Our prior port
+	 * opened ch5 only at ndo_open — seconds later, across the controller-
+	 * enable boundary. The g_hdma_port10_armed latch in hdma_port_enable makes
+	 * the later ndo_open call a no-op, so the channel<->DQM coupling is now
+	 * established once, at probe, in AVM order. The DMA controllers probe at
+	 * ~0.18s and CBM at ~1.1s, so the DMA2TX controller is bound by now.
+	 */
+	{
+		int hret = hdma_port_enable(10);
+
+		if (hret)
+			dev_warn(dev, "cbm: IG-068 probe-time hdma_port_enable(10) = %d (ndo_open will retry)\n",
+				 hret);
+		else
+			pr_info("cbm: IG-068 DMA2TX ch5 opened at probe-end (AVM order)\n");
+	}
+
+	/*
+	 * IG-120 (dma_rx_channels): open the EQM-port DMA2RX ingress channels for
+	 * ports 5/6 (AVM enqueue_dma_port_init -> setup_DMA_channel, cbm.c:5673-
+	 * 5708 / 4459-4497). cbm_config.c EQM rows: port5=ch14, port6=ch15 on
+	 * DMA2RX. STD channels only for the first-smoke subset (jumbo ch30/31
+	 * deferred: the jumbo BUFREQ offset is unverified without an HRM). The
+	 * Stage-1 EQM descriptor windows are already seeded by the M2SEED
+	 * dma_port_enable loop in cbm_hw_init, so only the Stage-2 channel open is
+	 * needed here. Probe tail, AFTER cbm_enable_controllers() + the
+	 * hdma_port_enable(10) TX channel open — strictly additive, AVM order.
+	 */
+	cbm_eqm_rx_chan_open(DMA2RX_CBMP5_CLASS14, 5, CBM_PORT_F_STANDARD_BUF);
+	cbm_eqm_rx_chan_open(DMA2RX_CBMP6_CLASS15, 6, CBM_PORT_F_STANDARD_BUF);
+	/*
+	 * IG-186: the pid5/pid6 JUMBO movers — AVM opens DMA2RX ch30/31 for
+	 * the 0x1e500800/0x1e501800 windows (cbm_config.c:262-270/:280-288
+	 * post-A21-remap; the old "jumbo BUFREQ offset unverified" deferral
+	 * above is resolved by the audit: cbm_eqm_rx_chan_open's
+	 * CBM_EQM_DMA_DESC(pid,0,jbo) already targets +0x800). Closes the
+	 * last RX-side channel-coverage gap vs AVM; also = the GSW-R-side
+	 * P2D jumbo path coming alive on our box if GSW-R ever offers.
+	 */
+	cbm_eqm_rx_chan_open(DMA2RX_CBMP5_CLASS30_JUMBO, 5, CBM_PORT_F_JUMBO_BUF);
+	cbm_eqm_rx_chan_open(DMA2RX_CBMP6_CLASS31_JUMBO, 6, CBM_PORT_F_JUMBO_BUF);
+
+	/*
+	 * IG-125 (dma1rx_host_rx_admit): open the DMA1RX EQM RX-admit channels
+	 * for EQM ports 7 + 8 — the ACTUAL host-RX admit movers. The 4.9 testbed
+	 * oracle (cbmenq per-port eqpc on a host ping) proved host-RX (GPHY5 p5)
+	 * enters the CBM at EQM dma_p7 (eqpc=19 = the RX_Good count) on DMA1RX,
+	 * while the IG-120 DMA2RX ports 5/6 (dma_p5/dma_p6) carry ZERO — IG-120
+	 * opened the wrong controller. cbm_config.c EQM rows (cqm/grx500/
+	 * cbm_config.c:289-315): tmu_port=7 -> dma_ctrl=1(DMA1RX) chnl 0(std);
+	 * tmu_port=8 -> dma_ctrl=1(DMA1RX) chnl 15(std, A21-remapped to 5; see
+	 * the channel-macro note below). The EQM descriptor
+	 * windows for ports 7/8 are already seeded by the M2SEED dma_port_enable
+	 * loop above (setup_eqm_dma_desc(idx+5) covers pid 5..8), so only the
+	 * Stage-2 channel open is needed. STD only for the first-smoke subset;
+	 * jumbo (DMA1RX ch16 / ch31) deferred — unverified BUFREQ offset, no HRM.
+	 *
+	 * Channel macros (dma/lantiq_dmax.h): EQM port 7 std = DMA1RX channel 0,
+	 * whose ONLY handle is DMA1RX_TMU_CLASS0 (= _DMA_C(DMA1RX, DMA1RX_PORT,
+	 * DMA_CHANNEL_0); the "TMU" in the name is an AVM misnomer — it is simply
+	 * DMA1RX ch0, the std-buf RX-admit channel for EQM port 7, confirmed by
+	 * the cbm_config.c row + the audit at dma/hdma.c:2440-2449). EQM port 8
+	 * std: the cbm_config.c row encodes the un-remapped std channel 15, but
+	 * AVM sets cbm_rev=2 UNCONDITIONALLY (AVM cbm.c:5597) before
+	 * configure_ports(), which activates the A21 std-channel remap in
+	 * conf_eqm_dma_port (AVM cbm.c:5297-5302): for dma_ctrl==1 (DMA1RX),
+	 * dma_chnl = (dma_chnl == 0) ? 0 : 5. So EQM port 8 std is DMA1RX channel
+	 * 5 = DMA1RX_CBM_P8_CLASS5, NOT channel 15 — the hardware EQM DMA-IGP
+	 * port-8 enqueues to ch5, so arming ch15 (DMA1RX_CBM_P8_CLASS15) would
+	 * open the wrong channel and port-8 host-RX would never flow (same
+	 * failure mode as IG-120). Port 7's std channel 0 is remap-invariant
+	 * ((0)?0:5 leaves 0). DMA1RX (cid=2) passes the dma_lookup_ctrl guard
+	 * (dma/hdma.c:1488, cid <= DMA2RX). Keep the IG-120 DMA2RX port5/6 opens
+	 * above (harmless). Does NOT touch TX.
+	 */
+	cbm_eqm_rx_chan_open(DMA1RX_TMU_CLASS0, 7, CBM_PORT_F_STANDARD_BUF);
+	cbm_eqm_rx_chan_open(DMA1RX_CBM_P8_CLASS5, 8, CBM_PORT_F_STANDARD_BUF);
+
+	/*
+	 * IG-146: open the JUMBO DMA1RX RX-admit channels for dma_p7 / dma_p8 so
+	 * the dual std+jumbo enqueue ports have a live mover for the +0x800 jumbo
+	 * descriptor set seeded by the M2SEED jumbo loop. Channels are the
+	 * POST-A21-remap values (AVM conf_eqm_dma_port cbm.c:5284,
+	 * `dma_chnl = (dma_chnl == 16) ? 6 : 11`): cbm_config.c raw jumbo 16 (p7)
+	 * -> ch6, raw 31 (p8) -> ch11. cbm_eqm_rx_chan_open routes buf_type into
+	 * CBM_EQM_DMA_DESC(cbm_port, 0, buf_type>>1), so passing
+	 * CBM_PORT_F_JUMBO_BUF auto-targets the +0x800 jumbo desc window. Mirrors
+	 * the AVM type-6 enqueue loop opening both channels (cbm.c:5691-5704).
+	 */
+	cbm_eqm_rx_chan_open(DMA1RX_CBM_P7_CLASS6_JUMBO, 7, CBM_PORT_F_JUMBO_BUF);
+	cbm_eqm_rx_chan_open(DMA1RX_CBM_P8_CLASS11_JUMBO, 8, CBM_PORT_F_JUMBO_BUF);
+
+	/* (h) Success banner — Sub-6 reserved-memory wording (replaces the
+	 * Sub-4 PLACEHOLDER / IG-012 framing).
+	 */
+	dev_info(dev,
+		 "%s: CBM XRX500 ready (reserved-memory pools 18MiB std / 8MiB jbo, IG-006 mitigated)\n",
+		 dev_name(dev));
+	return 0;
+
+err_clk:
+	if (cbm_clk) {
+		clk_disable_unprepare(cbm_clk);
+		cbm_clk = NULL;
+	}
+err:
+	cbm_pdev_cache = NULL;
+	atomic_dec(&cbm_probe_count);
+	return ret;
+}
