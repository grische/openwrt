+/*
+ * cbm_xrx500_remove - tear down in reverse.
+ *
+ * Sub-6 ST-002 — devm-managed resources (12 ioremap, optional clk_get,
+ * devm_memremap for the two reserved-memory pools, devm_request_irq from
+ * ST-005) are released by the devres machinery automatically when the
+ * platform_device is unbound. This function only needs to undo what is
+ * NOT devm-tracked:
+ *   - clk_disable_unprepare (devm undoes _get, not _enable)
+ *   - atomic_dec the probe guard
+ *   - clear the g_cbm_buff buffer pointers so a re-bind sees them empty
+ *
+ * Sub-4's cbm_buf_free calls on g_cbm_buff.{std,jbo}_buf_base are gone
+ * because the carve allocator's underlying storage (devm_memremap'd
+ * reserved-memory) is freed by devres — explicit cbm_buf_free per chunk
+ * is the in-flight packet path, not a pool teardown.
+ */
+static void cbm_xrx500_remove(struct platform_device *pdev)
+{
+	(void)pdev;
+
+	g_cbm_buff.jbo_buf_base = NULL;
+	g_cbm_buff.jbo_buf_addr = NULL;
+	g_cbm_buff.std_buf_base = NULL;
+	g_cbm_buff.std_buf_addr = NULL;
+
+	if (cbm_clk) {
+		clk_disable_unprepare(cbm_clk);
+		cbm_clk = NULL;
+	}
+	cbm_pdev_cache = NULL;
+	atomic_dec(&cbm_probe_count);
+}
