+/*
+ * cbm_intr_mapping_init — port of AVM cqm/grx500/cbm.c:1208-1225
+ *                         + the stock firmware's expected sequence.
+ *
+ * Writes the per-line cbm_irnen / egp_irnen masks that gate which CBM
+ * interrupt sources can reach the GIC. AVM uses a 4-block magic-number
+ * pattern (`0x1 << 8`, `0x2 << 8`, `0x4 << 8`, `0x8 << 8` for lines
+ * 4..7 respectively) — review_focus asks for a loop-based form when
+ * possible, so we use `0x100U << (n - 4)` which produces the identical
+ * sequence (0x100/0x200/0x400/0x800) for n ∈ {4,5,6,7}.
+ *
+ * Dropped AVM conditionals — both off in the stock firmware, both wrapped
+ * in source comments per AC-004-7:
+ *
+ *   /+ AVM ENABLE_LL_DEBUG/CONFIG_CBM_LS_ENABLE conditionals dropped
+ *      per Sub-4 minimum init +/
+ *
+ *   * ENABLE_LL_DEBUG → would set CBM_INT_LINE(5, cbm_irnen)=0x10000
+ *     instead of 0x200 (debug-only routing — the stock firmware does not
+ *     enable it).
+ *   * CONFIG_CBM_LS_ENABLE → would set CBM_INT_LINE(6, egp_irnen)=0x4
+ *     and SKIP the line-6 egp_irnen=0 write (LS path — Sub-6 owns the LS
+ *     reactivation; Sub-4 holds line 6 egp_irnen at zero per v108bz).
+ *
+ * Step 6 self-check: readback each just-written cbm_irnen / egp_irnen
+ * register and WARN_ON mismatch. This proves the writes landed in the
+ * expected windows (catches MMIO routing bugs that would otherwise only
+ * show up as silent silicon misbehaviour). Sample size = 8 registers,
+ * well below the log-spam threshold.
+ *
+ * Source citation: AVM cqm/grx500/cbm.c:1208-1225 + the stock
+ * firmware's verbatim cbm_irnen/egp_irnen sequence.
+ *
+ * Returns 0 on success (no failure path — these are pure MMIO writes).
+ */
+int cbm_intr_mapping_init(void)
+{
+	/* egp_irnen-zero target lines per v108bz: 0, 4, 5, 6. Using a
+	 * named array rather than 4 copy-pasted writes (review_focus:
+	 * "static const u8 lines[] = {0,4,5,6} for the second").
+	 */
+	static const u8 egp_zero_lines[] = { 0, 4, 5, 6 };
+	int n;
+	size_t i;
+	u32 expected;
+	u32 actual;
+
+	if (!g_cbm_base) {
+		pr_err("cbm: cbm_intr_mapping_init: g_cbm_base NULL\n");
+		return -ENODEV;
+	}
+
+	/* (a) cbm_irnen writes — AVM cbm.c:1208/1212/1215/1219. */
+	for (n = 4; n <= 7; n++) {
+		expected = 0x100U << (n - 4);
+		__raw_writel(expected, g_cbm_base + CBM_INT_LINE(n, cbm_irnen));
+	}
+
+	/* (b) egp_irnen zero writes — AVM cbm.c:1221-1225 (line 6 entry is
+	 * the !CONFIG_CBM_LS_ENABLE branch we explicitly retain).
+	 */
+	for (i = 0; i < ARRAY_SIZE(egp_zero_lines); i++)
+		__raw_writel(0U, g_cbm_base + CBM_INT_LINE(egp_zero_lines[i],
+							    egp_irnen));
+
+	/* Step 6 — readback self-check vs the stock firmware's values. */
+	for (n = 4; n <= 7; n++) {
+		expected = 0x100U << (n - 4);
+		actual = __raw_readl(g_cbm_base + CBM_INT_LINE(n, cbm_irnen));
+		WARN_ONCE(actual != expected,
+			  "cbm: CBM_INT_LINE(%d, cbm_irnen) readback 0x%08x != expected 0x%08x\n",
+			  n, actual, expected);
+	}
+	for (i = 0; i < ARRAY_SIZE(egp_zero_lines); i++) {
+		actual = __raw_readl(g_cbm_base +
+				     CBM_INT_LINE(egp_zero_lines[i], egp_irnen));
+		WARN_ONCE(actual != 0U,
+			  "cbm: CBM_INT_LINE(%u, egp_irnen) readback 0x%08x != expected 0x00000000\n",
+			  (unsigned int)egp_zero_lines[i], actual);
+	}
+
+	return 0;
+}
+
+/*
+ * cbm_interrupt_init — port of AVM cqm/grx500/cbm.c:2810-2870
+ *                      adapted for linux-6.18.y devm semantics.
+ *
+ * Plumbs the 5 CBM GIC IRQs (collected by cbm_xrx500_probe) to their
+ * ST-005-owned handlers via devm_request_irq, so probe-failure unwind
+ * is handled automatically by the devres machinery (AVM uses raw
+ * request_irq which would leak on probe failure).
+ *
+ * Flag choice (review_focus): AVM uses `0` (no flags) on every line; the
+ * plan AC-004-5 mandates `IRQF_SHARED` for the linux-6.18.y port because
+ * linux-6.18.y's GIC infrastructure shares interrupt lines across the
+ * CBM and adjacent IP blocks more aggressively than AVM's 4.9 kernel
+ * (CBM_INT_LINE 4..7 land on the same GIC SPI numbers as some PPv4
+ * counters that Sub-7 may eventually wire up; IRQF_SHARED defers the
+ * arbitration decision to the IRQ subsystem instead of failing-fast on
+ * a parallel registration).
+ *
+ * Affinity: AVM sets per-VPE irq_set_affinity (cpumask 0x1 / 0x2 / 0x4
+ * / 0x8) on lines 1..4. The plan does not request this — Sub-6's full
+ * datapath bring-up will revisit affinity once cbm_dequeue is exercised.
+ * Documented here so the omission is intentional, not an oversight.
+ *
+ * Handler names: AVM uses "cbm_eqm" (line 0) and "cbm_dqm" (lines 1..4).
+ * The plan AC-004-5 prescribes per-line "cbm_isr_<n>" names so /proc/interrupts
+ * disambiguates the 5 handlers — easier debugging than 4 lines all
+ * showing "cbm_dqm".
+ *
+ * Failure path: devm_request_irq returns the linux errno. On failure we
+ * dev_err + return early — devres auto-frees any earlier successful
+ * registrations when probe ultimately returns the error (AC-004-5).
+ *
+ * Returns 0 on full success; negative errno (propagated from
+ * devm_request_irq) on the first failing line.
+ */
+int cbm_interrupt_init(struct platform_device *pdev, int *irqs)
+{
+	static const irq_handler_t cbm_isr_table[5] = {
+		cbm_isr_0,
+		cbm_isr_4,
+		cbm_isr_5,
+		cbm_isr_6,
+		cbm_isr_7,
+	};
+	static const char * const cbm_isr_names[5] = {
+		"cbm_isr_0", "cbm_isr_4", "cbm_isr_5", "cbm_isr_6", "cbm_isr_7",
+	};
+	int n;
+	int ret;
+
+	if (!pdev || !irqs) {
+		pr_err("cbm: cbm_interrupt_init: pdev=%p irqs=%p\n",
+		       pdev, irqs);
+		return -EINVAL;
+	}
+
+	for (n = 0; n < 5; n++) {
+		ret = devm_request_irq(&pdev->dev, irqs[n], cbm_isr_table[n],
+				       IRQF_SHARED, cbm_isr_names[n], pdev);
+		if (ret) {
+			dev_err(&pdev->dev,
+				"cbm: devm_request_irq %s (irq=%d) failed: %d\n",
+				cbm_isr_names[n], irqs[n], ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
