+/*
+ * cbm_isr_6 — top-level ISR for line 6. Port of AVM cqm/grx500/cbm.c:2730-2781.
+ *
+ * AVM line 6 carries the most complex flow: CONFIG_CBM_LS_ENABLE wires
+ * napi_schedule on the dqm side (the EQM DMA-side RX path), and the
+ * non-LS path tasklet_schedules cbm_tasklet[cpu]. Sub-4 strips both
+ * branches and falls back to "ack + log".
+ *
+ * AVM dispatch masks for line 6:
+ *   cbm_irncr & 0x0400 — LS interrupt for cpu 2 (AVM 2755 path)
+ *   egp_irncr non-zero — DMA-side RX ready (AVM 2740 path, napi_schedule)
+ *
+ * Sub-6 will restore napi_schedule on the egp_irncr path; until then the
+ * ack-only behaviour avoids leaving stale events asserted on the GIC line.
+ */
+irqreturn_t cbm_isr_6(int irq, void *dev_id)
+{
+	u32 cbm_irncr;
+	u32 igp_irncr;
+	u32 egp_irncr;
+
+	(void)irq;
+	(void)dev_id;
+
+	if (!g_cbm_base) {
+		pr_err_ratelimited("cbm: cbm_isr_6: g_cbm_base NULL\n");
+		return IRQ_NONE;
+	}
+
+	cbm_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(6, cbm_irncr));
+	igp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(6, igp_irncr));
+	egp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(6, egp_irncr));
+
+	pr_debug("cbm: isr6: cbm_irncr=0x%x igp_irncr=0x%x egp_irncr=0x%x\n",
+		 cbm_irncr, igp_irncr, egp_irncr);
+
+	/* AVM 2740 — egp_irncr (DMA RX ready). napi_schedule stripped per
+	 * Step 7; left as a debug log so the trace is visible.
+	 */
+	if (egp_irncr)
+		pr_debug("cbm: isr6: dqm rx ready (napi deferred to Sub-6)\n");
+
+	/*
+	 * IG-156 — AVM 2755-2764: cbm_irncr bit10 (0x0400) = LS interrupt for
+	 * LS PORT 2, the port identity-paired with DQM cpu_p2 (the q35 host-RX
+	 * dequeue port). The old Sub-4 stub blind-W1C'd the line-6 aggregate
+	 * and returned IRQ_HANDLED — but the LEVEL source (IRNCR_LS port-2
+	 * bits + qlen) stays asserted, so line 6 refired forever: a SILENT
+	 * hardirq storm (no "nobody cared" — we claimed it) that starved
+	 * softirqs → the IG-151..155 wedges, with isr4=0 because it is line 6.
+	 * Handle it exactly like cbm_isr_4's LS branch: mask line-6 IRNEN,
+	 * flush, mask the IRNEN_LS port-2 bits, flush, defer to the tasklet
+	 * (data=2 → drains LS port 2, re-arms line 6 on empty).
+	 */
+	if (cbm_irncr & 0x0400) {
+		__raw_writel(0, g_cbm_base + CBM_INT_LINE(6, cbm_irnen));
+		__raw_readl(g_cbm_base + CBM_INT_LINE(6, cbm_irnen));
+		__raw_writel(__raw_readl(g_cbm_ls_base + IRNEN_LS) &
+				     ~(u32)(3UL << (2 * 2 + 16)),
+			     g_cbm_ls_base + IRNEN_LS);
+		__raw_readl(g_cbm_ls_base + IRNEN_LS);
+		tasklet_schedule(&cbm_tasklet[2]);
+		return IRQ_HANDLED;
+	}
+
+	__raw_writel(cbm_irncr, g_cbm_base + CBM_INT_LINE(6, cbm_irncr));
+	__raw_writel(igp_irncr, g_cbm_base + CBM_INT_LINE(6, igp_irncr));
+	__raw_writel(egp_irncr, g_cbm_base + CBM_INT_LINE(6, egp_irncr));
+
+	if (cbm_irncr || igp_irncr || egp_irncr)
+		return IRQ_HANDLED;
+	return IRQ_NONE;
+}
