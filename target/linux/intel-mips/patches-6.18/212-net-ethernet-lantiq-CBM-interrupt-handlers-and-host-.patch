+/* ------------------------------------------------------------------------ */
+/* SUB-8 ST-002 (IG-095) — LS RX engine                                     */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * cbm_ls_deq_list — drain the LS output ring for port @pid into
+ * g_cbm_dlist[pid][]. Port of AVM cqm/grx500/cbm.c:1985-2003.
+ *
+ * Reads the per-port LS window at g_cbm_ls_base (CQ-003 A): status at
+ * CBM_LS_PORT_STATUS(pid), descriptor words desc0..desc3 at
+ * CBM_LS_PORT_DESC(pid, 0..3). While the 4-bit queued-descriptor count
+ * ((status >> CBM_LS_QUEUE_LEN_POS) & 0xF) is non-zero, copies each present
+ * descriptor into the staging array. A drain budget of CBM_RX_DRAIN_BUDGET
+ * bounds one call; on exhaustion it returns CBM_RESCHEDULE so the caller
+ * re-schedules instead of spinning. A terminating desc2 == 0 sentinel is
+ * written after the last copied entry so do_cbm_tasklet's in-list walk has a
+ * definite end.
+ *
+ * Returns CBM_SUCCESS when the ring drained within budget, CBM_RESCHEDULE
+ * when the budget was hit with descriptors still queued. Big-endian MMIO via
+ * __raw_readl (matching the rest of the CBM driver).
+ */
+static int cbm_ls_deq_list(u32 pid)
+{
+	int budget = CBM_RX_DRAIN_BUDGET;
+	int i = 0;
+	int ret = CBM_SUCCESS;
+
+	while (((__raw_readl(g_cbm_ls_base + CBM_LS_PORT_STATUS(pid))
+		 >> CBM_LS_QUEUE_LEN_POS) & 0xF) != 0) {
+		if (budget-- < 0) {
+			ret = CBM_RESCHEDULE;
+			break;
+		}
+		g_cbm_dlist[pid][i].desc0 =
+			__raw_readl(g_cbm_ls_base + CBM_LS_PORT_DESC(pid, 0));
+		g_cbm_dlist[pid][i].desc1 =
+			__raw_readl(g_cbm_ls_base + CBM_LS_PORT_DESC(pid, 1));
+		g_cbm_dlist[pid][i].desc2 =
+			__raw_readl(g_cbm_ls_base + CBM_LS_PORT_DESC(pid, 2));
+		g_cbm_dlist[pid][i].desc3 =
+			__raw_readl(g_cbm_ls_base + CBM_LS_PORT_DESC(pid, 3));
+		i++;
+	}
+	/* AVM cbm.c:2001 — terminating sentinel for the in-list walk. */
+	g_cbm_dlist[pid][i].desc2 = 0;
+	return ret;
+}
+
+/*
+ * cbm_cpu_dequeue_list — gate + drain the LS ring for CPU dequeue port @pid.
+ * Port of AVM cqm/grx500/cbm.c:2005-2010.
+ *
+ * Refuses (CBM_FAILURE) to drain a port that is out of range
+ * (pid >= CPU_DQM_PORT_NUM) or not activated (its bit clear in
+ * g_cpu_port_alloc), so an unconfigured LS-output port never drains a ring;
+ * otherwise delegates to cbm_ls_deq_list.
+ */
+static int cbm_cpu_dequeue_list(u32 pid)
+{
+	if (pid >= CPU_DQM_PORT_NUM || (((1UL << pid) & g_cpu_port_alloc) == 0))
+		return CBM_FAILURE;
+	return cbm_ls_deq_list(pid);
+}
+
+/*
+ * do_cbm_tasklet — LS RX bottom half. Port of AVM cqm/grx500/cbm.c:2578-2668
+ * with the two task-mandated datapath adaptations (CQ-002 A copy-break +
+ * CQ-004 A descriptor-phys dma_sync) replacing AVM's build_skb_grx500/dp_rx
+ * tail and dma_map_single.
+ *
+ * @cpu: tasklet data; pinned to 0 (the only activated LS-output port,
+ *       g_cpu_port_alloc bit 0 — CQ-001 A / AS-001). Every line-4 register
+ *       access below therefore uses the literal CBM interrupt line 4 (== 4 +
+ *       cpu with cpu == 0); AVM's 4 + cpu generalisation collapses to 4 here.
+ *
+ * Flow: read the LS port status; if the queued count is non-zero, stage the
+ * ring via cbm_cpu_dequeue_list and walk the staged descriptors to the
+ * desc2 == 0 sentinel; for each, decode then deliver (copy-break, only when a
+ * netdev is bound and the segment resolves, preceded by the dma_sync) and
+ * recycle the segment EXACTLY ONCE on every path. Finally re-arm: if the
+ * budget was hit or the ring is not yet QUEUE_EMPTY, re-schedule WITHOUT
+ * re-arming; else ack line 4, flush, and re-enable IRNEN_LS + CBM line 4.
+ */
+/*
+ * IG-120 (ls_w1c): clear the Load-Spreader IRN capture register on the drained
+ * re-arm path. Faithful port of AVM ls_intr_handler (cbm.c:2228-2244): read the
+ * LS IRN capture-ICR (IRNICR_LS 0x914), mask to this pid's 2 bits
+ * (3 << (pid*2+16)), then W1C the LS IRN capture register (IRNCR_LS 0x910).
+ * ICR (0x914) and CR (0x910) are DISTINCT registers — the readback comes from
+ * the ICR, the W1C goes to the CR; both offsets are ported verbatim. AVM's
+ * xrx500_cbm_r32/w32 on CBM_LS_BASE map to __raw_readl/writel on g_cbm_ls_base.
+ */
+static void ls_intr_handler(u32 pid)
+{
+	u32 ls_intr_stat;
+
+	if (!g_cbm_ls_base) {
+		pr_err_ratelimited("cbm: ls_intr_handler: g_cbm_ls_base NULL\n");
+		return;
+	}
+
+	/* AVM cbm.c:2232 — read the LS IRN capture-ICR (0x914). */
+	ls_intr_stat = __raw_readl(g_cbm_ls_base + IRNICR_LS);
+	/* AVM cbm.c:2239 — mask to this pid's 2 bits (3 << (pid*2+16)). */
+	ls_intr_stat &= (u32)(3UL << (pid * 2 + 16));
+	/* AVM cbm.c:2240 — W1C the LS IRN capture register (0x910). */
+	__raw_writel(ls_intr_stat, g_cbm_ls_base + IRNCR_LS);
+}
+
+static void do_cbm_tasklet(unsigned long cpu)
+{
+	struct cbm_desc *desc_list;
+	u32 status;
+	u32 pkt_recvd;
+	int deq_ret = CBM_SUCCESS;
+	int j = 0;
+
+	if (!g_cbm_ls_base || !g_cbm_base) {
+		pr_err_ratelimited("cbm: do_cbm_tasklet: MMIO base NULL\n");
+		return;
+	}
+
+	/* LS port queued-descriptor count (AVM cbm.c:2592-2595). */
+	status = __raw_readl(g_cbm_ls_base + CBM_LS_PORT_STATUS(cpu));
+	pkt_recvd = (status & CBM_LS_QUEUE_LEN_MASK) >> CBM_LS_QUEUE_LEN_POS;
+	pr_debug("cbm: do_cbm_tasklet: cpu %lu qlen %u\n", cpu, pkt_recvd);
+
+	if (pkt_recvd > 0) {
+		/* Stage the ring into g_cbm_dlist[cpu][] (AVM cbm.c:2599-2600). */
+		deq_ret = cbm_cpu_dequeue_list((u32)cpu);
+		/* IG-156b: a guard rejection (port bit not in g_cpu_port_alloc)
+		 * must never silently walk the stale staging list again.
+		 */
+		if (deq_ret == CBM_FAILURE)
+			pr_err_ratelimited("cbm: do_cbm_tasklet: dequeue_list REJECTED for port %lu (alloc=0x%lx)\n",
+					   cpu, g_cpu_port_alloc);
+		desc_list = &g_cbm_dlist[cpu][0];
+
+		/* Walk staged descriptors to the desc2 == 0 sentinel. */
+		while (desc_list->desc2) {
+			u32 desc2_phys = desc_list->desc2;
+			u32 desc3 = desc_list->desc3;
+			int data_len = (int)(desc3 & 0x0000FFFFu);
+			int data_offset = (int)((desc3 & 0x03800000u) >> 23);
+			struct net_device *ndev = g_cbm_rx_netdev;
+			void *buf_virt = NULL;
+			u32 seg_off;
+
+			/* IG-121 (FIX #2): validate the LS descriptor length BEFORE
+			 * any copy. A stale/garbage descriptor must not drive an
+			 * over-read of the fixed std segment (data_len up to 65535
+			 * out of a std_frm_size buffer) nor a skb_pull() underflow
+			 * (data_len < the 8-byte PMAC hdr). AVM gets this bound for
+			 * free from build_skb_grx500's frag_size > size_used reject
+			 * (cbm.c:1070-1075); our copy-break port must clamp it here.
+			 * The drop-path free is legit — the frame is never delivered,
+			 * so the 'continue' skips the tail recycle (no double-free).
+			 *
+			 * The upper bound must also account for the FIXED in-segment
+			 * start offset baked into desc2_phys: the DMA2RX descriptor is
+			 * seeded as (buf_phys + CBM_FIXED_RX_OFFSET) & ~0x7
+			 * (cbm_dma.c:223,296), and cbm_buf_phys_to_virt(desc2_phys)
+			 * resolves to the VA AT that offset, not the segment base. The
+			 * memcpy reads [buf_virt + data_offset, +data_len), so the read
+			 * END measured from the segment base is
+			 * seg_off + data_offset + data_len. Deriving seg_off from the
+			 * resolved phys (rather than the seed constant) tracks the
+			 * actual & ~0x7 alignment exactly. std_frm_size is a power of
+			 * two (2048), so the mask is valid. This mirrors AVM's
+			 * real_buf_start = data_ptr & 0xfffff800 / size_used bound
+			 * (cbm.c:1067-1075), which our copy-break clamp must reproduce.
+			 */
+			seg_off = desc2_phys & (g_cbm_buff.std_frm_size - 1);
+			if (data_len < (CBM_PMAC_RX_HDR_LEN + ETH_HLEN) ||
+			    (u32)(seg_off + data_offset + data_len) >
+				    g_cbm_buff.std_frm_size) {
+				pr_err_ratelimited("cbm: bad RX desc len=%d off=%d segoff=%u (recycled)\n",
+						   data_len, data_offset, seg_off);
+				cbm_fsqm_buf_free(CBM_CPU_DQM_RETURN_PORT, desc2_phys);
+				desc_list = &g_cbm_dlist[cpu][++j];
+				continue;
+			}
+
+			/* ADAPTATION 1 (AS-004): resolve the segment VA through the
+			 * no-map pool walk, NEVER __va(desc2) — the pool is
+			 * MEMREMAP_WB no-map, so __va/virt_to_phys are invalid.
+			 */
+			if (ndev)
+				buf_virt = cbm_buf_phys_to_virt(desc2_phys);
+
+			if (ndev && buf_virt) {
+				struct sk_buff *skb;
+
+				/* IG-160/IG-162 FIX (replaces the CQ-004 A phys-keyed
+				 * dma_sync_single_for_cpu): invalidate through the
+				 * MEMREMAP VA the CPU actually reads, NOT the physical
+				 * address. arch_sync_dma_for_cpu invalidates via the
+				 * KSEG0/__va alias of the phys address, but the pool is
+				 * a MEMREMAP_WB no-map mapping at a DIFFERENT VA — on
+				 * this VIPT dcache the wrong-alias invalidate leaves the
+				 * memremap-VA lines STALE, and the memcpy below shipped
+				 * stale bytes (IG-160 exposed it: delivered frames read
+				 * as zeros — DA/SA/ethertype all 0 — while the DMA had
+				 * written real frame bytes to DRAM). This mirrors the
+				 * TX-side IG-077 fix verbatim (intel_xrx500.c:1607
+				 * dma_cache_wback on the memremap VA, whose comment
+				 * already warned "phys-based dma_sync would compute the
+				 * wrong VA"). buf_virt corresponds to desc2_phys, so
+				 * the range base/length match the old sync exactly.
+				 */
+				dma_cache_inv((unsigned long)buf_virt,
+					      (unsigned long)(data_offset + data_len));
+
+				/* CQ-002 A copy-break: fresh slab skb, copy the frame
+				 * out of the pool; the pool segment is recycled below.
+				 * NO __build_skb over the no-map pool, NO skb
+				 * destructor recycle hook, NO dp_rx/PPA/PPv4.
+				 */
+				skb = netdev_alloc_skb_ip_align(ndev, data_len);
+				if (skb) {
+					memcpy(skb_put(skb, data_len),
+					       (u8 *)buf_virt + data_offset,
+					       (size_t)data_len);
+					/* Strip the 8-byte PMAC RX header before L2. */
+					skb_pull(skb, CBM_PMAC_RX_HDR_LEN);
+					skb->dev = ndev;
+					skb->protocol = eth_type_trans(skb, ndev);
+					netif_receive_skb(skb);
+					ndev->stats.rx_packets++;
+					ndev->stats.rx_bytes += data_len;
+				} else {
+					pr_err_ratelimited("cbm: do_cbm_tasklet: skb alloc failed; dropping frame (segment recycled)\n");
+				}
+			}
+
+			/* Return the consumed CBM segment to the FSQM free pool on
+			 * EVERY path (delivered included). This is copy-break: the
+			 * bytes were memcpy'd into a plain slab skb, so the pool
+			 * segment is finished the instant the copy completes and must
+			 * be returned exactly once. There is NO CBM/FSQM hardware
+			 * auto-recycle on the RX-consume path — cbm_ls_deq_list only
+			 * READS the LS port registers (AVM cbm.c:1985-2003) and the
+			 * sole return path to the free-list is the DQM ptr_rtn write in
+			 * cbm_fsqm_buf_free / cbm_buffer_free_grx500 (AVM cbm.c:1039).
+			 * AVM returns every consumed segment exactly once too: drop =
+			 * immediately in the tasklet (cbm.c:2645), delivered = deferred
+			 * via dp_rx -> the registered .cbm_buffer_free callback
+			 * (cbm.c:5425), refcount-gated (cbm.c:1018-1023). Our port has
+			 * no skb destructor / dp_rx, so the delivered segment would
+			 * otherwise be returned by nobody — every delivered frame would
+			 * permanently consume one free-list segment, draining the pool
+			 * that cbm_fsqm_buf_alloc (new_sptr BUFREQ, cbm_dma.c:368-409)
+			 * refills the DMA2RX ring from, until 'FSQM std pool empty' ->
+			 * DMA2RX starves -> silent RX re-hang (the IG-120 wedge). The
+			 * cbm_dma.c:412-420 'HW recycles after egress' note applies to
+			 * the TX-EGRESS rollback case, NOT this RX-consume path (no
+			 * egress here).
+			 */
+			cbm_fsqm_buf_free(CBM_CPU_DQM_RETURN_PORT, desc2_phys);
+
+			desc_list = &g_cbm_dlist[cpu][++j];
+		}
+	}
+
+	/* Re-arm (AVM cbm.c:2650-2667). Re-read status so the QUEUE_EMPTY
+	 * decision reflects frames that arrived during the drain.
+	 */
+	status = __raw_readl(g_cbm_ls_base + CBM_LS_PORT_STATUS(cpu));
+	if ((deq_ret == CBM_RESCHEDULE || !(status & CBM_LS_QUEUE_EMPTY)) &&
+	    g_cbm_resched_cnt[cpu] < CBM_RX_RESCHED_CAP) {
+		/* Budget hit or ring still non-empty: drain again next tick
+		 * WITHOUT re-arming the LS line (it stays masked), so no frame
+		 * is lost and the level-triggered line cannot storm.
+		 *
+		 * IG-121 (FIX #3): count the self-reschedule. If the ring fails
+		 * to drain to QUEUE_EMPTY within CBM_RX_RESCHED_CAP ticks, the
+		 * AND above goes false and we fall through to the re-arm branch
+		 * instead of looping forever — a residual non-QUEUE_EMPTY status
+		 * can no longer livelock the softirq.
+		 */
+		g_cbm_resched_cnt[cpu]++;
+		tasklet_schedule(&cbm_tasklet[cpu]);
+	} else {
+		/* Ring drained to QUEUE_EMPTY (or IG-121 reschedule cap hit):
+		 * ack the CBM line-4 LS source, dummy-read to flush, then
+		 * re-enable the IRNEN_LS bits at g_cbm_ls_base + 0x918 (CQ-003 A:
+		 * the LS window, NOT g_cbm_base) and the CBM line-4 enable so the
+		 * next LS interrupt can fire.
+		 */
+		/* IG-121 (FIX #3): drained/empty (or capped) — reset the counter
+		 * so the bound applies per stall episode, not cumulatively.
+		 */
+		g_cbm_resched_cnt[cpu] = 0;
+		/* IG-120 (ls_w1c): AVM cbm.c:2653 — W1C IRNCR_LS FIRST, before the
+		 * wmb() and the CBM line-4 ack/re-arm below. Order is load-bearing
+		 * and matches AVM exactly; the reschedule branch is left untouched.
+		 */
+		ls_intr_handler((u32)cpu);
+		wmb();
+		/* IG-156: LS port p signals CBM interrupt LINE (4+p) — line 4
+		 * was hardcoded (correct only for port 0). Bit (0x100<<p)
+		 * within the line block was already parameterized.
+		 */
+		__raw_writel((u32)(BIT(cpu) << 8),
+			     g_cbm_base + CBM_INT_LINE(4 + (int)cpu, cbm_irncr));
+		__raw_readl(g_cbm_base + CBM_INT_LINE(4 + (int)cpu, cbm_irnicr)); /* dummy read */
+		__raw_readl(g_cbm_base + CBM_INT_LINE(4 + (int)cpu, cbm_irncr));  /* flush */
+		rmb();
+		__raw_writel(__raw_readl(g_cbm_ls_base + IRNEN_LS) |
+				     (u32)(3UL << (cpu * 2 + 16)),
+			     g_cbm_ls_base + IRNEN_LS);
+		__raw_writel((u32)((1UL << cpu) << 8),
+			     g_cbm_base + CBM_INT_LINE(4 + (int)cpu, cbm_irnen));
+	}
+}
+
+/*
+ * cbm_rx_set_netdev — bind (or, with NULL, unbind) the single netdev the RX
+ * engine delivers to. Intra-module; called from intel_xrx500.c ndo_open(dev)
+ * / ndo_stop(NULL) in ST-004. Accepts NULL: do_cbm_tasklet then drops and
+ * recycles each frame, so an unbind racing an in-flight tasklet is safe (no
+ * leak, no oops).
+ */
+void cbm_rx_set_netdev(struct net_device *dev)
+{
+	g_cbm_rx_netdev = dev;
+}
+
+/*
+ * cbm_rx_engine_init — one-time RX engine arm. Intra-module; called once from
+ * cbm_xrx500_probe before the controllers/interrupts come up (ST-003).
+ * tasklet_init MUST precede set_bit so a (hypothetically early) schedule can
+ * never run against an uninitialised tasklet. Bit 0 is the cpu/LS-output
+ * dequeue index (CQ-001 A), NOT the CPU DQM return port 2.
+ */
+void cbm_rx_engine_init(void)
+{
+	/* IG-156: one tasklet per LS port (data = port). Host-RX (q35 via
+	 * DQM cpu_p2) arrives on LS PORT 2 / CBM line 6 — the nosmp port
+	 * only ever serviced port 0.
+	 */
+	tasklet_init(&cbm_tasklet[0], do_cbm_tasklet, 0);
+	tasklet_init(&cbm_tasklet[1], do_cbm_tasklet, 1);
+	tasklet_init(&cbm_tasklet[2], do_cbm_tasklet, 2);
+	tasklet_init(&cbm_tasklet[3], do_cbm_tasklet, 3);
+	set_bit(0, &g_cpu_port_alloc);
+	/* IG-156b: host-RX drains LS PORT 2 (q35 -> DQM cpu_p2 pairing) — the
+	 * cbm_cpu_dequeue_list guard rejected pid=2 (only bit 0 was set), so
+	 * the tasklet walked a stale all-zeros staging list forever (the
+	 * IG-156 boot's livelock: qlen=1, pops read zeros, rxd=0). AVM sets
+	 * g_cpu_port_alloc per configured DQM CPU port (RESERVE_PORTS in
+	 * conf_dqm_cpu_port — ports 1/2/3 on the 7560).
+	 */
+	set_bit(2, &g_cpu_port_alloc);
+}
