+/*
+ * cbm_isr_4 — top-level ISR for line 4. Port of AVM cqm/grx500/cbm.c:2670-2695.
+ *
+ * SUB-8 ST-003 restores the AVM Load-Spreader (LS) top-half that Sub-4 left as
+ * an ack-and-drop stub. On the LS line bit (cbm_irncr & 0x0100) — the cpu-0 LS
+ * line (AS-001 / CQ-001 A) — this disables CBM interrupt line 4 (g_cbm_base),
+ * dummy-reads to flush, masks the LS IRQ enable (clears bits 3 << (0*2 + 16) at
+ * g_cbm_ls_base + IRNEN_LS, CQ-003 A), schedules the RX bottom half
+ * cbm_tasklet[0], and returns IRQ_HANDLED. do_cbm_tasklet (ST-002) then drains
+ * LS output port 0, delivers via netif_receive_skb, recycles the CBM segment,
+ * and re-arms the SAME IRNEN_LS bits this top-half masks (AC-003-4:
+ * mask-then-drain-then-rearm is symmetric for the level-triggered line). cpu is
+ * pinned to 0, so AVM's "4 + cpu" / "cpu * 2 + 16" collapse to line 4 / shift 16.
+ *
+ * The NON-LS path is UNCHANGED from the Sub-4 stub (AC-003-2): the three IRNCR
+ * reads at entry, the captured-value write-clear of all three CBM_INT_LINE(4,*)
+ * registers, and the IRQ_HANDLED-if-any-nonzero / IRQ_NONE return (line is
+ * IRQF_SHARED — IRQ_NONE lets the IRQ subsystem try the next handler). Only the
+ * (cbm_irncr & 0x0100) path changes; cbm_isr_5/6/7 are not touched (their LS
+ * lines stay un-armed because cbm_rx_engine_init activates only LS port 0).
+ */
+irqreturn_t cbm_isr_4(int irq, void *dev_id)
+{
+	u32 cbm_irncr;
+	u32 igp_irncr;
+	u32 egp_irncr;
+
+	(void)irq;
+	(void)dev_id;
+
+	if (!g_cbm_base) {
+		pr_err_ratelimited("cbm: cbm_isr_4: g_cbm_base NULL\n");
+		return IRQ_NONE;
+	}
+
+	/* Three reads — AC-005-1 invariant. */
+	cbm_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(4, cbm_irncr));
+	igp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(4, igp_irncr));
+	egp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(4, egp_irncr));
+
+	pr_debug("cbm: isr4: cbm_irncr=0x%x igp_irncr=0x%x egp_irncr=0x%x\n",
+		 cbm_irncr, igp_irncr, egp_irncr);
+
+	/*
+	 * SUB-8 ST-003 — restore the AVM LS top-half (AVM cqm/grx500/cbm.c:
+	 * 2678-2688). 0x0100 is the cpu-0 LS line bit; cpu is pinned to 0
+	 * (AS-001 / CQ-001 A).
+	 */
+	if (cbm_irncr & 0x0100) {
+		/* AVM 2680 — disable CBM interrupt line 4 (g_cbm_base). */
+		__raw_writel(0, g_cbm_base + CBM_INT_LINE(4, cbm_irnen));
+		/* AVM 2682 — dummy read-back to flush the disable write. */
+		__raw_readl(g_cbm_base + CBM_INT_LINE(4, cbm_irnen));
+		/*
+		 * AVM 2684 — mask the LS IRQ enable: clear bits 3 << (0*2 + 16)
+		 * at g_cbm_ls_base + IRNEN_LS (0x918). CQ-003 A: the LS window
+		 * (g_cbm_ls_base), NOT g_cbm_base — a mask written to g_cbm_base
+		 * would not quiesce the level-triggered LS line and would storm.
+		 * Identical bits/offset to the do_cbm_tasklet re-arm (AC-003-4).
+		 */
+		__raw_writel(__raw_readl(g_cbm_ls_base + IRNEN_LS) &
+				     ~(u32)(3UL << (0 * 2 + 16)),
+			     g_cbm_ls_base + IRNEN_LS);
+		/* AVM 2685 — dummy read-back to flush the mask write. */
+		__raw_readl(g_cbm_ls_base + IRNEN_LS);
+		pr_debug("cbm: isr4: load spreader interrupt on pid 0; schedule tasklet\n");
+		/* AVM 2688 — wake the RX bottom half (ST-002). */
+		tasklet_schedule(&cbm_tasklet[0]);
+		/* AVM 2694 — IRQ_HANDLED on the LS path. */
+		return IRQ_HANDLED;
+	}
+
+	/*
+	 * NON-LS path UNCHANGED (AC-003-2): write-clear all three captured
+	 * IRNCRs and return IRQ_HANDLED if any was set, else IRQ_NONE so the
+	 * IRQF_SHARED peers on this GIC line are still polled.
+	 */
+	__raw_writel(cbm_irncr, g_cbm_base + CBM_INT_LINE(4, cbm_irncr));
+	__raw_writel(igp_irncr, g_cbm_base + CBM_INT_LINE(4, igp_irncr));
+	__raw_writel(egp_irncr, g_cbm_base + CBM_INT_LINE(4, egp_irncr));
+
+	if (cbm_irncr || igp_irncr || egp_irncr)
+		return IRQ_HANDLED;
+	return IRQ_NONE;
+}
+
+/*
+ * cbm_isr_5 — top-level ISR for line 5. Port of AVM cqm/grx500/cbm.c:2697-2728.
+ *
+ * AVM behaviour summary: if cbm_irncr & 0x0200 (LS interrupt for pid 1),
+ * disable IRNEN and tasklet_schedule. ENABLE_LL_DEBUG path additionally
+ * handles cbm_irncr & 0x10000 (double-free debug) — stripped in Sub-4
+ * (ENABLE_LL_DEBUG was never set in the stock firmware). Else: ls_intr +
+ * ack + IRQ_NONE.
+ *
+ * Sub-4 simplifications: same as cbm_isr_4. No tasklet, no LS handler,
+ * no ENABLE_LL_DEBUG branch. Three reads + log + write-clear + return.
+ */
+irqreturn_t cbm_isr_5(int irq, void *dev_id)
+{
+	u32 cbm_irncr;
+	u32 igp_irncr;
+	u32 egp_irncr;
+
+	(void)irq;
+	(void)dev_id;
+
+	if (!g_cbm_base) {
+		pr_err_ratelimited("cbm: cbm_isr_5: g_cbm_base NULL\n");
+		return IRQ_NONE;
+	}
+
+	cbm_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(5, cbm_irncr));
+	igp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(5, igp_irncr));
+	egp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(5, egp_irncr));
+
+	pr_debug("cbm: isr5: cbm_irncr=0x%x igp_irncr=0x%x egp_irncr=0x%x\n",
+		 cbm_irncr, igp_irncr, egp_irncr);
+
+	/* AVM 2703 — 0x0200 = LS interrupt for cpu 1. */
+	/* IG-156 — same silent-storm hazard as line 6: LS port 1 is a
+	 * LEVEL source; mask + defer to tasklet[1] instead of blind-ack.
+	 */
+	if (cbm_irncr & 0x0200) {
+		__raw_writel(0, g_cbm_base + CBM_INT_LINE(5, cbm_irnen));
+		__raw_readl(g_cbm_base + CBM_INT_LINE(5, cbm_irnen));
+		__raw_writel(__raw_readl(g_cbm_ls_base + IRNEN_LS) &
+				     ~(u32)(3UL << (1 * 2 + 16)),
+			     g_cbm_ls_base + IRNEN_LS);
+		__raw_readl(g_cbm_ls_base + IRNEN_LS);
+		tasklet_schedule(&cbm_tasklet[1]);
+		return IRQ_HANDLED;
+	}
+
+	__raw_writel(cbm_irncr, g_cbm_base + CBM_INT_LINE(5, cbm_irncr));
+	__raw_writel(igp_irncr, g_cbm_base + CBM_INT_LINE(5, igp_irncr));
+	__raw_writel(egp_irncr, g_cbm_base + CBM_INT_LINE(5, egp_irncr));
+
+	if (cbm_irncr || igp_irncr || egp_irncr)
+		return IRQ_HANDLED;
+	return IRQ_NONE;
+}
