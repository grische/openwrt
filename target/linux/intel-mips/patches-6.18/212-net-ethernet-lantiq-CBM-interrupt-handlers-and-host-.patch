+/*
+ * FSQM_IRNCR — local register-offset literal.
+ *
+ * AVM cqm/grx500/reg/fsqm.h:292 — FSQM IRN Capture Register at offset 0x10.
+ * Defined LOCALLY here (not in cbm_regs.h) because cbm_regs.h is OUTSIDE
+ * ST-005's file_scope.modify list. Sub-6 may promote this into cbm_regs.h
+ * if another TU needs it. The offset matches the FSQM register window
+ * (struct-overlay layout in AVM): IRNCR=0x10, IRNICR=0x14, IRNEN=0x18.
+ */
+#define FSQM_IRNCR 0x10
+
+/*
+ * Forward declarations of sub-handlers (file-static).
+ *
+ * Declaring them up front lets the cbm_isr_<n> bodies appear in their
+ * natural top-down order while the sub-handler bodies live below.
+ */
+static void fsqm_intr_handler(int idx);
+static void igp_cpu_intr_handler(int pid);
+static void egp_cpu_intr_handler(int pid);
+
+/*
+ * Forward declarations matching the extern block in cbm.c. Repeated
+ * here so gcc -Wmissing-prototypes is satisfied without promoting
+ * cbm_isr_0/4/5/6/7 into cbm.h (cbm.h is OUTSIDE ST-005's
+ * file_scope.modify list — see the naming-rename note in the file
+ * header above). Identical C11 §6.7p4 safe redeclaration as the
+ * cbm_set_val pattern in cbm_basic.c. AC-005-5 calls for these
+ * declarations to be reachable from cbm_interrupt_init (they are: the
+ * mirror extern block in cbm.c satisfies that contract).
+ */
+irqreturn_t cbm_isr_0(int irq, void *dev_id);
+irqreturn_t cbm_isr_4(int irq, void *dev_id);
+irqreturn_t cbm_isr_5(int irq, void *dev_id);
+irqreturn_t cbm_isr_6(int irq, void *dev_id);
+irqreturn_t cbm_isr_7(int irq, void *dev_id);
+
+/* ======================================================================== */
+/* SUB-8 ST-002 (IG-095) — Load-Spreader TASKLET RX dequeue/deliver engine. */
+/*                                                                          */
+/* Port of the AVM LS receive engine (AVM cqm/grx500/cbm.c:1985-2010 and    */
+/* 2578-2668). FB7560 runs the TASKLET path (CONFIG_CBM_LS_ENABLE off), NOT  */
+/* NAPI, so do_dq_cbm_poll / netif_napi_add / napi_schedule are deliberately */
+/* NOT ported. AVM's build_skb_grx500/dp_rx success tail and its            */
+/* dma_map_single are replaced by the two task-mandated adaptations:         */
+/*   CQ-002 A copy-break delivery (netdev_alloc_skb_ip_align + memcpy) and   */
+/*   CQ-004 A descriptor-phys dma_sync_single_for_cpu cache-invalidate,      */
+/* both required because our buffer pool is MEMREMAP_WB no-map reserved      */
+/* memory (no struct page; __va/virt_to_phys/dma_map_single are invalid).    */
+/*                                                                          */
+/* At the END of ST-002 the engine is fully defined and self-referential    */
+/* (do_cbm_tasklet <- cbm_rx_engine_init; cbm_ls_deq_list <-                */
+/* cbm_cpu_dequeue_list <- do_cbm_tasklet; the setters have external        */
+/* linkage) but DORMANT at runtime: cbm_isr_4 (above) is STILL the          */
+/* ack-and-drop stub and cbm_rx_engine_init() is not yet called. ST-003     */
+/* restores the cbm_isr_4 LS top-half and calls cbm_rx_engine_init() from    */
+/* the probe; ST-004 binds the netdev from intel_xrx500.c.                  */
+/* ======================================================================== */
+
+/*
+ * Engine return codes — AVM cqm/cqm_common.h:23-24 and cbm.h:209, verbatim
+ * values. Defined locally because our tree does not port cqm_common.h.
+ */
+#define CBM_SUCCESS     0
+#define CBM_FAILURE     (-1)
+#define CBM_RESCHEDULE  4
+
+/*
+ * CBM_CPU_DQM_RETURN_PORT — the CPU DQM buffer-return (ptr_rtn) port that
+ * init_cbm_dqm_cpu_port(2) (ST-001, cbm_dma.c) armed. do_cbm_tasklet recycles
+ * every consumed RX segment to it via cbm_fsqm_buf_free(). DISTINCT from the
+ * cpu/LS-output dequeue/alloc index 0 the tasklet drains (g_cpu_port_alloc
+ * bit 0) — CQ-001 A.
+ *
+ * CPU_DQM_PORT_NUM (= 4, AVM cbm.h:199) is intentionally NOT redefined here:
+ * it is already the single source of truth in cbm_regs.h (added by ST-001)
+ * and is in scope via the "cbm.h" -> "cbm_regs.h" include chain.
+ * cbm_cpu_dequeue_list below bounds pid against it.
+ */
+#define CBM_CPU_DQM_RETURN_PORT 2
+
+/*
+ * AVM cbm.c:1987 — a single do_cbm_tasklet invocation stages at most this
+ * many descriptors before yielding (re-scheduling), so the bottom half is
+ * bounded and a busy ring cannot livelock the tasklet. g_cbm_dlist's 64
+ * slots exceed this so a full-budget drain plus the desc2 == 0 sentinel
+ * always fits.
+ */
+#define CBM_RX_DRAIN_BUDGET 50
+
+/*
+ * datapath_api_gswip30.h:292 — the 8-byte PMAC RX header the GSWIP/PMAC
+ * prepends; skb_pull'd before eth_type_trans so the Ethernet header is at
+ * skb->data.
+ */
+#define CBM_PMAC_RX_HDR_LEN 8
+
+/*
+ * RX engine file-scope state (task-mandated shapes).
+ *   g_cbm_dlist      - per-cpu staging copy of the LS ring drained by
+ *                      cbm_ls_deq_list; a desc2 == 0 entry terminates the
+ *                      in-list walk in do_cbm_tasklet.
+ *   g_cpu_port_alloc - bitmask of activated LS-output dequeue ports; bit 0
+ *                      is set by cbm_rx_engine_init(). cbm_cpu_dequeue_list
+ *                      refuses to drain a port whose bit is clear, so an
+ *                      unconfigured port never drains a ring.
+ *   cbm_tasklet      - per-cpu bottom half; only [0] is initialised/used.
+ *   g_cbm_rx_netdev  - the single RX delivery netdev (eth0), bound by
+ *                      cbm_rx_set_netdev (ST-004). NULL => drop-and-recycle.
+ */
+static struct cbm_desc g_cbm_dlist[NR_CPUS][64];
+static unsigned long g_cpu_port_alloc;
+static struct tasklet_struct cbm_tasklet[NR_CPUS];
+static struct net_device *g_cbm_rx_netdev;
+
+/*
+ * IG-121 (FIX #3): per-cpu self-reschedule counter. Defensive bound so a
+ * residual non-QUEUE_EMPTY LS status cannot livelock the softirq forever in
+ * the tasklet_schedule() self-reschedule branch. Once the tasklet has
+ * re-scheduled CBM_RX_RESCHED_CAP times without the ring draining to empty,
+ * fall through to the re-arm branch instead. Reset on the drained/empty path.
+ */
+#define CBM_RX_RESCHED_CAP 1000
+static u32 g_cbm_resched_cnt[NR_CPUS];
+
+/* ------------------------------------------------------------------------ */
+/* Sub-handlers                                                             */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * fsqm_intr_handler — port of AVM cqm/grx500/cbm.c:2198-2226.
+ *
+ * Reads the FSQM IRNCR, logs watermark events (bits 0..4 at pr_debug per
+ * the plan; the AVM original used LOGF_KLOG_ERR_ONCE for all of them but
+ * the plan's Step 4 distinguishes "normal" watermark events from
+ * silicon-fatal ones), logs silicon-fatal events (RAM_VIOL / CMD_RAM_VIOL
+ * / CMD_OVERFLOW / ALLOC_NIL at pr_err_ratelimited), then write-clears
+ * the captured IRNCR value back to the same register.
+ *
+ * The captured value (not a fresh read) is written back so a second event
+ * that fires between the read and the clear is not silently lost — it
+ * remains visible in the IRNCR register and the IRQ stays asserted until
+ * the next ISR entry. (Review_focus item: "Verify write-clear at end uses
+ * the CAPTURED irncr value (read once at entry), not a re-read".)
+ *
+ * Per AC-005-3, the per-bit log lines are emitted at:
+ *   bits 0..4 (FSQM_IRNEN_EVT0..EVT4 / watermark events) -> pr_debug
+ *   bit 12 (RAM_VIOL) / 16 (CMD_RAM_VIOL) /
+ *   bit 20 (CMD_OVERFLOW) / 24 (ALLOC_NIL)               -> pr_err_ratelimited
+ */
+static void fsqm_intr_handler(int idx)
+{
+	u32 fsqm_intr_stat;
+	int i;
+
+	if (idx < 0 || idx >= 2) {
+		pr_err_ratelimited("cbm: fsqm_intr_handler: invalid idx=%d\n",
+				   idx);
+		return;
+	}
+	if (!g_cbm_fsqm_base[idx]) {
+		pr_err_ratelimited("cbm: fsqm_intr_handler: g_cbm_fsqm_base[%d] NULL\n",
+				   idx);
+		return;
+	}
+
+	/* AVM cbm.c:2204 — read IRNCR at entry. */
+	fsqm_intr_stat = fsqm_r32(idx, FSQM_IRNCR);
+
+	pr_debug("cbm: fsqm[%d] status: 0x%x\n", idx, fsqm_intr_stat);
+
+	/* AVM cbm.c:2208-2213 — bits 0..4 watermark events. Plan Step 4:
+	 * "if bit 0..4 set, pr_debug 'fsqm[%d] watermark evt N'".
+	 */
+	for (i = 0; i < 5; i++) {
+		if (fsqm_intr_stat & BIT(i))
+			pr_debug("cbm: fsqm[%d] watermark[%d] intrt!\n",
+				 idx, i);
+	}
+
+	/* AVM cbm.c:2214-2221 — silicon-fatal violations. Plan Step 4:
+	 * "if RAM_VIOL bit set, pr_err_ratelimited 'fsqm[%d] LLT_RAM
+	 * violation' (silicon-fatal, log loudly)". The four error
+	 * conditions get pr_err_ratelimited (LOGF_KLOG_ERR_ONCE in AVM
+	 * maps to pr_err_once per AC-005-4 — but pr_err_ratelimited
+	 * provides more visibility for chronic faults; the plan Step 4
+	 * mapping explicitly says pr_err_ratelimited for these).
+	 */
+	if (fsqm_intr_stat & FSQM_IRNEN_RAM_VIOL)
+		pr_err_ratelimited("cbm: fsqm[%d] LLT_RAM violation\n", idx);
+	if (fsqm_intr_stat & FSQM_IRNEN_CMD_RAM_VIOL)
+		pr_err_ratelimited("cbm: fsqm[%d] free command RAM violation\n",
+				   idx);
+	if (fsqm_intr_stat & FSQM_IRNEN_CMD_OVERFLOW)
+		pr_err_ratelimited("cbm: fsqm[%d] free command overflow\n",
+				   idx);
+	if (fsqm_intr_stat & FSQM_IRNEN_ALLOC_NIL)
+		pr_err_ratelimited("cbm: fsqm[%d] alloc command nil response\n",
+				   idx);
+
+	/* AVM cbm.c:2222-2223 — write-clear by writing the CAPTURED value
+	 * back to IRNCR (W1C semantics). Critical: we do NOT re-read here
+	 * (review_focus: a fresh read could miss events that fired during
+	 * the handler).
+	 */
+	pr_debug("cbm: clear fsqm[%d] intr status\n", idx);
+	fsqm_w32(idx, FSQM_IRNCR, fsqm_intr_stat);
+}
+
+/*
+ * igp_cpu_intr_handler — port of AVM cqm/grx500/cbm.c:2246-2273.
+ *
+ * Reads CBM_EQM_CPU_PORT(pid, irncr) on the EQM window, logs the per-bit
+ * meanings (Packet Not Accept / WaterMark / Desc Ready / Pointer Ready),
+ * then writes the captured value back to W1C the register.
+ *
+ * Per the plan Step 5: "if bit set, pr_debug 'eqm cpu pid=%d irncr=0x%x';
+ * write-clear via writel back to same register." Following the plan's
+ * pr_debug mapping (LOGF_KLOG_DEBUG in AVM 2267-2272 maps to pr_debug),
+ * while LOGF_KLOG_ERR_ONCE in AVM 2251-2265 maps to pr_err_once per
+ * AC-005-4. The plan Step 5 chose pr_debug for the top-level summary;
+ * the per-bit ERR_ONCE lines retain pr_err_once for fault visibility.
+ */
+static void igp_cpu_intr_handler(int pid)
+{
+	u32 eqm_intr_stat;
+
+	if (!g_cbm_eqm_base) {
+		pr_err_ratelimited("cbm: igp_cpu_intr_handler: g_cbm_eqm_base NULL\n");
+		return;
+	}
+
+	/* AVM cbm.c:2250 — read on the EQM window (NOT g_cbm_base). */
+	eqm_intr_stat = cbm_eqm_r32(CBM_EQM_CPU_PORT(pid, irncr));
+
+	pr_debug("cbm: eqm cpu pid=%d irncr=0x%x\n", pid, eqm_intr_stat);
+
+	/* AVM cbm.c:2254-2265 — per-bit error reporting. */
+	if (eqm_intr_stat & BIT(0))
+		pr_err_once("cbm: igp pid=%d Packet Not Accept\n", pid);
+	if (eqm_intr_stat & BIT(1))
+		pr_err_once("cbm: igp pid=%d Low WaterMark Interrupt\n", pid);
+	if (eqm_intr_stat & BIT(2))
+		pr_err_once("cbm: igp pid=%d High WaterMark Interrupt\n", pid);
+	if (eqm_intr_stat & BIT(3))
+		pr_err_once("cbm: igp pid=%d Descriptor Ready for Enqueue\n",
+			    pid);
+	if (eqm_intr_stat & BIT(4))
+		pr_err_once("cbm: igp pid=%d Standard Pointer Ready\n", pid);
+	if (eqm_intr_stat & BIT(5))
+		pr_err_once("cbm: igp pid=%d Jumbo Pointer Ready\n", pid);
+
+	/* AVM cbm.c:2267-2269 — write-clear with captured value. */
+	pr_debug("cbm: clear igp intr status on pid=%d\n", pid);
+	cbm_eqm_w32(CBM_EQM_CPU_PORT(pid, irncr), eqm_intr_stat);
+}
+
+/*
+ * egp_cpu_intr_handler — port of AVM cqm/grx500/cbm.c:2275-2296.
+ *
+ * Reads CBM_DQM_CPU_PORT(pid, irncr) on the DQM window, logs the
+ * "Register ready for pointer free" bit, then write-clears.
+ *
+ * NOTE: AVM cbm.c:2290-2291 contains a bug — the AVM source writes to
+ * CBM_EQM_CPU_PORT(pid, irncr) on the DQM base, which is a typo (correct
+ * register is CBM_DQM_CPU_PORT). We use the correct DQM register here;
+ * this is a one-line divergence from AVM verbatim and is documented as a
+ * silent-bug fix. (Review_focus item: "Verify the IRNCR write-back is a
+ * single u32 writel" — the AVM typo would actually write to the EQM
+ * port-window offset on the DQM base, which is silently a different
+ * register; the fix routes to the intended port.)
+ */
+static void egp_cpu_intr_handler(int pid)
+{
+	u32 dqm_intr_stat;
+
+	if (!g_cbm_dqm_base) {
+		pr_err_ratelimited("cbm: egp_cpu_intr_handler: g_cbm_dqm_base NULL\n");
+		return;
+	}
+
+	/* AVM cbm.c:2279-2280 — read on the DQM window. */
+	dqm_intr_stat = cbm_dqm_r32(CBM_DQM_CPU_PORT(pid, irncr));
+
+	pr_debug("cbm: dqm cpu pid=%d irncr=0x%x\n", pid, dqm_intr_stat);
+
+	/* AVM cbm.c:2284-2287 — per-bit error reporting. */
+	if (dqm_intr_stat & BIT(0))
+		pr_err_once("cbm: egp pid=%d register ready for pointer free\n",
+			    pid);
+
+	/* AVM cbm.c:2289-2291 — write-clear with captured value (using the
+	 * corrected DQM port, not the AVM EQM-typo).
+	 */
+	pr_debug("cbm: clear egp intr status on pid=%d\n", pid);
+	cbm_dqm_w32(CBM_DQM_CPU_PORT(pid, irncr), dqm_intr_stat);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Top-level ISRs                                                           */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * Read the three CBM_INT_LINE(N, *) registers (cbm/igp/egp IRNCR) at
+ * entry and write-clear all three at end. Helper macros keep the five
+ * sibling handlers readable.
+ *
+ * Three-register-read invariant (review_focus): cbm_isr_0 reads ALL
+ * THREE IRNCRs at entry (NOT just cbm_irncr). Attempt-1 of this subtask
+ * regressed on this point; attempt-2 fix made it explicit; ST-005 keeps
+ * the invariant for ALL FIVE ISRs (not just cbm_isr_0).
+ */
+
+/*
+ * cbm_isr_0 — top-level ISR for line 0 (FSQM + IGP CPU0 + EGP CPU0
+ * interrupts). Port of AVM cqm/grx500/cbm.c:2298-2358.
+ *
+ * (a) Three reads (AVM 2304-2306):
+ *       cbm_irncr  = CBM_INT_LINE(0, cbm_irncr)
+ *       igp_irncr  = CBM_INT_LINE(0, igp_irncr)
+ *       egp_irncr  = CBM_INT_LINE(0, egp_irncr)
+ *
+ * (b) Dispatch on cbm_irncr (AVM 2313-2330):
+ *       cbm_irncr & 0x30 -> fsqm_intr_handler(0)   (FSQM0 events)
+ *       else cbm_irncr & 0xC0 -> fsqm_intr_handler(1)  (FSQM1 events)
+ *     The 0x30 / 0xC0 bit masks are silicon-defined and verbatim from
+ *     AVM (review_focus: "the dispatch masks 0x30 / 0xC0 / 0x1 are
+ *     sourced from AVM cbm.c:2298-2339 verbatim — these bit positions
+ *     are silicon-defined and must not be paraphrased").
+ *
+ *     AVM 2331-2334 also handles cbm_irncr & 0x0100 (Load Spreader
+ *     interrupt on pid 0). Sub-4 strips LS but keeps the log for trace
+ *     visibility (LS reactivation is Sub-6).
+ *
+ * (c) Dispatch on igp_irncr (AVM 2337-2338):
+ *       igp_irncr & 0x1 -> igp_cpu_intr_handler(0)
+ *
+ * (d) Dispatch on egp_irncr — the plan Step 2(d) says "egp_irncr non-zero
+ *     -> egp_cpu_intr_handler(0)". AVM does NOT have an explicit egp
+ *     dispatch in cbm_isr_0 (lines 2300-2358), but the plan Step 2(d)
+ *     explicitly mandates this dispatch — added per the plan's AC-005-2
+ *     wording "egp_irncr non-zero -> egp_cpu_intr_handler(0)".
+ *
+ * (e) Write-clear all three IRNCRs with their CAPTURED values (AVM
+ *     2341-2346). Critical: captured values, not fresh re-reads.
+ *
+ * (f) Return IRQ_HANDLED (AVM 2357). The plan Step 2(f) is unconditional
+ *     IRQ_HANDLED for line 0 because this line carries FSQM events which
+ *     are silicon-fatal — any spurious fire still warrants the ack.
+ */
+irqreturn_t cbm_isr_0(int irq, void *dev_id)
+{
+	u32 cbm_irncr;
+	u32 igp_irncr;
+	u32 egp_irncr;
+
+	(void)irq;
+	(void)dev_id;
+
+	if (!g_cbm_base) {
+		pr_err_ratelimited("cbm: cbm_isr_0: g_cbm_base NULL\n");
+		return IRQ_NONE;
+	}
+
+	/* (a) Three reads at entry — AC-005-2 requirement. */
+	cbm_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(0, cbm_irncr));
+	igp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(0, igp_irncr));
+	egp_irncr = __raw_readl(g_cbm_base + CBM_INT_LINE(0, egp_irncr));
+
+	pr_debug("cbm: isr0: cbm_irncr=0x%x igp_irncr=0x%x egp_irncr=0x%x\n",
+		 cbm_irncr, igp_irncr, egp_irncr);
+
+	/* (b) cbm_irncr dispatch — FSQM0 / FSQM1 / LS-trace. */
+	if (cbm_irncr != 0) {
+		/* AVM 2315-2318 — TMU interrupt is "impossible" path; the
+		 * plan Step 7 (and CQ-004 A) strips TMU branches. We still
+		 * log if the bits fire so the impossibility marker stays
+		 * observable.
+		 */
+		if (cbm_irncr & 0x3)
+			pr_err_ratelimited("cbm: isr0: TMU interrupt triggered (impossible)\n");
+
+		/* AVM 2320-2330 — FSQM bits 4..7. The mask 0xF0 gates the
+		 * sub-dispatch; 0x30 -> FSQM0, 0xC0 -> FSQM1.
+		 */
+		if (cbm_irncr & 0xF0) {
+			if (cbm_irncr & 0x30) {
+				pr_debug("cbm: isr0: FSQM0 interrupt\n");
+				fsqm_intr_handler(0);
+			} else if (cbm_irncr & 0xC0) {
+				pr_debug("cbm: isr0: FSQM1 interrupt\n");
+				fsqm_intr_handler(1);
+			}
+		}
+
+		/* AVM 2331-2334 — LS interrupt on pid 0 (log-only in Sub-4). */
+		if (cbm_irncr & 0x0100)
+			pr_debug("cbm: isr0: load spreader interrupt on pid 0 (Sub-6)\n");
+	}
+
+	/* (c) igp_irncr dispatch — IGP CPU port 0. */
+	if (igp_irncr & 0x1)
+		igp_cpu_intr_handler(0);
+
+	/* (d) egp_irncr dispatch — EGP CPU port 0 (plan Step 2(d)). */
+	if (egp_irncr)
+		egp_cpu_intr_handler(0);
+
+	/* (e) Write-clear all three captured IRNCRs (AVM 2341-2346). */
+	pr_debug("cbm: isr0: clear cbm/igp/egp intr source\n");
+	__raw_writel(cbm_irncr, g_cbm_base + CBM_INT_LINE(0, cbm_irncr));
+	__raw_writel(igp_irncr, g_cbm_base + CBM_INT_LINE(0, igp_irncr));
+	__raw_writel(egp_irncr, g_cbm_base + CBM_INT_LINE(0, egp_irncr));
+
+	/* (f) Always IRQ_HANDLED on line 0 (AVM 2357). */
+	return IRQ_HANDLED;
+}
