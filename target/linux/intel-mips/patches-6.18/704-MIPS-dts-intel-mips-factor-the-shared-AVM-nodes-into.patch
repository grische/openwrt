-&pcie_phy0 {
-	status = "okay";
-	intel,ssc-enable = <1>;
-};
-
-&pcie_phy1 {
-	status = "okay";
-	intel,ssc-enable = <1>;
-};
-
-&pcie_phy2 {
-	status = "okay";
-	intel,ssc-enable = <1>;
