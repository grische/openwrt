From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Tue, 18 Aug 2026 01:25:52 +0200
Subject: MIPS: dts: intel-mips: factor the shared AVM nodes into a dtsi

seale_avm_fritz7560.dtsi has been carrying the description of the whole
AVM board family since it was the only board file there was. Roughly six
hundred of its lines say nothing specific to the FRITZ!Box 7560: the
GSWIP MDIO aperture derivation, the GPHY firmware loader window, the
NAND controller wiring, the CBM pool reservations and their binding, and
the four-port datapath. The FRITZ!Box 7590 needs all of it verbatim --
including the four LAN ports, which it wires identically, reversed
ordering and all, because its fifth GPHY serves a WAN port on the other
switch instance rather than a fifth LAN jack.

Introduce seale_avm.dtsi between xrx500.dtsi and the board files and move
that content into it, leaving each board with its identity, memory map,
flash layout, populated GPHY list, and the front-panel, PCIe and USB wiring
that genuinely differs. Boards now include seale_avm.dtsi rather than
xrx500.dtsi directly, so the family layer cannot be skipped by accident;
this is the shape mscc uses for jaguar2 and serval.

PCIe, USB and the LEDs stay in the FRITZ!Box 7560 file for now. The
first two are board-family-shaped and will follow once a second board
has exercised them; the LEDs genuinely do not transfer, since the
FRITZ!Box 7590 drives its through the SSO shift register rather than SoC
GPIOs.

phy_id and the GPHY resets stay per board too. How many GPHYs exist is the
one real die difference in this datapath, and keeping the list in the board
file means the disputed fifth reset bit gets decided in one visible place
rather than shadowing a default.

Four comments in xrx500.dtsi described where the overlays that enable
its disabled nodes live, and two of them named the file this commit
deletes. Corrected in the same commit so the tree never carries a
dangling reference.

Pure move plus two new labels; the xrx500.dtsi edits are comments only.
seale_avm_fritz7560.dtb is unchanged: the decompiled, sorted DTB is
identical before and after. The raw blob is not byte-identical -- dtc
emits nodes in source order, so relocating a block reorders it without
changing its meaning.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/arch/mips/boot/dts/intel-mips/seale_avm.dtsi b/arch/mips/boot/dts/intel-mips/seale_avm.dtsi
new file mode 100644
index 000000000000..62c92e26d3a9
--- /dev/null
+++ b/arch/mips/boot/dts/intel-mips/seale_avm.dtsi
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 Grische <github@grische.xyz>
+/*
+ * AVM FRITZ!Box boards on the Lantiq/Intel xRX500 (Seale) SoC family.
+ * Board-family layer: everything common to every FRITZ!Box on this SoC, but
+ * nothing that is on the die. SoC-level description is in xrx500.dtsi;
+ * per-board data is in the board .dts.
+ */
+
+#include "xrx500.dtsi"
+
+/*
+ * Every FRITZ!Box on this SoC wires its flash to EBU chip-select 1, with the
+ * chip data window decoded at 0x17c00000. Both facts are in the vendor device
+ * tree (lantiq,cs = <1>, and the localbus ranges that place the window).
+ */
+&ebu_nand {
+	status = "okay";
+
+	lantiq,cs = <1>;
+
+	nand0: nand@0 {
+		reg = <0>;
+		label = "nand0";
+
+		/*
+		 * On-die ECC, selected through the legacy "nand-ecc-mode"
+		 * property on purpose: the modern "nand-ecc-engine" spelling is
+		 * a phandle, and a string there fails phandle resolution
+		 * silently, leaving the engine type at INVALID with no
+		 * diagnostic.
+		 */
+		nand-ecc-mode = "on-die";
+	};
+};
+
+/* Both GSWIP-3.0 instances; on-die blocks with no board wiring. */
+&gswl {
+	status = "okay";
+};
+
+&gswr {
+	status = "okay";
+};
+
+/ {
+	/*
+	 * GPHY firmware loader. The 0x280 window must cover the per-GPHY
+	 * LBADR/MBADR pairs at offsets 0x228..0x26f. The firmware must be
+	 * built in: this driver probes long before any rootfs is mounted.
+	 */
+	gphy_fw: phy-xrx500@1c003c00 {
+		compatible = "lantiq,phy-xrx500";
+		reg = <0x1c003c00 0x280>;
+		firmware-name = "lantiq/xrx500-phy-fw.bin";
+		status = "okay";
+	};
+
+	/*
+	 * GSWIP-3.0 MDIO bus on the GSW-L instance. The aperture is the
+	 * switch base plus (MDCTRL dword 0x004 + GSW30_TOP_OFFSET 0xf00) * 4,
+	 * a 0x20 span covering MDCTRL, MDREAD, MDWRITE and the two MDCCFG
+	 * registers. It overlaps the switch node's own reg claim on purpose,
+	 * which is why the driver maps it with devm_ioremap() rather than
+	 * requesting the region.
+	 *
+	 * The bus defers probing until the GPHY firmware loader has run: a
+	 * PHY without firmware never answers MDIO.
+	 */
+	gswip_mdio: gswip-mdio@1c003c10 {
+		compatible = "lantiq,gswip-mdio";
+		reg = <0x1c003c10 0x20>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		/*
+		 * Each label is consumed by the port whose intel,dp-port-id
+		 * equals this PHY's MDIO address. Getting the pairing wrong
+		 * gives a working link on the wrong front-panel socket, which
+		 * no probe-time check can catch.
+		 */
+		gphy_lan1: ethernet-phy@5 {
+			reg = <0x05>;
+		};
+
+		gphy_lan2: ethernet-phy@4 {
+			reg = <0x04>;
+		};
+
+		gphy_lan3: ethernet-phy@3 {
+			reg = <0x03>;
+		};
+
+		gphy_lan4: ethernet-phy@2 {
+			reg = <0x02>;
+		};
+	};
+
+	/*
+	 * Datapath netdev parent. Each child names one front-panel port and
+	 * its datapath port id; the driver allocates one netdev per child.
+	 */
+	intel_xrx500_net: ethernet {
+		compatible = "intel,xrx500-net";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		port@0 {
+			reg = <0>;
+			intel,dp-port-id = <5>;
+			phy-handle = <&gphy_lan1>;
+		};
+
+		port@1 {
+			reg = <1>;
+			intel,dp-port-id = <4>;
+			phy-handle = <&gphy_lan2>;
+		};
+
+		port@2 {
+			reg = <2>;
+			intel,dp-port-id = <3>;
+			phy-handle = <&gphy_lan3>;
+		};
+
+		port@3 {
+			reg = <3>;
+			intel,dp-port-id = <2>;
+			phy-handle = <&gphy_lan4>;
+		};
+	};
+
+	/*
+	 * CBM standard and jumbo buffer pools.
+	 *
+	 * Both the sizes and the addresses are facts about the SoC rather
+	 * than about any board. They abut exactly (0x23800000 + 0x1200000 =
+	 * 0x24a00000) and top out at 0x25200000.
+	 *
+	 * They are nonetheless declared here rather than in xrx500.dtsi,
+	 * because a reservation cannot be stated without the memory node it
+	 * comes out of, and easy350_anywan has no use for them.
+	 *
+	 * PRECONDITION for every board including this file: its memory node
+	 * must cover 0x23800000..0x25200000. True of the FRITZ!Box 7560 (128 MiB) and
+	 * the FRITZ!Box 7590 (224 MiB). A board with less RAM than that would have to
+	 * override these, and widening a board's memory node cannot move them
+	 * -- only extend past them.
+	 *
+	 * `no-map` keeps the regions out of the buddy allocator entirely so
+	 * that cbm_buf.c's carve allocator owns the only access path. The
+	 * kernel establishes no linear mapping for these pages, so cbm_buf.c
+	 * must memremap() at probe time and cannot rely on virt_to_phys()
+	 * against the resulting pointer.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		cbm_std_pool: cbm-std-pool@23800000 {
+			reg = <0x23800000 0x1200000>;
+			no-map;
+		};
+
+		cbm_jbo_pool: cbm-jbo-pool@24a00000 {
+			reg = <0x24a00000 0x800000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * The pools carry no restricted-dma-pool compatible, so the driver has to
+ * look them up explicitly through this phandle list.
+ */
+&cbm {
+	memory-region = <&cbm_std_pool>, <&cbm_jbo_pool>;
+	memory-region-names = "cbm-std-pool", "cbm-jbo-pool";
+	status = "okay";
+};
diff --git a/arch/mips/boot/dts/intel-mips/seale_avm_fritz7560.dts b/arch/mips/boot/dts/intel-mips/seale_avm_fritz7560.dts
index 60f626923268..accfb8426524 100644
--- a/arch/mips/boot/dts/intel-mips/seale_avm_fritz7560.dts
+++ b/arch/mips/boot/dts/intel-mips/seale_avm_fritz7560.dts
@@ -1,12 +1,15 @@
 // SPDX-License-Identifier: GPL-2.0-only
 // Copyright (C) 2026 Grische <github@grische.xyz>
+/*
+ * AVM FRITZ!Box 7560 (HW221), GRX350. Board-specific data only; the SoC is
+ * described in xrx500.dtsi and the board family in seale_avm.dtsi.
+ */
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 
-#include "xrx500.dtsi"
-#include "seale_avm_fritz7560.dtsi"
+#include "seale_avm.dtsi"
 
 / {
 	model = "AVM FRITZ!Box 7560";
@@ -31,8 +34,10 @@ avm-hw-revision {
 	 * bootcore (kernel2 at load 0x8DFFFFFC) lives in the upper region;
 	 * conservative Phase 1 exposes only the bottom 128 MiB to the
 	 * InterAptiv kernel.
-	 * Reserved-memory regions (gphy_fw, cbm_std_pool, cbm_jbo_pool from
-	 * the 5.10 DTS) are deferred to Phase 2/3 where they're load-bearing.
+	 *
+	 * This covers the CBM pools that seale_avm.dtsi reserves at
+	 * 0x23800000..0x25200000, which is a precondition of including that
+	 * file rather than something this node may be shrunk below.
 	 */
 	memory@20000000 {
 		device_type = "memory";
@@ -47,4 +52,288 @@ chosen {
 		stdout-path = "serial0:115200n8";
 		bootargs = "";
 	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Crash persistence. mem-type = <1> asks for
+		 * pgprot_noncached: nothing flushes the cache on the watchdog
+		 * path, so a cached record would not survive. The zone sizes
+		 * fill reg exactly; fs/pstore/ram.c fails the whole probe if
+		 * they overflow it. Kept low enough that a recovery image
+		 * staged in RAM cannot overwrite the record being diagnosed.
+		 */
+		ramoops@23700000 {
+			compatible = "ramoops";
+			reg = <0x23700000 0x100000>;
+			record-size = <0x4000>;
+			console-size = <0x80000>;
+			mem-type = <1>;
+		};
+	};
+
+	/*
+	 * Front-panel LEDs, buttons and the DECT reset line. Every line here
+	 * is active low: the lamps sink from 3V3.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		/*
+		 * Bank 1, pin 4 == SoC pin 36. The boot loader already lights
+		 * this lamp; default-on avoids a dark gap at probe.
+		 */
+		led_power: led-0 {
+			label = "green:power";
+			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		/* Vendor name: gpio_avm_led_internet. Drives "Fon". */
+		led_fon: led-1 {
+			label = "green:fon";
+			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		/* Vendor name: gpio_avm_led_festnetz. Drives "DECT". */
+		led_dect: led-2 {
+			label = "green:dect";
+			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wlan: led-3 {
+			label = "green:wlan";
+			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_info: led-4 {
+			label = "green:info";
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		/* Bank 1, pin 2 == SoC pin 34. */
+		led_info_red: led-5 {
+			label = "red:info";
+			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
+	/*
+	 * Polled rather than interrupt-driven: the GPIO banks do not
+	 * publish an irq domain (see xrx500.dtsi). 100 ms is fast enough
+	 * for both the short-press and the long-press handlers.
+	 */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		button-dect {
+			label = "dect";
+			linux,code = <KEY_PHONE>;
+			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
+		};
+
+		button-wlan {
+			label = "wlan";
+			linux,code = <KEY_RFKILL>;
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	aliases {
+		led-boot = &led_power;
+		led-running = &led_power;
+		led-failsafe = &led_info_red;
+		led-upgrade = &led_info;
+		led-wifi = &led_wlan;
+	};
+
+	/*
+	 * The single USB host port on the back of the box. VBUS is a
+	 * GPIO-backed fixed regulator, active high, consumed by the PHY.
+	 */
+	usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio0 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+/*
+ * Macronix MX30LF1GE8AB, 128 MiB. The labels and offsets are the layout the
+ * vendor boot loader installs, so a vendor recovery still finds them.
+ */
+&nand0 {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		/*
+		 * AVM urlader (first-stage bootloader). It also holds
+		 * the only copy of the WiFi calibration data. Read-only:
+		 * overwriting it bricks the device past the point of
+		 * recovery without JTAG/SPI-flashing the chip.
+		 */
+		partition@0 {
+			label = "urlader";
+			reg = <0x0 0x100000>;
+			read-only;
+		};
+
+		/*
+		 * AVM TFFS environment. Holds the only copy of this
+		 * device's identity (MAC addresses, serial number).
+		 * Read-only: it is never written from Linux, and
+		 * erasing it cannot be undone.
+		 */
+		partition@100000 {
+			label = "nand-tffs";
+			reg = <0x100000 0x400000>;
+			read-only;
+		};
+
+		/* Primary kernel slot. Written by sysupgrade. */
+		partition@500000 {
+			label = "kernel";
+			reg = <0x500000 0x800000>;
+		};
+
+		/* AVM secondary/recovery kernel slot. Written by sysupgrade. */
+		partition@d00000 {
+			label = "reserved-kernel";
+			reg = <0xd00000 0x800000>;
+		};
+
+		/* UBI volume hosting rootfs / rootfs_data. */
+		partition@1500000 {
+			label = "ubi";
+			reg = <0x1500000 0x6b00000>;
+		};
+	};
+};
+
+/*
+ * The four LAN GPHYs this board populates. The reset bit list is not
+ * contiguous, so every entry is spelled out; the set bit and the status bit
+ * are the same number here, hence the doubled cell.
+ */
+&gphy_fw {
+	phy_id = <0x02 0x03 0x04 0x05>;
+	resets = <&rcu_reset0 29 29>,
+		 <&rcu_reset0 28 28>,
+		 <&rcu_reset0 26 26>,
+		 <&rcu_reset0 25 25>;
+	reset-names = "phy2", "phy3", "phy4", "phy5";
+};
+
+/*
+ * DECT reset, active high. No DECT driver exists in this tree, so the
+ * line is hogged and driven asserted at boot to hold the Dialog DECT
+ * companion chip quiesced instead of leaving it half-initialised and
+ * chattering on the shared SSI bus.
+ */
+&gpio0 {
+	dect-reset-hog {
+		gpio-hog;
+		gpios = <10 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "dect-reset";
+	};
+};
+
+&pcie_phy0 {
+	status = "okay";
+	intel,ssc-enable = <1>;
+};
+
+&pcie_phy1 {
+	status = "okay";
+	intel,ssc-enable = <1>;
+};
+
+&pcie_phy2 {
+	status = "okay";
+	intel,ssc-enable = <1>;
+};
+
+/*
+ * Inbound byte swapping is enabled on the two radio ports and disabled
+ * on RC2. This SoC is big endian and the DWC core is not, so inbound
+ * DMA is byte-swapped on the way through -- except for the VRX318,
+ * whose driver already presents its shared memory in the endianness the
+ * host expects, and swapping again would undo it. The vendor tree
+ * arrives at the same split: grx_common.dtsi sets inbound-swap on all
+ * three, and vrx318.dtsi, included only by boards carrying that chip,
+ * clears it on RC2.
+ *
+ * Outbound is never swapped, on any port.
+ */
+&pcie0 {
+	status = "okay";
+	intel,inbound-swap = <1>;
+	intel,outbound-swap = <0>;
+	reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
+};
+
+&pcie1 {
+	status = "okay";
+	intel,inbound-swap = <1>;
+	intel,outbound-swap = <0>;
+	reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
+
+	/*
+	 * The 2.4 GHz radio is an AR93xx whose EEPROM is blank, so it
+	 * enumerates as 168c:abcd (AR9300_DEVID_INVALID). ath9k_of_init()
+	 * only looks for calibration data in a file when the device has an
+	 * OF node carrying qca,no-eeprom, so without this node the driver
+	 * keeps AH_USE_EEPROM and the radio cannot come up at all -- there
+	 * is nothing on the part to fall back to.
+	 *
+	 * The outer node is the root port at devfn 0 on bus 0, the inner
+	 * one the endpoint at devfn 0 on bus 1; matching is by devfn, so
+	 * the compatible is documentation.
+	 */
+	pcie@0 {
+		reg = <0 0 0 0 0>;
+		#size-cells = <2>;
+		#address-cells = <3>;
+		device_type = "pci";
+		ranges;
+
+		wifi@0,0 {
+			compatible = "pci168c,abcd";
+			reg = <0 0 0 0 0>;
+			/* load from ath9k-eeprom-pci-0001:01:00.0.bin */
+			qca,no-eeprom;
+		};
+	};
+};
+
+/* VRX318 DSL companion -- see the inbound-swap note above. */
+&pcie2 {
+	status = "okay";
+	intel,inbound-swap = <0>;
+	intel,outbound-swap = <0>;
+	reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
+};
+
+&usb1_phy {
+	status = "okay";
+	vbus-supply = <&usb_vbus>;
+};
+
+&usb1 {
+	status = "okay";
 };
