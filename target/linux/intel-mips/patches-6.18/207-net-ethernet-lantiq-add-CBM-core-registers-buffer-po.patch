index 0000000000000..d14d41c3c0a3f
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/datapath/lantiq_cbm_api.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Central Buffer Manager (CBM) public type-only port.
+ *
+ * Sub-3 ST-001 port of AVM 4.9 include/net/lantiq_cbm_api.h, restricted to
+ * "ONLY the type declarations and macros needed by Sub-3
+ * (CBM_PORT_DP_SET, CBM_PORT_DQ_SET, struct cbm_dp_en_data,
+ * cbm_dp_alloc_complete typedef)" per the plan. ALL function declarations
+ * are stripped because CBM is stubbed in datapath_cbm_stubs.h per CQ-001
+ * option B and the real CBM surface is Sub-4 territory.
+ *
+ * No forbidden conditional-compilation tokens exist in the AVM source,
+ * so AC-001-3's line-excision strip-list is a no-op for this header.
+ */
+
+#ifndef __CBM_API_H
+#define __CBM_API_H
+
+#include <linux/types.h>
+#include <linux/bits.h>	/* IG-159: BIT() for the DP_F_* mirrors below */
+
+/*
+ * IG-123: SINGLE_RX_CH0_ONLY — verbatim from AVM include/net/lantiq_cbm_api.h:72.
+ * The AVM default build defines this =1 (the p2p RX bridge runs ONLY the
+ * DMA1TX ch0 <-> DMA2RX ch0 pair, and the GSW-L PMAC egress funnels every
+ * CPU-bound frame to nRxDmaChanId=0). #ifndef-guarded because the canonical
+ * gate used by cbm.c lives in dma/lantiq_dmax.h (the header cbm.c actually
+ * includes); this copy keeps any TU that pulls in this header consistent.
+ */
+#ifndef SINGLE_RX_CH0_ONLY
+#define SINGLE_RX_CH0_ONLY 1
+#endif
+
+/*
+ * CBM return / error codes (AVM lantiq_cbm_api.h:78-82).
+ */
+#define CBM_OK 0
+#define CBM_ERROR (-1)
+
+/*
+ * Flag bits for struct cbm_dp_en_data and dp_alloc_complete (AVM
+ * lantiq_cbm_api.h around the CBM_PORT_* macro block). These two bits
+ * gate the cbm_dp_enable HW-interaction path inside dp_register_subif:
+ * if neither is set, the call short-circuits.
+ */
+#define CBM_PORT_DP_SET BIT(0)
+#define CBM_PORT_DQ_SET BIT(1)
+#define CBM_PORT_DMA_CHAN_SET BIT(2)
+#define CBM_PORT_PKT_CRDT_SET BIT(3)
+#define CBM_PORT_BYTE_CRDT_SET BIT(4)
+#define CBM_PORT_RING_ADDR_SET BIT(5)
+#define CBM_PORT_RING_SIZE_SET BIT(6)
+#define CBM_PORT_RING_OFFSET_SET BIT(7)
+
+/*
+ * Maximum CPU ports used by the CBM CPU-port enumeration. Ported as-is
+ * from AVM because struct cbm_cpu_port_data carries an array of this
+ * length.
+ */
+#define CQM_MAX_CPU 4
+
+/*
+ * CBM DP allocate completion data block - returned by cbm_dp_port_alloc.
+ * Sub-3 only references the type by pointer through cbm_dp_alloc_complete;
+ * field semantics are preserved verbatim for Sub-4 to populate when the
+ * stub is replaced with the real CBM driver.
+ */
+struct cbm_dp_alloc_data {
+	int dp_inst;
+	int cbm_inst;
+	u32 flags;
+	u32 dp_port;
+	u32 deq_port_num;
+	u32 deq_port;
+	u32 dma_chan;
+	u32 tx_pkt_credit;
+	u32 tx_b_credit;
+	u32 tx_ring_addr;
+	u32 tx_ring_size;
+	u32 tx_ring_offset;
+	u32 num_dma_chan;
+};
+
+/* Backwards-compat typedef name used by some Sub-4 call sites. */
+typedef struct cbm_dp_alloc_data cbm_dp_alloc_complete_t;
+
+/*
+ * Data block passed in/out of cbm_dp_enable (per CQ-001 B's stubbing surface).
+ * The .flags field is the one tested via (flags & (CBM_PORT_DP_SET |
+ * CBM_PORT_DQ_SET)) inside dp_register_subif_private.
+ */
+struct cbm_dp_en_data {
+	int dp_inst;
+	int cbm_inst;
+	u32 deq_port;
+	u32 dma_chnl_init;
+	u32 num_dma_chan;
+};
+
+/*
+ * ==========================================================================
+ * IG-159 (B1 port) — DP_F_* flag mirrors + TMU resource tuple, consumed by
+ * the cqm/grx500 pmac-port registry (cbm_ports.c / cbm_dp.c).
+ *
+ * Values verbatim from AVM:
+ *   - DP_F_DEQ_* dequeue-port selectors: include/net/lantiq_cbm_api.h:192-195
+ *   - port-type bits: include/net/datapath_api.h:120-165 (enum DP_F_FLAG),
+ *     mirrored as #defines because our tree carries no datapath_api.h flag
+ *     enum; datapath_api.c:136-151 / datapath_misc.c:126-132 keep their
+ *     file-local mirrors of the SAME values (those TUs do not include this
+ *     header, so no redefinition arises). #ifndef-guarded so a later full
+ *     datapath_api.h port wins silently.
+ * ==========================================================================
+ */
+#ifndef DP_F_DEQ_CPU
+#define DP_F_DEQ_CPU 0x2	/* AVM lantiq_cbm_api.h:192 */
+#define DP_F_DEQ_CPU1 0x3	/* AVM lantiq_cbm_api.h:193 */
+#define DP_F_DEQ_MPE 0x4	/* AVM lantiq_cbm_api.h:194 */
+#define DP_F_DEQ_DL 0x5		/* AVM lantiq_cbm_api.h:195 */
+#endif
+
+#ifndef DP_F_FAST_ETH_LAN
+#define DP_F_FAST_ETH_LAN	BIT(1)	/* AVM datapath_api.h:121 */
+#define DP_F_FAST_ETH_WAN	BIT(2)	/* AVM datapath_api.h:122 */
+#define DP_F_FAST_WLAN		BIT(3)	/* AVM datapath_api.h:123 */
+#define DP_F_FAST_DSL		BIT(4)	/* AVM datapath_api.h:124 */
+#define DP_F_DIRECT		BIT(5)	/* AVM datapath_api.h:125 */
+#define DP_F_LOOPBACK		BIT(6)	/* AVM datapath_api.h:126 */
+#define DP_F_DIRECTLINK		BIT(7)	/* AVM datapath_api.h:130 */
+#define DP_F_MPE_ACCEL		BIT(25)	/* AVM datapath_api.h:155 */
+#define DP_F_CHECKSUM		BIT(26)	/* AVM datapath_api.h:156 */
+#define DP_F_DIRECTPATH_RX	BIT(27)	/* AVM datapath_api.h:159 */
+#define DP_F_DONTCARE		BIT(28)	/* AVM datapath_api.h:162 */
+#define DP_F_LRO		BIT(29)	/* AVM datapath_api.h:163 */
+#define DP_F_FAST_DSL_DOWNSTREAM BIT(30) /* AVM datapath_api.h:164 */
+#define DP_F_PORT_TUNNEL_DECAP	DP_F_LOOPBACK /* AVM datapath_api.h:206 */
+#endif
+
+/*
+ * TMU resource structure for a TMU port — AVM include/net/
+ * lantiq_cbm_api.h:475-480 verbatim.
+ */
+typedef struct cbm_tmu_res {
+	uint32_t tmu_port; /*!< TMU port number, -1 if no TMU port allocated */
+	uint32_t cbm_deq_port; /*!< CBM Dequeue port number, -1 if no CBM port allocated */
+	int32_t tmu_sched; /*!< TMU scheduler Id attached to TMU port, -1 if unassigned */
+	int32_t tmu_q; /*!< TMU Queue Id attached to TMU scheduler on this TMU port, -1 if unassigned */
+} cbm_tmu_res_t;
+
+/*
+ * IG-159 (B1): resolve the TMU/CBM dequeue resources bound to a dp_port from
+ * the pmac-port registry. Exported wrapper (cbm_dp.c) over the cbm_ports.c
+ * implementation, mirroring AVM's l_cbm_ops.cbm_dp_port_resources_get ->
+ * cbm_wrapper.c:277-287 EXPORT layering. On success *res_pp is a
+ * kmalloc(GFP_ATOMIC) array of *num_tmu_ports entries the CALLER must kfree.
+ * Returns 0 on success, -1 if the port is not in the registry (the AVM
+ * static-pmac LAN/WAN fallback is GATED OFF for B1 — spec risk 3: the
+ * dqm_port_info DMA rows are not populated yet).
+ */
+s32 cbm_dp_port_resources_get(u32 *dp_port, u32 *num_tmu_ports,
+			      cbm_tmu_res_t **res_pp, u32 flags);
+
+#endif /* __CBM_API_H */
diff --git a/include/net/cqm_cbm_api.h b/include/net/cqm_cbm_api.h
