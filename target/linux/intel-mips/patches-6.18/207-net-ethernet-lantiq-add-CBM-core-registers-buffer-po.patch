index 0000000000000..a4a7644df40b1
--- /dev/null
+++ b/include/net/cqm_cbm_api.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cross-TU CBM API surface.
+ *
+ * Sub-4 ST-001: bare extern declarations for the CBM symbols that
+ * datapath/ and other in-module TUs need to call. NO static inlines, NO
+ * bodies — the real symbol definitions live in
+ * drivers/net/ethernet/lantiq/cqm/grx500/{cbm_basic,cbm_buf,cbm,cbm_dp}.c
+ * and are link-resolved within the single intel-xrx500-gswip.ko composite
+ * per CQ-001 A.
+ *
+ * This header replaces drivers/net/ethernet/lantiq/datapath/datapath_cbm_stubs.h
+ * (deleted via `git rm` per AS-003). C11 §6.2.2 forbids the
+ * static-inline-then-extern coexistence the deleted stub relied on; the
+ * bare-extern surface here is the canonical fix.
+ *
+ * The struct types referenced (cbm_dp_en_data, cbm_dp_alloc_data) come
+ * from <net/lantiq_cbm_api.h> in upstream / from
+ * drivers/net/ethernet/lantiq/datapath/lantiq_cbm_api.h in the Sub-3
+ * port; either include path provides compatible declarations.
+ */
+
+#ifndef _NET_CQM_CBM_API_H
+#define _NET_CQM_CBM_API_H
+
+#include <linux/types.h>
+#include <linux/module.h>
+
+struct cbm_dp_en_data;
+struct net_device;
+struct cbm_dp_alloc_data;
+
+/*
+ * cbm_dp_enable — port-level enable/disable hook called from
+ * dp_register_subif_private when the first subif on a dp_port comes
+ * online. AVM signature (cqm/grx500/cbm.c:3629-3635) preserved verbatim:
+ * 5 arguments, owner / port_id / data / flags / alloc_flags.
+ */
+int cbm_dp_enable(struct module *owner, u32 port_id,
+		  struct cbm_dp_en_data *cbm_data,
+		  u32 flags, u32 alloc_flags);
+
+/*
+ * cbm_dp_port_alloc / cbm_dp_port_dealloc — CBM dp_port allocate/free hooks
+ * called from dp_alloc_port_private (datapath_api.c) when a LAN port is
+ * registered / deregistered. Sub-7 ST-001 real exports replacing the Sub-3
+ * dp_local_* WARN_ONCE placeholders; bodies live in
+ * drivers/net/ethernet/lantiq/cqm/grx500/cbm_dp.c. The parameter lists are
+ * byte-identical to the deleted dp_local_cbm_dp_port_alloc /
+ * dp_local_cbm_dp_port_dealloc stubs so the ST-002 call-site rename is a
+ * pure symbol swap. struct net_device / struct cbm_dp_alloc_data are reached
+ * by forward declaration (above) to avoid a heavyweight <linux/netdevice.h>
+ * include cycle, mirroring the struct cbm_dp_en_data pattern.
+ */
+int cbm_dp_port_alloc(struct module *owner, struct net_device *dev,
+		      u32 dev_port, s32 port_id,
+		      struct cbm_dp_alloc_data *data, u32 flags);
+int cbm_dp_port_dealloc(struct module *owner, u32 dev_port, s32 port_id,
+			struct cbm_dp_alloc_data *data, u32 flags);
+
+/*
+ * cbm_counter_mode_set — toggle CBM enqueue/dequeue counter between
+ * packet-count and byte-count modes. AVM signature
+ * (cqm/grx500/cbm.c:4843): two ints (idx, mode).
+ */
+int cbm_counter_mode_set(int idx, int mode);
+
+/*
+ * get_lookup_qid_via_index — CBM QIDT lookup. Returns the 8-bit queue id
+ * stored at the given lookup-index entry. AVM uses uint8_t/uint32_t in
+ * the public surface so the Sub-3 callers can mix and match.
+ */
+u8 get_lookup_qid_via_index(u32 lookup_idx);
+
+/*
+ * Placeholder buffer-pool surface used by Sub-3/Sub-4 callers that need
+ * to allocate or release CBM-bound buffers from outside the cqm/grx500
+ * scope. Sub-6 will reshape these to of_reserved_mem_lookup-backed pools
+ * per IG-006 / IG-012 — the signatures are stable.
+ */
+void *cbm_buf_alloc(u32 size, u32 *pool_phys, u32 flags);
+int   cbm_buf_free(void *buf, u32 size);
+
+/*
+ * EQM/DMA dequeue port management (ST-006 territory). Declarations are
+ * published now so the cqm_cbm_api.h surface is contractual from Sub-4
+ * onward; the bodies fill in alongside ST-006.
+ */
+int dma_port_enable(u32 idx, int dqm_flag);
+int init_cbm_eqm_dma_port(int idx, u32 flags); /* IG-146: flags = std/jumbo buffer type */
+int setup_eqm_dma_desc(int pid, int desc_count, u32 flags, u32 buf_offset);
+
+/*
+ * cbm_dequeue — return a buffer to CBM EQM CPU port @pid via the
+ * AVM cbm.c:2936-2962 wait-cycle pattern. Body in cbm_dma.c (Sub-4
+ * ST-006).
+ *
+ * The plan refers to this as "cbm_dequeue"; the AVM source name is
+ * cbm_ptr_refcnt_incr. We adopt the plan name for the public surface
+ * because Sub-6 grep keys will use it. Signature deviates from the
+ * plan's invented "struct cbm_pkt_desc *desc" (which does not exist in
+ * AVM or in any of the ported headers) to match the AVM signature
+ * (pid, buf_ptr) with an additional reserved flags argument the plan
+ * mentions.
+ *
+ * Returns 0 on success, -ETIMEDOUT on wait-cycle exhaustion, -EINVAL on
+ * pid out-of-range, -ENODEV if g_cbm_eqm_base is not yet mapped.
+ */
+int cbm_dequeue(int pid, u32 buf_ptr, u32 flags);
+
+/*
+ * cbm_cpu_enqueue_hw — fire-and-forget CPU TX enqueue to the CBM EQM
+ * CPU ingress port @pid. Faithful port of AVM cqm/grx500/cbm.c
+ * cpu_enqueue_hw (~line 1853): writes DW0, DW1, the buffer phys
+ * pointer, then (after a sync) DW3 last — DW3 is the commit word.
+ * Silicon consumes the descriptor and frees the buffer; there is no
+ * own-bit poll on the CPU TX path (own=0 means "CPU filled, silicon
+ * take it"). MMIO window ownership stays inside cqm/grx500 so callers
+ * never touch g_cbm_eqm_base directly.
+ *
+ * @pid:          EQM CPU ingress port id (0..3).
+ * @dw0:          descriptor DWORD0 (dest_sub_if_id etc).
+ * @dw1:          descriptor DWORD1 (ep / color etc).
+ * @data_phys:    physical/bus address of the buffer (incl pmac hdr).
+ * @dw3:          descriptor DWORD3 (data_len | sop | eop, own=0) —
+ *                written LAST, commits the enqueue.
+ *
+ * Returns 0 on success, -EINVAL on bad pid, -ENODEV if the EQM window
+ * is not yet mapped.
+ */
+int cbm_cpu_enqueue_hw(int pid, u32 dw0, u32 dw1, u32 data_phys, u32 dw3);
+
+#endif /* _NET_CQM_CBM_API_H */
