--- /dev/null
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/fsqm.c
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sub-4 ST-003 — FSQM init for the two physical FSQM windows.
+ *
+ * Direct port of AVM cqm/grx500/cbm.c:1086-1140 init_fsqm() /
+ * init_fsqm_buf_std() / init_fsqm_by_idx(), restructured into a single
+ * idx-keyed entry point (init_fsqm(int idx)) per the Sub-4 plan
+ * "FSQM init: LLT_RAM seeding, OFSQ/OFSC/LSARNG pack, FSQT
+ * thresholds, IRNEN, CTRL".
+ *
+ * Three correctness load-bearings live in this TU:
+ *
+ *   1. The LLT_RAM seed loop bound: i = 1..frm_num INCLUSIVE.
+ *      The HW expects the i=frm_num-1 slot (last but one in the linked
+ *      list) to carry the 0x7FFF end-marker; the i=frm_num iteration
+ *      then writes slot (frm_num-1) with (frm_num % frm_num) = 0.
+ *      Drop the inclusive bound and slot (frm_num-1) is left
+ *      uninitialised — the FSQM silently deadlocks on the first
+ *      descriptor return because the linked list never terminates.
+ *
+ *   2. FSQT threshold arithmetic uses LEFT-TO-RIGHT integer division:
+ *      `frm_num / 6 * n` — NOT `(frm_num * n) / 6`. For frm_num=2048
+ *      these expressions yield 1705/1364/1023/682/341 vs.
+ *      1706/1365/1024/682/341 (FSQT0..2 wrong). The silicon's
+ *      watermark slot expects the AVM-source formula's exact value.
+ *
+ *   3. The OFSC pack reads back 0x000007FF for std@frm_num=2048 (and
+ *      0x000000FF for jbo@frm_num=256) with the Sub-4 placeholder
+ *      pools. Sub-6 raises frm_num to 9216/1024 once reserved-memory
+ *      lands, at which point OFSC reads back 0x000023FF / 0x000003FF
+ *      (the stock firmware's oracle values). The IG-012 marker is
+ *      printed by cbm.c's banner so the divergence is auditable.
+ *
+ * Note on writel choice: the codebase uses fsqm_w32() / fsqm_r32()
+ * inline helpers (cbm.h) which wrap __raw_writel / __raw_readl to
+ * match AVM cbm.c:170-171 xrx500_cbm_r32/w32 semantics. We use those
+ * helpers throughout to maintain a single barrier convention across
+ * the whole grx500 CBM port. __raw_writel does NOT carry the wmb()
+ * barrier that the cooked writel() carries; that is the AVM-source
+ * pinned convention, NOT a Builder optimisation.
+ *
+ * Note on RCNT: AVM cqm/grx500/cbm.c:1112-1115 (std) and cbm.c:1156-1157
+ * (jbo, unconditional) write RCNT[i-1] = 1 per-slot INSIDE the LLT loop.
+ * The attempt-1 plan Step 3.(4) consolidated this into a single
+ * writel(1, base + RCNT) at the top of init_fsqm_by_idx, but the
+ * Build-Reviewer (attempt-1 verdict) correctly identified that as a
+ * silent behavioral divergence from the byte-for-byte AVM port contract:
+ * slots RCNT[1..frm_num-1] would be left at the silicon-reset value (0)
+ * which risks FSQM deadlock on first descriptor return. attempt-2
+ * RESTORES the per-slot RCNT[i-1]=1 write inside init_fsqm_buf_std's
+ * LLT seed loop to match AVM verbatim; the single fsqm_w32(RCNT, 1) in
+ * init_fsqm_by_idx is removed (the per-slot loop now covers RCNT[0] = 1
+ * at i=1).
+ *
+ * Note on bit-field constants: LSARNG_MAXLSA_POS / OFSC_FSC_MASK /
+ * etc. live in AVM cqm/grx500/reg/fsqm.h. cbm_regs.h is OUTSIDE
+ * ST-003's file_scope.modify, so the bit constants are defined locally
+ * here with file-scope #defines. Recorded as a manifest note.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/io.h>
+#include <linux/bug.h>
+#include <linux/types.h>
+
+#include "cbm.h"
+
+/*
+ * Local bit-field constants — verbatim from AVM
+ * cqm/grx500/reg/fsqm.h:564-702. cbm_regs.h is outside ST-003's
+ * file_scope.modify, so these live here. Sub-6 may promote them to
+ * cbm_regs.h once the FSQM_LSARNG_*_POS / FSQM_OFSC_*_POS namespace
+ * is needed by another TU.
+ *
+ *   AVM fsqm.h:564 OFSQ_HEAD_POS    = 0
+ *   AVM fsqm.h:566 OFSQ_HEAD_MASK   = 0x7FFFu
+ *   AVM fsqm.h:569 OFSQ_TAIL_POS    = 16
+ *   AVM fsqm.h:571 OFSQ_TAIL_MASK   = 0x7FFF0000u
+ *   AVM fsqm.h:587 OFSC_FSC_POS     = 0
+ *   AVM fsqm.h:589 OFSC_FSC_MASK    = 0x7FFFu
+ *   AVM fsqm.h:695 LSARNG_MINLSA_POS  = 0
+ *   AVM fsqm.h:697 LSARNG_MINLSA_MASK = 0x7FFFu
+ *   AVM fsqm.h:700 LSARNG_MAXLSA_POS  = 16
+ *   AVM fsqm.h:702 LSARNG_MAXLSA_MASK = 0x7FFF0000u
+ */
+#define LSARNG_MINLSA_POS  0
+#define LSARNG_MINLSA_MASK 0x00007FFFu
+#define LSARNG_MAXLSA_POS  16
+#define LSARNG_MAXLSA_MASK 0x7FFF0000u
+#define OFSQ_HEAD_POS      0
+#define OFSQ_HEAD_MASK     0x00007FFFu
+#define OFSQ_TAIL_POS      16
+#define OFSQ_TAIL_MASK     0x7FFF0000u
+#define OFSC_FSC_POS       0
+#define OFSC_FSC_MASK      0x00007FFFu
+
+/* FSQM end-of-list sentinel. AVM cqm/grx500/cbm.c:1106 / 1110-1112:
+ *   the last linked-list slot carries the literal 0x7FFF (NOT 0xFFFF
+ *   and NOT 0x7FFFFFFF — the HW only consumes the low 15 bits and a
+ *   wider literal would alias into the reserved bits 15..31).
+ */
+#define FSQM_LLT_END_MARKER 0x7FFFu
+
+/*
+ * init_fsqm_buf_std — seed the FSQM Linked-List Table RAM.
+ *
+ * Per AVM cqm/grx500/cbm.c:1103-1116, the loop bound is INCLUSIVE
+ * (i = 1..frm_num), and the i==frm_num-1 iteration emits the
+ * end-marker 0x7FFF into slot (frm_num-2). All other iterations
+ * write (i % frm_num) — so the i=frm_num iteration writes slot
+ * (frm_num-1) with value 0 (since frm_num % frm_num = 0).
+ *
+ * Worked example (frm_num=8):
+ *   i=1 slot 0 -> 1     i=2 slot 1 -> 2     i=3 slot 2 -> 3
+ *   i=4 slot 3 -> 4     i=5 slot 4 -> 5     i=6 slot 5 -> 6
+ *   i=7 slot 6 -> 0x7FFF (END-MARKER)
+ *   i=8 slot 7 -> 0 (8 % 8 = 0)
+ *
+ * MUST NOT REWRITE the loop to i=0..frm_num-1: doing so writes slot 0
+ * with (0 % frm_num) = 0 instead of 1, and slot frm_num-1 is left
+ * uninitialised — the FSQM deadlocks on first buffer return.
+ *
+ * After seeding, a sampled WARN_ONCE self-check verifies the seed
+ * survived the writes. The check samples at most 8 random slots
+ * (avoids log-spam at frm_num=2048).
+ */
+static void init_fsqm_buf_std(int idx, u32 frm_num)
+{
+	u32 i;
+	u32 samples;
+	u32 sample_step;
+
+	/* AVM cqm/grx500/cbm.c:1103-1116 — i = 1..frm_num INCLUSIVE.
+	 * MUST NOT REWRITE to i=0..frm_num-1 (silent deadlock).
+	 *
+	 * Per-slot RCNT[i-1] = 1 is written ALONGSIDE the LLT seed inside
+	 * this loop — AVM cbm.c:1112-1115 (std, #else branch) and AVM
+	 * cbm.c:1156-1157 (jbo, unconditional). Pulling the RCNT write out
+	 * of the loop (as the attempt-1 plan-step did) leaves slots
+	 * RCNT[1..frm_num-1] at the silicon-reset value (0) and risks
+	 * FSQM deadlock on first descriptor return. MUST NOT MOVE the
+	 * RCNT write back out of this loop.
+	 */
+	for (i = 1; i <= frm_num; i++) {
+		u32 slot = i - 1;
+		u32 val  = (i == frm_num - 1) ? FSQM_LLT_END_MARKER
+					      : (i % frm_num);
+
+		fsqm_w32(idx, RAM  + (slot << 2), val);
+		fsqm_w32(idx, RCNT + (slot << 2), 1);
+	}
+
+	/* Sampled readback self-check — at most 8 slots, evenly spaced.
+	 * Uses dynamic expected = ((i+1) == frm_num-1 ? 0x7FFF
+	 *                                             : (i+1) % frm_num)
+	 * so any future frm_num bump stays correct. WARN_ONCE keeps the
+	 * boot log usable on hardware that mis-seeds repeatedly.
+	 *
+	 * Boundary-slot coverage (attempt-2 reviewer fix): the evenly-spaced
+	 * sweep below MISSES the two slots with non-trivial values when
+	 * sample_step > 1 (e.g. frm_num=2048 leaves slot 2046 [end-marker]
+	 * and slot 2047 [wrap-terminator] unchecked). Force-check those two
+	 * slots after the sweep — they are the slots a regression to the
+	 * loop bound or end-marker conditional would silently corrupt.
+	 * Total readback ≤ 10 slots, well below log-spam threshold.
+	 */
+	samples = (frm_num < 8) ? frm_num : 8;
+	sample_step = frm_num / samples;
+	if (!sample_step)
+		sample_step = 1;
+	for (i = 0; i < samples; i++) {
+		u32 slot = i * sample_step;
+		u32 expected;
+		u32 read_val;
+
+		if (slot >= frm_num)
+			break;
+
+		/* Loop wrote slot S with value V where (S = j-1, V depends
+		 * on j) for j=1..frm_num. So expected[S] is:
+		 *   if (S == frm_num - 2)  -> 0x7FFF (end marker; j=frm_num-1)
+		 *   else                   -> (S + 1) % frm_num
+		 */
+		if (slot == frm_num - 2)
+			expected = FSQM_LLT_END_MARKER;
+		else
+			expected = (slot + 1) % frm_num;
+
+		read_val = fsqm_r32(idx, RAM + (slot << 2));
+		WARN_ONCE(read_val != expected,
+			  "cbm: FSQM LLT_RAM seed mismatch idx=%d slot=%u got=0x%08x expected=0x%08x\n",
+			  idx, slot, read_val, expected);
+	}
+
+	/* Boundary slot coverage: end-marker slot (frm_num-2) MUST hold
+	 * 0x7FFF and wrap-terminator slot (frm_num-1) MUST hold 0
+	 * (frm_num % frm_num = 0). These are the two slots whose values
+	 * are non-trivial under the AVM seed contract; any mutation to the
+	 * loop bound or end-marker conditional would corrupt them.
+	 * Guarded by frm_num >= 2 (already enforced at init_fsqm entry).
+	 */
+	if (frm_num >= 2) {
+		u32 em_slot = frm_num - 2;
+		u32 wrap_slot = frm_num - 1;
+		u32 em_val = fsqm_r32(idx, RAM + (em_slot << 2));
+		u32 wrap_val = fsqm_r32(idx, RAM + (wrap_slot << 2));
+
+		WARN_ONCE(em_val != FSQM_LLT_END_MARKER,
+			  "cbm: FSQM LLT_RAM end-marker missing idx=%d slot=%u got=0x%08x expected=0x%08x\n",
+			  idx, em_slot, em_val, FSQM_LLT_END_MARKER);
+		WARN_ONCE(wrap_val != 0,
+			  "cbm: FSQM LLT_RAM wrap-terminator non-zero idx=%d slot=%u got=0x%08x expected=0\n",
+			  idx, wrap_slot, wrap_val);
+	}
+}
+
+/*
+ * init_fsqm_by_idx — register-sequence init for one FSQM instance.
+ *
+ * AVM cqm/grx500/cbm.c:1103-1136 + 1086-1091 source ordering
+ * (preserving the bit-packed LSARNG/OFSQ/OFSC operands computed by the
+ * caller). The write sequence is:
+ *
+ *   (1) [init_fsqm_buf_std done by caller — LLT_RAM linked list +
+ *        per-slot RCNT[i-1]=1; see file-top "Note on RCNT"]
+ *   (2) LSARNG = <maxlsa:minlsa>
+ *   (3) OFSQ   = <tail:head>
+ *   (4) OFSC   = <fill>
+ *   (5) FSQM_IRNEN = FSQM_IRNEN_DEFAULT
+ *   (6) FSQT0..FSQT4 = frm_num/6 * (5..1)
+ *   (7) IO_BUF_RD = 0          -- clear HW-master read command window
+ *   (8) IO_BUF_WR = 0          -- clear HW-master write command window
+ *   (9) FSQM_CTRL = 1          -- enable FSQM
+ *
+ * (7)-(9) are AVM's init_fsqm_by_idx (cbm.c:1086-1091), called LAST
+ * (cbm.c:1136) after all list/range state is programmed — the IO_BUF
+ * drain belongs immediately before the enable, NOT at the front
+ * (IG-157: the earlier front-position drain is the prime suspect for
+ * the EQM hardware buffer-exchange pop never functioning, while the
+ * software BUFREQ pop path worked). FSQM_CTRL is written LAST so the
+ * engine cannot consume a partial config snapshot.
+ *
+ * Dynamic FSQT readback uses `expected = frm_num / 6 * n` — the SAME
+ * formula as the write, NOT hardcoded 1705/1023/etc — so the check
+ * stays correct when Sub-6 bumps frm_num to 9216/1024.
+ */
+static void init_fsqm_by_idx(int idx, u32 frm_num, u32 lsarng,
+			     u32 ofsq, u32 ofsc)
+{
+	u32 fsqt0_expected;
+	u32 fsqt1_expected;
+	u32 fsqt2_expected;
+	u32 fsqt3_expected;
+	u32 fsqt4_expected;
+
+	/*
+	 * IG-157 — the IO_BUF_RD/WR drain MOVED to the END, immediately
+	 * before CTRL=1. That is AVM's REAL ordering: init_fsqm_buf_std
+	 * writes LLT/RCNT, LSARNG, OFSQ, OFSC, IRNEN, FSQT0-4 (cbm.c:
+	 * 1103-1134) and THEN calls init_fsqm_by_idx (cbm.c:1136 -> 1086-
+	 * 1091), whose entire body is: IO_BUF_RD=0; IO_BUF_WR=0; CTRL=1.
+	 * Our port had hoisted the drain to the FRONT with an invented
+	 * "must drain before LSARNG/OFSQ/OFSC" rationale that contradicts
+	 * the source. Suspected consequence (IG-156b hardware evidence):
+	 * the software BUFREQ pops work, but the EQM's HARDWARE buffer-
+	 * exchange pop never succeeds (OFSC never moves from EQM activity;
+	 * the EQM accepts exactly the one pre-seeded spare frame then
+	 * REASON2-rejects) — consistent with the HW-master command port
+	 * (IO_BUF) being armed against pre-config state instead of being
+	 * cleared as the final step of the enable sequence.
+	 */
+
+	/* (3) LLT seed already done by init_fsqm() before us. The seed
+	 *     loop in init_fsqm_buf_std also writes RCNT[i-1]=1 per slot
+	 *     (AVM cbm.c:1112-1115 std / 1156-1157 jbo), so no separate
+	 *     RCNT write is needed here. MUST NOT re-add a single
+	 *     fsqm_w32(idx, RCNT, 1) — that would touch only slot 0 and
+	 *     leave the per-slot writes untouched (functionally a no-op
+	 *     overwrite, but cosmetically misleading).
+	 */
+
+	/* (4) (5) (6) LSARNG / OFSQ / OFSC bit-packed values, computed by
+	 *     init_fsqm() per AVM cbm.c:1121-1128.
+	 */
+	fsqm_w32(idx, LSARNG, lsarng);
+	fsqm_w32(idx, OFSQ,   ofsq);
+	fsqm_w32(idx, OFSC,   ofsc);
+
+	/* (7) FSQM_IRNEN_DEFAULT — symbolic constant, NOT a literal
+	 *     0x111101F. cbm_regs.h's static_assert proves the OR sums to
+	 *     0x111101F (AVM cbm.c:1129 oracle).
+	 */
+	fsqm_w32(idx, FSQM_IRNEN, FSQM_IRNEN_DEFAULT);
+
+	/* (8) FSQT0..FSQT4 watermarks.
+	 *     AVM cbm.c:1130-1134 uses left-to-right integer division:
+	 *     (frm_num / 6) * N  — NOT (frm_num * N) / 6 — which yields a
+	 *     different value at frm_num=2048.
+	 *     MUST NOT REWRITE to (frm_num*N)/6: at frm_num=2048 it gives
+	 *     1706/1365/1024/682/341 instead of 1705/1364/1023/682/341.
+	 */
+	fsqt0_expected = frm_num / 6 * 5;
+	fsqt1_expected = frm_num / 6 * 4;
+	fsqt2_expected = frm_num / 6 * 3;
+	fsqt3_expected = frm_num / 6 * 2;
+	fsqt4_expected = frm_num / 6;
+	fsqm_w32(idx, FSQT0, fsqt0_expected);
+	fsqm_w32(idx, FSQT1, fsqt1_expected);
+	fsqm_w32(idx, FSQT2, fsqt2_expected);
+	fsqm_w32(idx, FSQT3, fsqt3_expected);
+	fsqm_w32(idx, FSQT4, fsqt4_expected);
+
+	/* (9) IO_BUF drain + FSQM_CTRL enable — the AVM init_fsqm_by_idx
+	 *     triplet (cbm.c:1086-1091), byte-exact and LAST so the engine
+	 *     starts on a consistent snapshot of all preceding regs with a
+	 *     freshly cleared HW-master command window.
+	 */
+	fsqm_w32(idx, IO_BUF_RD, 0);
+	fsqm_w32(idx, IO_BUF_WR, 0);
+	fsqm_w32(idx, FSQM_CTRL, 1);
+
+	/* Self-checks per AC-003-3 / AC-003-5 / AC-003-6. Dynamic formula
+	 * matches the write (NOT hardcoded values) — robust to any future
+	 * frm_num bump.
+	 */
+	WARN_ON(fsqm_r32(idx, FSQT0) != fsqt0_expected);
+	WARN_ON(fsqm_r32(idx, FSQT1) != fsqt1_expected);
+	WARN_ON(fsqm_r32(idx, FSQT2) != fsqt2_expected);
+	WARN_ON(fsqm_r32(idx, FSQT3) != fsqt3_expected);
+	WARN_ON(fsqm_r32(idx, FSQT4) != fsqt4_expected);
+	WARN_ON(fsqm_r32(idx, FSQM_IRNEN) != FSQM_IRNEN_DEFAULT);
+	WARN_ON(fsqm_r32(idx, LSARNG) != lsarng);
+	WARN_ON(fsqm_r32(idx, OFSQ)   != ofsq);
+	WARN_ON(fsqm_r32(idx, OFSC)   != ofsc);
+}
+
+/*
+ * init_fsqm — public entry point. Brings up one FSQM instance.
+ *
+ * @idx: 0 = std pool FSQM, 1 = jbo pool FSQM (per AVM
+ *       std_fsqm_idx/jbo_fsqm_idx convention).
+ *
+ * AVM equivalence map:
+ *   init_fsqm()              (AVM cbm.c:1181-1202) — the no-arg outer
+ *                            init that bound to specific pools.
+ *   init_fsqm_buf_std()      (AVM cbm.c:1095-1139) — the std-pool body.
+ *   init_fsqm_buf_jumbo()    (AVM cbm.c:1141-1179) — the jbo-pool body.
+ *
+ * The Sub-4 plan collapses {std,jbo} into a single idx-keyed
+ * init_fsqm(idx) so cbm_hw_init can simply call init_fsqm(0);
+ * init_fsqm(1); (order matters — std before jbo per AVM cbm.c:1199-1200
+ * outer init).
+ *
+ * Inputs are read from g_cbm_buff (populated by ST-002's probe):
+ *   frm_num   = std_frm_num | jbo_frm_num
+ *   frm_size  = std_frm_size | jbo_frm_size
+ *   pool_base = std_buf_addr | jbo_buf_addr (post-buf_addr_adjust)
+ *
+ * Sub-4 PLACEHOLDER values per IG-012:
+ *   std: frm_num = 2048, frm_size = 2048, pool = 4 MiB
+ *        -> maxlsa = 2046, minlsa = 0, OFSC = 0x000007FF
+ *   jbo: frm_num =  256, frm_size = 8192, pool = 2 MiB
+ *        -> maxlsa =  254, minlsa = 0, OFSC = 0x000000FF
+ *
+ * Sub-6 will swap to reserved-memory backed pools at AVM-sized
+ * frm_num (std=9216, jbo=1024), at which point OFSC reads back
+ * 0x000023FF / 0x000003FF (the stock firmware's oracle).
+ */
+void init_fsqm(int idx)
+{
+	u32 frm_num;
+	u32 maxlsa;
+	u32 minlsa;
+	u32 lsarng;
+	u32 ofsq;
+	u32 ofsc;
+	u32 ofsc_readback;
+
+	if (idx < 0 || idx > 1) {
+		pr_err("cbm: init_fsqm: invalid idx %d (must be 0 or 1)\n",
+		       idx);
+		return;
+	}
+	if (!g_cbm_fsqm_base[idx]) {
+		pr_err("cbm: init_fsqm: g_cbm_fsqm_base[%d] not ioremapped\n",
+		       idx);
+		return;
+	}
+
+	/* (a) Pull per-instance parameters from g_cbm_buff (ST-002 probe
+	 *     populated them; ST-003 owns the consumption shape).
+	 */
+	frm_num = (idx == 0) ? g_cbm_buff.std_frm_num
+			     : g_cbm_buff.jbo_frm_num;
+
+	if (frm_num < 2) {
+		pr_err("cbm: init_fsqm: idx=%d frm_num=%u too small (need >=2)\n",
+		       idx, frm_num);
+		return;
+	}
+
+	/* (b) LLT_RAM seed first — the linked-list must exist before the
+	 *     register sequence below brings the engine online.
+	 */
+	init_fsqm_buf_std(idx, frm_num);
+
+	/* (c) Compute LSARNG / OFSQ / OFSC pack values.
+	 *     Verbatim from AVM cqm/grx500/cbm.c:1086-1101 / 1121-1128.
+	 *     minlsa = 0; maxlsa = frm_num - 2  (equivalent to AVM's
+	 *     (size / frm_size) - 2 because frm_num = size / frm_size).
+	 *     The "-2" is the AVM-source's "last item is invalid inside
+	 *     the FSQM" rule (cbm.c:1119, cbm.c:1162).
+	 *
+	 *     LSARNG: HEAD(maxlsa) at bit 16, TAIL(minlsa) at bit 0
+	 *     OFSQ:   TAIL(maxlsa) at bit 16, HEAD(minlsa) at bit 0
+	 *     OFSC:   FSC = (maxlsa - minlsa + 1) at bit 0
+	 *
+	 *     For std@frm_num=2048: maxlsa=2046, OFSC=0x000007FF
+	 *     For jbo@frm_num=256:  maxlsa=254,  OFSC=0x000000FF
+	 */
+	minlsa = 0;
+	maxlsa = frm_num - 2;
+	lsarng = ((maxlsa << LSARNG_MAXLSA_POS) & LSARNG_MAXLSA_MASK) |
+		 ((minlsa << LSARNG_MINLSA_POS) & LSARNG_MINLSA_MASK);
+	ofsq   = ((maxlsa << OFSQ_TAIL_POS) & OFSQ_TAIL_MASK) |
+		 ((minlsa << OFSQ_HEAD_POS) & OFSQ_HEAD_MASK);
+	ofsc   = ((maxlsa - minlsa + 1) << OFSC_FSC_POS) & OFSC_FSC_MASK;
+
+	/* (d) Run the 10-step register sequence (IO_BUF, RCNT, LSARNG,
+	 *     OFSQ, OFSC, IRNEN, FSQTn, CTRL).
+	 */
+	init_fsqm_by_idx(idx, frm_num, lsarng, ofsq, ofsc);
+
+	/* (e) Sub-6 will swap pool sizes; expected OFSC=0x000023FF /
+	 *     0x000003FF then, per the stock firmware. The Sub-4 placeholder
+	 *     readback contract is OFSC=0x000007FF (std) / 0x000000FF
+	 *     (jbo) — AC-003-4.
+	 */
+	ofsc_readback = fsqm_r32(idx, OFSC);
+	WARN_ON(ofsc_readback != ofsc);
+
+	pr_info("cbm: %sinit_fsqm idx=%d frm_num=%u OFSC=0x%08x (lsarng=0x%08x ofsq=0x%08x)\n",
+		g_cbm_buff.placeholder ? "PLACEHOLDER " : "",
+		idx, frm_num, ofsc_readback, lsarng, ofsq);
+}
+EXPORT_SYMBOL_GPL(init_fsqm);
