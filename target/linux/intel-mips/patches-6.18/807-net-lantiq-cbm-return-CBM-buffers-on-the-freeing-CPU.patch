-#define CBM_CPU_DQM_RETURN_PORT 2
+static u32 cbm_rx_return_port(void)
+{
+	u32 cpu = smp_processor_id();
+
+	/*
+	 * Unreachable on this 4-VPE SoC (CPU_DQM_PORT_NUM == the VPE count).
